<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Godot 4.7's prebuilt Android template is built for net9.0 and refuses
         anything else; the desktop stays on net8.0. ADR-0017. -->
    <TargetFramework Condition="'$(GodotTargetPlatform)' == 'android'">net9.0</TargetFramework>
    <!-- The web export exists only in the fork in tools/godot_web, whose
         runtime is .NET 9's browser-wasm Mono; it also needs an entry point,
         src/Platform/Web/Program.cs, which no other build compiles.
         ADR-0008. -->
    <TargetFramework Condition="'$(GodotTargetPlatform)' == 'web'">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>GUO</RootNamespace>
    <AssemblyName>GUO</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <!--
      Ported ClassicUO code is performance-critical and uses pointer arithmetic
      in the .mul/.uop readers, exactly as upstream does.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Upstream has many intentional unused-parameter and naming patterns.
         Keep the build readable while the port is in progress. -->
    <NoWarn>CS0169;CS0649;CA1050</NoWarn>
  </PropertyGroup>

  <!--
    The plugin ABI: CUO_API.PluginHeader and the delegates a plugin DLL is
    handed. Referenced from the upstream checkout by HintPath, exactly as
    upstream's ClassicUO.Client.csproj does, and never re-declared here: a
    hand-written copy that drifted by one field would corrupt every plugin.
    UpstreamDir can be overridden (-p:UpstreamDir=... or the environment) for
    a checkout that keeps sources/ elsewhere, such as a git worktree.
  -->
  <ItemGroup Condition="'$(GodotTargetPlatform)' != 'web'">
    <Compile Remove="src/Platform/Web/Program.cs" />
  </ItemGroup>

  <PropertyGroup>
    <UpstreamDir Condition="'$(UpstreamDir)' == ''">$(MSBuildThisFileDirectory)..\..\sources\ClassicUO</UpstreamDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="cuoapi">
      <HintPath>$(UpstreamDir)\external\cuoapi\cuoapi.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!--
    The managed-plugin host, tools/plugin_host: upstream's ClassicUO.Bootstrap
    ported to a .NET Framework library that src/Network/PluginClrHost.cs
    starts inside this process. Built with the client and copied into a
    plugin_host folder next to GUO.dll, where that class looks for it.
    Windows only, as .NET Framework is.
  -->
  <!--
    Whether this build carries the plugin host. Two facts have to hold: the
    build machine is Windows, because the host is .NET Framework, and the
    build is FOR Windows, because so is the host. Godot's export sets
    GodotTargetPlatform from the RuntimeIdentifier (android-arm64 gives
    "android"); a desktop build on Windows gets "windows" from the SDK, and
    a plain `dotnet build` with no RID gets the same. Without the second
    test an Android export from a Windows machine built the host for
    android-arm64, which its x64 PlatformTarget refuses (NETSDK1032).
    ADR-0017.
  -->
  <PropertyGroup>
    <GuoPluginHost Condition="'$(OS)' == 'Windows_NT' and ('$(GodotTargetPlatform)' == '' or '$(GodotTargetPlatform)' == 'windows')">true</GuoPluginHost>
  </PropertyGroup>
  <ItemGroup Condition="'$(GuoPluginHost)' == 'true'">
    <ProjectReference Include="..\..\tools\plugin_host\GUO.PluginHost.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="TargetFramework" />
  </ItemGroup>
  <!--
    An export builds for a runtime identifier (win-x64), which puts the host
    one folder deeper, and publishes to a directory of its own; both are
    covered so an exported build carries plugin_host as a dev build does.
  -->
  <Target Name="CopyPluginHost" AfterTargets="Build" Condition="'$(GuoPluginHost)' == 'true'">
    <ItemGroup>
      <PluginHostFiles Include="..\..\tools\plugin_host\bin\$(Configuration)\*.dll" />
      <PluginHostFiles Include="..\..\tools\plugin_host\bin\$(Configuration)\$(RuntimeIdentifier)\*.dll" Condition="'$(RuntimeIdentifier)' != ''" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginHostFiles)" DestinationFolder="$(OutDir)plugin_host" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishPluginHost" AfterTargets="Publish" DependsOnTargets="CopyPluginHost" Condition="'$(GuoPluginHost)' == 'true'">
    <Error Condition="'@(PluginHostFiles)' == ''" Text="plugin_host was not built; an exported GUO would load no managed plugin." />
    <Copy SourceFiles="@(PluginHostFiles)" DestinationFolder="$(PublishDir)plugin_host" SkipUnchangedFiles="true" />
  </Target>

  <!--
    Compiled-in resources.

    The .resx files keep their UPSTREAM logical names. The ported
    Res*.Designer.cs files ask for "ClassicUO.Resources.ResGumps" and friends,
    and that string is inside a literal, which the bulk porter deliberately
    never rewrites. Renaming the resource to match the port would mean editing
    three generated files by hand on every upstream merge; naming the resource
    what the code already asks for costs one attribute and nothing else. The
    logical name is an internal lookup key, not anything a user sees.

    The two PNGs replace upstream's FileEmbed source generator; see
    src/Resources/Loader.cs.
  -->
  <ItemGroup>
    <EmbeddedResource Update="src/Resources/embedded/ResErrorMessages.resx" LogicalName="ClassicUO.Resources.ResErrorMessages.resources" />
    <EmbeddedResource Update="src/Resources/embedded/ResGeneral.resx" LogicalName="ClassicUO.Resources.ResGeneral.resources" />
    <EmbeddedResource Update="src/Resources/embedded/ResGumps.resx" LogicalName="ClassicUO.Resources.ResGumps.resources" />
    <EmbeddedResource Include="src/Resources/embedded/cuologo.png" LogicalName="cuologo.png" />
    <EmbeddedResource Include="src/Resources/embedded/game-background.png" LogicalName="game-background.png" />
    <!-- GUO: input glyphs (Kenney Input Prompts Pixel, CC0), tools/glyphs -->
    <EmbeddedResource Include="src/Resources/embedded/glyphs/*.png" LogicalName="glyphs/%(Filename)%(Extension)" />
    <!-- GUO: the community server catalogue, servers/ at the repo root (docs/data_formats.md 18) -->
    <EmbeddedResource Include="../../servers/catalogue.json" LogicalName="servers/catalogue.json" />
    <!--
      The eight UI fonts, upstream's own .xnb files. They replace the FileEmbed
      source generator the same way the two PNGs above do; see src/Render/Fonts.cs.
    -->
    <EmbeddedResource Include="src/Resources/embedded/fonts/regular_font.xnb" LogicalName="regular_font.xnb" />
    <EmbeddedResource Include="src/Resources/embedded/fonts/bold_font.xnb" LogicalName="bold_font.xnb" />
    <EmbeddedResource Include="src/Resources/embedded/fonts/map1_font.xnb" LogicalName="map1_font.xnb" />
    <EmbeddedResource Include="src/Resources/embedded/fonts/map2_font.xnb" LogicalName="map2_font.xnb" />
    <EmbeddedResource Include="src/Resources/embedded/fonts/map3_font.xnb" LogicalName="map3_font.xnb" />
    <EmbeddedResource Include="src/Resources/embedded/fonts/map4_font.xnb" LogicalName="map4_font.xnb" />
    <EmbeddedResource Include="src/Resources/embedded/fonts/map5_font.xnb" LogicalName="map5_font.xnb" />
    <EmbeddedResource Include="src/Resources/embedded/fonts/map6_font.xnb" LogicalName="map6_font.xnb" />
  </ItemGroup>
</Project>
