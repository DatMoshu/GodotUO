; GUO - Godot project
;
; Generated as part of the ClassicUO -> Godot port scaffold.
; Engine: Godot 4.7.2 .NET (mono). The .NET build is required; the port is C#.

config_version=5

[application]

config/name="GUO"
config/description="Godot Ultima Online - the Classic client, ported from ClassicUO onto Godot."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"

[dotnet]

project/assembly_name="GUO"

[rendering]

renderer/rendering_method="forward_plus"
; UO art is authored as pixel art: never filter it.
textures/canvas_textures/default_texture_filter=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
; No stretch. The client sizes its own window -- the login screen asks for
; 640x480, the game for whatever the profile saved -- and draws one client
; pixel per screen pixel, as the original does. Any stretch mode would keep
; the root viewport at the size above and scale the result, which both
; filters pixel art and leaves the client drawing into a corner of a buffer
; it does not know the size of.
window/stretch/mode="disabled"
window/stretch/aspect="expand"
; Phones and tablets only (ignored on the desktop): UO is a landscape game,
; and the touch layer sizes its gump bar for a wide screen. ADR-0007.
window/handheld/orientation=4

[debug]

gdscript/warnings/enable=true
