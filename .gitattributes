# Default: let git normalise text in the repo, check out native on Windows.
* text=auto

# Windows launchers MUST be CRLF: cmd.exe mis-parses LF-only .bat files
# (a `call` on the last line can silently do nothing).
*.bat text eol=crlf
*.cmd text eol=crlf
*.bat.example text eol=crlf

# Everything else stays LF in the working tree so the C# and Python
# toolchains, and any non-Windows contributor, see consistent files.
*.cs   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.sh   text eol=lf
*.sh.example text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Godot project files.
*.godot   text eol=lf
*.tscn    text eol=lf
*.tres    text eol=lf
*.import  text eol=lf
*.csproj  text eol=lf
*.gd      text eol=lf
*.gdshader text eol=lf
*.gdshaderinc text eol=lf
*.resx    text eol=lf
*.toml    text eol=lf

# Extensionless dotfiles: without this they fall through to `text=auto`
# and core.autocrlf checks them out CRLF, which churns on every commit.
.gitignore     text eol=lf
.gitattributes text eol=lf
.editorconfig  text eol=lf

# Binary.
*.png binary
*.jpg binary
*.ico binary
*.zip binary

# Godot script UIDs: generated, committed, and LF like everything else.
*.uid text eol=lf

# Patches are applied byte for byte by `git apply`; line-ending normalisation
# makes them fail to apply. Keep them exactly as written.
*.patch -text

# Fixtures copied byte for byte from other projects (sha256-checked manifests).
tools/uopack/fixtures/** -text
