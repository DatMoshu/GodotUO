# ============================================================================
#  GUO
#
#  Adapted from the Claude Code Game Studios template. The Unity and Unreal
#  sections were removed: this is a Godot .NET project, and the inherited
#  `*.csproj` / `*.sln` rules would have excluded godot/GUO/GUO.csproj,
#  which must be tracked.
# ============================================================================

# === Large external checkouts (restored by launchers, not committed) ======
# Upstream ClassicUO reference (~170 MB, its own git repo).
# Restore with: launchers\dev\sync_upstream.bat
# The exact reviewed commit is recorded in docs/upstream/UPSTREAM_PIN.json.
sources/

# Pinned Godot engine build (~350 MB).
# Restore with: launchers\dev\fetch_godot.bat
tools/godot/Godot_v*/

# ModernUO checkout and build (~1 GB, its own git repo).
# Restore with: launchers\shard\fetch.bat then launchers\shard\build.bat
# The patches, the config templates and the reviewed commit are tracked in
# tools/modernuo; the source and the built server are not.
tools/modernuo/src/

# === Generated artifacts ==================================================
build/
docs/consistency-failures.md

# === Godot ================================================================
.godot/
.mono/
*.translation
export_presets.cfg

# === .NET =================================================================
bin/
obj/
*.user
*.suo
*.pdb
*.mdb
*.opendb
*.VC.db
# Godot generates the solution; the .csproj is authored and IS tracked.
godot/GUO/GUO.sln
godot/GUO/GUO.slnx

# === Build output =========================================================
builds/
out/
dist/
*.exe
*.dll
*.so
*.dylib
*.app

# === Compiled shaders =====================================================
*.spv
*.cso
*.dxbc

# === IDE and editor =======================================================
.vs/
.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# === Claude Code local ====================================================
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md

# === Your machine =========================================================
# Your own paths: copy launchers/_shared/config.local.bat.example.
launchers/_shared/config.local.bat*
!launchers/_shared/config.local.bat.example
launchers/_shared/config.local.sh*
!launchers/_shared/config.local.sh.example
# Agent working files (sprints, session state, logs) stay local, as in CCGS upstream.
production/*
!production/session-state/
production/session-state/*
!production/session-state/.gitkeep
# Browser-automation snapshots.
.playwright-mcp/

# === Temporary and cache ==================================================
*.tmp
*.temp
*.cache
*.log
__pycache__/
*.pyc
.pytest_cache/
node_modules/

# === Archives =============================================================
*.zip
*.tar.gz
*.rar
*.7z

# === Secrets ==============================================================
.env
.env.local
.env.*.local
*.pem
*.key
credentials.json
secrets.json
# The dev shard's generated passwords (tools/guo/shard_secrets.py). They live
# in the per-user workspace, outside the repo; this catches a workspace that
# UO_WORKSPACE_DIR points inside it.
secrets.bat
secrets.bat.tmp

# === UO game data: proprietary, never committed ===========================
# The client install is read in place from UO_CLIENT_DATA. Nothing below
# should ever appear in this repository; these rules are a backstop against
# an accidental copy.
*.mul
*.uop
*.idx
*.enu
*.def
cliloc.*
Cliloc.*

# The Godot export templates fetched beside the engine.
tools/godot/templates/

# Press kit: kept locally, out of the repo for now
design/press-kit/

# Godot 4.4+ resource UIDs for C# scripts; the editor regenerates them.
*.uid

# === Device builds and signing ============================================
# APKs, bundles and keystores are built per machine; a keystore is a secret.
*.apk
*.aab
*.idsig
*.keystore
*.jks
godot/GUO/android/build/
godot/GUO/android/.build_version

# === Agent coordination ===================================================
# Director/Codex hand-over notes and session hand-offs name local machines,
# devices and accounts; they stay on the machine that wrote them.
codex_message.md
codex_reply.md
docs/handoff_*.md

# privacy_scan: your own values, never committed.
tools/privacy_scan/deny.local.txt

# tools/godot_web: a community Godot 4.7.2 mono build that can export C# to
# the web (ADR-0008 amendment). The binaries are third-party and large; only
# the README (version, origin, SHA-256) is tracked.
tools/godot_web/*
!tools/godot_web/README.md

# tools/web/hello: generated by the editor and the export.
tools/web/hello/.godot/
tools/web/hello/Hello.sln
tools/web/hello/export_presets.cfg

# ServUO checkout and build (GPL-3.0, never vendored): tools/servuo
tools/servuo/src/
# Codex's view of the skills: a local link to .claude/skills (tools/agent_skills).
.agents/

# tools/pixelorama (ADR-0029): Pixelorama source and release build are fetched
# (MIT, third-party); the README, run.py and the GUO extension are ours.
tools/pixelorama/src/
tools/pixelorama/bin/
# Fit Lab browser runtime: installed automatically, editor only.
godot/GUO/addons/godot_cef/
