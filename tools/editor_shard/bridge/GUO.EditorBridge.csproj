<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The GUO editor bridge, a ModernUO assembly (see EditorBridge.cs). Built
    against the private instance's own Server.dll and Logger.dll, so it matches
    what that instance runs. tools/editor_shard/run.py builds and installs it:

      python tools\editor_shard\run.py bridge
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>GUO.EditorBridge</AssemblyName>
    <RootNamespace>GUO.EditorBridge</RootNamespace>
    <!-- The ModernUO build to compile against: the private copy by default. -->
    <ModernUODir Condition="'$(ModernUODir)' == ''">$(MSBuildThisFileDirectory)..\..\..\build\shard_private</ModernUODir>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\..\build\editor_bridge</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- tests/ is its own project (AdminChannel.cs without the server). -->
    <Compile Remove="tests/**" />
    <Compile Include="../../../godot/GUO/src/Store/StoreMapDefinition.cs" Link="StoreMapDefinition.cs" />
    <!-- AD6: the Admin tab's snapshots, shared with the editor (which restores them). -->
    <Compile Include="../../../godot/GUO/src/Workspace/ShardBackups.cs" Link="ShardBackups.cs" />
    <Compile Include="../../../godot/GUO/src/Workspace/AdminCommandRules.cs" Link="AdminCommandRules.cs" />
    <Compile Include="../../../godot/GUO/src/Store/StoreTileDefinition.cs" Link="StoreTileDefinition.cs" />
    <Compile Include="../../../godot/GUO/src/Store/StoreRegionDefinition.cs" Link="StoreRegionDefinition.cs" />
    <Compile Include="../../../godot/GUO/src/Store/StoreLootDefinition.cs" Link="StoreLootDefinition.cs" />
    <Compile Include="../../../godot/GUO/src/Store/StoreCreatureDefinition.cs" Link="StoreCreatureDefinition.cs" />
    <Compile Include="../../../godot/GUO/src/Store/StoreSpawnerDefinition.cs" Link="StoreSpawnerDefinition.cs" />
    <Reference Include="Server">
      <HintPath>$(ModernUODir)\Server.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- ModernUO's content (spawners, decoration): the world-objects sync, ADR-0014. -->
    <Reference Include="UOContent">
      <HintPath>$(ModernUODir)\Assemblies\UOContent.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Logger">
      <HintPath>$(ModernUODir)\Logger.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
