<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The bridge's admin channel (ADR-0035) without ModernUO: AdminChannel.cs is
    plain .NET, so it is tested on its own. Run it with dotnet run and this
    project; the README of tools/editor_shard has the line.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../AdminChannel.cs" Link="AdminChannel.cs" />
    <Compile Include="../GodViewDiff.cs" Link="GodViewDiff.cs" />
    <Compile Include="../GodViewRules.cs" Link="GodViewRules.cs" />
    <Compile Include="../AccountRules.cs" Link="AccountRules.cs" />
    <Compile Include="../../../../godot/GUO/src/Workspace/AdminCommandRules.cs" Link="AdminCommandRules.cs" />
  </ItemGroup>
</Project>
