{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guo/art_set@1",
  "title": "GUO extracted art set: set.json (data_formats section 36, ADR-0034)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "generated", "tool", "client_version", "fingerprint", "classes"],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "properties": {
    "schema": {"const": "guo/art_set@1"},
    "version": {"const": 1},
    "generated": {"type": "string", "format": "date-time"},
    "tool": {"type": "string", "minLength": 1},
    "client_version": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+){1,3}[a-z]?$"},
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "set_id"],
      "properties": {
        "set_id": {"$ref": "#/$defs/sha256"},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "size", "sha256"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\:][^:]*$"},
              "size": {"type": "integer", "minimum": 0},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "classes": {
      "type": "object",
      "propertyNames": {"enum": ["land", "static", "gump", "texmap", "light", "anim"]},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pages", "count", "skipped", "bytes"],
        "properties": {
          "pages": {"type": "integer", "minimum": 0},
          "count": {"type": "integer", "minimum": 0},
          "skipped": {"type": "integer", "minimum": 0},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
