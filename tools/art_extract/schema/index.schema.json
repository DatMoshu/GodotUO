{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guo/art_index@1",
  "title": "GUO extracted art set: class index (data_formats section 36, ADR-0034)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "class", "set_id", "page_size", "pixel_format", "pages", "entries", "skipped"],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "properties": {
    "schema": {"const": "guo/art_index@1"},
    "version": {"const": 1},
    "class": {"enum": ["land", "static", "gump", "texmap", "light"]},
    "set_id": {"$ref": "#/$defs/sha256"},
    "page_size": {"const": 2048},
    "pixel_format": {"const": "rgba8"},
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "sha256"],
        "properties": {
          "file": {"type": "string", "pattern": "^page_[0-9]{4}\\.png$"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "entries": {
      "type": "object",
      "propertyNames": {"pattern": "^(0|[1-9][0-9]*)$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "x", "y", "w", "h", "pixels_sha256"],
        "properties": {
          "page": {"type": "integer", "minimum": 0},
          "x": {"type": "integer", "minimum": 0, "maximum": 2047},
          "y": {"type": "integer", "minimum": 0, "maximum": 2047},
          "w": {"type": "integer", "minimum": 1, "maximum": 2048},
          "h": {"type": "integer", "minimum": 1, "maximum": 2048},
          "pixels_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason"],
        "properties": {
          "id": {"type": "integer", "minimum": 0},
          "reason": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    }
  }
}
