{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guo/scenario@1",
  "title": "GUO scenario file (docs/data_formats.md section 34)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "surface",
    "steps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"
    },
    "title": {
      "type": "string"
    },
    "surface": {
      "enum": [
        "client",
        "editor",
        "web",
        "deck",
        "shard"
      ]
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shard": {
          "type": "string",
          "minLength": 1
        },
        "account": {
          "type": "string",
          "pattern": "^\\$\\{?[A-Za-z_][A-Za-z0-9_]*\\}?$"
        },
        "build": {
          "enum": [
            "debug",
            "release"
          ]
        }
      }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "step_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "run_s": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "do"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "do": {
          "$ref": "#/$defs/do"
        },
        "say": {
          "type": "string"
        },
        "expect": {
          "$ref": "#/$defs/expect"
        },
        "timeout_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "shot": {
          "type": "boolean"
        },
        "on_fail": {
          "enum": [
            "abort",
            "continue"
          ]
        },
        "ai_only": {
          "type": "boolean"
        },
        "surface": {
          "enum": [
            "client",
            "editor",
            "web",
            "deck",
            "shard"
          ]
        }
      }
    },
    "do": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "launch",
            "wait",
            "shot",
            "note",
            "tour_segment",
            "editor_invoke",
            "ui.click",
            "ui.fill",
            "ui.key",
            "chat",
            "scene_set",
            "renderdump",
            "render_diff",
            "lane"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "launch"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "launch"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "wait"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "wait"
              },
              "seconds": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "shot"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "shot"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "note"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "note"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "text"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tour_segment"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "tour_segment"
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "editor_invoke"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "editor_invoke"
              },
              "key": {
                "type": "string",
                "minLength": 1
              },
              "query": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "key"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ui.click"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "ui.click"
              },
              "control": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "control"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ui.fill"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "ui.fill"
              },
              "control": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "control",
              "text"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ui.key"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "ui.key"
              },
              "key": {
                "type": "string",
                "minLength": 1
              },
              "mods": {
                "type": "array",
                "items": {
                  "enum": [
                    "shift",
                    "ctrl",
                    "alt",
                    "meta"
                  ]
                }
              }
            },
            "required": [
              "kind",
              "key"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "chat"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "chat"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "text"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "scene_set"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "scene_set"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "property": {
                "type": "string",
                "minLength": 1
              },
              "value": {}
            },
            "required": [
              "kind",
              "path",
              "property",
              "value"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "renderdump"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "renderdump"
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "name"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "render_diff"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "render_diff"
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "name"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "lane"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "lane"
              },
              "lane": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "lane"
            ],
            "additionalProperties": false
          }
        }
      ]
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "within_s": {
          "type": "number",
          "minimum": 0
        },
        "result": {
          "type": "object"
        },
        "editor.state": {
          "type": "object"
        },
        "file.exists": {
          "type": "string",
          "minLength": 1
        },
        "ui.exists": {
          "type": "string",
          "minLength": 1
        },
        "ui.text": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "control",
            "equals"
          ],
          "properties": {
            "control": {
              "type": "string",
              "minLength": 1
            },
            "equals": {
              "type": "string"
            }
          }
        },
        "world.position": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "integer"
            },
            "y": {
              "type": "integer"
            },
            "z": {
              "type": "integer"
            },
            "tolerance": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "render_diff": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_drawn_diff"
          ],
          "properties": {
            "max_drawn_diff": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
