{
  "id": "world.britain_parity",
  "title": "Compare what GUO draws at the Britain bank with ClassicUO",
  "surface": "client",
  "requires": {
    "shard": "dev",
    "account": "$account",
    "build": "debug"
  },
  "timeouts": {
    "step_s": 60,
    "run_s": 480
  },
  "steps": [
    {
      "id": "launch",
      "do": {
        "kind": "launch",
        "args": [
          "--scratch-profile"
        ],
        "settings": {
          "autologin": true
        }
      },
      "say": "Start GUO.",
      "timeout_s": 240,
      "expect": {
        "scene": "LoginScene",
        "within_s": 60
      }
    },
    {
      "id": "login_screen",
      "do": {
        "kind": "wait",
        "seconds": 2
      },
      "say": "The login screen is up.",
      "shot": true
    },
    {
      "id": "type_account",
      "do": {
        "kind": "ui.fill",
        "control": {
          "type": "StbTextBox"
        },
        "text": "$account"
      },
      "say": "Type the account name."
    },
    {
      "id": "type_password",
      "do": {
        "kind": "ui.fill",
        "control": {
          "type": "PasswordStbTextBox"
        },
        "text": "$password"
      },
      "say": "Type the password."
    },
    {
      "id": "log_in",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "Button",
          "system": "classic",
          "index": 2
        }
      },
      "say": "Press Login.",
      "expect": {
        "scene": "GameScene",
        "within_s": 60
      }
    },
    {
      "id": "in_world",
      "do": {
        "kind": "wait",
        "seconds": 4
      },
      "say": "We are in the world.",
      "shot": true,
      "expect": {
        "ui.exists": "WorldViewportGump"
      }
    },
    {
      "id": "go_bank",
      "do": {
        "kind": "chat",
        "text": "[go 1434 1697"
      },
      "say": "Say a GM command to go to the Britain bank.",
      "expect": {
        "world.position": {
          "x": 1434,
          "y": 1697,
          "map": 0,
          "tolerance": 3
        },
        "within_s": 20
      }
    },
    {
      "id": "settle",
      "do": {
        "kind": "wait",
        "seconds": 8
      },
      "say": "Wait for the map to settle."
    },
    {
      "id": "dump",
      "do": {
        "kind": "renderdump",
        "name": "britain_bank"
      },
      "say": "Dump what the client drew at the bank."
    },
    {
      "id": "diff",
      "do": {
        "kind": "render_diff",
        "name": "britain_bank"
      },
      "say": "Compare the dump with ClassicUO's at the same spot.",
      "expect": {
        "render_diff": {
          "max_drawn_diff": 0
        }
      }
    },
    {
      "id": "bank_shot",
      "do": {
        "kind": "wait",
        "seconds": 1
      },
      "say": "The Britain bank.",
      "shot": true
    }
  ]
}
