{
  "id": "world.dungeon_parity",
  "title": "Compare what GUO draws inside Despise with ClassicUO",
  "surface": "client",
  "requires": {
    "shard": "dev",
    "account": "$account",
    "build": "debug"
  },
  "timeouts": {
    "step_s": 60,
    "run_s": 480
  },
  "steps": [
    {
      "id": "launch",
      "do": {
        "kind": "launch",
        "args": [
          "--scratch-profile",
          "--autologin",
          "--account",
          "$account",
          "--password",
          "$password",
          "--window-size",
          "1280x720"
        ],
        "settings": {
          "autologin": true
        }
      },
      "say": "Start GUO at 1280x720, the reference's size, and log straight in (upstream's autologin: a generated shard password is longer than the login gump's 16 characters).",
      "timeout_s": 240,
      "expect": {
        "scene": "GameScene",
        "within_s": 120
      }
    },
    {
      "id": "in_world",
      "do": {
        "kind": "wait",
        "seconds": 4
      },
      "say": "We are in the world.",
      "shot": true,
      "expect": {
        "ui.exists": "WorldViewportGump"
      }
    },
    {
      "id": "go_dungeon",
      "do": {
        "kind": "chat",
        "text": "[go 5401 629"
      },
      "say": "Say a GM command to go into Despise, the first level.",
      "expect": {
        "world.position": {
          "x": 5401,
          "y": 629,
          "map": 0,
          "tolerance": 3
        },
        "within_s": 20
      }
    },
    {
      "id": "settle",
      "do": {
        "kind": "wait",
        "seconds": 8
      },
      "say": "Wait for the map to settle."
    },
    {
      "id": "dump",
      "do": {
        "kind": "renderdump",
        "name": "despise"
      },
      "say": "Dump what the client drew in the dungeon."
    },
    {
      "id": "diff",
      "do": {
        "kind": "render_diff",
        "name": "despise"
      },
      "say": "Compare the dump with ClassicUO's, standing on the same tile.",
      "expect": {
        "render_diff": {
          "max_drawn_diff": 0
        }
      }
    },
    {
      "id": "dungeon_shot",
      "do": {
        "kind": "wait",
        "seconds": 1
      },
      "say": "Despise, the first level.",
      "shot": true
    }
  ]
}
