{
  "id": "client.render.water_shallow",
  "title": "Shallow shores and caustics under the realtime water style: docks and bay, strength from $shallow (0 = off)",
  "surface": "client",
  "requires": {
    "shard": "dev",
    "account": "$account",
    "build": "debug"
  },
  "timeouts": {
    "step_s": 60,
    "run_s": 600
  },
  "steps": [
    {
      "id": "launch",
      "do": {
        "kind": "launch",
        "args": [
          "--scratch-profile",
          "--water-style",
          "uo",
          "--water-shallow",
          "$shallow"
        ]
      },
      "say": "Start GUO with realtime water and this session's shallow-shores strength (0 is off).",
      "timeout_s": 240,
      "expect": {
        "scene": "LoginScene",
        "within_s": 60
      }
    },
    {
      "id": "login_screen",
      "do": {
        "kind": "wait",
        "seconds": 2
      },
      "say": "The login screen is up.",
      "shot": true
    },
    {
      "id": "type_account",
      "do": {
        "kind": "ui.fill",
        "control": {
          "type": "StbTextBox"
        },
        "text": "$account"
      },
      "say": "Type the account name."
    },
    {
      "id": "type_password",
      "do": {
        "kind": "ui.fill",
        "control": {
          "type": "PasswordStbTextBox"
        },
        "text": "$password"
      },
      "say": "Type the password."
    },
    {
      "id": "log_in",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "Button",
          "system": "classic",
          "index": 2
        }
      },
      "say": "Press Login.",
      "expect": {
        "ui.exists": "ServerSelectionGump",
        "within_s": 60
      }
    },
    {
      "id": "server_list",
      "do": {
        "kind": "wait",
        "seconds": 2
      },
      "say": "The server list is up.",
      "shot": true
    },
    {
      "id": "pick_server",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "ServerEntryGump",
          "index": 0
        }
      },
      "say": "Pick the first server."
    },
    {
      "id": "server_next",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "Button",
          "system": "classic",
          "index": 1
        }
      },
      "say": "Press Next.",
      "expect": {
        "ui.exists": "CharacterSelectionGump",
        "within_s": 60
      }
    },
    {
      "id": "character_list",
      "do": {
        "kind": "wait",
        "seconds": 2
      },
      "say": "The character list is up.",
      "shot": true
    },
    {
      "id": "pick_character",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "CharacterEntryGump",
          "index": 0
        }
      },
      "say": "Pick the first character."
    },
    {
      "id": "character_next",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "Button",
          "system": "classic",
          "index": 3
        }
      },
      "say": "Press Next.",
      "expect": {
        "scene": "GameScene",
        "within_s": 60
      }
    },
    {
      "id": "in_world",
      "do": {
        "kind": "wait",
        "seconds": 4
      },
      "say": "We are in the world.",
      "shot": true,
      "expect": {
        "ui.exists": "WorldViewportGump"
      }
    },
    {
      "id": "go_docks",
      "do": {
        "kind": "chat",
        "text": "[go 1499 1761 -3"
      },
      "say": "Say a GM command to go to the Britain docks.",
      "expect": {
        "world.position": {
          "x": 1499,
          "y": 1761,
          "map": 0,
          "tolerance": 3
        },
        "within_s": 20
      }
    },
    {
      "id": "settle_docks",
      "do": {
        "kind": "wait",
        "seconds": 8
      },
      "say": "Wait for the map to settle and the water mask to build."
    },
    {
      "id": "shot_docks",
      "do": {
        "kind": "wait",
        "seconds": 1
      },
      "say": "Realtime water at the Britain docks.",
      "shot": true
    },
    {
      "id": "shot_docks_later",
      "do": {
        "kind": "wait",
        "seconds": 2
      },
      "say": "Two seconds on: the swell has moved.",
      "shot": true
    },
    {
      "id": "go_bay",
      "do": {
        "kind": "chat",
        "text": "[go 2087 2861 -3"
      },
      "say": "Say a GM command to go to the Trinsic bay.",
      "expect": {
        "world.position": {
          "x": 2087,
          "y": 2861,
          "map": 0,
          "tolerance": 3
        },
        "within_s": 20
      }
    },
    {
      "id": "settle_bay",
      "do": {
        "kind": "wait",
        "seconds": 8
      },
      "say": "Wait for the map to settle and the water mask to build."
    },
    {
      "id": "shot_bay",
      "do": {
        "kind": "wait",
        "seconds": 1
      },
      "say": "Realtime water at the Trinsic bay.",
      "shot": true
    },
    {
      "id": "shot_bay_later",
      "do": {
        "kind": "wait",
        "seconds": 2
      },
      "say": "Two seconds on: the swell has moved.",
      "shot": true
    },
    {
      "id": "summary",
      "do": {
        "kind": "note",
        "text": "Shallow shores (UO+ Options > World): with strength 0 the water is the plain realtime style; with 100 the sea floor and caustics show near land."
      }
    }
  ]
}
