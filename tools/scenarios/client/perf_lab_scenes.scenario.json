{
  "id": "client.perf_lab.scenes",
  "title": "Visit the places the perf lab times and photograph each",
  "surface": "client",
  "requires": {
    "shard": "dev",
    "account": "$account",
    "build": "debug"
  },
  "timeouts": {
    "step_s": 60,
    "run_s": 480
  },
  "steps": [
    {
      "id": "launch",
      "do": {
        "kind": "launch",
        "args": [
          "--scratch-profile",
          "--postfx",
          "off"
        ],
        "settings": {
          "autologin": false
        }
      },
      "say": "Start GUO.",
      "timeout_s": 240,
      "expect": {
        "scene": "LoginScene",
        "within_s": 60
      }
    },
    {
      "id": "login_screen",
      "do": {
        "kind": "wait",
        "seconds": 2
      },
      "say": "The login screen is up.",
      "shot": true
    },
    {
      "id": "type_account",
      "do": {
        "kind": "ui.fill",
        "control": {
          "type": "StbTextBox"
        },
        "text": "$account"
      },
      "say": "Type the account name."
    },
    {
      "id": "type_password",
      "do": {
        "kind": "ui.fill",
        "control": {
          "type": "PasswordStbTextBox"
        },
        "text": "$password"
      },
      "say": "Type the password."
    },
    {
      "id": "log_in",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "Button",
          "system": "classic",
          "index": 2
        }
      },
      "say": "Press Login.",
      "expect": {
        "ui.exists": "ServerSelectionGump",
        "within_s": 60
      }
    },
    {
      "id": "server_list",
      "do": {
        "kind": "wait",
        "seconds": 2
      },
      "say": "The server list is up.",
      "shot": true
    },
    {
      "id": "pick_server",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "ServerEntryGump",
          "index": 0
        }
      },
      "say": "Pick the first server."
    },
    {
      "id": "server_next",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "Button",
          "system": "classic",
          "index": 1
        }
      },
      "say": "Press Next.",
      "expect": {
        "ui.exists": "CharacterSelectionGump",
        "within_s": 60
      }
    },
    {
      "id": "character_list",
      "do": {
        "kind": "wait",
        "seconds": 2
      },
      "say": "The character list is up.",
      "shot": true
    },
    {
      "id": "pick_character",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "CharacterEntryGump",
          "index": 0
        }
      },
      "say": "Pick the first character."
    },
    {
      "id": "character_next",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "Button",
          "system": "classic",
          "index": 3
        }
      },
      "say": "Press Next.",
      "expect": {
        "scene": "GameScene",
        "within_s": 60
      }
    },
    {
      "id": "in_world",
      "do": {
        "kind": "wait",
        "seconds": 4
      },
      "say": "We are in the world.",
      "shot": true,
      "expect": {
        "ui.exists": "WorldViewportGump"
      }
    },
    {
      "id": "go_open_field",
      "do": {
        "kind": "chat",
        "text": "[go 1164 1668"
      },
      "say": "Open grassland south of Britain: the perf lab's open-field scene.",
      "expect": {
        "world.position": {
          "x": 1164,
          "y": 1668,
          "map": 0,
          "tolerance": 3
        },
        "within_s": 20
      }
    },
    {
      "id": "at_open_field",
      "do": {
        "kind": "wait",
        "seconds": 3
      },
      "say": "Let the ground load, as the lab does before it times a scene.",
      "shot": true
    },
    {
      "id": "go_britain_bank",
      "do": {
        "kind": "chat",
        "text": "[go 1434 1699 0"
      },
      "say": "The Britain bank: the perf lab's busiest scene.",
      "expect": {
        "world.position": {
          "x": 1434,
          "y": 1699,
          "map": 0,
          "tolerance": 3
        },
        "within_s": 20
      }
    },
    {
      "id": "at_britain_bank",
      "do": {
        "kind": "wait",
        "seconds": 3
      },
      "say": "Let the ground load, as the lab does before it times a scene.",
      "shot": true
    },
    {
      "id": "go_dense_forest",
      "do": {
        "kind": "chat",
        "text": "[go 633 858"
      },
      "say": "The forest east of Yew: the perf lab's dense-forest scene.",
      "expect": {
        "world.position": {
          "x": 633,
          "y": 858,
          "map": 0,
          "tolerance": 3
        },
        "within_s": 20
      }
    },
    {
      "id": "at_dense_forest",
      "do": {
        "kind": "wait",
        "seconds": 3
      },
      "say": "Let the ground load, as the lab does before it times a scene.",
      "shot": true
    },
    {
      "id": "go_dungeon",
      "do": {
        "kind": "chat",
        "text": "[go 5401 629"
      },
      "say": "The mouth of Despise: the perf lab's dungeon scene.",
      "expect": {
        "world.position": {
          "x": 5401,
          "y": 629,
          "map": 0,
          "tolerance": 3
        },
        "within_s": 20
      }
    },
    {
      "id": "at_dungeon",
      "do": {
        "kind": "wait",
        "seconds": 3
      },
      "say": "Let the ground load, as the lab does before it times a scene.",
      "shot": true
    }
  ]
}
