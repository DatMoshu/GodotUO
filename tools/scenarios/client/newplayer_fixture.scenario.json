{
  "id": "client.newplayer.fixture",
  "title": "Gate fixture: a game master places a stationary attack dummy beside the new-player start",
  "surface": "client",
  "requires": {
    "shard": "dev",
    "account": "$account",
    "build": "debug"
  },
  "timeouts": {
    "step_s": 60,
    "run_s": 420
  },
  "steps": [
    {
      "id": "launch",
      "do": {
        "kind": "launch",
        "args": [
          "--scratch-profile"
        ],
        "settings": {
          "autologin": false
        }
      },
      "say": "Start GUO.",
      "timeout_s": 240,
      "expect": {
        "scene": "LoginScene",
        "within_s": 60
      }
    },
    {
      "id": "login_screen",
      "do": {
        "kind": "wait",
        "seconds": 2
      },
      "say": "The login screen is up.",
      "shot": true
    },
    {
      "id": "type_account",
      "do": {
        "kind": "ui.fill",
        "control": {
          "type": "StbTextBox"
        },
        "text": "$account",
        "clear": 32
      },
      "say": "Type the account name (clearing the account the login gump remembers)."
    },
    {
      "id": "type_password",
      "do": {
        "kind": "ui.fill",
        "control": {
          "type": "PasswordStbTextBox"
        },
        "text": "$password"
      },
      "say": "Type the password."
    },
    {
      "id": "log_in",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "Button",
          "system": "classic",
          "index": 2
        }
      },
      "say": "Press Login.",
      "expect": {
        "ui.exists": "ServerSelectionGump",
        "within_s": 60
      }
    },
    {
      "id": "pick_server",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "ServerEntryGump",
          "index": 0
        }
      },
      "say": "Pick the first server."
    },
    {
      "id": "server_next",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "Button",
          "system": "classic",
          "index": 1
        }
      },
      "say": "Press Next: the game master's characters are listed.",
      "expect": {
        "ui.exists": "CharacterSelectionGump",
        "within_s": 60
      }
    },
    {
      "id": "pick_character",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "CharacterEntryGump",
          "index": 0
        }
      },
      "say": "Pick the first character."
    },
    {
      "id": "character_next",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "Button",
          "system": "classic",
          "index": 3
        }
      },
      "say": "Press Next.",
      "expect": {
        "scene": "GameScene",
        "within_s": 60
      }
    },
    {
      "id": "in_world",
      "do": {
        "kind": "wait",
        "seconds": 4
      },
      "say": "The world is drawn around the character.",
      "expect": {
        "ui.exists": "WorldViewportGump"
      },
      "shot": true
    },
    {
      "id": "to_trammel",
      "do": {
        "kind": "chat",
        "text": "[self set map trammel"
      },
      "say": "Go to Trammel."
    },
    {
      "id": "to_start",
      "do": {
        "kind": "chat",
        "text": "[go 3503 2574 14"
      },
      "say": "Go to where a new character starts.",
      "expect": {
        "world.position": {
          "map": 1,
          "x": 3503,
          "y": 2574,
          "tolerance": 1
        },
        "within_s": 20
      }
    },
    {
      "id": "place_dummies",
      "do": {
        "kind": "chat",
        "text": "[GuoPadDummies"
      },
      "say": "Place the dummies beside the start.",
      "expect": {
        "journal.contains": "GUO_PAD: dummies spawned",
        "world.mobile": {
          "contains": "Attack Dummy",
          "within": 3
        },
        "within_s": 20
      },
      "shot": true
    },
    {
      "id": "open_paperdoll_to_leave",
      "do": {
        "kind": "ui.key",
        "key": "P",
        "alt": true
      },
      "say": "Open the paperdoll.",
      "expect": {
        "ui.exists": "PaperDollGump",
        "within_s": 10
      }
    },
    {
      "id": "log_out",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "Button",
          "system": "classic",
          "gump": "PaperDollGump",
          "button_id": 2
        }
      },
      "say": "Press Log Out on the paperdoll.",
      "expect": {
        "ui.exists": "QuestionGump",
        "within_s": 10
      }
    },
    {
      "id": "confirm_log_out",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "Button",
          "system": "classic",
          "gump": "QuestionGump",
          "button_id": 1
        }
      },
      "say": "Confirm.",
      "expect": {
        "scene": "LoginScene",
        "within_s": 30
      }
    },
    {
      "id": "back_at_login",
      "do": {
        "kind": "wait",
        "seconds": 2
      },
      "say": "Back at the login screen.",
      "shot": true
    }
  ]
}
