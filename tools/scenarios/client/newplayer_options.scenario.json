{
  "id": "client.newplayer.options",
  "title": "A player changes two options in the Options gump and they are saved with the character (the gate reads the saved profile)",
  "surface": "client",
  "requires": {
    "shard": "dev",
    "account": "$account",
    "build": "debug"
  },
  "timeouts": {
    "step_s": 60,
    "run_s": 420
  },
  "steps": [
    {
      "id": "launch",
      "do": {
        "kind": "launch",
        "args": [
          "--scratch-profile"
        ],
        "settings": {
          "autologin": false
        }
      },
      "say": "Start GUO.",
      "timeout_s": 240,
      "expect": {
        "scene": "LoginScene",
        "within_s": 60
      }
    },
    {
      "id": "login_screen",
      "do": {
        "kind": "wait",
        "seconds": 2
      },
      "say": "The login screen is up.",
      "shot": true
    },
    {
      "id": "type_account",
      "do": {
        "kind": "ui.fill",
        "control": {
          "type": "StbTextBox"
        },
        "text": "$account",
        "clear": 32
      },
      "say": "Type the account name (clearing the account the login gump remembers)."
    },
    {
      "id": "type_password",
      "do": {
        "kind": "ui.fill",
        "control": {
          "type": "PasswordStbTextBox"
        },
        "text": "$password"
      },
      "say": "Type the password."
    },
    {
      "id": "log_in",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "Button",
          "system": "classic",
          "index": 2
        }
      },
      "say": "Press Login.",
      "expect": {
        "ui.exists": "ServerSelectionGump",
        "within_s": 60
      }
    },
    {
      "id": "pick_server",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "ServerEntryGump",
          "index": 0
        }
      },
      "say": "Pick the first server."
    },
    {
      "id": "server_next",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "Button",
          "system": "classic",
          "index": 1
        }
      },
      "say": "Press Next. The account now has a character, so the character list opens.",
      "expect": {
        "ui.exists": "CharacterSelectionGump",
        "within_s": 60
      }
    },
    {
      "id": "character_list",
      "do": {
        "kind": "wait",
        "seconds": 2
      },
      "say": "The character made earlier is on the list.",
      "expect": {
        "ui.exists": {
          "contains": "$charname"
        }
      },
      "shot": true
    },
    {
      "id": "pick_character",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "CharacterEntryGump",
          "index": 0
        }
      },
      "say": "Pick it."
    },
    {
      "id": "character_next",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "Button",
          "system": "classic",
          "index": 3
        }
      },
      "say": "Press Next.",
      "expect": {
        "scene": "GameScene",
        "within_s": 60
      }
    },
    {
      "id": "in_world",
      "do": {
        "kind": "wait",
        "seconds": 4
      },
      "say": "The world is drawn around the character.",
      "expect": {
        "ui.exists": "WorldViewportGump"
      },
      "shot": true
    },
    {
      "id": "open_options",
      "do": {
        "kind": "ui.key",
        "key": "O",
        "alt": true
      },
      "say": "Open Options.",
      "expect": {
        "ui.exists": "OptionsGump",
        "within_s": 10
      },
      "shot": true
    },
    {
      "id": "tick_always_run",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "Checkbox",
          "index": 3,
          "gump": "OptionsGump"
        }
      },
      "say": "Tick Always run."
    },
    {
      "id": "tick_fast_rotation",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "Checkbox",
          "index": 5,
          "gump": "OptionsGump"
        }
      },
      "say": "Tick Fast rotation.",
      "shot": true
    },
    {
      "id": "press_okay",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "Button",
          "system": "classic",
          "gump": "OptionsGump",
          "button_id": 4
        }
      },
      "say": "Press Okay: the Options gump applies and closes.",
      "shot": true,
      "expect": {
        "ui.absent": "OptionsGump",
        "within_s": 10
      }
    },
    {
      "id": "open_paperdoll",
      "do": {
        "kind": "wait",
        "seconds": 1
      },
      "say": "The paperdoll left open by the last start is still open (it is not toggled here).",
      "expect": {
        "ui.exists": "PaperDollGump",
        "within_s": 10
      }
    },
    {
      "id": "log_out",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "Button",
          "system": "classic",
          "gump": "PaperDollGump",
          "button_id": 2
        }
      },
      "say": "Press Log Out on the paperdoll.",
      "expect": {
        "ui.exists": "QuestionGump",
        "within_s": 10
      }
    },
    {
      "id": "confirm_log_out",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "Button",
          "system": "classic",
          "index": 2
        }
      },
      "say": "Confirm.",
      "expect": {
        "scene": "LoginScene",
        "within_s": 30
      }
    },
    {
      "id": "back_at_login",
      "do": {
        "kind": "wait",
        "seconds": 2
      },
      "say": "Back at the login screen.",
      "shot": true
    }
  ]
}
