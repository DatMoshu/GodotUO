{
  "id": "client.newplayer.equip",
  "title": "A new player drags a worn item from the paperdoll into the backpack and back: unequip and equip",
  "surface": "client",
  "requires": {
    "shard": "dev",
    "account": "$account",
    "build": "debug"
  },
  "timeouts": {
    "step_s": 60,
    "run_s": 480
  },
  "steps": [
    {
      "id": "launch",
      "do": {
        "kind": "launch",
        "args": [
          "--scratch-profile"
        ],
        "settings": {
          "autologin": false
        }
      },
      "say": "Start GUO.",
      "timeout_s": 240,
      "expect": {
        "scene": "LoginScene",
        "within_s": 60
      }
    },
    {
      "id": "login_screen",
      "do": {
        "kind": "wait",
        "seconds": 2
      },
      "say": "The login screen is up.",
      "shot": true
    },
    {
      "id": "type_account",
      "do": {
        "kind": "ui.fill",
        "control": {
          "type": "StbTextBox"
        },
        "text": "$account",
        "clear": 32
      },
      "say": "Type the account name (clearing the account the login gump remembers)."
    },
    {
      "id": "type_password",
      "do": {
        "kind": "ui.fill",
        "control": {
          "type": "PasswordStbTextBox"
        },
        "text": "$password"
      },
      "say": "Type the password."
    },
    {
      "id": "log_in",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "Button",
          "system": "classic",
          "index": 2
        }
      },
      "say": "Press Login.",
      "expect": {
        "ui.exists": "ServerSelectionGump",
        "within_s": 60
      }
    },
    {
      "id": "pick_server",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "ServerEntryGump",
          "index": 0
        }
      },
      "say": "Pick the first server."
    },
    {
      "id": "server_next",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "Button",
          "system": "classic",
          "index": 1
        }
      },
      "say": "Press Next. The account now has a character, so the character list opens.",
      "expect": {
        "ui.exists": "CharacterSelectionGump",
        "within_s": 60
      }
    },
    {
      "id": "character_list",
      "do": {
        "kind": "wait",
        "seconds": 2
      },
      "say": "The character made earlier is on the list.",
      "expect": {
        "ui.exists": {
          "contains": "$charname"
        }
      },
      "shot": true
    },
    {
      "id": "pick_character",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "CharacterEntryGump",
          "index": 0
        }
      },
      "say": "Pick it."
    },
    {
      "id": "character_next",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "Button",
          "system": "classic",
          "index": 3
        }
      },
      "say": "Press Next.",
      "expect": {
        "scene": "GameScene",
        "within_s": 60
      }
    },
    {
      "id": "in_world",
      "do": {
        "kind": "wait",
        "seconds": 4
      },
      "say": "The world is drawn around the character.",
      "expect": {
        "ui.exists": "WorldViewportGump"
      },
      "shot": true
    },
    {
      "id": "open_paperdoll",
      "do": {
        "kind": "ui.key",
        "key": "P",
        "alt": true
      },
      "say": "Open the paperdoll.",
      "expect": {
        "ui.exists": "PaperDollGump",
        "within_s": 10
      }
    },
    {
      "id": "open_backpack",
      "do": {
        "kind": "ui.key",
        "key": "I",
        "alt": true
      },
      "say": "Open the backpack.",
      "expect": {
        "ui.exists": "ContainerGump",
        "within_s": 10
      }
    },
    {
      "id": "both_open",
      "do": {
        "kind": "wait",
        "seconds": 2
      },
      "say": "The paperdoll and the backpack are open.",
      "shot": true
    },
    {
      "id": "move_backpack",
      "do": {
        "kind": "ui.drag",
        "from": {
          "type": "GumpPicContainer",
          "gump": "ContainerGump"
        },
        "from_offset": {
          "x": 0,
          "y": -75
        },
        "to": {
          "type": "PaperDollGump"
        },
        "to_offset": {
          "x": 400,
          "y": 0
        },
        "steps": 12
      },
      "say": "The backpack opened over the paperdoll: drag it by its flap to the paperdoll's right."
    },
    {
      "id": "unequip",
      "do": {
        "kind": "ui.drag",
        "from": {
          "type": "ItemGumpFixed",
          "gump": "PaperDollGump"
        },
        "to": {
          "type": "GumpPicContainer",
          "gump": "ContainerGump"
        },
        "to_offset": {
          "x": 0,
          "y": 20
        },
        "steps": 12
      },
      "say": "Drag something the character wears from its slot on the paperdoll into the backpack.",
      "expect": {
        "world.equipped": {
          "delta": -1,
          "lacks": "$dragged"
        },
        "world.backpack": {
          "has": "$dragged"
        },
        "within_s": 10
      },
      "shot": true
    },
    {
      "id": "equip",
      "do": {
        "kind": "ui.drag",
        "from": {
          "serial": "$dragged",
          "gump": "ContainerGump"
        },
        "to": {
          "type": "PaperDollInteractable"
        },
        "to_offset": {
          "x": 0,
          "y": -20
        },
        "steps": 12
      },
      "say": "Drag the same item from the backpack back onto the paperdoll: the character wears it again.",
      "expect": {
        "world.equipped": {
          "delta": 1,
          "has": "$dragged"
        },
        "world.backpack": {
          "lacks": "$dragged"
        },
        "within_s": 10
      },
      "shot": true
    },
    {
      "id": "log_out",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "Button",
          "system": "classic",
          "gump": "PaperDollGump",
          "button_id": 2
        }
      },
      "say": "Press Log Out on the paperdoll.",
      "expect": {
        "ui.exists": "QuestionGump",
        "within_s": 10
      }
    },
    {
      "id": "confirm_log_out",
      "do": {
        "kind": "ui.click",
        "control": {
          "type": "Button",
          "system": "classic",
          "gump": "QuestionGump",
          "button_id": 1
        }
      },
      "say": "Confirm.",
      "expect": {
        "scene": "LoginScene",
        "within_s": 30
      }
    },
    {
      "id": "back_at_login",
      "do": {
        "kind": "wait",
        "seconds": 2
      },
      "say": "Back at the login screen.",
      "shot": true
    }
  ]
}
