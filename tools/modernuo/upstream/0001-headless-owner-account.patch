+using System;
 using Server.Accounting;
 using Server.Logging;
 
@@ -12,6 +13,15 @@ public static void Initialize()
         if (Accounts.Count == 0)
         {
             logger.Warning("This server has no accounts.");
+
+            // Headless (stdin redirected): there is no one to answer the prompt below, and reading
+            // the console throws. The owner account comes from the environment instead, if set.
+            if (Core.Headless)
+            {
+                CreateOwnerFromEnvironment();
+                return;
+            }
+
             logger.Information("Do you want to create the owner account now? (y/n):");
 
             var answer = ConsoleInputHandler.ReadLine();
@@ -37,4 +47,26 @@ public static void Initialize()
             }
         }
     }
+
+    private static void CreateOwnerFromEnvironment()
+    {
+        var username = Environment.GetEnvironmentVariable("MODERNUO_OWNER_USERNAME");
+        var password = Environment.GetEnvironmentVariable("MODERNUO_OWNER_PASSWORD");
+
+        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
+        {
+            logger.Warning(
+                "Headless: set MODERNUO_OWNER_USERNAME and MODERNUO_OWNER_PASSWORD to create the owner account. No owner account created."
+            );
+            return;
+        }
+
+        var a = new Account(username, password)
+        {
+            AccessLevel = AccessLevel.Owner
+        };
+
+        logger.Information("Owner account created: {Username}", username);
+        ServerAccess.AddProtectedAccount(a, true);
+    }
 }
