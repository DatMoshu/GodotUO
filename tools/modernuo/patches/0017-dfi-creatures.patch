@@ -0,0 +1,232 @@
+// DFI Network's Paladin, "the Dark Knight", ported from DFI RUNUO Scripts/Custom/Opticon/Paladin AI (Paladin.cs,
+// PaladinAI.cs). DFI's 936-line AI was a copy of the RunUO mage AI casting chivalry; this one keeps what it did
+// in a fight on top of ModernUO's melee AI: cleanse when poisoned, close wounds when hurt, lift curses, and
+// otherwise open with divine fury, enemy of one, consecrate weapon, holy light or dispel evil. Its blows deal a
+// mortal wound one time in ten.
+
+using System;
+using ModernUO.Serialization;
+using Server.Items;
+using Server.Spells;
+using Server.Spells.Chivalry;
+using Server.Spells.Fourth;
+using Server.Spells.First;
+
+namespace Server.Mobiles;
+
+[SerializationGenerator(0)]
+public partial class Paladin : BaseCreature
+{
+    private static readonly TimeSpan PlayerWound = TimeSpan.FromSeconds(6.0);
+    private static readonly TimeSpan CreatureWound = TimeSpan.FromSeconds(12.0);
+
+    [Constructible]
+    public Paladin() : base(AIType.AI_Melee, FightMode.Closest)
+    {
+        Title = "the Dark Knight";
+        Hue = Race.Human.RandomSkinHue();
+        Female = Utility.RandomBool();
+        Body = Female ? 0x191 : 0x190;
+        Name = NameList.RandomName(Female ? "female" : "male");
+        HairItemID = Race.Human.RandomHair(Female);
+        HairHue = Race.Human.RandomHairHue();
+        SetSpeed(0.2, 0.4);
+
+        TithingPoints = 1000;
+
+        SetStr(150);
+        SetDex(100);
+        SetInt(100);
+
+        SetHits(250, 300);
+        SetMana(400);
+
+        SetDamage(10, 20);
+
+        SetDamageType(ResistanceType.Physical, 60);
+        SetDamageType(ResistanceType.Fire, 20);
+        SetDamageType(ResistanceType.Energy, 20);
+
+        SetResistance(ResistanceType.Physical, 65);
+        SetResistance(ResistanceType.Fire, 50);
+        SetResistance(ResistanceType.Cold, 50);
+        SetResistance(ResistanceType.Poison, 100);
+        SetResistance(ResistanceType.Energy, 50);
+
+        SetSkill(SkillName.Chivalry, 95.1, 100.1);
+        SetSkill(SkillName.Focus, 90.1, 100.1);
+        SetSkill(SkillName.Meditation, 100.0);
+        SetSkill(SkillName.MagicResist, 85.1, 95.0);
+        SetSkill(SkillName.Magery, 95.1, 100.0);
+        SetSkill(SkillName.Anatomy, 90.1, 100.1);
+        SetSkill(SkillName.Parry, 85.1, 95.1);
+        SetSkill(SkillName.Tactics, 100.0);
+        SetSkill(SkillName.Swords, 100.0);
+
+        Fame = 5000;
+        Karma = -5000;
+        VirtualArmor = 35;
+
+        var weapon = new VikingSword
+        {
+            DamageLevel = (WeaponDamageLevel)Utility.Random(3, 3),
+            DurabilityLevel = (WeaponDurabilityLevel)Utility.Random(0, 1),
+            AccuracyLevel = (WeaponAccuracyLevel)Utility.Random(3, 3),
+            Skill = SkillName.Swords,
+            Speed = 40,
+            Hue = 0x8A5,
+            Weight = 0.5,
+            Quality = WeaponQuality.Exceptional,
+            Name = "Holy Avenger"
+        };
+        weapon.Attributes.SpellChanneling = 1;
+
+        Wear(weapon);
+        Wear(Female ? new FemalePlateChest { Hue = 0x47E } : new PlateChest { Hue = 0x47E });
+        Wear(new PlateGloves { Hue = 0x47E });
+        Wear(new PlateArms { Hue = 0x47E });
+        Wear(new PlateGorget { Hue = 0x47E });
+        Wear(new PlateHelm { Hue = 0x47E });
+        Wear(new OrderShield());
+        Wear(new PlateLegs { Hue = 0x47E });
+        Wear(new BodySash(0xCF));
+        Wear(new Cloak(0xCF));
+
+        PackItem(new BookOfChivalry { LootType = LootType.Blessed });
+        PackGold(200, 300);
+        PackGem(5, 8);
+        PackGem(3, 6);
+        PackMagicItems(3, 5, 0.50, 0.75);
+        PackMagicItems(3, 5, 0.50, 0.75);
+    }
+
+    public override string CorpseName => "a paladin's corpse";
+    public override Poison PoisonImmune => Poison.Lethal;
+    public override bool AlwaysMurderer => true;
+    public override bool ShowFameTitle => false;
+    public override bool BardImmune => true;
+    public override bool Unprovokable => true;
+    public override bool Uncalmable => true;
+
+    protected override BaseAI ForcedAI => new PaladinAI(this);
+
+    private void Wear(Item item)
+    {
+        item.Movable = false;
+        AddItem(item);
+    }
+
+    // Immune to pets and provoked creatures.
+    public override void AlterMeleeDamageFrom(Mobile from, ref int damage)
+    {
+        if (from is BaseCreature bc && (bc.Controlled || bc.BardTarget == this))
+        {
+            damage = 0;
+        }
+    }
+
+    public override void OnGaveMeleeAttack(Mobile defender, int damage)
+    {
+        base.OnGaveMeleeAttack(defender, damage);
+
+        if (Utility.RandomDouble() < 0.1)
+        {
+            defender.SendLocalizedMessage(1060087); // You have been mortally wounded!
+            defender.PlaySound(0x1E1);
+            defender.FixedParticles(0x37B9, 244, 25, 9944, 31, 0, EffectLayer.Waist);
+            MortalStrike.BeginWound(defender, defender.Player ? PlayerWound : CreatureWound);
+        }
+    }
+}
+
+public class PaladinAI : MeleeAI
+{
+    private long _nextCast;
+
+    public PaladinAI(BaseCreature m) : base(m) => _nextCast = Core.TickCount;
+
+    public override bool Think()
+    {
+        // Every chivalry spell it casts that wants a target is one it means for itself.
+        if (Mobile.Target is SpellTarget<Mobile> target && Mobile.Spell is not null)
+        {
+            target.Invoke(Mobile, Mobile);
+            return true;
+        }
+
+        return base.Think();
+    }
+
+    public override bool DoActionWander()
+    {
+        if (Mobile.Poisoned || Mobile.Hits < Mobile.HitsMax * 0.8)
+        {
+            TryCast(SelfCare());
+        }
+
+        return base.DoActionWander();
+    }
+
+    public override bool DoActionCombat()
+    {
+        var combatant = Mobile.Combatant;
+
+        if (combatant != null && Mobile.InRange(combatant, 12) && Core.TickCount - _nextCast >= 0)
+        {
+            TryCast(SelfCare() ?? Attack(combatant));
+        }
+
+        return base.DoActionCombat();
+    }
+
+    private Spell SelfCare()
+    {
+        if (Mobile.Poisoned)
+        {
+            return new CleanseByFireSpell(Mobile);
+        }
+
+        if (Mobile.Hits < Mobile.HitsMax / 2 && !MortalStrike.IsWounded(Mobile))
+        {
+            return new CloseWoundsSpell(Mobile);
+        }
+
+        if (CurseSpell.UnderEffect(Mobile))
+        {
+            return new RemoveCurseSpell(Mobile);
+        }
+
+        return null;
+    }
+
+    private Spell Attack(Mobile combatant)
+    {
+        // Someone healing with a spell gets the paladin's fury.
+        if (combatant.Spell is GreaterHealSpell or HealSpell)
+        {
+            return new DivineFurySpell(Mobile);
+        }
+
+        return Utility.Random(13) switch
+        {
+            < 3  => new DivineFurySpell(Mobile),
+            < 6  => new EnemyOfOneSpell(Mobile),
+            < 9  => new ConsecrateWeaponSpell(Mobile),
+            < 11 => new HolyLightSpell(Mobile),
+            _    => new DispelEvilSpell(Mobile)
+        };
+    }
+
+    private void TryCast(Spell spell)
+    {
+        if (spell == null || Mobile.Spell?.IsCasting == true || Core.TickCount - _nextCast < 0)
+        {
+            return;
+        }
+
+        if (spell.Cast())
+        {
+            _nextCast = Core.TickCount + Utility.RandomMinMax(4000, 8000);
+        }
+    }
+}
