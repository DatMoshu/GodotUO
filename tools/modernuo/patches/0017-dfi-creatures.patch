diff --git a/Projects/UOContent/Custom/DFI/Mobiles/SphynxFortune.cs b/Projects/UOContent/Custom/DFI/Mobiles/SphynxFortune.cs
new file mode 100644
index 000000000..0063533e3
--- /dev/null
+++ b/Projects/UOContent/Custom/DFI/Mobiles/SphynxFortune.cs
@@ -0,0 +1,303 @@
+// The sphynx's paid fortune reading, ported from DFI RUNUO Scripts/Custom/Mobiles/Monsters/SphynxFortuneGump.cs
+// and the Sphynx region of Mobiles/PlayerMobile.cs. For 5,000 gold a player gets one of twenty fortunes for a day:
+// a resistance, luck, enhance potions, defend chance or mana regeneration, raised or lowered. DFI kept the
+// fortune on PlayerMobile; here it is saved alongside, and AosAttributes.GetValue adds the non-resistance ones.
+
+using System;
+using System.Collections.Generic;
+using Server.ContextMenus;
+using Server.Gumps;
+using Server.Items;
+using Server.Mobiles;
+using Server.Network;
+
+namespace Server.Custom.Dfi;
+
+public class SphynxFortunes : GenericPersistence
+{
+    public const int Price = 5000;
+    public static readonly TimeSpan Duration = TimeSpan.FromHours(24.0);
+    private const string ModName = "SphynxFortune";
+
+    private static readonly Dictionary<Mobile, Fortune> _fortunes = [];
+
+    public SphynxFortunes() : base("SphynxFortunes", 10)
+    {
+    }
+
+    public static void Configure()
+    {
+        _ = new SphynxFortunes();
+    }
+
+    public readonly record struct Fortune(int Type, int Power, DateTime Expires);
+
+    public static bool HasFortune(Mobile m) => GetFortune(m) != null;
+
+    public static Fortune? GetFortune(Mobile m)
+    {
+        if (m == null || !_fortunes.TryGetValue(m, out var fortune))
+        {
+            return null;
+        }
+
+        if (fortune.Expires > Core.Now && !m.Deleted)
+        {
+            return fortune;
+        }
+
+        End(m);
+        return null;
+    }
+
+    // DFI's twenty outcomes, half of them blessings and half curses.
+    public static void TellFortune(Mobile m)
+    {
+        var type = Utility.Random(20) + 1;
+
+        var power = type switch
+        {
+            6 or 16   => Utility.RandomMinMax(10, 50),
+            7 or 17   => Utility.RandomMinMax(1, 5) * 5,
+            8 or 18   => Utility.RandomMinMax(50, 100),
+            10 or 20  => Utility.RandomMinMax(1, 3),
+            19        => Utility.RandomMinMax(1, 10),
+            _         => Utility.RandomMinMax(1, 15)
+        };
+
+        Apply(m, type, power, Core.Now + Duration);
+    }
+
+    public static void Apply(Mobile m, int type, int power, DateTime expires)
+    {
+        if (HasFortune(m))
+        {
+            return;
+        }
+
+        m.SendLocalizedMessage(type switch
+        {
+            1  => 1060886, // Your endurance shall protect you from your enemies blows.
+            2  => 1060887, // A smile will be upon your lips, as you gaze into the infernos.
+            3  => 1060888, // The ice of ages will embrace you, and you will embrace it alike.
+            4  => 1060889, // Your blood runs pure and strong.
+            5  => 1060890, // Your flesh shall endure the power of storms.
+            6  => 1060891, // Seek riches and they will seek you.
+            7  => 1060892, // The power of alchemy shall thrive within you.
+            8  => 1060893, // Fate smiles upon you this day.
+            9  => 1060894, // A keen mind in battle will help you avoid injury.
+            10 => 1060895, // The flow of the ether is strong within you.
+            11 => 1060901, // Your wounds in battle shall run deep.
+            12 => 1060902, // The fires of the abyss shall tear asunder your flesh!
+            13 => 1060903, // Winter's touch shall be your undoing.
+            14 => 1060904, // Your veins will freeze with poison's chill.
+            15 => 1060905, // The wise will seek to avoid the anger of storms.
+            16 => 1060906, // Your dreams of wealth shall vanish like smoke.
+            17 => 1060907, // The strength of alchemy will fail you.
+            18 => 1060908, // Only fools take risks in fate's shadow.
+            19 => 1060909, // Your lack of focus in battle shall be your undoing.
+            _  => 1060910  // Your connection with the ether is weak, take heed.
+        });
+
+        _fortunes[m] = new Fortune(type, power, expires);
+        AddResistance(m, type, power);
+        m.Delta(MobileDelta.Stat);
+    }
+
+    private static void AddResistance(Mobile m, int type, int power)
+    {
+        var (resistance, sign) = type switch
+        {
+            1 or 11  => (ResistanceType.Physical, 1),
+            2 or 12  => (ResistanceType.Fire, 1),
+            3 or 13  => (ResistanceType.Cold, 1),
+            4 or 14  => (ResistanceType.Poison, 1),
+            5 or 15  => (ResistanceType.Energy, 1),
+            _        => (ResistanceType.Physical, 0)
+        };
+
+        if (sign == 0)
+        {
+            return;
+        }
+
+        m.RemoveResistanceMod(ModName);
+        m.AddResistanceMod(new ResistanceMod(resistance, ModName, type > 10 ? -power : power));
+    }
+
+    public static void End(Mobile m)
+    {
+        if (_fortunes.Remove(m))
+        {
+            m.RemoveResistanceMod(ModName);
+            m.Delta(MobileDelta.Stat);
+        }
+    }
+
+    // What the fortune adds to an attribute; AosAttributes.GetValue calls this for every attribute it sums.
+    public static int GetBonus(Mobile m, AosAttribute attribute)
+    {
+        if (_fortunes.Count == 0 || GetFortune(m) is not { } f)
+        {
+            return 0;
+        }
+
+        return (attribute, f.Type) switch
+        {
+            (AosAttribute.Luck, 6 or 8)             => f.Power,
+            (AosAttribute.Luck, 16 or 18)           => -f.Power,
+            (AosAttribute.EnhancePotions, 7)        => f.Power,
+            (AosAttribute.EnhancePotions, 17)       => -f.Power,
+            (AosAttribute.DefendChance, 9)          => f.Power,
+            (AosAttribute.DefendChance, 19)         => -f.Power,
+            (AosAttribute.RegenMana, 10)            => f.Power,
+            (AosAttribute.RegenMana, 20)            => -f.Power,
+            _                                       => 0
+        };
+    }
+
+    public override void Serialize(IGenericWriter writer)
+    {
+        writer.WriteEncodedInt(0); // version
+
+        var live = new List<(Mobile, Fortune)>();
+
+        foreach (var (m, f) in _fortunes)
+        {
+            if (!m.Deleted && f.Expires > Core.Now)
+            {
+                live.Add((m, f));
+            }
+        }
+
+        writer.WriteEncodedInt(live.Count);
+
+        foreach (var (m, f) in live)
+        {
+            writer.Write(m);
+            writer.WriteEncodedInt(f.Type);
+            writer.WriteEncodedInt(f.Power);
+            writer.Write(f.Expires);
+        }
+    }
+
+    public override void Deserialize(IGenericReader reader)
+    {
+        reader.ReadEncodedInt(); // version
+
+        var count = reader.ReadEncodedInt();
+
+        for (var i = 0; i < count; i++)
+        {
+            var m = reader.ReadEntity<Mobile>();
+            var type = reader.ReadEncodedInt();
+            var power = reader.ReadEncodedInt();
+            var expires = reader.ReadDateTime();
+
+            if (m != null && expires > Core.Now)
+            {
+                _fortunes[m] = new Fortune(type, power, expires);
+                Timer.DelayCall(() => AddResistance(m, type, power));
+            }
+        }
+    }
+}
