+public class SphynxFortuneEntry : ContextMenuEntry
+{
+    public SphynxFortuneEntry() : base(6199, 8) // Ask for my fortune
+    {
+    }
+
+    public override void OnClick(Mobile from, IEntity target)
+    {
+        if (target is Sphynx sphynx && from is PlayerMobile && !SphynxFortunes.HasFortune(from))
+        {
+            from.SendGump(new SphynxFortuneGump(sphynx), true);
+        }
+    }
+}
