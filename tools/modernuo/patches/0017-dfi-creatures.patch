+
+    public override void OnResponse(NetState sender, in RelayInfo info)
+    {
+        var m = sender.Mobile;
+
+        if (_sphynx.Deleted || m == null)
+        {
+            return;
+        }
+
+        if (info.ButtonID != 1 || !info.IsSwitched(1))
+        {
+            m.SendLocalizedMessage(1061007); // You decide against having your fortune told.
+            return;
+        }
+
+        if (SphynxFortunes.HasFortune(m))
+        {
+            return;
+        }
+
+        if (m.Backpack?.ConsumeTotal(typeof(Gold), SphynxFortunes.Price) == true)
+        {
+            m.SendLocalizedMessage(1060867); // You pay the fee.
+            SphynxFortunes.TellFortune(m);
+        }
+        else
+        {
+            // You haven't got the coin to make the proper donation to the Sphynx.  Your fortune has not been read.
+            m.SendLocalizedMessage(1061006);
+        }
+    }
+}
