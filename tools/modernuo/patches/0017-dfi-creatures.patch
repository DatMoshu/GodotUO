@@ -0,0 +1,140 @@
+// DFI Network's faction creatures and items, ported from DFI RUNUO Scripts/Custom/Engines/Faction/Mobiles,
+// Custom/Mobiles/Ethereal Mounts, Custom/Items/Staff/CounselorStaff.cs and Custom/Items/Misc/AncientMIB.cs,
+// AncientSOS.cs. Each faction creature serves one faction and leaves that faction's players alone.
+
+using ModernUO.Serialization;
+using Server.Factions;
+using Server.Items;
+
+namespace Server.Mobiles
+{
+    [SerializationGenerator(0)]
+    public partial class FactionDaemon : Daemon
+    {
+        [Constructible]
+        public FactionDaemon()
+        {
+        }
+
+        public override Faction FactionAllegiance => Shadowlords.Instance;
+
+        public override bool IsEnemy(Mobile m) =>
+            !(m.Player && Faction.Find(m) == Shadowlords.Instance) && base.IsEnemy(m);
+    }
+
+    [SerializationGenerator(0)]
+    public partial class FactionOgreLord : OgreLord
+    {
+        [Constructible]
+        public FactionOgreLord()
+        {
+        }
+
+        public override Faction FactionAllegiance => Minax.Instance;
+
+        public override bool IsEnemy(Mobile m) => !(m.Player && Faction.Find(m) == Minax.Instance) && base.IsEnemy(m);
+    }
+
+    [SerializationGenerator(0)]
+    public partial class FactionSilverSerpent : SilverSerpent
+    {
+        [Constructible]
+        public FactionSilverSerpent()
+        {
+        }
+
+        public override Faction FactionAllegiance => TrueBritannians.Instance;
+
+        public override bool IsEnemy(Mobile m) =>
+            !(m.Player && Faction.Find(m) == TrueBritannians.Instance) && base.IsEnemy(m);
+    }
+
+    [SerializationGenerator(0)]
+    public partial class FactionWisp : Wisp
+    {
+        [Constructible]
+        public FactionWisp()
+        {
+        }
+
+        public override Faction FactionAllegiance => CouncilOfMages.Instance;
+
+        public override bool IsEnemy(Mobile m) =>
+            !(m.Player && Faction.Find(m) == CouncilOfMages.Instance) && base.IsEnemy(m);
+    }
+
+    [SerializationGenerator(0)]
+    public partial class EtherealSkeletalMount : EtherealMount
+    {
+        [Constructible]
+        public EtherealSkeletalMount() : base(9751, 16059)
+        {
+        }
+
+        public override string DefaultName => "Ethereal Skeletal Steed Statuette";
+        public override int EtherealHue => 0;
+    }
+
+    // Only a faction member may ride it.
+    [SerializationGenerator(0)]
+    public partial class EtherealWarHorse : EtherealMount
+    {
+        [Constructible]
+        public EtherealWarHorse() : base(11676, 16018)
+        {
+        }
+
+        public override string DefaultName => "Ethereal War Horse Statuette";
+        public override int EtherealHue => 0;
+
+        public override void OnDoubleClick(Mobile from)
+        {
+            if (Faction.Find(from) == null)
+            {
+                from.SendMessage("You have to be a faction member to use this item!");
+                return;
+            }
+
+            base.OnDoubleClick(from);
+        }
+    }
+}
+
+namespace Server.Items
+{
+    [SerializationGenerator(0)]
+    public partial class CounselorStaff : BlackStaff
+    {
+        [Constructible(AccessLevel.Counselor)]
+        public CounselorStaff()
+        {
+            Hue = 3;
+            Attributes.NightSight = 1;
+        }
+
+        public override string DefaultName => "Counselor's Staff";
+        public override int InitMinHits => 10;
+        public override int InitMaxHits => 10;
+
+        public override bool OnEquip(Mobile from) => from.AccessLevel > AccessLevel.Player && base.OnEquip(from);
+    }
+
+    // A message in a bottle that always holds an ancient SOS.
+    [SerializationGenerator(0)]
+    public partial class AncientMIB : MessageInABottle
+    {
+        [Constructible]
+        public AncientMIB(Map map = null) : base(map ?? Map.Felucca, 4)
+        {
+        }
+    }
+
+    [SerializationGenerator(0)]
+    public partial class AncientSOS : SOS
+    {
+        [Constructible]
+        public AncientSOS(Map map = null) : base(map ?? Map.Felucca, 4)
+        {
+        }
+    }
+}
diff --git a/Projects/UOContent/Custom/DFI/Mobiles/Paladin.cs b/Projects/UOContent/Custom/DFI/Mobiles/Paladin.cs
