diff --git a/Projects/UOContent.Tests/Tests/Custom/DfiCreatureTests.cs b/Projects/UOContent.Tests/Tests/Custom/DfiCreatureTests.cs
new file mode 100644
index 000000000..e04409830
--- /dev/null
+++ b/Projects/UOContent.Tests/Tests/Custom/DfiCreatureTests.cs
@@ -0,0 +1,159 @@
+using System;
+using System.Collections.Generic;
+using Server;
+using Server.Custom.Dfi;
+using Server.Items;
+using Server.Misc;
+using Server.Mobiles;
+using Xunit;
+
+namespace UOContent.Tests.Custom;
+
+[Collection("Sequential UOContent Tests")]
+public class DfiCreatureTests : IDisposable
+{
+    private readonly List<IEntity> _created = new();
+
+    public DfiCreatureTests()
+    {
+        if (NameList.GetNameList("male") == null)
+        {
+            NameList.Configure();
+        }
+    }
+
+    public static TheoryData<Type> Types =>
+    [
+        typeof(Paladin), typeof(FactionDaemon), typeof(FactionOgreLord), typeof(FactionSilverSerpent), typeof(FactionWisp),
+        typeof(EtherealSkeletalMount), typeof(EtherealWarHorse), typeof(CounselorStaff), typeof(AncientMIB), typeof(AncientSOS)
+    ];
+
+    public void Dispose()
+    {
+        foreach (var e in _created)
+        {
+            if (e is Mobile m)
+            {
+                SphynxFortunes.End(m);
+            }
+
+            e?.Delete();
+        }
+
+        _created.Clear();
+    }
+
+    private T Track<T>(T e) where T : IEntity
+    {
+        _created.Add(e);
+        return e;
+    }
+
+    private PlayerMobile Player()
+    {
+        var m = Track(new PlayerMobile());
+        m.Player = true;
+        m.Body = 0x190;
+        m.AddItem(new Backpack());
+        m.MoveToWorld(new Point3D(1500, 1600, 0), Map.Felucca);
+        return m;
+    }
+
+    [Theory]
+    [MemberData(nameof(Types))]
+    public void Type_Constructs(Type type)
+    {
+        var entity = Track(type.CreateInstance<IEntity>());
+
+        Assert.False(entity.Deleted);
+    }
+
+    [Theory]
+    [InlineData(6, 40, AosAttribute.Luck, 40)]
+    [InlineData(18, 70, AosAttribute.Luck, -70)]
+    [InlineData(7, 15, AosAttribute.EnhancePotions, 15)]
+    [InlineData(19, 5, AosAttribute.DefendChance, -5)]
+    [InlineData(10, 2, AosAttribute.RegenMana, 2)]
+    [InlineData(1, 10, AosAttribute.Luck, 0)]
+    public void Fortune_AddsToItsAttributeOnly(int type, int power, AosAttribute attribute, int expected)
+    {
+        var player = Player();
+
+        SphynxFortunes.Apply(player, type, power, Core.Now.AddHours(1));
+
+        Assert.Equal(expected, SphynxFortunes.GetBonus(player, attribute));
+    }
+
+    [Fact]
+    public void Fortune_ResistanceComesAndGoes()
+    {
+        var player = Player();
+        var before = player.PhysicalResistance;
+
+        SphynxFortunes.Apply(player, 11, 8, Core.Now.AddHours(1));
+        Assert.Equal(before - 8, player.PhysicalResistance);
+
+        SphynxFortunes.End(player);
+        Assert.Equal(before, player.PhysicalResistance);
+        Assert.False(SphynxFortunes.HasFortune(player));
+    }
+
+    [Fact]
+    public void Fortune_OneAtATimeAndItExpires()
+    {
+        var player = Player();
+
+        SphynxFortunes.Apply(player, 6, 40, Core.Now.AddHours(1));
+        SphynxFortunes.Apply(player, 8, 90, Core.Now.AddHours(1));
+        Assert.Equal(40, SphynxFortunes.GetBonus(player, AosAttribute.Luck));
+
+        SphynxFortunes.End(player);
+        SphynxFortunes.Apply(player, 6, 40, Core.Now.AddSeconds(-1));
+        Assert.False(SphynxFortunes.HasFortune(player));
+        Assert.Equal(0, SphynxFortunes.GetBonus(player, AosAttribute.Luck));
+    }
+
+    [Fact]
+    public void Fortune_ReadingAlwaysGivesOne()
+    {
+        for (var i = 0; i < 50; i++)
+        {
+            var player = Player();
+
+            SphynxFortunes.TellFortune(player);
+
+            Assert.True(SphynxFortunes.HasFortune(player));
+        }
+    }
+
+    [Fact]
+    public void Paladin_FightsWithItsOwnAI()
+    {
+        var paladin = Track(new Paladin());
+
+        Assert.IsType<PaladinAI>(paladin.AIObject);
+        Assert.NotNull(paladin.Backpack.FindItemByType<BookOfChivalry>());
+        Assert.Equal(1000, paladin.TithingPoints);
+    }
+
+    [Fact]
+    public void CounselorStaff_RefusesPlayers()
+    {
+        var player = Player();
+        player.RawStr = 100;
+        // The test server loads no tiledata, so the staff gets its layer here.
+        var staff = Track(new CounselorStaff { Layer = Layer.TwoHanded });
+
+        Assert.False(player.EquipItem(staff));
+
+        player.AccessLevel = AccessLevel.Counselor;
+        Assert.True(player.EquipItem(staff));
+    }
+
+    [Fact]
+    public void AncientBottle_HoldsAnAncientSOS()
+    {
+        Assert.Equal(4, Track(new AncientMIB()).Level);
+        Assert.True(Track(new AncientSOS()).IsAncient);
+    }
+}
diff --git a/Projects/UOContent/Custom/DFI/Mobiles/FactionCreatures.cs b/Projects/UOContent/Custom/DFI/Mobiles/FactionCreatures.cs
