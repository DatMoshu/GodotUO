+using System;
+using System.Collections.Generic;
+using Server;
+using Server.Custom.Dfi;
+using Server.Items;
+using Server.Misc;
+using Server.Mobiles;
+using Xunit;
+
+namespace UOContent.Tests.Custom;
+
+[Collection("Sequential UOContent Tests")]
+public class DfiTownTests : IDisposable
+{
+    private readonly List<IEntity> _created = new();
+
+    public DfiTownTests()
+    {
+        if (NameList.GetNameList("male") == null)
+        {
+            NameList.Configure();
+        }
+    }
+
+    public static TheoryData<Type> Types =>
+    [
+        typeof(CriminalBanker), typeof(PrisonerNoble), typeof(PrisonerSeeker), typeof(PriestOfMondain), typeof(PaidFullHealer),
+        typeof(Necromancer), typeof(HavenCrier), typeof(RiddleNPC), typeof(BankWithdrawStone), typeof(LimitedItemStone),
+        typeof(LimitedRegStone), typeof(RegWithdrawStone), typeof(NecroRegWithdrawStone), typeof(PetBondingStone),
+        typeof(WebStone), typeof(WeaponStone)
+    ];
+
+    public void Dispose()
+    {
+        foreach (var e in _created)
+        {
+            e?.Delete();
+        }
+
+        _created.Clear();
+        Riddles.List.Clear();
+    }
+
+    private T Track<T>(T e) where T : IEntity
+    {
+        _created.Add(e);
+        return e;
+    }
+
+    private PlayerMobile Player()
+    {
+        var m = Track(new PlayerMobile());
+        m.Player = true;
+        m.Body = 0x190;
+        m.AddItem(new Backpack());
+        m.AddItem(new BankBox(m));
+        m.MoveToWorld(new Point3D(1434, 1690, 0), Map.Felucca);
+        return m;
+    }
+
+    private T Placed<T>(T item) where T : Item
+    {
+        Track(item);
+        item.MoveToWorld(new Point3D(1434, 1691, 0), Map.Felucca);
+        return item;
+    }
+
+    [Theory]
+    [MemberData(nameof(Types))]
+    public void Type_Constructs(Type type)
+    {
+        var entity = Track(type.CreateInstance<IEntity>());
+
+        Assert.False(entity.Deleted);
+    }
+
+    [Fact]
+    public void CriminalBanker_AloneServesCriminals()
+    {
+        Assert.True(Track(new CriminalBanker()).ServesCriminals);
+        Assert.False(Track(new Banker()).ServesCriminals);
+    }
+
+    [Fact]
+    public void Necromancer_SellsNecroReagentsAndBooks()
+    {
+        var shop = new SBNecromancer();
+
+        Assert.Contains(shop.BuyInfo, b => b.Type == typeof(NecromancerSpellbook));
+        Assert.Contains(shop.BuyInfo, b => b.Type == typeof(NoxCrystal));
+        Assert.True(shop.SellInfo.IsSellable(Track(new BatWing())));
+    }
+
+    [Fact]
+    public void PaidHealer_FullResurrectionRestoresHitsAndMana()
+    {
+        var player = Player();
+        player.RawStr = player.RawInt = 50;
+        player.Kill();
+
+        PaidFullHealerGump.FullResurrect(player);
+
+        Assert.True(player.Alive);
+        Assert.Equal(player.HitsMax, player.Hits);
+        Assert.Equal(player.ManaMax, player.Mana);
+        Assert.False(player.Frozen);
+    }
+
+    [Fact]
+    public void BankWithdrawStone_PaysFromTheBankUpToItsLimit()
+    {
+        var player = Player();
+        player.BankBox.DropItem(new Gold(1000));
+        var stone = Placed(new BankWithdrawStone { GoldAmount = 300 });
+
+        stone.OnDoubleClick(player);
+        stone.OnDoubleClick(player);
+
+        Assert.Equal(300, player.Backpack.GetAmount(typeof(Gold)));
+        Assert.Equal(700, Banker.GetBalance(player));
+        Assert.Equal("a limited 300 gp withdrawal stone", stone.Name ?? stone.DefaultName);
+    }
+
+    [Theory]
+    [InlineData(LimitedItemType.MageReagentBag, typeof(BagOfReagents))]
+    [InlineData(LimitedItemType.NecroReagentBag, typeof(BagOfNecroReagents))]
+    [InlineData(LimitedItemType.Bandages, typeof(Bandage))]
+    public void LimitedItemStone_GivesItsItemOnce(LimitedItemType kind, Type expected)
+    {
+        var player = Player();
+        var stone = Placed(new LimitedItemStone { ItemType = kind });
+
+        stone.OnDoubleClick(player);
+        stone.OnDoubleClick(player);
+
+        Assert.Single(player.Backpack.Items, i => i.GetType() == expected);
+    }
+
+    [Fact]
+    public void RegWithdrawStone_TakesReagentsFromTheBank()
+    {
+        var player = Player();
+        var stone = Placed(new RegWithdrawStone { RegAmount = 10 });
+
+        stone.OnDoubleClick(player);
+        Assert.Null(player.Backpack.FindItemByType<BagOfReagents>());
+
+        foreach (var type in (Type[])[typeof(BlackPearl), typeof(Bloodmoss), typeof(MandrakeRoot), typeof(SulfurousAsh),
+                     typeof(SpidersSilk), typeof(Garlic), typeof(Ginseng), typeof(Nightshade)])
+        {
+            var reg = type.CreateInstance<Item>();
+            reg.Amount = 15;
+            player.BankBox.DropItem(reg);
+        }
+
+        stone.OnDoubleClick(player);
+
+        Assert.NotNull(player.Backpack.FindItemByType<BagOfReagents>());
+        Assert.Equal(5, player.BankBox.GetAmount(typeof(BlackPearl)));
+    }
+
+    [Fact]
+    public void WeaponStone_LimitsEachAccountToFive()
+    {
+        var player = Player();
+        var stone = Placed(new WeaponStone { UseLimit = true });
+
+        for (var i = 0; i < 7; i++)
+        {
+            stone.Give(player, typeof(Katana), "Katana");
+        }
+
+        stone.Give(player, typeof(Arrow), "Arrows");
+
+        Assert.Equal(WeaponStone.AmountToGive, player.Backpack.Items.Count);
+    }
+
+    [Fact]
+    public void WeaponStone_HandsOutAmmunitionByTheHundred()
+    {
+        var player = Player();
+        var stone = Placed(new WeaponStone());
+
+        stone.Give(player, typeof(Arrow), "Arrows");
+
+        Assert.Equal(WeaponStone.StackAmount, player.Backpack.GetAmount(typeof(Arrow)));
+    }
+
+    [Fact]
+    public void Riddler_RightAnswerWinsTheBarsAndTheNextRiddleComesUp()
+    {
+        var player = Player();
+        var riddler = Track(new RiddleNPC());
+        riddler.MoveToWorld(new Point3D(1435, 1690, 0), Map.Felucca);
+        Riddles.List.Add(new Riddle("What has keys but no locks?", "A piano", 4));
+        Riddles.List.Add(new Riddle("What gets wetter as it dries?", "A towel", 2));
+
+        Assert.False(riddler.TryAnswer(player, "a door"));
+        Assert.True(riddler.TryAnswer(player, "  a PIANO "));
+
+        Assert.Equal(4, player.Backpack.GetAmount(typeof(CopperBar)));
+        Assert.Single(Riddles.List);
+        Assert.True(riddler.Hidden);
+    }
+}
