@@ -0,0 +1,344 @@
+// DFI Network's Riddler, ported from DFI RUNUO Scripts/Custom/Mobiles/Riddle Man. Administrators keep a list
+// of up to ten riddles; players who talk to him hear the first, and the first to answer it wins its copper bars.
+// He then vanishes for 20 to 30 hours, and comes back while riddles remain.
+
+using System;
+using System.Collections.Generic;
+using ModernUO.Serialization;
+using Server.Engines.Quests;
+using Server.Gumps;
+using Server.Mobiles;
+using Server.Network;
+using Server.Prompts;
+
+namespace Server.Custom.Dfi;
+
+public record Riddle(string Question, string Answer, int RewardAmount);
+
+public class Riddles : GenericPersistence
+{
+    public const int MaxRiddles = 10;
+    public const int MaxReward = 20;
+
+    public static List<Riddle> List { get; } = [];
+
+    public Riddles() : base("DfiRiddles", 10)
+    {
+    }
+
+    public static void Configure()
+    {
+        _ = new Riddles();
+    }
+
+    public override void Serialize(IGenericWriter writer)
+    {
+        writer.WriteEncodedInt(0); // version
+        writer.WriteEncodedInt(List.Count);
+
+        foreach (var r in List)
+        {
+            writer.Write(r.Question);
+            writer.Write(r.Answer);
+            writer.WriteEncodedInt(r.RewardAmount);
+        }
+    }
+
+    public override void Deserialize(IGenericReader reader)
+    {
+        reader.ReadEncodedInt(); // version
+        var count = reader.ReadEncodedInt();
+
+        for (var i = 0; i < count; i++)
+        {
+            List.Add(new Riddle(reader.ReadString(), reader.ReadString(), reader.ReadEncodedInt()));
+        }
+    }
+}
+
+[SerializationGenerator(0)]
+public partial class RiddleNPC : BaseQuester
+{
+    private Timer _hiddenTimer;
+
+    [Constructible(AccessLevel.Administrator)]
+    public RiddleNPC() : base("the Riddler")
+    {
+    }
+
+    public override string DefaultName => "the Riddler";
+    public override bool ClickTitle => true;
+
+    public override void InitBody()
+    {
+        InitStats(100, 100, 25);
+        Hue = Race.Human.RandomSkinHue();
+        Body = 0x190;
+        Name = NameList.RandomName("male");
+        HairItemID = Race.Human.RandomHair(false);
+        HairHue = Race.Human.RandomHairHue();
+    }
+
+    public override void InitOutfit()
+    {
+        AddItem(new Items.FancyShirt(Utility.RandomBlueHue()));
+        AddItem(new Items.Kilt(Utility.RandomGreenHue()));
+        AddItem(new Items.FeatheredHat(Utility.RandomGreenHue()));
+        AddItem(new Items.ThighBoots());
+    }
+
+    public override void OnTalk(PlayerMobile talker, bool contextMenu)
+    {
+        if (talker.AccessLevel >= AccessLevel.Administrator)
+        {
+            talker.SendGump(new RiddlesGump(), true);
+            return;
+        }
+
+        if (talker.AccessLevel != AccessLevel.Player)
+        {
+            return;
+        }
+
+        if (Riddles.List.Count > 0)
+        {
+            Say(Riddles.List[0].Question);
+            talker.Prompt = new RiddlePrompt(this);
+        }
+        else
+        {
+            Say("Currently i am out of things to solve, come back later i may have something for you.");
+            Vanish();
+        }
+    }
+
+    // Returns whether the answer was right; the winner gets the riddle's copper bars.
+    public bool TryAnswer(Mobile m, string text)
+    {
+        if (Riddles.List.Count == 0 || m.Backpack == null)
+        {
+            return false;
+        }
+
+        var riddle = Riddles.List[0];
+
+        if (!string.Equals(text.Trim(), riddle.Answer.Trim(), StringComparison.OrdinalIgnoreCase))
+        {
+            m.SendMessage("I am sorry that is not the correct answer, try again.");
+            return false;
+        }
+
+        foreach (var ns in NetState.Instances)
+        {
+            if (ns.Mobile is { } listener)
+            {
+                listener.SendMessage(0x482, "Message from the Riddler:");
+                listener.SendMessage(0x482, $"{m.Name} just solved the following riddle: {riddle.Question}");
+                listener.SendMessage(0x482, $"The answer was: '{riddle.Answer}'. Expect more riddles when you see me again.");
+            }
+        }
+
+        m.SendMessage("Congratulations you have solved the riddle!");
+        EventRewardSystem.CreateCopperBar(m, riddle.RewardAmount, "solved a riddle");
+        Riddles.List.RemoveAt(0);
+        Vanish();
+        return true;
+    }
+
+    private void Vanish()
+    {
+        Effects.SendLocationEffect(Location, Map, 0x36BD, 10);
+        Hidden = true;
+        _hiddenTimer?.Stop();
+        _hiddenTimer = Timer.DelayCall(TimeSpan.FromHours(Utility.RandomMinMax(20, 30)), Return);
+    }
+
+    private void Return()
+    {
+        if (Deleted || !Hidden || Riddles.List.Count == 0)
+        {
+            return;
+        }
+
+        Hidden = false;
+        Effects.SendLocationEffect(Location, Map, 0x36BD, 10);
+
+        foreach (var ns in NetState.Instances)
+        {
+            ns.Mobile?.SendMessage(0x482, "The Riddler is back.");
+        }
+    }
+
+    // A riddler hidden at a restart has lost its timer, so it comes back then if riddles remain.
+    [AfterDeserialization]
+    private void AfterDeserialization()
+    {
+        if (Hidden)
+        {
+            Timer.DelayCall(TimeSpan.FromMinutes(1.0), Return);
+        }
+    }
+
+    public override void OnDelete()
+    {
+        _hiddenTimer?.Stop();
+        _hiddenTimer = null;
+        base.OnDelete();
+    }
+
+    private class RiddlePrompt : Prompt
+    {
+        private readonly RiddleNPC _riddler;
+
+        public RiddlePrompt(RiddleNPC riddler) => _riddler = riddler;
+
+        public override void OnResponse(Mobile from, string text)
+        {
+            if (!_riddler.Deleted)
+            {
+                _riddler.TryAnswer(from, text);
+            }
+        }
+    }
+}
+
+public class RiddlesGump : DynamicGump
+{
+    public RiddlesGump() : base(50, 50)
+    {
+    }
+
+    public override bool Singleton => true;
+
+    protected override void BuildLayout(ref DynamicGumpBuilder builder)
+    {
+        builder.AddPage();
+        builder.AddBackground(0, 0, 429, 297, 9200);
+        builder.AddLabel(18, 16, 0, "Riddles:");
+
+        for (var i = 0; i < Riddles.List.Count; i++)
+        {
+            var question = Riddles.List[i].Question;
+            var y = 46 + 18 * i;
+            builder.AddLabel(17, y, 0, $"{i + 1}.");
+            builder.AddButton(39, y, 1210, 1209, i + 1);
+            builder.AddLabel(62, y, 0, question.Length > 35 ? question[..30] : question);
+        }
+
+        builder.AddButton(20, 255, 247, 248, 0);
+        builder.AddButton(260, 255, 4029, 248, 20);
+        builder.AddLabel(300, 255, 0, "Add new riddle");
+    }
+
+    public override void OnResponse(NetState sender, in RelayInfo info)
+    {
+        var m = sender.Mobile;
+
+        if (m.AccessLevel < AccessLevel.Administrator)
+        {
+            return;
+        }
+
+        if (info.ButtonID == 20)
+        {
+            if (Riddles.List.Count < Riddles.MaxRiddles)
+            {
+                m.SendGump(new RiddleGump(-1), true);
+            }
+            else
+            {
+                m.SendMessage("There are already 10 riddles, that is enough for now.");
+            }
+        }
+        else if (info.ButtonID > 0 && info.ButtonID <= Riddles.List.Count)
+        {
+            m.SendGump(new RiddleGump(info.ButtonID - 1), true);
+        }
+    }
+}
+
+public class RiddleGump : DynamicGump
+{
+    private const int Save = 1;
+    private const int Delete = 2;
+
+    private readonly int _index;
+
+    public RiddleGump(int index) : base(50, 50) => _index = index;
+
+    private Riddle Existing => _index >= 0 && _index < Riddles.List.Count ? Riddles.List[_index] : null;
+
+    public override bool Singleton => true;
+
+    protected override void BuildLayout(ref DynamicGumpBuilder builder)
+    {
+        var riddle = Existing;
+
+        builder.AddPage();
+        builder.AddBackground(0, 0, 400, 400, 9200);
+        builder.AddHtml(0, 15, 400, 22, "Riddle", align: TextAlignment.Center);
+        builder.AddLabel(15, 55, 0, "Question:");
+        builder.AddBackground(15, 80, 370, 120, 9350);
+        builder.AddTextEntry(20, 84, 360, 110, 0, 0, riddle?.Question ?? "");
+        builder.AddLabel(15, 220, 0, "Answer:");
+        builder.AddBackground(15, 240, 370, 83, 9350);
+        builder.AddTextEntry(20, 245, 360, 73, 0, 1, riddle?.Answer ?? "");
+        builder.AddLabel(15, 340, 0, "Reward Amount:");
+        builder.AddBackground(118, 336, 249, 30, 9350);
+        builder.AddTextEntry(123, 341, 239, 20, 0, 2, riddle != null ? $"{riddle.RewardAmount}" : "");
+
+        if (riddle != null)
+        {
+            builder.AddButton(158, 374, 2464, 2463, Delete);
+        }
+
+        builder.AddButton(290, 370, 247, 248, Save);
+        builder.AddButton(45, 370, 241, 242, 0);
+    }
+
+    public override void OnResponse(NetState sender, in RelayInfo info)
+    {
+        var m = sender.Mobile;
+
+        if (m.AccessLevel < AccessLevel.Administrator)
+        {
+            return;
+        }
+
+        var question = info.GetTextEntry(0)?.Trim() ?? "";
+        var answer = info.GetTextEntry(1)?.Trim() ?? "";
+        _ = int.TryParse(info.GetTextEntry(2)?.Trim(), out var amount);
+        amount = Math.Clamp(amount, 1, Riddles.MaxReward);
+
+        switch (info.ButtonID)
+        {
+            case Save when question.Length == 0 || answer.Length == 0:
+                {
+                    m.SendMessage("A riddle needs a question and an answer.");
+                    break;
+                }
+            case Save when Existing != null:
+                {
+                    Riddles.List[_index] = new Riddle(question, answer, amount);
+                    break;
+                }
+            case Save when Riddles.List.Count < Riddles.MaxRiddles:
+                {
+                    Riddles.List.Add(new Riddle(question, answer, amount));
+                    break;
+                }
+            case Save:
+                {
+                    m.SendMessage("There are already 10 riddles, that is enough for now.");
+                    break;
+                }
+            case Delete when Existing != null:
+                {
+                    Riddles.List.RemoveAt(_index);
+                    break;
+                }
+        }
+
+        m.SendGump(new RiddlesGump(), true);
+    }
+}
diff --git a/Projects/UOContent/Custom/DFI/Town/Stones.cs b/Projects/UOContent/Custom/DFI/Town/Stones.cs
