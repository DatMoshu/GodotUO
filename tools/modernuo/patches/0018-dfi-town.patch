@@ -0,0 +1,543 @@
+// DFI Network's service stones, ported from DFI RUNUO Scripts/Custom/Items/Stones: gold, reagent and weapon
+// handouts, the pet bonding stone and the web stone. A stone's per-player limit lasts until the server restarts,
+// as DFI's did.
+
+using System;
+using System.Collections.Generic;
+using ModernUO.Serialization;
+using Server.Gumps;
+using Server.Mobiles;
+using Server.Network;
+using Server.Targeting;
+
+namespace Server.Items;
+
+[SerializationGenerator(0)]
+public abstract partial class DfiStone : Item
+{
+    private readonly Dictionary<string, int> _uses = [];
+
+    protected DfiStone(int itemID, int hue) : base(itemID)
+    {
+        Movable = false;
+        Hue = hue;
+    }
+
+    // Uses are counted per account, so a player's other characters share the limit.
+    protected bool CheckLimit(Mobile from, bool useLimit, int limit, string message)
+    {
+        if (useLimit && _uses.TryGetValue(Key(from), out var used) && used >= limit)
+        {
+            from.SendMessage(message);
+            return false;
+        }
+
+        return true;
+    }
+
+    protected void CountUse(Mobile from)
+    {
+        var key = Key(from);
+        _uses[key] = _uses.GetValueOrDefault(key) + 1;
+    }
+
+    private static string Key(Mobile from) => from.Account?.Username ?? from.Serial.ToString();
+
+    protected bool CheckRange(Mobile from)
+    {
+        if (from.InRange(GetWorldLocation(), 2))
+        {
+            return true;
+        }
+
+        from.SendLocalizedMessage(500446); // That is too far away.
+        return false;
+    }
+}
+
+[SerializationGenerator(0)]
+public partial class BankWithdrawStone : DfiStone
+{
+    [SerializableField(0)]
+    [InvalidateProperties]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private bool _active = true;
+
+    [SerializableField(1)]
+    [InvalidateProperties]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private bool _useLimit = true;
+
+    [SerializableField(2)]
+    [InvalidateProperties]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private int _limit = 1;
+
+    [SerializableField(3)]
+    [InvalidateProperties]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private int _goldAmount;
+
+    [Constructible(AccessLevel.GameMaster)]
+    public BankWithdrawStone() : base(0xED4, 0x2D1)
+    {
+    }
+
+    public override string DefaultName => $"{(_useLimit ? "a limited " : "a ")}{_goldAmount} gp withdrawal stone";
+
+    public override void GetProperties(IPropertyList list)
+    {
+        base.GetProperties(list);
+        list.Add(_active ? 1060742 : 1060743); // active / inactive
+    }
+
+    public override void OnDoubleClick(Mobile from)
+    {
+        if (!_active || _goldAmount <= 0)
+        {
+            from.SendMessage("This stone is disabled.");
+            return;
+        }
+
+        if (!CheckRange(from) || !CheckLimit(from, _useLimit, _limit, "You cannot take anymore use this stone another time."))
+        {
+            return;
+        }
+
+        if (!Banker.Withdraw(from, _goldAmount))
+        {
+            from.SendMessage("You do not have enough money in your bank to withdraw this amount.");
+            return;
+        }
+
+        from.SendMessage($"Your new bank balance is: {Banker.GetBalance(from)}gp.");
+        from.AddToBackpack(_goldAmount < 1000 ? new Gold(_goldAmount) : new BankCheck(_goldAmount));
+        CountUse(from);
+    }
+}
+
+public enum LimitedItemType
+{
+    MageReagentBag,
+    NecroReagentBag,
+    Bandages
+}
+
+// Hands out a bag of 50 of each reagent, or 50 bandages, a set number of times per player.
+[SerializationGenerator(0)]
+public partial class LimitedItemStone : DfiStone
+{
+    [SerializableField(0)]
+    [InvalidateProperties]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private bool _active = true;
+
+    [SerializableField(1)]
+    [InvalidateProperties]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private bool _useLimit = true;
+
+    [SerializableField(2)]
+    [InvalidateProperties]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private LimitedItemType _itemType;
+
+    [SerializableField(3)]
+    [InvalidateProperties]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private int _limit = 1;
+
+    [Constructible(AccessLevel.GameMaster)]
+    public LimitedItemStone() : base(0xED4, 0x2D1)
+    {
+    }
+
