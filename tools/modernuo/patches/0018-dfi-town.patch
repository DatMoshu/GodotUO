+        {
+            LimitedItemType.Bandages        => "bandage stone",
+            LimitedItemType.NecroReagentBag => "necro reagent stone",
+            _                               => "mage reagent stone"
+        }}";
+
+    public override void GetProperties(IPropertyList list)
+    {
+        base.GetProperties(list);
+
+        if (!_active)
+        {
+            list.Add(1060743); // inactive
+            return;
+        }
+
+        list.Add(1060742); // active
+
+        if (_useLimit)
+        {
+            list.Add(1060658, $"{"limit"}\t{_limit}"); // ~1_val~: ~2_val~
+        }
+    }
+
+    public override void OnDoubleClick(Mobile from)
+    {
+        if (!_active)
+        {
+            from.SendMessage("This stone is disabled.");
+            return;
+        }
+
+        if (!CheckRange(from) || !CheckLimit(from, _useLimit, _limit, "You cannot take anymore items from this stone."))
+        {
+            return;
+        }
+
+        Item item = _itemType switch
+        {
+            LimitedItemType.NecroReagentBag => new BagOfNecroReagents(),
+            LimitedItemType.Bandages        => new Bandage(50),
+            _                               => new BagOfReagents()
+        };
+
+        if (!from.PlaceInBackpack(item))
+        {
+            from.SendLocalizedMessage(500720); // You don't have enough room in your backpack!
+            item.Delete();
+            return;
+        }
+
+        from.SendLocalizedMessage(1072223); // An item has been placed in your backpack.
