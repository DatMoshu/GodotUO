+using Server;
+using Server.Custom.Dfi;
+using Server.Engines.ConPVP;
+using Xunit;
+
+namespace UOContent.Tests.Custom;
+
+[Collection("Sequential UOContent Tests")]
+public class DfiArenasTests
+{
+    [Fact]
+    public void LunaGrandArena_IsAnActiveConPvpArenaWithALadder()
+    {
+        var controller = DfiArenasGen.Place();
+
+        try
+        {
+            var arena = controller.Arena;
+
+            Assert.True(arena.Active);
+            Assert.Contains(arena, Arena.Arenas);
+            Assert.Equal(Map.Malas, arena.Facet);
+            Assert.NotNull(arena.Ladder);
+            Assert.Same(arena.Ladder.Ladder, arena.AcquireLadder());
+            Assert.True(DfiArenasGen.Pit.Contains(arena.Points.EdgeWest));
+            Assert.True(DfiArenasGen.Pit.Contains(arena.Points.EdgeEast));
+            Assert.True(DfiArenasGen.Pit.Contains(arena.Wall));
+            Assert.True(DfiArenasGen.Grounds.Contains(arena.Points.CornerNW));
+            Assert.False(DfiArenasGen.Grounds.Contains(arena.Outside));
+        }
+        finally
+        {
+            DfiArenasGen.Remove();
+        }
+    }
+}
