+public abstract partial class DfiRare : Item, IStealable
+{
+    public DfiRare(int itemID) : base(itemID) => Movable = false;
+
+    public abstract double GetMin();
+    public abstract double GetMax();
+
+    public virtual void OnSteal()
+    {
+    }
+}
