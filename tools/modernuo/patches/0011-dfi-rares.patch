@@ -0,0 +1,114 @@
+using System;
+using System.Collections.Generic;
+using Server;
+using Server.Custom.Dfi;
+using Server.Items;
+using Server.Misc;
+using Server.Mobiles;
+using Xunit;
+
+namespace UOContent.Tests.Custom;
+
+[Collection("Sequential UOContent Tests")]
+public class DfiRareTests : IDisposable
+{
+    private readonly List<IEntity> _created = new();
+
+    // The shared test server never runs the skill system's start-up, which installs the skill checks.
+    public DfiRareTests() => SkillCheck.Initialize();
+
+    public static TheoryData<Type> Rares =>
+    [
+        typeof(SRDriedOnions), typeof(SRDriedHerbs), typeof(SRDriedFlowers), typeof(SRHorseShoes), typeof(SRArrowShafts),
+        typeof(SREIronWire), typeof(SRESilverWire), typeof(SREGoldWire), typeof(SRECopperWire), typeof(SRDRBloodyWater),
+        typeof(SRDRCocoon), typeof(SRDRDamagedBooks), typeof(SRDRRuinedBooks), typeof(SRDRBottle), typeof(SRDRBrazier),
+        typeof(SRDRLampPost), typeof(SRDRRuinedPainting), typeof(SRDRSaddle), typeof(SRDRTarot), typeof(SRDREggCase),
+        typeof(SRDRGruesomeStandard), typeof(SRDRHangingLeatherTunic), typeof(SRDRHangingStuddedLeggings),
+        typeof(SRDRHangingStuddedTunic), typeof(SRDRRock), typeof(SRDRSkinnedDeer), typeof(SRDRSkinnedGoat),
+        typeof(SRDRSkullCandle), typeof(SRDRStackedBooks2), typeof(SRDRStackedBooks), typeof(SRDRStretchedHide),
+        typeof(SRDRReversedBackPack)
+    ];
+
+    public void Dispose()
+    {
+        foreach (var e in _created)
+        {
+            e?.Delete();
+        }
+
+        _created.Clear();
+    }
+
+    private T Track<T>(T e) where T : IEntity
+    {
+        _created.Add(e);
+        return e;
+    }
+
+    private PlayerMobile Thief(double stealing)
+    {
+        var m = Track(new PlayerMobile(World.NewMobile));
+        m.DefaultMobileInit();
+        m.MoveToWorld(new Point3D(1500, 1600, 0), Map.Felucca);
+        m.AddItem(new Backpack());
+        m.Skills.Stealing.Base = stealing;
+        return m;
+    }
+
+    [Theory]
+    [MemberData(nameof(Rares))]
+    public void Rare_SpawnsFixedAndStealable(Type type)
+    {
+        var item = Track(type.CreateInstance<Item>());
+
+        Assert.False(item.Movable);
+        Assert.IsAssignableFrom<IStealable>(item);
+        Assert.True(((IStealable)item).GetMin() >= 80.0);
+    }
+
+    [Fact]
+    public void Steal_BelowTheRaresMinimum_IsRefusedAndLeavesItFixed()
+    {
+        var thief = Thief(90.0);
+        var rare = Track(new SRDRTarot());
+        rare.MoveToWorld(new Point3D(1501, 1600, 0), Map.Felucca);
+
+        Assert.Null(DfiRares.Steal(thief, rare, rare));
+        Assert.False(rare.Movable);
+    }
+
+    [Fact]
+    public void Steal_AtTheTopOfTheWindow_AlwaysSucceedsAndFreesTheRare()
+    {
+        var thief = Thief(100.0);
+        var rare = Track(new SRDriedOnions());
+        rare.MoveToWorld(new Point3D(1501, 1600, 0), Map.Felucca);
+
+        Assert.Same(rare, DfiRares.Steal(thief, rare, rare));
+        Assert.True(rare.Movable);
+    }
+
+    [Fact]
+    public void Steal_OutOfReach_IsRefused()
+    {
+        var thief = Thief(100.0);
+        var rare = Track(new SRDriedOnions());
+        rare.MoveToWorld(new Point3D(1510, 1600, 0), Map.Felucca);
+
+        Assert.Null(DfiRares.Steal(thief, rare, rare));
+    }
+
+    [Fact]
+    public void LockedFruitBasket_EatenLeavesAnEmptyBasket()
+    {
+        var m = Thief(0);
+        m.Hunger = 0;
+        var basket = Track(new LockedFruitBasket());
+        basket.MoveToWorld(new Point3D(1501, 1600, 0), Map.Felucca);
+
+        basket.OnDoubleClick(m);
+
+        Assert.True(basket.Deleted);
+        Assert.True(m.Hunger > 0);
+    }
+}
