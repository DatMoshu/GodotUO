@@ -0,0 +1,42 @@
+using Server.Items;
+
+namespace Server.Custom.Dfi;
+
+public static class DfiRares
+{
+    // A fixed rare on the ground: the thief needs the rare's minimum skill to try at all, succeeds by
+    // a skill check across its min..max window, and on success the rare becomes an ordinary item.
+    // The spawner that placed it counts it gone once it is in a backpack and puts a new one back.
+    public static Item Steal(Mobile thief, Item item, IStealable rare)
+    {
+        if (!thief.InRange(item.GetWorldLocation(), 1))
+        {
+            thief.SendLocalizedMessage(502703); // You must be standing next to an item to steal it.
+            return null;
+        }
+
+        if (thief.Backpack?.CheckHold(thief, item, false, true) != true)
+        {
+            thief.SendLocalizedMessage(1048147); // Your backpack can't hold anything else.
+            return null;
+        }
+
+        if (thief.Skills.Stealing.Value < rare.GetMin())
+        {
+            // You're not skilled enough to attempt the theft of this item.
+            thief.SendLocalizedMessage(1060025, "", 0x66D);
+            return null;
+        }
+
+        if (!thief.CheckTargetSkill(SkillName.Stealing, item, rare.GetMin(), rare.GetMax()))
+        {
+            thief.SendLocalizedMessage(502723); // You fail to steal the item.
+            return null;
+        }
+
+        thief.SendLocalizedMessage(502724); // You successfully steal the item.
+        item.Movable = true;
+        rare.OnSteal();
+        return item;
+    }
+}
