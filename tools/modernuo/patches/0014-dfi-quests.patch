+
+            if (Utility.RandomDouble() < 0.3)
+            {
+                from.SendMessage("You destroy the skull.");
+                new Gold(25, 100).MoveToWorld(GetWorldLocation(), Map);
+                Delete();
+            }
+            else
+            {
+                from.SendMessage("You damage the skull.");
+            }
+        }
+
+        public override void OnAfterDelete()
+        {
+            _timerToken.Cancel();
+            base.OnAfterDelete();
+        }
