+        {
+            base.Decline();
+            AddConversation(new DeclineConversation());
+        }
+
+        // A bag of magic items, a 5,000 gold check and a treasure map; one time in ten a Kale artifact, and
+        // often the Midas Touch.
+        public static void GiveRewardTo(PlayerMobile player)
+        {
+            var bag = new Bag { Hue = Utility.RandomDyedHue() };
+            DfiLoot.AddRandomLoot(bag, 5, 600, 5, 5, 50, 100);
+            bag.DropItem(new BankCheck(5000));
+            bag.DropItem(new TreasureMap(Utility.RandomDouble() < 0.08 ? 6 : Utility.RandomMinMax(3, 5), Map.Felucca));
+
+            if (Utility.RandomDouble() < 0.1)
+            {
+                bag.DropItem(
+                    Utility.Random(4) switch
+                    {
+                        0 => new YetisPads(),
+                        1 => new Necronomicon(),
+                        2 => new Behemoth(),
+                        _ => new DragonClenchingClaws()
+                    }
+                );
+            }
+
+            if (Utility.RandomDouble() < 0.80)
+            {
+                bag.DropItem(new MidasTouch());
+            }
+
+            if (!player.KarmaLocked)
+            {
+                player.Karma = Math.Min(15000, player.Karma + 1500);
+            }
+
+            if (player.PlaceInBackpack(bag))
+            {
+                player.SendMessage("Reward bag has been placed in your backpack.");
+            }
+            else
+            {
+                player.SendMessage("Your backpack if full, reward is on the ground.");
+                bag.MoveToWorld(player.Location, player.Map);
+            }
+        }
+    }
