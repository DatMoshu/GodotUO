+
+        public override void OnTalk(PlayerMobile player, bool contextMenu)
+        {
+            Direction = GetDirectionTo(player);
+
+            var qs = player.Quest;
+
+            if (qs is not MidasQuest)
+            {
+                if (qs == null && QuestSystem.CanOfferQuest(player, typeof(MidasQuest)))
+                {
+                    new MidasQuest(player).SendOffer();
+                }
+
+                return;
+            }
+
+            if (qs.IsObjectiveInProgress(typeof(SlayObjective)))
+            {
+                qs.AddConversation(new DuringSlayConversation());
+                return;
+            }
+
+            // Every round leaves a report-back objective; the newest one not yet done is this round's.
+            ReturnToNimreObjective current = null;
+
+            foreach (var obj in qs.Objectives)
+            {
+                if (obj is ReturnToNimreObjective r && !r.Completed)
+                {
+                    current = r;
+                }
+            }
+
+            if (current == null)
+            {
+                return;
+            }
+
+            current.Complete();
+
+            if (current.Round >= MidasRounds.All.Length - 1)
+            {
+                qs.AddConversation(new EndConversation());
+            }
+            else
+            {
