+        public override bool OnDragDrop(Mobile from, Item dropped)
+        {
+            if (from is not PlayerMobile { Quest: ThePlagueQuest qs } || dropped is not PoisonFungus fungus)
+            {
+                return base.OnDragDrop(from, dropped);
+            }
+
+            var obj = qs.FindObjective(typeof(CollectFungusObjective));
+
+            if (obj == null || obj.Completed)
+            {
+                SayTo(from, "You have already given me all the Poison fungus necessary to weave the spell.  Keep these for a later time.");
+                return false;
+            }
+
+            var need = obj.MaxProgress - obj.CurProgress;
+
+            if (fungus.Amount < need)
+            {
+                obj.CurProgress += fungus.Amount;
+                fungus.Delete();
+                qs.ShowQuestLogUpdated();
+            }
+            else
+            {
+                fungus.Consume(need);
+                obj.Complete();
+
+                if (!fungus.Deleted)
+                {
+                    SayTo(from, "You have already given me all the Poison fungus necessary to weave the spell.  Keep these for a later time.");
+                }
+            }
+
+            return false;
+        }
