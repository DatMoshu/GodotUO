+                {
+                    var member = info.Mobile;
+
+                    if (member != from && member.Map == Map.Felucca && member.Region == from.Region)
+                    {
+                        member.SendGump(new ZuleikaPartyGump(from, member), true);
+                    }
+                }
+            }
