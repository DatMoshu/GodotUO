+        public MidasQuest()
+        {
+        }
+
+        public override Type[] TypeReferenceTable => _typeReferenceTable;
+        public override object Name => "Slayer of evil!";
+
+        public override object OfferMessage =>
+            "<i>Nimre starts to speak.</i><BR><BR>Help me slay demons that roam in this cursed dungeon.<BR><BR>Will you aid me?";
+
+        public override TimeSpan RestartDelay => TimeSpan.Zero;
+        public override bool IsTutorial => false;
+        public override int Picture => 0x15A9;
