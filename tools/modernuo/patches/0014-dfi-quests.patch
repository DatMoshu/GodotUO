+    // Holds only reagents. Drop it on any vendor that sells reagents and the vendor offers to top every
+    // reagent of the bag's kind back up to its refill amount, at the vendor's own prices.
+    [SerializationGenerator(0)]
+    public partial class QuestReagentBag : Bag
+    {
+        public enum ReagentBagType
+        {
+            Mage,
+            Necro
+        }
+
+        private static readonly Type[] _mageReagents =
+        [
+            typeof(BlackPearl), typeof(Bloodmoss), typeof(Garlic), typeof(Ginseng), typeof(MandrakeRoot), typeof(Nightshade),
+            typeof(SulfurousAsh), typeof(SpidersSilk)
+        ];
+
+        private static readonly Type[] _necroReagents =
+            [typeof(BatWing), typeof(GraveDust), typeof(DaemonBlood), typeof(NoxCrystal), typeof(PigIron)];
+
+        [SerializableField(0)]
+        [SerializedCommandProperty(AccessLevel.Administrator)]
+        private ReagentBagType _bagType;
+
+        [SerializableField(1)]
+        [SerializedCommandProperty(AccessLevel.Administrator)]
+        private int _refillAmount;
+
+        [Constructible]
+        public QuestReagentBag(ReagentBagType bagType = ReagentBagType.Mage)
+        {
+            _bagType = bagType;
+            _refillAmount = 60 + Utility.Random(7) * 10;
+
+            if (bagType == ReagentBagType.Necro)
+            {
+                Name = "Necromancer Reagent Bag";
+                Hue = 0x482;
+            }
+            else
+            {
+                Name = "Mage Reagent Bag";
+                Hue = 0x1AF;
+            }
+
+            foreach (var type in ReagentTypes)
+            {
+                var reg = type.CreateInstance<Item>();
+                reg.Amount = _refillAmount;
+                DropItem(reg);
+            }
+        }
+
+        public Type[] ReagentTypes => _bagType == ReagentBagType.Necro ? _necroReagents : _mageReagents;
+
+        public override void GetProperties(IPropertyList list)
+        {
+            base.GetProperties(list);
+            list.Add(1070722, "(Refillable)");
+            list.Add(1060660, $"{"refill amount"}\t{_refillAmount}");
+        }
+
+        public override bool OnDragDropInto(Mobile from, Item item, Point3D p) =>
+            CheckItem(from, item) && base.OnDragDropInto(from, item, p);
+
+        public override bool OnDragDrop(Mobile from, Item dropped) => CheckItem(from, dropped) && base.OnDragDrop(from, dropped);
+
+        private static bool CheckItem(Mobile from, Item item)
+        {
+            if (item is BaseReagent)
+            {
+                return true;
+            }
+
+            from.SendLocalizedMessage(1042474); // The bag rejects that item.
+            return false;
+        }
+
+        public override bool OnDroppedToMobile(Mobile from, Mobile target)
+        {
+            if (target is not BaseVendor vendor || !SellsAnyOf(vendor))
+            {
+                return base.OnDroppedToMobile(from, target);
+            }
+
+            var entries = RefillEntries(vendor);
+            var amount = 0;
+
+            foreach (var entry in entries)
+            {
+                amount += entry.Amount;
+            }
+
+            if (amount <= 0)
+            {
+                vendor.Say("That bag seems to be full.");
+            }
+            else
+            {
+                from.SendGump(new RefillGump(vendor, this, entries), true);
+            }
+
+            // The bag stays with its owner; the vendor only quotes.
+            return false;
+        }
+
+        private bool SellsAnyOf(BaseVendor vendor)
+        {
+            foreach (var type in ReagentTypes)
+            {
+                if (PriceAt(vendor, type) > 0)
+                {
+                    return true;
+                }
+            }
+
+            return false;
+        }
+
+        public static int PriceAt(BaseVendor vendor, Type type)
+        {
+            foreach (var info in vendor.GetBuyInfo())
+            {
+                if (info is GenericBuyInfo gbi && gbi.Type == type)
+                {
+                    return gbi.Price;
+                }
+            }
+
+            return 0;
+        }
+
+        public List<RefillEntry> RefillEntries(BaseVendor vendor)
+        {
+            var list = new List<RefillEntry>();
+
+            foreach (var type in ReagentTypes)
+            {
+                var held = 0;
+
+                foreach (var item in Items)
+                {
+                    if (item.GetType() == type)
+                    {
+                        held += item.Amount;
+                    }
+                }
+
+                list.Add(new RefillEntry(type, Math.Max(0, _refillAmount - held), PriceAt(vendor, type)));
+            }
+
+            return list;
+        }
+
+        public void Refill(List<RefillEntry> entries)
+        {
+            foreach (var entry in entries)
+            {
+                if (entry.Amount <= 0 || entry.Price <= 0)
+                {
+                    continue;
+                }
+
+                Item stack = null;
+
+                foreach (var item in Items)
+                {
+                    if (item.GetType() == entry.Type)
+                    {
+                        stack = item;
+                        break;
+                    }
+                }
+
+                if (stack != null)
+                {
+                    stack.Amount += entry.Amount;
+                }
+                else
+                {
+                    var reg = entry.Type.CreateInstance<Item>();
+                    reg.Amount = entry.Amount;
+                    DropItem(reg);
+                }
+            }
+        }
+    }
+
+    public record RefillEntry(Type Type, int Amount, int Price)
+    {
+        public bool VendorSells => Price > 0;
+        public int TotalCost => VendorSells ? Amount * Price : 0;
+    }
+
+    public class RefillGump : DynamicGump
+    {
+        private readonly BaseVendor _vendor;
+        private readonly QuestReagentBag _bag;
+        private readonly List<RefillEntry> _entries;
+        private readonly int _price;
+
+        public RefillGump(BaseVendor vendor, QuestReagentBag bag, List<RefillEntry> entries) : base(50, 50)
+        {
+            _vendor = vendor;
+            _bag = bag;
+            _entries = entries;
+
+            foreach (var entry in entries)
+            {
+                _price += entry.TotalCost;
+            }
+        }
+
+        public override bool Singleton => true;
+
+        protected override void BuildLayout(ref DynamicGumpBuilder builder)
+        {
+            builder.AddPage();
+            builder.AddBackground(0, 0, 453, 285, 2620);
+            builder.AddAlphaRegion(4, 7, 443, 271);
+            builder.AddLabel(140, 13, 955, $"Refill {_bag.Name}");
+            builder.AddLabel(22, 45, 955, "Reagents");
+            builder.AddLabel(106, 45, 955, "Amount to refill");
+            builder.AddLabel(239, 45, 955, "Cost per reagent");
+            builder.AddLabel(371, 45, 955, "Total Cost");
+            builder.AddButton(410, 250, 4017, 4018, 0);
+
+            for (var i = 0; i < _entries.Count; ++i)
+            {
+                var entry = _entries[i];
+                var y = 70 + i * 20;
+                builder.AddLabel(22, y, 955, entry.Type.Name);
+
+                if (entry.VendorSells)
+                {
+                    builder.AddLabel(147, y, 955, $"{entry.Amount}");
+                    builder.AddLabel(277, y, 955, $"{entry.Price} gp");
+                    builder.AddLabel(380, y, 955, $"{entry.TotalCost} gp");
+                }
+                else
+                {
+                    builder.AddLabel(147, y, 955, "*Vendor does not sell this item*");
+                }
+            }
+
+            if (_price > 0)
+            {
+                builder.AddLabel(100, 229, 955, $"Do you want to refill your bag for {_price} gp?");
+                builder.AddButton(210, 250, 4023, 4024, 1);
+            }
+        }
+
+        public override void OnResponse(NetState sender, in RelayInfo info)
+        {
+            var from = sender.Mobile;
+
+            if (info.ButtonID != 1 || _bag.Deleted || _vendor.Deleted)
+            {
+                return;
+            }
+
+            if (!from.InRange(_vendor, 10))
+            {
+                from.SendLocalizedMessage(500295); // You are too far away to do that.
+                return;
+            }
+
+            var entries = _bag.RefillEntries(_vendor);
+            var cost = 0;
+
+            foreach (var entry in entries)
+            {
+                cost += entry.TotalCost;
+            }
+
+            if (cost != _price)
+            {
+                _vendor.SayTo(from, "Seems like you have changed the reagents in your bag!");
+                _vendor.SayTo(from, "I will not refill your bag to that price anymore!");
+                return;
+            }
+
+            if (from.Backpack?.ConsumeTotal(typeof(Gold), cost) == true)
+            {
+                from.SendMessage($"{cost} gp has been removed from your backpack.");
+            }
+            else if (Banker.Withdraw(from, cost))
+            {
+                from.SendLocalizedMessage(1060398, $"{cost}"); // ~1_AMOUNT~ gold has been withdrawn from your bank box.
+            }
+            else
+            {
+                _vendor.SayTo(from, 500192); // Begging thy pardon, but thou casnt afford that.
+                return;
+            }
+
+            _bag.Refill(entries);
+        }
+    }
