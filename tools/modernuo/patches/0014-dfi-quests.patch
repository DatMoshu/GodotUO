@@ -0,0 +1,307 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Text.Json;
+using Server;
+using Server.Custom.Dfi;
+using Server.Engines.Quests.ElderWizard;
+using Server.Engines.Quests.Midas;
+using Server.Engines.Quests.Plague;
+using Server.Engines.Spawners;
+using Server.Items;
+using Server.Misc;
+using Server.Mobiles;
+using Xunit;
+
+namespace UOContent.Tests.Custom;
+
+[Collection("Sequential UOContent Tests")]
+public class DfiQuestTests : IDisposable
+{
+    private readonly List<IEntity> _created = new();
+
+    public DfiQuestTests()
+    {
+        if (NameList.GetNameList("male") == null)
+        {
+            NameList.Configure();
+        }
+    }
+
+    public static TheoryData<Type> Types =>
+    [
+        typeof(Zuleika), typeof(ThePlague), typeof(PlagueSummoningAltar), typeof(PoisonFungus), typeof(PlagueChest),
+        typeof(PlaguedSkull), typeof(BookOfLostKnowledge), typeof(BowOfWeakening), typeof(GlovesOfTheLepracon),
+        typeof(GrizzlysCourage), typeof(MidasQuestGiver), typeof(Behemoth), typeof(DragonClenchingClaws), typeof(MidasTouch),
+        typeof(Necronomicon), typeof(YetisPads), typeof(GabrielleTheElderWizard), typeof(MandrakeQuestReagent),
+        typeof(GarlicQuestReagent), typeof(NightShadeQuestReagent), typeof(GinsengQuestReagent), typeof(RarePlantsBook),
+        typeof(QuestReagentBag), typeof(SunArms), typeof(SunChest), typeof(SunGloves), typeof(SunGorget), typeof(SunHelm),
+        typeof(SunLegs), typeof(EvilOrcHelm)
+    ];
+
+    public void Dispose()
+    {
+        foreach (var e in _created)
+        {
+            e?.Delete();
+        }
+
+        _created.Clear();
+    }
+
+    private T Track<T>(T e) where T : IEntity
+    {
+        _created.Add(e);
+        return e;
+    }
+
+    private PlayerMobile Player(Point3D at)
+    {
+        var m = Track(new PlayerMobile());
+        m.Player = true;
+        m.RawStr = 100;
+        m.RawDex = 100;
+        m.RawInt = 100;
+        m.Body = 0x190;
+        m.AddItem(new Backpack());
+        m.MoveToWorld(at, Map.Felucca);
+        return m;
+    }
+
+    [Theory]
+    [MemberData(nameof(Types))]
+    public void Type_Constructs(Type type)
+    {
+        var entity = Track(type.CreateInstance<IEntity>());
+
+        Assert.False(entity.Deleted);
+    }
+
+    [Fact]
+    public void Plagued_IsGreenStrongerAndNeverAlsoElder()
+    {
+        var rat = Track(new GiantRat());
+        var hits = rat.HitsMaxSeed;
+
+        DfiVariants.MakePlagued(rat);
+        DfiVariants.MakeElder(rat);
+
+        Assert.True(DfiVariants.IsPlagued(rat));
+        Assert.False(DfiVariants.IsElder(rat));
+        Assert.Equal(DfiVariants.PlagueHue, rat.Hue);
+        Assert.Equal(hits * 2, rat.HitsMaxSeed);
+    }
+
+    [Fact]
+    public void Plague_NeverRisesOutsideFeluccaDungeons()
+    {
+        var rat = Track(new GiantRat());
+
+        for (var i = 0; i < 200; i++)
+        {
+            Assert.False(DfiVariants.CheckPlague(rat, new Point3D(1500, 1600, 0), Map.Felucca));
+            Assert.False(DfiVariants.CheckPlague(rat, new Point3D(5200, 1470, 0), Map.Trammel));
+        }
+    }
+
+    [Theory]
+    [InlineData(500, 1, 1)]
+    [InlineData(5000, 5, 10)]
+    [InlineData(20000, 20, 25)]
+    public void PoisonFungus_ScalesWithFame(int fame, int min, int max)
+    {
+        for (var i = 0; i < 20; i++)
+        {
+            Assert.InRange(DfiVariants.PoisonFungusAmount(fame), min, max);
+        }
+    }
+
+    [Fact]
+    public void Zuleika_CountsFungusToTwoHundredAndKeepsTheRest()
+    {
+        var player = Player(new Point3D(2709, 2165, 0));
+        var zuleika = Track(new Zuleika { Altar = Track(new PlagueSummoningAltar()) });
+        zuleika.MoveToWorld(new Point3D(2709, 2163, 0), Map.Felucca);
+
+        var qs = new ThePlagueQuest(zuleika, player);
+        player.Quest = qs;
+        qs.AddObjective(new CollectFungusObjective());
+
+        var first = Track(new PoisonFungus(150));
+        Assert.False(zuleika.OnDragDrop(player, first));
+        Assert.True(first.Deleted);
+
+        var obj = qs.FindObjective(typeof(CollectFungusObjective));
+        Assert.Equal(150, obj.CurProgress);
+
+        var second = Track(new PoisonFungus(80));
+        player.Backpack.DropItem(second);
+        zuleika.OnDragDrop(player, second);
+
+        Assert.True(obj.Completed);
+        Assert.Equal(30, second.Amount);
+    }
+
+    [Fact]
+    public void Midas_SixRoundsEndInARewardBag()
+    {
+        var player = Player(new Point3D(5436, 1162, 0));
+        var nimre = Track(new MidasQuestGiver());
+        nimre.MoveToWorld(new Point3D(5436, 1160, 0), Map.Felucca);
+
+        var qs = new MidasQuest(player);
+        player.Quest = qs;
+        new SlayConversation(0) { System = qs }.OnRead();
+
+        Type[] kills = [typeof(DarknightCreeper), typeof(FleshRenderer), typeof(Impaler), typeof(ShadowKnight), typeof(AbysmalHorror), typeof(DemonKnight)];
+
+        for (var round = 0; round < kills.Length; round++)
+        {
+            var slay = Assert.IsType<SlayObjective>(qs.Objectives[^1]);
+            Assert.Equal(round, slay.Round);
+
+            slay.OnKill(Track(new Mongbat()), null);
+            Assert.False(slay.Completed);
+
+            slay.OnKill(Track(kills[round].CreateInstance<BaseCreature>()), null);
+            Assert.True(slay.Completed);
+
+            nimre.OnTalk(player, false);
+
+            if (round < kills.Length - 1)
+            {
+                Assert.IsType<SlayConversation>(qs.Conversations[^1]).OnRead();
+            }
+            else
+            {
+                Assert.IsType<Server.Engines.Quests.Midas.EndConversation>(qs.Conversations[^1]).OnRead();
+            }
+        }
+
+        Assert.Null(player.Quest);
+        Assert.NotNull(player.Backpack.FindItemByType<Bag>());
+    }
+
+    [Fact]
+    public void ElderWizard_PlantCountsOnlyWhenItIsTheOneWanted()
+    {
+        var player = Player(new Point3D(2171, 1334, 0));
+        var qs = new ElderWizardQuest(player);
+        player.Quest = qs;
+        qs.AddObjective(new FindPlantObjective(0));
+
+        var garlic = Track(new GarlicQuestReagent());
+        garlic.MoveToWorld(new Point3D(2171, 1333, 0), Map.Felucca);
+        garlic.OnDoubleClick(player);
+
+        var obj = (FindPlantObjective)qs.FindObjective(typeof(FindPlantObjective));
+        Assert.Equal(0, obj.CurProgress);
+
+        var mandrake = Track(new MandrakeQuestReagent());
+        mandrake.MoveToWorld(new Point3D(2171, 1333, 0), Map.Felucca);
+        mandrake.OnDoubleClick(player);
+
+        Assert.Equal(1, obj.CurProgress);
+        Assert.Equal(3254, mandrake.ItemID);
+
+        mandrake.OnDoubleClick(player);
+        Assert.Equal(1, obj.CurProgress);
+    }
+
+    [Fact]
+    public void ReagentBag_RefillsWhatIsMissingAtTheVendorsPrices()
+    {
+        var mage = Track(new Mage());
+        var bag = Track(new QuestReagentBag());
+        var full = bag.RefillAmount;
+
+        var pearl = bag.FindItemByType<BlackPearl>();
+        pearl.Amount = 10;
+
+        var entries = bag.RefillEntries(mage);
+        var pearlEntry = entries.Find(e => e.Type == typeof(BlackPearl));
+
+        Assert.Equal(full - 10, pearlEntry.Amount);
+        Assert.True(pearlEntry.Price > 0);
+
+        bag.Refill(entries);
+
+        Assert.Equal(full, bag.FindItemByType<BlackPearl>().Amount);
+        Assert.All(bag.RefillEntries(mage), e => Assert.Equal(0, e.Amount));
+    }
+
+    [Fact]
+    public void ReagentBag_RejectsAnythingButReagents()
+    {
+        var player = Player(new Point3D(1500, 1600, 0));
+        var bag = Track(new QuestReagentBag(QuestReagentBag.ReagentBagType.Necro));
+
+        Assert.False(bag.OnDragDrop(player, Track(new Gold(10))));
+        Assert.Equal(QuestReagentBag.ReagentBagType.Necro, bag.BagType);
+    }
+
+    [Fact]
+    public void SunArmor_FullSetGivesTheLegs900Luck()
+    {
+        var player = Player(new Point3D(1500, 1600, 0));
+        // The test server loads no tiledata, so the pieces get their layers here.
+        var legs = Track(new SunLegs { Layer = Layer.Pants });
+
+        foreach (var piece in (BaseArmor[])
+                 [
+                     new SunHelm { Layer = Layer.Helm }, new SunChest { Layer = Layer.InnerTorso },
+                     new SunGorget { Layer = Layer.Neck }, new SunArms { Layer = Layer.Arms },
+                     new SunGloves { Layer = Layer.Gloves }
+                 ])
+        {
+            Track(piece);
+            Assert.True(player.EquipItem(piece));
+        }
+
+        Assert.Equal(0, legs.Attributes.Luck);
+
+        player.EquipItem(legs);
+        Assert.Equal(900, legs.Attributes.Luck);
+
+        var helm = player.FindItemOnLayer(Layer.Helm);
+        player.AddToBackpack(helm);
+        Assert.Equal(0, legs.Attributes.Luck);
+
+        player.EquipItem(helm);
+        Assert.Equal(900, legs.Attributes.Luck);
+    }
+
+    [Fact]
+    public void EvilOrcHelm_TakesFromTheWearersHigherStat()
+    {
+        var player = Player(new Point3D(1500, 1600, 0));
+        player.RawInt = 80;
+        player.RawDex = 40;
+        var helm = Track(new EvilOrcHelm { Layer = Layer.Helm });
+
+        Assert.True(player.EquipItem(helm));
+
+        Assert.Equal(10, helm.Attributes.BonusStr);
+        Assert.Equal(-10, helm.Attributes.BonusInt);
+        Assert.Equal(0, helm.Attributes.BonusDex);
+    }
+
+    [Fact]
+    public void RarePlantsFile_PlacesEveryPlantKind()
+    {
+        var path = Path.Combine(Core.BaseDirectory, "Data", "Spawns", "dfi", "dfi-rare-plants.json");
+        var dtos = JsonSerializer.Deserialize<List<SpawnerDto>>(File.ReadAllText(path), SpawnerJsonSerializer.Options);
+        var kinds = new HashSet<string>();
+
+        foreach (var dto in dtos)
+        {
+            foreach (var entry in dto.EntryView)
+            {
+                Assert.NotNull(AssemblyHandler.FindTypeByName(entry.SpawnedName));
+                kinds.Add(entry.SpawnedName);
+            }
+        }
+
+        Assert.Equal(FindPlantObjective.Plants.Length, kinds.Count);
+    }
+}
