index 000000000..453995b62
--- /dev/null
+++ b/Projects/UOContent/Custom/DFI/Items/SunArmor.cs
@@ -0,0 +1,264 @@
+// DFI Network's Armor of the Sun and evil orc helm, ported from DFI RUNUO Scripts/Custom/Items/Armor/Sun Armor and
+// Custom/Items/Misc/EvilOrcHelm.cs, with the drops DFI added to TreasureMap.cs, BaseChampion.cs, OrcBrute.cs and
+// OrcishLord.cs.
+
+using ModernUO.CodeGeneratedEvents;
+using ModernUO.Serialization;
+using Server.Items;
+using Server.Misc;
+using Server.Mobiles;
+using Server.Spells;
+
+namespace Server.Custom.Dfi
+{
+    public static class SunArmor
+    {
+        public const int Hue = 2213;
+
+        public static BaseArmor CreateRandomPiece() =>
+            Utility.Random(6) switch
+            {
+                0 => new SunChest(),
+                1 => new SunGloves(),
+                2 => new SunArms(),
+                3 => new SunLegs(),
+                4 => new SunGorget(),
+                _ => new SunHelm()
+            };
+
+        // A dug treasure chest may raise a Sun Guardian among its guardians, one in 80 times the map level
+        // (at least two), carrying a piece of the Armor of the Sun.
+        public static void CheckSunGuardian(int level, TreasureMapChest chest)
+        {
+            if (chest?.Map == null || Utility.Random(80) >= System.Math.Max(2, level))
+            {
+                return;
+            }
+
+            var bc = TreasureMap.Spawn(level, chest.Location, chest.Map, null, true);
+
+            if (bc == null)
+            {
+                return;
+            }
+
+            chest.Guardians.Add(bc);
+            bc.Hue = Hue;
+            bc.Title = "The Sun Guardian";
+            bc.PackItem(CreateRandomPiece());
+        }
+
+        // A champion slain in the Lost Lands carries a piece six times in ten; orc brutes carry an evil orc
+        // helm one time in ten, orcish lords one in twenty.
+        [OnEvent(nameof(CreatureEvents.CreatureDeathEvent))]
+        public static void OnCreatureDeath(BaseCreature bc)
+        {
+            if (bc.Corpse is not Container c || bc.Controlled || bc.Summoned)
+            {
+                return;
+            }
+
+            switch (bc)
+            {
+                case BaseChampion when SpellHelper.IsFeluccaT2A(bc.Map, bc.Location) && Utility.RandomDouble() < 0.6:
+                    {
+                        c.DropItem(CreateRandomPiece());
+                        break;
+                    }
+                case OrcBrute when Utility.RandomDouble() < 0.1:
+                case OrcishLord when Utility.RandomDouble() < 0.05:
+                    {
+                        c.DropItem(new EvilOrcHelm());
+                        break;
+                    }
+            }
+        }
+    }
+}
+
+namespace Server.Items
+{
+    // Five pieces with three or four magic properties each; wearing all six gives the legs 900 luck.
+    [SerializationGenerator(0)]
+    public abstract partial class BaseSunArmor : BaseArmor
+    {
+        public BaseSunArmor(int itemID, double weight) : base(itemID)
+        {
+            Hue = Server.Custom.Dfi.SunArmor.Hue;
+            Weight = weight;
+            BaseRunicTool.ApplyAttributesTo(this, Utility.RandomMinMax(3, 4), 40, 80);
+            Attributes.Luck = 0;
+        }
+
+        public override int BasePhysicalResistance => 6;
+        public override int BaseFireResistance => 6;
+        public override int BaseColdResistance => 6;
+        public override int BasePoisonResistance => 6;
+        public override int BaseEnergyResistance => 6;
+        public override int InitMinHits => 30;
+        public override int InitMaxHits => 40;
+        public override int AosStrReq => 20;
+        public override int OldStrReq => 10;
+        public override int ArmorBase => 13;
+        public override ArmorMaterialType MaterialType => ArmorMaterialType.Dragon;
+        public override ArmorMeditationAllowance DefMedAllowance => ArmorMeditationAllowance.All;
+        public override string DefaultName => "Armor of the Sun";
+
+        private static readonly Layer[] _setLayers = [Layer.Helm, Layer.InnerTorso, Layer.Neck, Layer.Pants, Layer.Arms, Layer.Gloves];
+
+        public override bool OnEquip(Mobile from)
+        {
+            var ok = base.OnEquip(from);
+
+            // The legs carry the set's luck; OnEquip runs before the piece is on, so count this one in.
+            if (ok && from.FindItemOnLayer(Layer.Pants) is SunLegs legs)
+            {
+                var full = true;
+
+                foreach (var layer in _setLayers)
+                {
+                    if (layer != Layer && from.FindItemOnLayer(layer) is not BaseSunArmor)
+                    {
+                        full = false;
+                        break;
+                    }
+                }
+
+                legs.Attributes.Luck = full ? 900 : 0;
+            }
+            else if (ok && this is SunLegs && WearsAllButLegs(from))
+            {
+                Attributes.Luck = 900;
+            }
+
+            return ok;
+        }
+
+        private static bool WearsAllButLegs(Mobile m)
+        {
+            foreach (var layer in _setLayers)
+            {
+                if (layer != Layer.Pants && m.FindItemOnLayer(layer) is not BaseSunArmor)
+                {
+                    return false;
+                }
+            }
+
+            return true;
+        }
+
+        public override void OnRemoved(IEntity parent)
+        {
+            base.OnRemoved(parent);
+
+            if (this is SunLegs)
+            {
+                Attributes.Luck = 0;
+            }
+            else if (parent is Mobile m && m.FindItemOnLayer(Layer.Pants) is SunLegs legs)
+            {
+                legs.Attributes.Luck = 0;
+            }
+        }
+    }
+
+    [SerializationGenerator(0)]
+    [Flippable(0x2657, 0x2658)]
+    public partial class SunArms : BaseSunArmor
+    {
+        [Constructible]
+        public SunArms() : base(0x2657, 5.0)
+        {
+        }
+    }
+
+    // DFI's SunArmor (the tunic), named SunChest so it does not clash with the SunArmor drop helper.
+    [SerializationGenerator(0)]
+    [Flippable(0x2641, 0x2642)]
+    public partial class SunChest : BaseSunArmor
+    {
+        [Constructible]
+        public SunChest() : base(0x2641, 10.0)
+        {
+        }
+    }
+
+    [SerializationGenerator(0)]
+    [Flippable(0x2643, 0x2644)]
+    public partial class SunGloves : BaseSunArmor
+    {
+        [Constructible]
+        public SunGloves() : base(0x2643, 2.0)
+        {
+        }
+    }
+
+    [SerializationGenerator(0)]
+    public partial class SunGorget : BaseSunArmor
+    {
+        [Constructible]
+        public SunGorget() : base(0x13C7, 1.0)
+        {
+        }
+    }
+
+    [SerializationGenerator(0)]
+    public partial class SunHelm : BaseSunArmor
+    {
+        [Constructible]
+        public SunHelm() : base(0x2645, 5.0)
+        {
+        }
+    }
+
+    [SerializationGenerator(0)]
+    public partial class SunLegs : BaseSunArmor
+    {
+        [Constructible]
+        public SunLegs() : base(0x2647, 6.0)
+        {
+        }
+    }
+
+    // +10 strength, and -10 to whichever of dexterity or intelligence is the wearer's higher; an evil act.
+    [SerializationGenerator(0)]
+    public partial class EvilOrcHelm : OrcHelm
+    {
+        [Constructible]
+        public EvilOrcHelm()
+        {
+            Hue = 0x96E;
+            Attributes.BonusStr = 10;
+            Attributes.BonusInt = -10;
+            Attributes.BonusDex = -10;
+        }
+
+        public override int LabelNumber => 1062021; // an evil orc helm
+
+        public override bool OnEquip(Mobile from)
+        {
+            if (from.RawInt > from.RawDex)
+            {
+                Attributes.BonusDex = 0;
+            }
+            else
+            {
+                Attributes.BonusInt = 0;
+            }
+
+            Titles.AwardKarma(from, -22, true);
+            return base.OnEquip(from);
+        }
+
+        public override void OnRemoved(IEntity parent)
+        {
+            base.OnRemoved(parent);
+
+            if (parent is Mobile)
+            {
+                Attributes.BonusInt = -10;
+                Attributes.BonusDex = -10;
+            }
+        }
+    }
+}
diff --git a/Projects/UOContent/Custom/DFI/Quests/DfiQuestsGen.cs b/Projects/UOContent/Custom/DFI/Quests/DfiQuestsGen.cs
new file mode 100644
index 000000000..019b3589b
--- /dev/null
+++ b/Projects/UOContent/Custom/DFI/Quests/DfiQuestsGen.cs
@@ -0,0 +1,101 @@
+// Places the quest givers and the Plague's altar. Nimre stands where DFI's last world save had him; Gabrielle
+// in Buccaneer's Den, where DFI's hint gump put the Elder Wizard; Zuleika beside her (DFI's saves kept no
+// Zuleika). The Plague's altar is in the Alternate Dimension, the spiral halls on Trammel Zuleika sends players
+// to, with a passage back. The rare plants come from Data/Spawns/dfi/dfi-rare-plants.json.
+
+using System.Collections.Generic;
+using Server.Commands;
+using Server.Engines.Quests.ElderWizard;
+using Server.Engines.Quests.Midas;
+using Server.Engines.Quests.Plague;
+using Server.Items;
+using Server.Logging;
+using Server.Mobiles;
+
+namespace Server.Custom.Dfi;
+
+public static class DfiQuestsGen
+{
+    private static readonly ILogger logger = LogFactory.GetLogger(typeof(DfiQuestsGen));
+
+    public static readonly Point3D GabrielleSpot = new(2703, 2163, 0);
+    public static readonly Point3D ZuleikaSpot = new(2709, 2163, 0);
+    public static readonly Point3D[] NimreSpots = [new(5436, 1160, 0), new(5489, 1100, 0)];
+
+    public static readonly Point3D PlagueAltar = new(6083, 451, -2);
+    public static readonly Point3D AlternateDimensionExit = new(6074, 460, -22);
+
+    public static void Configure()
+    {
+        CommandSystem.Register("DfiQuests", AccessLevel.Administrator, OnCommand);
+    }
+
+    [Usage("DfiQuests")]
+    [Description("Places DFI's quest givers (Gabrielle, Zuleika, Nimre) and the Plague's altar, replacing any placed before.")]
+    private static void OnCommand(CommandEventArgs e)
+    {
+        var removed = Remove();
+        var placed = Place();
+        e.Mobile.SendMessage($"DfiQuests: removed {removed}, placed {placed}.");
+        logger.Information("{User} placed {Placed} DFI quest fixtures ({Removed} removed)", e.Mobile, placed, removed);
+    }
+
+    public static int Remove()
+    {
+        var doomed = new List<IEntity>();
+
+        foreach (var m in World.Mobiles.Values)
+        {
+            if (m is GabrielleTheElderWizard or Zuleika or MidasQuestGiver)
+            {
+                doomed.Add(m);
+            }
+        }
+
+        foreach (var item in World.Items.Values)
+        {
+            if (item is PlagueSummoningAltar ||
+                item is CursedCavePassage && item.Map == Map.Trammel && item.Location == AlternateDimensionExit)
+            {
+                doomed.Add(item);
+            }
+        }
+
+        foreach (var entity in doomed)
+        {
+            entity.Delete();
+        }
+
+        return doomed.Count;
+    }
+
+    public static int Place()
+    {
+        var placed = 0;
+
+        var altar = new PlagueSummoningAltar();
+        altar.MoveToWorld(PlagueAltar, Map.Trammel);
+        altar.IsActive = true;
+        placed++;
+
+        new CursedCavePassage(new Point3D(2706, 2165, 0)) { Name = "a way back to Buccaneer's Den" }.MoveToWorld(AlternateDimensionExit, Map.Trammel);
+        placed++;
+
+        Put(new GabrielleTheElderWizard(), GabrielleSpot);
+        Put(new Zuleika { Altar = altar }, ZuleikaSpot);
+
+        foreach (var spot in NimreSpots)
+        {
+            Put(new MidasQuestGiver(), spot);
+        }
+
+        return placed + 2 + NimreSpots.Length;
+    }
+
+    private static void Put(BaseCreature npc, Point3D at)
+    {
+        npc.Home = at;
+        npc.RangeHome = 2;
+        npc.MoveToWorld(at, Map.Felucca);
+    }
+}
diff --git a/Projects/UOContent/Custom/DFI/Quests/DfiVariants.cs b/Projects/UOContent/Custom/DFI/Quests/DfiVariants.cs
new file mode 100644
index 000000000..9d077eccc
--- /dev/null
+++ b/Projects/UOContent/Custom/DFI/Quests/DfiVariants.cs
@@ -0,0 +1,205 @@
+// DFI Network's plagued and elder creatures, ported from DFI RUNUO Scripts/Custom/Engines/Quest System/Plague/
+// Plague.cs, Custom/Engines/AI/Creature/Elders.cs and the plague and elder loot in Custom/Misc/BaseCreatureLoot.cs
+// and Engines/AI/Creature/BaseCreature.cs.
+
+using System;
+using System.Collections.Generic;
+using ModernUO.CodeGeneratedEvents;
+using Server.Items;
+using Server.Mobiles;
+using Server.Regions;
+
+namespace Server.Custom.Dfi;
+
+// Plagued creatures rise in place of one in twenty new spawns in Felucca's dungeons: green, stronger, and
+// carrying poison fungus for Zuleika's quest and now and then a plague chest. Elders, white and stronger
+// still, come only out of the nests the Elder Wizard's plants hide (DFI never spawned them otherwise).
+// ModernUO's creatures have no flag for either, so the set of them is saved here.
+public class DfiVariants : GenericPersistence
+{
+    public const double PlagueChance = 0.05;
+    public const double PlagueChestChance = 0.10;
+    public const int PlagueHue = 0x558;
+    public const int ElderHue = 0x1B6;
+
+    private static readonly HashSet<BaseCreature> _plagued = [];
+    private static readonly HashSet<BaseCreature> _elders = [];
+
+    // Plagued creatures out of a skull the Plague throws give no plague loot.
+    private static readonly HashSet<BaseCreature> _noPlagueLoot = [];
+
+    public DfiVariants() : base("DfiVariants", 10)
+    {
+    }
+
+    public static void Configure()
+    {
+        _ = new DfiVariants();
+    }
+
+    public static bool IsPlagued(BaseCreature bc) => _plagued.Contains(bc);
+    public static bool IsElder(BaseCreature bc) => _elders.Contains(bc);
+
+    public static bool CheckPlague(BaseCreature bc, Point3D location, Map map) =>
+        map == Map.Felucca && bc is not (BaseChampion or Harrower or BaseVendor) && !bc.IsParagon &&
+        Region.Find(location, map) is DungeonRegion && Utility.RandomDouble() < PlagueChance;
+
+    public static void MakePlagued(BaseCreature bc, bool plagueLoot = true)
+    {
+        if (bc.IsParagon || IsPlagued(bc) || IsElder(bc))
+        {
+            return;
+        }
+
+        bc.Hue = PlagueHue;
+        Buff(bc, 2.0, 1.05, 1.10, 1.10, 1.10, 1.10, 1.20, 1.20);
+        _plagued.Add(bc);
+
+        if (!plagueLoot)
+        {
+            _noPlagueLoot.Add(bc);
+        }
+    }
+
+    public static void MakeElder(BaseCreature bc)
+    {
+        if (bc.IsParagon || IsPlagued(bc) || IsElder(bc))
+        {
+            return;
+        }
+
+        bc.Hue = ElderHue;
+        Buff(bc, 5.0, 1.05, 1.20, 1.20, 1.20, 1.20, 1.40, 1.40);
+        _elders.Add(bc);
+    }
+
+    private static void Buff(
+        BaseCreature bc, double hits, double str, double intel, double dex, double skills, double speed, double fame,
+        double karma
+    )
+    {
+        bc.HitsMaxSeed = (int)(bc.HitsMaxSeed * hits);
+        bc.RawStr = (int)(bc.RawStr * str);
+        bc.RawInt = (int)(bc.RawInt * intel);
+        bc.RawDex = (int)(bc.RawDex * dex);
+        bc.Hits = bc.HitsMax;
+
+        for (var i = 0; i < bc.Skills.Length; i++)
+        {
+            var skill = bc.Skills[i];
+
+            if (skill.Base > 0.0)
+            {
+                skill.Base *= skills;
+            }
+        }
+
+        bc.SetSpeed(bc.ActiveSpeed / speed, bc.PassiveSpeed / speed);
+        bc.DamageMin += 5;
+        bc.DamageMax += 5;
+
+        if (bc.Fame > 0)
+        {
+            bc.Fame = (int)(bc.Fame * fame);
+        }
+
+        if (bc.Karma != 0)
+        {
+            bc.Karma = (int)(bc.Karma * karma);
+        }
+    }
+
+    public static int PoisonFungusAmount(int fame)
+    {
+        var amount = fame / 1000;
+        return amount > 1 ? Utility.RandomMinMax(amount, amount + 5) : 1;
+    }
+
+    // DFI put the fungus on the corpse when it was carved; here it is on the corpse from the start.
+    [OnEvent(nameof(CreatureEvents.CreatureDeathEvent))]
+    public static void OnCreatureDeath(BaseCreature bc)
+    {
+        var plagued = _plagued.Remove(bc);
+        var elder = _elders.Remove(bc);
+        var loot = !_noPlagueLoot.Remove(bc);
+
+        if (!plagued && !elder || bc.Controlled || bc.Summoned || bc.NoKillAwards || bc.Corpse is not Container c)
+        {
+            return;
+        }
+
+        if (plagued && loot)
+        {
+            c.DropItem(new PoisonFungus(PoisonFungusAmount(bc.Fame)));
+
+            if (bc.TreasureMapLevel >= 0 && Utility.RandomDouble() < PlagueChestChance)
+            {
+                c.DropItem(new PlagueChest(bc.Name, bc.TreasureMapLevel));
+            }
+
+            DfiLoot.AddMoreLoot(bc, c, false, 1000, 1);
+            ScaleGold(c, 1.50);
+        }
+        else if (elder)
+        {
+            DfiLoot.AddMoreLoot(bc, c, false, 1000, 1);
+            ScaleGold(c, 1.60);
+        }
+    }
+
+    private static void ScaleGold(Container c, double factor)
+    {
+        if (c.FindItemByType<Gold>() is { } gold)
+        {
+            gold.Amount = Math.Max(1, (int)(gold.Amount * factor));
+        }
+    }
+
+    [OnEvent(nameof(CreatureEvents.CreatureDeletedEvent))]
+    public static void OnCreatureDeleted(BaseCreature bc)
+    {
+        _plagued.Remove(bc);
+        _elders.Remove(bc);
+        _noPlagueLoot.Remove(bc);
+    }
+
+    public override void Serialize(IGenericWriter writer)
+    {
+        writer.WriteEncodedInt(0); // version
+        Write(writer, _plagued);
+        Write(writer, _elders);
+        Write(writer, _noPlagueLoot);
+    }
+
+    private static void Write(IGenericWriter writer, HashSet<BaseCreature> set)
+    {
+        set.RemoveWhere(bc => bc.Deleted);
+        writer.WriteEncodedInt(set.Count);
+
+        foreach (var bc in set)
+        {
+            writer.Write(bc);
+        }
+    }
+
+    public override void Deserialize(IGenericReader reader)
+    {
+        reader.ReadEncodedInt(); // version
+        Read(reader, _plagued);
+        Read(reader, _elders);
+        Read(reader, _noPlagueLoot);
+    }
+
+    private static void Read(IGenericReader reader, HashSet<BaseCreature> set)
+    {
+        var count = reader.ReadEncodedInt();
+
+        for (var i = 0; i < count; i++)
+        {
+            if (reader.ReadEntity<BaseCreature>() is { } bc)
+            {
+                set.Add(bc);
+            }
+        }
+    }
+}
diff --git a/Projects/UOContent/Custom/DFI/Quests/ElderWizardQuest.cs b/Projects/UOContent/Custom/DFI/Quests/ElderWizardQuest.cs
new file mode 100644
index 000000000..7822da327
--- /dev/null
+++ b/Projects/UOContent/Custom/DFI/Quests/ElderWizardQuest.cs
@@ -0,0 +1,788 @@
+// DFI Network's Elder Wizard quest, ported from DFI RUNUO Scripts/Custom/Engines/Quest System/ElderWizard.
+
+using System;
+using System.Collections.Generic;
+using ModernUO.Serialization;
+using Server.Custom.Dfi;
+using Server.Engines.Quests.CursedCave;
+using Server.Gumps;
+using Server.Items;
+using Server.Mobiles;
+using Server.Network;
+
+namespace Server.Engines.Quests.ElderWizard
+{
+    // Gabrielle hands the player Edwin's plant book and sends them for four of each of four rare roots, one
+    // kind after another; the reward is a reagent bag any reagent vendor refills.
+    public class ElderWizardQuest : DfiQuestSystem
+    {
+        private static readonly Type[] _typeReferenceTable =
+        [
+            typeof(AcceptConversation),
+            typeof(DuringFindPlantConversation),
+            typeof(DontOfferConversation),
+            typeof(EndConversation),
+            typeof(FindPlantObjective),
+            typeof(ReportBackObjective)
+        ];
+
+        public ElderWizardQuest(PlayerMobile from) : base(from)
+        {
+        }
+
+        public ElderWizardQuest()
+        {
+        }
+
+        public override Type[] TypeReferenceTable => _typeReferenceTable;
+        public override object Name => "Elder Wizard";
+
+        public override object OfferMessage =>
+            "<I>The Elder Wizard looks busy sorting some strange looking plants as you approach her, she turns around and " +
+            "says. </I><BR><BR>Hail traverel!<BR>Would you like to collect some rare plants for me? As reward i can give " +
+            "you a reagent bag that is easy to refill.";
+
+        public override TimeSpan RestartDelay => TimeSpan.Zero;
+        public override bool IsTutorial => false;
+        public override int Picture => 0x15C9;
+
+        public override void Accept()
+        {
+            base.Accept();
+            From.Backpack?.DropItem(new RarePlantsBook());
+            AddConversation(new AcceptConversation());
+        }
+    }
+
+    public class FindPlantObjective : DfiQuestObjective
+    {
+        public static readonly (Type Plant, string Name, int Amount)[] Plants =
+        [
+            (typeof(MandrakeQuestReagent), "Rare Mandrake Root", 4),
+            (typeof(GarlicQuestReagent), "Rare Garlic Root", 4),
+            (typeof(NightShadeQuestReagent), "Rare Nightshade Root", 4),
+            (typeof(GinsengQuestReagent), "Rare Ginseng Root", 4)
+        ];
+
+        private int _round;
+
+        public FindPlantObjective(int round) => _round = round;
+
+        public FindPlantObjective()
+        {
+        }
+
+        public (Type Plant, string Name, int Amount) Current => Plants[Math.Clamp(_round, 0, Plants.Length - 1)];
+
+        public override string Text => "Find this rare plant for the Elder Wizard.";
+        public override int MaxProgress => Current.Amount;
+
+        public override void OnComplete()
+        {
+            if (_round + 1 >= Plants.Length)
+            {
+                System.AddObjective(new ReportBackObjective());
+            }
+            else
+            {
+                System.AddObjective(new FindPlantObjective(_round + 1));
+            }
+        }
+
+        public override void RenderProgress(ref DynamicGumpBuilder builder)
+        {
+            if (Completed)
+            {
+                base.RenderProgress(ref builder);
+                return;
+            }
+
+            builder.AddHtml(70, 260, 270, 100, Current.Name.Color(0x8CADFF));
+            builder.AddLabel(70, 280, 0x64, $"{CurProgress} / {Current.Amount}");
+        }
+
+        public override void ChildDeserialize(IGenericReader reader)
+        {
+            reader.ReadEncodedInt(); // version
+            _round = reader.ReadEncodedInt();
+
+            if (CurProgress > MaxProgress)
+            {
+                CurProgress = MaxProgress - 1;
+            }
+        }
+
+        public override void ChildSerialize(IGenericWriter writer)
+        {
+            writer.WriteEncodedInt(0); // version
+            writer.WriteEncodedInt(_round);
+        }
+    }
+
+    public class ReportBackObjective : DfiQuestObjective
+    {
+        public override string Text => "Return to the Elder Wizard and tell her that you have found all ingredients.";
+
+        public override void OnComplete()
+        {
+            System.AddConversation(new EndConversation());
+        }
+    }
+
+    public class AcceptConversation : DfiQuestConversation
+    {
+        public override string Text =>
+            "<I>The wizard looks happy as you accept the task.</I><BR><BR>Return to me when you have collected all of the " +
+            "rare plants. The location of these plants can be found in this book.<BR><BR><I>She gives you a book.</I><BR><BR>Good Luck.";
+
+        public override void OnRead()
+        {
+            System.AddObjective(new FindPlantObjective(0));
+        }
+    }
+
+    public class DuringFindPlantConversation : DfiQuestConversation
+    {
+        public override string Text =>
+            "<I>The elder wizard looks up from her cauldron and says...</I><BR><BR>Back so soon..? Have you collected the " +
+            "reagents I told you to? No? Well return here when you have and I will reward you.";
+
+        public override bool Logged => false;
+    }
+
+    public class DontOfferConversation : DfiQuestConversation
+    {
+        public override string Text =>
+            "<I>The elder wizard says...</I><BR><BR>I could use some help, but you seem too busy with another quest. Come " +
+            "and speak with me again when you have completed your present quest.";
+
+        public override bool Logged => false;
+    }
+
+    public class EndConversation : DfiQuestConversation
+    {
+        public override string Text =>
+            "<I>The elder wizard looks happy as you tell her of your completed task.</I><BR><BR>Well done! I did not think " +
+            "you would find all of them!<BR><BR><I>She smiles and takes the reagents from you and place them in a bag.</I>" +
+            "<BR><BR>Here is your reward just as I promised.<BR><BR><I>She gives you a Refillable Reagent Bag.</I><BR><BR>" +
+            "The refillable reagent bag can be easily refilled by any vendor that sells reagents, just drag and drop the bag " +
+            "on the vendor and he will tell you the cost to refill the bag.";
+
+        public override void OnRead()
+        {
+            System.Complete();
+        }
+    }
+
+    // DFI's own shop list was a mage's; ModernUO's mage shop sells the same reagents and scrolls.
+    [SerializationGenerator(0)]
+    public partial class GabrielleTheElderWizard : BaseQuester
+    {
+        [Constructible]
+        public GabrielleTheElderWizard() : base("the Elder Wizard")
+        {
+        }
+
+        public override string DefaultName => "Gabrielle";
+        public override bool ClickTitle => true;
+        public override bool IsActiveVendor => true;
+
+        public override void InitSBInfo()
+        {
+            SBInfos.Add(new SBMage());
+        }
+
+        public override void InitBody()
+        {
+            InitStats(100, 100, 25);
+            Hue = 33770;
+            Female = true;
+            Body = 0x191;
+            HairItemID = 0x203C;
+        }
+
+        public override void InitOutfit()
+        {
+            AddItem(new Robe(0x482));
+            AddItem(new Sandals(0x482));
+            AddItem(new WizardsHat(0x482));
+            AddItem(new BlackStaff { Movable = false });
+        }
+
+        public override void OnTalk(PlayerMobile player, bool contextMenu)
+        {
+            Direction = GetDirectionTo(player);
+
+            var qs = player.Quest;
+
+            if (qs is ElderWizardQuest)
+            {
+                if (qs.IsObjectiveInProgress(typeof(FindPlantObjective)))
+                {
+                    qs.AddConversation(new DuringFindPlantConversation());
+                    return;
+                }
+
+                var obj = qs.FindObjective(typeof(ReportBackObjective));
+
+                if (obj?.Completed != false)
+                {
+                    return;
+                }
+
+                var magery = player.Skills.Magery.Base;
+                var necro = player.Skills.Necromancy.Base;
+                var type = necro > magery || necro == magery && Utility.RandomBool()
+                    ? QuestReagentBag.ReagentBagType.Necro
+                    : QuestReagentBag.ReagentBagType.Mage;
+
+                var bag = new QuestReagentBag(type);
+
+                if (player.PlaceInBackpack(bag))
+                {
+                    obj.Complete();
+                }
+                else
+                {
+                    bag.Delete();
+                    // You need to clear some space in your inventory to continue with the quest.  Come back here when you have more space in your inventory.
+                    player.SendLocalizedMessage(1046260);
+                }
+            }
+            else if (qs != null)
+            {
+                qs.AddConversation(new DontOfferConversation());
+            }
+            else if (QuestSystem.CanOfferQuest(player, typeof(ElderWizardQuest)))
+            {
+                new ElderWizardQuest(player).SendOffer();
+            }
+        }
+    }
+}
+
+namespace Server.Items
+{
+    // A rare root growing where Edwin's book says. Picking the one the quest wants now counts it, and one time in
+    // three disturbs a nest of snakes, spiders or serpents underneath, a third of those plagued or elder.
+    [SerializationGenerator(0)]
+    public abstract partial class BaseQuestReagent : Item
+    {
+        private static readonly (Type Creature, string Name, int Min, int Max)[] _nests =
+        [
+            (typeof(Snake), "Snakes", 2, 6),
+            (typeof(GiantSpider), "Spiders", 2, 3),
+            (typeof(GiantSerpent), "Serpents", 2, 3),
+            (typeof(SilverSerpent), "Serpents", 1, 2),
+            (typeof(GiantBlackWidow), "Spiders", 1, 2)
+        ];
+
+        private const double NestDisturbChance = 0.35;
+        private const double SpecialNestChance = 0.35;
+
+        private bool _picked;
+
+        public BaseQuestReagent(int itemID) : base(itemID) => Movable = false;
+
+        protected abstract int PickedItemID { get; }
+
+        public override void OnDoubleClick(Mobile from)
+        {
+            if (Parent != null || Movable || Map == null || Map == Map.Internal || _picked)
+            {
+                return;
+            }
+
+            if (!from.InRange(Location, 2) || !from.InLOS(this))
+            {
+                from.LocalOverheadMessage(MessageType.Regular, 0x3B2, 1019045); // I can't reach that.
+                return;
+            }
+
+            if (from is not PlayerMobile { Quest: Engines.Quests.ElderWizard.ElderWizardQuest qs } ||
+                qs.FindObjective(typeof(Engines.Quests.ElderWizard.FindPlantObjective)) is not
+                    Engines.Quests.ElderWizard.FindPlantObjective { Completed: false } obj)
+            {
+                from.SendMessage("You see no reason to take that.");
+                return;
+            }
+
+            if (obj.Current.Plant != GetType())
+            {
+                from.SendMessage("This is not the reagent you should collect now.");
+                return;
+            }
+
+            Pick(from, obj);
+        }
+
+        private void Pick(Mobile from, Engines.Quests.ElderWizard.FindPlantObjective obj)
+        {
+            ItemID = PickedItemID;
+            _picked = true;
+
+            var amount = obj.Current.Amount;
+            obj.CurProgress++;
+            from.SendMessage("This looks like the reagent the wizard wanted.");
+
+            if (obj.CurProgress < amount)
+            {
+                from.SendMessage($"You need to collect {amount - obj.CurProgress} more of this plant.");
+            }
+
+            if (Utility.RandomDouble() < NestDisturbChance)
+            {
+                DisturbNest(from);
+            }
+
+            Timer.StartTimer(TimeSpan.FromMinutes(5.0), Delete);
+        }
+
+        private void DisturbNest(Mobile from)
+        {
+            var nest = _nests.RandomElement();
+            var count = Utility.RandomMinMax(nest.Min, nest.Max);
+            var elder = false;
+            var plagued = false;
+
+            if (Utility.RandomDouble() < SpecialNestChance)
+            {
+                elder = Utility.RandomBool();
+                plagued = !elder;
+            }
+
