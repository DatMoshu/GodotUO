+        private static void StopRace()
+        {
+            foreach (var m in PartData.Keys)
+            {
+                m.SendMessage("The race has stopped!");
+            }
+
+            _stopTimer?.Stop();
+            _raceTimer?.Stop();
+            _startTimer?.Stop();
+            _region?.Unregister();
+            _region = null;
+
+            foreach (var crate in CrateList.ToArray())
+            {
+                crate.Delete();
+            }
+
+            foreach (var apple in AppleList.ToArray())
+            {
+                apple.Delete();
+            }
+
+            foreach (var rd in PartList.ToArray())
+            {
+                RemovePlayer(rd.Part);
+            }
+
+            PartList.Clear();
+            PartData.Clear();
+
+            foreach (var fd in FinData)
+            {
+                var (money, text, bars) = fd.Place switch
+                {
+                    1 => (BankedMoney / 3, "You have won this Crate Race, Congratulations!", 3),
+                    2 => (BankedMoney / 6, "You have managed to become second in this Crate Race, Congratulations!", 2),
+                    3 => (BankedMoney / 9, "You have managed to become third in this Crate Race, Congratulations!", 1),
+                    _ => (0, "Thank you for participating in this Crate Race, unfortunately you have not won anything. Good luck next time!", 0)
+                };
+
+                if (Rewards && bars > 0)
+                {
+                    EventRewardSystem.CreateCopperBar(fd.Racer, bars, "Crate Race Event");
+                }
+
+                fd.Racer.SendMessage(text);
+
+                if (money > 0)
+                {
+                    fd.Racer.AddToBackpack(new BankCheck(money));
+                }
+
+                RemovePlayer(fd.Racer);
+                fd.Racer.SendGump(new RaceRankGump(new List<FinishedData>(FinData), 0), true);
+            }
+
+            OpenCrates = 0;
+            BankedMoney = 0;
+            Running = false;
+        }
