+++ b/Projects/UOContent/Custom/DFI/Games/CrateRace.cs
@@ -0,0 +1,1517 @@
+// DFI Network's crate race ("a Sunny Production, 2005"), ported from DFI RUNUO Scripts/Custom/Engines/Crate Race.
+// Players pay to join through the event masters, are undressed, and race laps of a walled track. Crates drop on
+// the track: running into one either takes effect (healing, a shield, damage) or stores it for later use by
+// saying "use first/second/third crate" or clicking it on the race gump (explosive drop, slick patch, freeze,
+// earthquake, energy bolt on the leader, chain lightning, flying bomb). Apples restore stamina or health. A
+// racer who dies is set twenty tiles back along the track. The first three take a third, a sixth and a ninth of
+// the entry fees, and copper bars if rewards are on.
+//
+// Staff set it up at the crate stone: build DFI's track around it, draw the track's rectangles in racing order
+// (each with the two directions a racer leaves it by), lay a finish line, set the region, then start it.
+
+using System;
+using System.Collections.Generic;
+using ModernUO.Serialization;
+using Server.Custom.Dfi.Events;
+using Server.Gumps;
+using Server.Items;
+using Server.Mobiles;
+using Server.Network;
+using Server.Regions;
+using Server.Spells;
+
+namespace Server.Custom.Dfi.CrateRace
+{
+    public class CrateRectangle
+    {
+        public CrateRectangle(Rectangle2D rect, Direction first = Direction.North, Direction second = Direction.North)
+        {
+            Rectangle = rect;
+            FirstDirection = first;
+            SecondDirection = second;
+        }
+
+        public Rectangle2D Rectangle { get; set; }
+        public Direction FirstDirection { get; set; }
+        public Direction SecondDirection { get; set; }
+
+        public bool Contains(int x, int y) =>
+            Rectangle.Start.X <= x && Rectangle.Start.Y <= y && Rectangle.End.X >= x && Rectangle.End.Y >= y;
+    }
+
+    public class RaceData : IComparable<RaceData>
+    {
+        public RaceData(Mobile m) => Part = m;
+
+        public Mobile Part { get; }
+        public bool Mirror, TempMirror, SwitchGump, Frozen;
+        public CrateType Crate1, Crate2, Crate3;
+        public int Place, Lap;
+
+        public bool UsedMirror()
+        {
+            if (TempMirror)
+            {
+                TempMirror = false;
+                return true;
+            }
+
+            if (Mirror)
+            {
+                Mirror = false;
+                return true;
+            }
+
+            return false;
+        }
+
+        // Ahead first: more laps, then further along the track's rectangles.
+        public int CompareTo(RaceData other) =>
+            Lap != other.Lap
+                ? other.Lap - Lap
+                : CrateRace.GetRectangleID(other.Part.X, other.Part.Y) - CrateRace.GetRectangleID(Part.X, Part.Y);
+
+        public void Store(CrateType type)
+        {
+            if (Crate1 == null)
+            {
+                Crate1 = type;
+            }
+            else if (Crate2 == null)
+            {
+                Crate2 = type;
+            }
+            else if (Crate3 == null)
+            {
+                Crate3 = type;
+            }
+            else
+            {
+                Crate3 = Crate2;
+                Crate2 = Crate1;
+                Crate1 = type;
+                CrateRace.OpenCrates--;
+            }
+
+            CrateRace.OpenCrates++;
+        }
+
+        public void Use(int slot)
+        {
+            var type = slot switch { 1 => Crate1, 2 => Crate2, _ => Crate3 };
+
+            if (type == null)
+            {
+                return;
+            }
+
+            switch (slot)
+            {
+                case 1:
+                    {
+                        Crate1 = null;
+                        break;
+                    }
+                case 2:
+                    {
+                        Crate2 = null;
+                        break;
+                    }
+                default:
+                    {
+                        Crate3 = null;
+                        break;
+                    }
+            }
+
+            type.OnUsage(Part);
+        }
+    }
+
+    public record FinishedData(Mobile Racer, int Place, TimeSpan Time);
+
+    public static class CrateRace
+    {
+        public const string Name = "Crate Race Event";
+        public const int DeathMoves = 20;
+
+        private static readonly Point3D _evictTo = new(1434, 1707, 18);
+
+        public static Dictionary<Mobile, RaceData> PartData { get; } = [];
+        public static List<RaceData> PartList { get; } = [];
+        public static List<RaceCrate> CrateList { get; } = [];
+        public static List<CrateApple> AppleList { get; } = [];
+        public static List<FinishedData> FinData { get; } = [];
+        public static List<RaceFinishLine> FinishLines { get; } = [];
+        public static List<CrateRectangle> Rectangles { get; private set; } = [];
+
+        public static int OpenCrates, BankedMoney, MaxCrates, Price, Laps, X, Y, Z;
+        public static bool Running, Animalised, QuickSpeed, Rewards;
+        public static Point3D StoneLocation;
+        public static Map Map;
+        public static Mobile FirstPlace;
+        public static Timer FreezeTimer;
+
+        private static CrateRegion _region;
+        private static double[] _rectangleChance = [];
+        private static DateTime _started;
+        private static int _countdown;
+        private static int _tick;
+        private static Timer _startTimer, _raceTimer, _stopTimer;
+
+        public static int Crates => CrateList.Count;
+        public static int Participants => PartData.Count;
+        public static bool Participant(Mobile m) => PartData.ContainsKey(m);
+
+        public static int GetRectangleID(int x, int y) => Rectangles.FindIndex(r => r.Contains(x, y));
+        public static CrateRectangle GetRectangle(int x, int y) => Rectangles.Find(r => r.Contains(x, y));
+
+        public static int GetHighestZ(int x, int y)
+        {
+            var z = Map.Tiles.GetLandTile(x, y).Z;
+
+            foreach (var item in Map.GetItemsInBounds(new Rectangle2D(x, y, 1, 1)))
+            {
+                z = Math.Max(z, item.GetSurfaceTop().Z);
+            }
+
+            return z;
+        }
+
+        public static void SetPlayerSpeed(RaceData rd)
+        {
+            // With quick speed racers run as if mounted and freezes bring them to normal; otherwise freezes walk.
+            var setting = QuickSpeed
+                ? rd.Frozen ? SpeedControlSetting.Disable : SpeedControlSetting.Mount
+                : rd.Frozen ? SpeedControlSetting.Walk : SpeedControlSetting.Disable;
+
+            rd.Part.NetState.SendSpeedControl(setting);
+        }
+
+        public static void SetPlayerSpeed(Mobile m)
+        {
+            if (PartData.TryGetValue(m, out var rd))
+            {
+                SetPlayerSpeed(rd);
+            }
+        }
+
+        public static void RequestJoin(Mobile m)
+        {
+            if (m.Player)
+            {
+                m.SendGump(new CrateJoinGump(), true);
+            }
+        }
+
+        public static string Join(PlayerMobile pm)
+        {
+            if (!EventSystem.Open || Participant(pm))
+            {
+                return "The race has already started.";
+            }
+
+            if (Price > 0 && !Banker.Withdraw(pm, Price))
+            {
+                return "You do not have enough money to participate.";
+            }
+
+            if (!EventWardrobe.Undress(pm))
+            {
+                if (Price > 0)
+                {
+                    Banker.Deposit(pm, Price);
+                }
+
+                return "You could not be undressed for the race.";
+            }
+
+            BankedMoney += Math.Max(Price, 0);
+            var data = new RaceData(pm);
+            PartData[pm] = data;
+            PartList.Add(data);
+            SetPlayerSpeed(data);
+            pm.MoveToWorld(StoneLocation, Map);
+
+            if (Animalised)
+            {
+                pm.SendGump(new CrateRaceCharGump(), true);
+            }
+
+            return null;
+        }
+
+        public static void Start(CrateStone stone)
+        {
+            Map = stone.Map;
+            X = stone.X;
+            Y = stone.Y;
+            Z = stone.Z;
+            StoneLocation = stone.Location;
+            Rewards = stone.Rewards;
+            Animalised = stone.Animalised;
+            QuickSpeed = stone.QuickSpeed;
+            MaxCrates = stone.MaxCrates;
+            Price = stone.Price;
+            Laps = stone.Laps;
+            Rectangles = stone.Rectangles;
+
+            if (stone.RegionRect.Width > 0)
+            {
+                _region = new CrateRegion(stone.RegionRect, Map);
+                _region.Register();
+            }
+
+            Running = true;
+            EventSystem.Start(stone.MinutesOpen, Name, StartNewRace, StopRace, RequestJoin);
+        }
+
+        private static void StartNewRace()
+        {
+            if (Rectangles.Count < 4 || PartData.Count == 0)
+            {
+                EventSystem.Stop();
+                return;
+            }
+
+            SetRectangleChances();
+            _started = Core.Now;
+
+            var row = 0;
+            var column = 1;
+
+            foreach (var m in PartData.Keys)
+            {
+                m.CloseGump<CrateRaceCharGump>();
+
+                if (Animalised && (int)m.BodyMod is 0 or 400 or 401)
+                {
+                    m.BodyMod = 0xD0;
+                }
+
+                m.Frozen = true;
+                m.Location = new Point3D(X - column, Y - 22 - row, Z);
+
+                if (++row % 8 == 0)
+                {
+                    row = 0;
+                    column++;
+                }
+            }
+
+            _countdown = 3;
+            _startTimer = Timer.DelayCall(TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1), CountDown);
+        }
+
+        private static void SetRectangleChances()
+        {
+            var total = 0;
+
+            foreach (var r in Rectangles)
+            {
+                total += r.Rectangle.Width * r.Rectangle.Height;
+            }
+
+            _rectangleChance = new double[Rectangles.Count];
+            var cumulative = 0.0;
+
+            for (var i = 0; i < Rectangles.Count; i++)
+            {
+                cumulative += (double)Rectangles[i].Rectangle.Width * Rectangles[i].Rectangle.Height / Math.Max(1, total);
+                _rectangleChance[i] = cumulative;
+            }
+        }
+
+        private static void CountDown()
+        {
+            _countdown--;
+
+            foreach (var m in PartData.Keys)
+            {
+                if (_countdown == 0)
+                {
+                    m.Frozen = false;
+                    m.SendMessage("The race has started!");
+                }
+                else
+                {
+                    m.SendMessage($"{_countdown} seconds untill the race begins!");
+                }
+            }
+
+            if (_countdown == 0)
+            {
+                _startTimer.Stop();
+                FinData.Clear();
+                _raceTimer = Timer.DelayCall(TimeSpan.Zero, TimeSpan.FromMilliseconds(500), OnRaceTimer);
+            }
+        }
+
+        private static void OnRaceTimer()
+        {
+            _tick++;
+            DropCrate();
+            DropApple();
+
+            if (_tick % 2 == 0)
+            {
+                foreach (var rd in PartList)
+                {
+                    rd.Part.SendGump(new CrateRaceGump(rd), true);
+                }
+            }
+
+            if (_tick == 4)
+            {
+                _tick = 0;
+                CheckPlace();
+            }
+        }
+
+        private static Point3D RandomDropLocation()
+        {
+            var roll = Utility.RandomDouble();
+            var rect = Rectangles[^1].Rectangle;
+
+            for (var i = 0; i < _rectangleChance.Length; i++)
+            {
+                if (roll <= _rectangleChance[i])
+                {
+                    rect = Rectangles[i].Rectangle;
+                    break;
+                }
+            }
+
+            var x = Utility.RandomMinMax(rect.Start.X, rect.End.X);
+            var y = Utility.RandomMinMax(rect.Start.Y, rect.End.Y);
+            return new Point3D(x, y, GetHighestZ(x, y));
+        }
+
+        private static void DropCrate()
+        {
+            if (Crates >= MaxCrates)
+            {
+                return;
+            }
+
+            var crate = new RaceCrate();
+            var loc = RandomDropLocation();
+            crate.MoveToWorld(loc, Map);
+            Effects.PlaySound(loc, Map, 0x202);
+            Effects.SendLocationEffect(loc, Map, 0x376A, 30, crate.Hue, 3);
+            Effects.SendLocationEffect(loc, Map, 0x3779, 30, crate.Hue, 3);
+            CrateList.Add(crate);
+        }
+
+        private static void DropApple()
+        {
+            if (AppleList.Count < 15)
+            {
+                var apple = new CrateApple();
+                apple.MoveToWorld(RandomDropLocation(), Map);
+                AppleList.Add(apple);
+            }
+        }
+
+        public static void CheckPlace()
+        {
+            PartList.Sort();
+            var place = FinData.Count + 1;
+
+            foreach (var rd in PartList)
+            {
+                if (place == FinData.Count + 1)
+                {
+                    FirstPlace = rd.Part;
+                }
+
+                rd.Place = place++;
+            }
+        }
+
+        // A racer who dies is set back DeathMoves tiles along the track's directions.
+        public static void OnDeath(Mobile m)
+        {
+            var x = m.X;
+            var y = m.Y;
+            var moves = DeathMoves;
+            var rect = GetRectangle(x, y);
+            var first = true;
+            var crossedStart = false;
+
+            while (rect != null && !NewLocation(rect, first, ref x, ref y, ref moves))
+            {
+                if (rect == Rectangles[0])
+                {
+                    crossedStart = true;
+                }
+
+                first = !first;
+
+                if (first)
+                {
+                    rect = GetRectangle(x, y);
+                }
+            }
+
+            if (rect == null)
+            {
+                return;
+            }
+
+            if (rect == Rectangles[0])
+            {
+                foreach (var line in FinishLines)
+                {
+                    if (line.X == x && line.Y == y)
+                    {
+                        switch (rect.FirstDirection)
+                        {
+                            case Direction.North:
+                                {
+                                    y++;
+                                    break;
+                                }
+                            case Direction.East:
+                                {
+                                    x--;
+                                    break;
+                                }
+                            case Direction.South:
+                                {
+                                    y--;
+                                    break;
+                                }
+                            case Direction.West:
+                                {
+                                    x++;
+                                    break;
+                                }
+                        }
+
+                        break;
+                    }
+                }
+            }
+            else if (crossedStart && PartData.TryGetValue(m, out var rd))
+            {
+                rd.Lap--;
+            }
+
+            m.MoveToWorld(new Point3D(x, y, GetHighestZ(x, y)), Map);
+        }
+
+        private static bool NewLocation(CrateRectangle rect, bool first, ref int x, ref int y, ref int moves)
+        {
+            var (edge, vertical, positive) = (first ? rect.FirstDirection : rect.SecondDirection) switch
+            {
+                Direction.North => (rect.Rectangle.Start.Y, true, false),
+                Direction.East  => (rect.Rectangle.End.X, false, true),
+                Direction.South => (rect.Rectangle.End.Y, true, true),
+                _               => (rect.Rectangle.Start.X, false, false)
+            };
+
+            var coord = vertical ? y : x;
+            var completed = false;
+            var difference = 0;
+
+            if (positive && coord + moves <= edge)
+            {
+                coord += moves;
+                completed = true;
+            }
+            else if (!positive && coord - moves >= edge)
+            {
+                coord -= moves;
+                completed = true;
+            }
+            else
+            {
+                difference = edge - coord + (first ? 0 : positive ? 1 : -1);
+                coord += difference;
+            }
+
+            if (vertical)
+            {
+                y = coord;
+            }
+            else
+            {
+                x = coord;
+            }
+
+            moves -= Math.Abs(difference);
+            return completed;
+        }
