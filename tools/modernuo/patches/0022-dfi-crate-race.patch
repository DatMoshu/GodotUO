+    // Draws the track's rectangles one at a time, in racing order, with the two directions a racer leaves each by.
+    public class RectangleSetup
+    {
+        private readonly Mobile _from;
+        private readonly CrateStone _stone;
+        private readonly List<Item> _markers = [];
+
+        public RectangleSetup(Mobile from, CrateStone stone, List<CrateRectangle> list)
+        {
+            _from = from;
+            _stone = stone;
+            List = list;
+        }
+
+        public List<CrateRectangle> List { get; }
+
+        public void Pick(int index)
+        {
+            _from.SendMessage("Target the corners of the track rectangle.");
+            BoundingBoxPicker.Begin(_from, (map, start, end) =>
+            {
+                var rect = new CrateRectangle(new Rectangle2D(new Point2D(start.X, start.Y), new Point2D(end.X + 1, end.Y + 1)));
+
+                if (index < List.Count)
+                {
+                    List[index] = rect;
+                }
+                else
+                {
+                    List.Add(rect);
+                    index = List.Count - 1;
+                }
+
+                Show(index);
+            });
+        }
+
+        public void Show(int index)
+        {
+            ClearMarkers();
+
+            if (List.Count > 0)
+            {
+                Mark(List[0].Rectangle, 1150);
+
+                if (index < List.Count && index > 0)
+                {
+                    Mark(List[index].Rectangle, 1151);
+                }
+            }
+
+            _from.SendGump(new TrackRectangleGump(this, index), true);
+        }
+
+        public void Save()
+        {
+            ClearMarkers();
+            _stone.Rectangles = List;
+            _from.SendMessage($"The track now has {List.Count} rectangles.");
+        }
+
+        public void ClearMarkers()
+        {
+            foreach (var item in _markers)
+            {
+                item.Delete();
+            }
+
+            _markers.Clear();
+        }
+
+        private void Mark(Rectangle2D rect, int hue)
+        {
+            var map = _stone.Map;
+
+            for (var x = rect.Start.X; x < rect.End.X; x++)
+            {
+                for (var y = rect.Start.Y; y < rect.End.Y; y++)
+                {
+                    var marker = new Static(0x1822) { Hue = hue, Name = "track marker" };
+                    marker.MoveToWorld(new Point3D(x, y, map.Tiles.GetLandTile(x, y).Z), map);
+                    _markers.Add(marker);
+                }
+            }
+        }
+    }
