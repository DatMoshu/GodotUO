+    // A bomb thrown ahead of the racer; it travels up to thirty tiles and hurts the first racer in its path.
+    public static class FlyingBomb
+    {
+        public static void Launch(Mobile from)
+        {
+            var (dx, dy) = (from.Direction & Direction.Mask) switch
+            {
+                Direction.North => (0, -1),
+                Direction.Right => (1, -1),
+                Direction.East  => (1, 0),
+                Direction.Down  => (1, 1),
+                Direction.South => (0, 1),
+                Direction.Left  => (-1, 1),
+                Direction.West  => (-1, 0),
+                _               => (-1, -1)
+            };
+
+            var map = from.Map;
+            var point = from.Location;
+            var target = new Entity(Serial.Zero, new Point3D(point.X + dx * 30, point.Y + dy * 30, point.Z), map);
+            Effects.SendMovingEffect(from, target, 10249, 7, 10, true, false);
+
+            var steps = 0;
+            Timer timer = null;
+            timer = Timer.DelayCall(TimeSpan.FromSeconds(0.1), TimeSpan.FromSeconds(0.1), 30, () =>
+            {
+                steps++;
+                var at = new Point3D(point.X + dx * steps, point.Y + dy * steps, point.Z);
+
+                foreach (var m in map.GetMobilesInRange(at, 0))
+                {
+                    if (m != from && CrateRace.PartData.TryGetValue(m, out var rd))
+                    {
+                        m.FixedParticles(0x36BD, 20, 10, 5044, EffectLayer.Head);
+                        m.PlaySound(0x307);
+                        Timer.DelayCall(() => CrateRace.HandleDamage(rd, .20));
+                        timer?.Stop();
+                        return;
+                    }
+                }
+            });
+        }
+    }
