+                        return;
+                    }
+                case Finish:
+                    {
+                        _setup.Save();
+                        return;
+                    }
+                case Remove when _index < _setup.List.Count:
+                    {
+                        _setup.List.RemoveAt(_index);
+                        _setup.Show(Math.Max(0, _index - 1));
+                        return;
+                    }
+                case Redo:
+                    {
+                        _setup.Pick(_index);
+                        return;
+                    }
+                case Previous:
+                    {
+                        _setup.Show(Math.Max(0, _index - 1));
+                        return;
+                    }
+                case Next:
+                    {
+                        _setup.Show(Math.Min(_setup.List.Count, _index + 1));
+                        return;
+                    }
+                case >= SecondBase and < SecondBase + 4 when _index < _setup.List.Count:
+                    {
+                        _setup.List[_index].SecondDirection = _dirs[id - SecondBase];
+                        break;
+                    }
+                case >= FirstBase and < FirstBase + 4 when _index < _setup.List.Count:
+                    {
+                        _setup.List[_index].FirstDirection = _dirs[id - FirstBase];
+                        break;
+                    }
+            }
+
+            _setup.Show(_index);
+        }
+    }
+}
