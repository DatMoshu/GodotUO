@@ -0,0 +1,253 @@
+using System;
+using System.Collections.Generic;
+using Server;
+using Server.Custom.Dfi.CrateRace;
+using Server.Custom.Dfi.Events;
+using Server.Items;
+using Server.Misc;
+using Server.Mobiles;
+using Xunit;
+
+namespace UOContent.Tests.Custom;
+
+[Collection("Sequential UOContent Tests")]
+public class DfiCrateRaceTests : IDisposable
+{
+    private static readonly Point3D StoneAt = new(5300, 1300, 0);
+
+    private readonly List<IEntity> _created = new();
+
+    public DfiCrateRaceTests()
+    {
+        if (NameList.GetNameList("male") == null)
+        {
+            NameList.Configure();
+        }
+    }
+
+    public void Dispose()
+    {
+        EventSystem.Stop();
+
+        foreach (var e in _created)
+        {
+            e?.Delete();
+        }
+
+        _created.Clear();
+        CrateRace.PartData.Clear();
+        CrateRace.PartList.Clear();
+        CrateRace.FinData.Clear();
+    }
+
+    private T Track<T>(T e) where T : IEntity
+    {
+        _created.Add(e);
+        return e;
+    }
+
+    private PlayerMobile Player(int bank = 0)
+    {
+        var m = Track(new PlayerMobile());
+        m.Player = true;
+        m.Body = 0x190;
+        m.RawStr = 100;
+        m.AddItem(new Backpack());
+        m.AddItem(new BankBox(m));
+        m.MoveToWorld(new Point3D(1434, 1690, 0), Map.Felucca);
+
+        if (bank > 0)
+        {
+            m.BankBox.DropItem(new BankCheck(bank));
+        }
+
+        return m;
+    }
+
+    private CrateStone Stone()
+    {
+        var stone = Track(new CrateStone { Price = 1000, MinutesOpen = 2 });
+        stone.MoveToWorld(StoneAt, Map.Felucca);
+        return stone;
+    }
+
+    [Fact]
+    public void Track_BuildsDfisTrackAroundTheStone()
+    {
+        var stone = Stone();
+
+        stone.BuildTrack();
+        var track = Assert.IsType<RaceTrackAddon>(stone.Track);
+        Track(track);
+
+        Assert.Equal(RaceTrackData.Tiles.Length / 4, track.Components.Count);
+        Assert.Equal(new Rectangle2D(StoneAt.X - 22, StoneAt.Y - 32, 45, 65), stone.RegionRect);
+
+        // The default layout: four lanes clockwise from the top straight, and a finish line across it.
+        var lines = CrateRace.FinishLines.FindAll(l => l.Map == Map.Felucca && l.X == StoneAt.X);
+        lines.ForEach(l => Track(l));
+        Assert.Equal(4, stone.Rectangles.Count);
+        Assert.Equal(Direction.East, stone.Rectangles[0].FirstDirection);
+        Assert.Equal(9, lines.Count);
+        Assert.All(lines, l => Assert.True(stone.Rectangles[0].Contains(l.X, l.Y)));
+
+        stone.DemolishTrack();
+        Assert.True(track.Deleted);
+    }
+
+    [Fact]
+    public void Stone_KeepsRectanglesWithTheirDirections()
+    {
+        var stone = Stone();
+
+        stone.Rectangles =
+        [
+            new CrateRectangle(new Rectangle2D(10, 10, 5, 20), Direction.North, Direction.East),
+            new CrateRectangle(new Rectangle2D(20, 10, 20, 5), Direction.East, Direction.South)
+        ];
+
+        var back = stone.Rectangles;
+        Assert.Equal(2, back.Count);
+        Assert.Equal(Direction.East, back[0].SecondDirection);
+        Assert.Equal(Direction.South, back[1].SecondDirection);
+        Assert.Equal(new Rectangle2D(20, 10, 20, 5), back[1].Rectangle);
+    }
+
+    [Fact]
+    public void Joining_ChargesUndressesAndBringsTheRacerToTheTrack()
+    {
+        var stone = Stone();
+        var player = Player(5000);
+        var shirt = new FancyShirt { Layer = Layer.Shirt };
+        player.EquipItem(shirt);
+        player.Backpack.DropItem(new Gold(50));
+
+        CrateRace.Start(stone);
+        Assert.True(EventSystem.Open);
+
+        Assert.Null(CrateRace.Join(player));
+
+        Assert.True(CrateRace.Participant(player));
+        // The fee left the bank; the backpack's 50 gold went into the wardrobe bag in the bank.
+        Assert.Equal(4050, Banker.GetBalance(player));
+        Assert.Equal(1000, CrateRace.BankedMoney);
+        Assert.Empty(player.Backpack.Items);
+        Assert.Null(player.FindItemOnLayer(Layer.Shirt));
+        Assert.Equal(StoneAt, player.Location);
+
+        Assert.NotNull(CrateRace.Join(player));
+    }
+
+    [Fact]
+    public void Wardrobe_GivesEverythingBack()
+    {
+        var player = Player();
+        var shirt = new FancyShirt { Layer = Layer.Shirt };
+        player.EquipItem(shirt);
+        var gold = new Gold(50);
+        player.Backpack.DropItem(gold);
+
+        Assert.True(EventWardrobe.Undress(player));
+        Assert.False(EventWardrobe.Undress(player));
+        Assert.True(EventWardrobe.Redress(player));
+
+        Assert.Same(shirt, player.FindItemOnLayer(Layer.Shirt));
+        Assert.True(gold.IsChildOf(player.Backpack));
+        Assert.False(EventWardrobe.IsUndressed(player));
+    }
+
+    [Fact]
+    public void Crates_StackThreeAndPushTheOldestOut()
+    {
+        var rd = new RaceData(Player());
+        var freeze = new FreezeCrateType();
+        var quake = new EarthQuakeCrateType();
+
+        rd.Store(freeze);
+        rd.Store(quake);
+        rd.Store(freeze);
+        rd.Store(quake);
+
+        Assert.Same(quake, rd.Crate1);
+        Assert.Same(freeze, rd.Crate2);
+        Assert.Same(quake, rd.Crate3);
+    }
+
+    [Fact]
+    public void Damage_IsTakenByShieldsFirst()
+    {
+        var player = Player();
+        player.Hits = player.HitsMax;
+        var rd = new RaceData(player) { Mirror = true, TempMirror = true };
+
+        CrateRace.HandleDamage(rd, .5);
+        Assert.False(rd.TempMirror);
+        Assert.Equal(player.HitsMax, player.Hits);
+
+        CrateRace.HandleDamage(rd, .5);
+        Assert.False(rd.Mirror);
+        Assert.Equal(player.HitsMax, player.Hits);
+
+        CrateRace.HandleDamage(rd, .5);
+        Assert.True(player.Hits < player.HitsMax);
+    }
+
+    [Fact]
+    public void Finishing_TheLastLapPlacesTheRacer()
+    {
+        var player = Player();
+        var rd = new RaceData(player) { Lap = 0 };
+        CrateRace.Laps = 2;
+        CrateRace.PartData[player] = rd;
+        CrateRace.PartList.Add(rd);
+        CrateRace.Map = Map.Felucca;
+
+        Assert.True(CrateRace.MobFinish(player));
+        Assert.True(CrateRace.MobFinish(player));
+        Assert.False(CrateRace.MobFinish(player));
+
+        Assert.Single(CrateRace.FinData);
+        Assert.Equal(1, CrateRace.FinData[0].Place);
+        Assert.False(CrateRace.Participant(player));
+    }
+
+    [Fact]
+    public void Placing_RanksByLapThenByRectangle()
+    {
+        var a = Player();
+        var b = Player();
+        var stone = Stone();
+        stone.Rectangles =
+        [
+            new CrateRectangle(new Rectangle2D(1400, 1680, 20, 20)),
+            new CrateRectangle(new Rectangle2D(1420, 1680, 20, 20))
+        ];
+        CrateRace.Map = Map.Felucca;
+        typeof(CrateRace).GetProperty(nameof(CrateRace.Rectangles))!.SetValue(null, stone.Rectangles);
+
+        a.Location = new Point3D(1405, 1690, 0);
+        b.Location = new Point3D(1425, 1690, 0);
+        var ra = new RaceData(a) { Lap = 1 };
+        var rb = new RaceData(b) { Lap = 1 };
+        CrateRace.PartList.Add(ra);
+        CrateRace.PartList.Add(rb);
+
+        CrateRace.CheckPlace();
+        Assert.Equal(1, rb.Place);
+        Assert.Same(b, CrateRace.FirstPlace);
+
+        ra.Lap = 2;
+        CrateRace.CheckPlace();
+        Assert.Equal(1, ra.Place);
+        Assert.Equal(2, rb.Place);
+    }
+
+    [Fact]
+    public void EventMaster_AndRaceItemsConstruct()
+    {
+        Assert.Contains(Track(new EventNpc()), EventSystem.Npcs);
+        Assert.False(Track(new RaceCrate()).Deleted);
+        Assert.False(Track(new CrateApple()).Deleted);
+        Assert.Contains(Track(new RaceFinishLine()), CrateRace.FinishLines);
+    }
+}
