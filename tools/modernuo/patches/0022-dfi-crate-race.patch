+        // Returns true while the racer still has laps to go.
+        public static bool MobFinish(Mobile m)
+        {
+            if (!PartData.TryGetValue(m, out var rd))
+            {
+                return false;
+            }
+
+            rd.Lap++;
+
+            if (rd.Lap != Laps + 1)
+            {
+                return true;
+            }
+
+            var place = FinData.Count + 1;
+            FinData.Add(new FinishedData(m, place, Core.Now - _started));
+
+            m.Location = place switch
+            {
+                1 => new Point3D(X, Y - 15, Z + 23),
+                2 => new Point3D(X, Y - 17, Z + 20),
+                3 => new Point3D(X, Y - 13, Z + 20),
+                _ => new Point3D(X + 3, Y - 17, Z)
+            };
+
+            if (place == 1)
+            {
+                _stopTimer = Timer.DelayCall(TimeSpan.FromMinutes(3), EventSystem.Stop);
+            }
+
+            PartData.Remove(m);
+            PartList.Remove(rd);
