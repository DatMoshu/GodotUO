@@ -0,0 +1,64 @@
+// Places the crate race's event masters by the banks of Britain and Buccaneer's Den, where DFI's announcements
+// sent players. With "here", also a crate stone at the caller's feet with DFI's track built round it and its
+// default layout: the track needs a flat, empty 45 by 65 tiles.
+
+using System.Collections.Generic;
+using Server.Commands;
+using Server.Custom.Dfi.CrateRace;
+using Server.Custom.Dfi.Events;
+using Server.Logging;
+
+namespace Server.Custom.Dfi;
+
+public static class DfiCrateRaceGen
+{
+    private static readonly ILogger logger = LogFactory.GetLogger(typeof(DfiCrateRaceGen));
+
+    public static readonly Point3D[] EventMasterSpots = [new(1427, 1695, 0), new(2731, 2187, 0)];
+
+    public static void Configure()
+    {
+        CommandSystem.Register("DfiCrateRace", AccessLevel.Administrator, OnCommand);
+    }
+
+    [Usage("DfiCrateRace [here]")]
+    [Description("Places the event masters; with \"here\", also a crate stone and DFI's race track at your feet.")]
+    private static void OnCommand(CommandEventArgs e)
+    {
+        var removed = 0;
+        var doomed = new List<Mobile>();
+
+        foreach (var m in World.Mobiles.Values)
+        {
+            if (m is EventNpc && m.Map == Map.Felucca && System.Array.IndexOf(EventMasterSpots, m.Location) >= 0)
+            {
+                doomed.Add(m);
+            }
+        }
+
+        foreach (var m in doomed)
+        {
+            m.Delete();
+            removed++;
+        }
+
+        foreach (var spot in EventMasterSpots)
+        {
+            var npc = new EventNpc { Home = spot, RangeHome = 0, CantWalk = true, Direction = Direction.South };
+            npc.MoveToWorld(spot, Map.Felucca);
+        }
+
+        var placed = EventMasterSpots.Length;
+
+        if (e.Length > 0 && e.GetString(0).Equals("here", System.StringComparison.OrdinalIgnoreCase))
+        {
+            var stone = new CrateStone();
+            stone.MoveToWorld(e.Mobile.Location, e.Mobile.Map);
+            stone.BuildTrack();
+            placed++;
+        }
+
+        e.Mobile.SendMessage($"DfiCrateRace: removed {removed}, placed {placed}.");
+        logger.Information("{User} placed {Placed} crate race fixtures ({Removed} removed)", e.Mobile, placed, removed);
+    }
+}
diff --git a/Projects/UOContent/Custom/DFI/Games/EventSystem.cs b/Projects/UOContent/Custom/DFI/Games/EventSystem.cs
new file mode 100644
index 000000000..32f33c8af
--- /dev/null
+++ b/Projects/UOContent/Custom/DFI/Games/EventSystem.cs
@@ -0,0 +1,385 @@
+// DFI Network's event signup, ported from DFI RUNUO Scripts/Custom/Sunny/EventSystem and the undress code in
+// Custom/Sunny/SunnySystem.cs. One staff event at a time: once started it is announced every minute for its
+// join time, while event masters take players in; then it begins. Players are undressed into a bag in their
+// bank when they join and dressed again afterwards, their pets stabled meanwhile. When an event ends its
+// players are set down at one of Britain's edges, blessed for twenty seconds.
+
+using System;
+using System.Collections.Generic;
+using ModernUO.Serialization;
+using Server.Collections;
+using Server.Commands;
+using Server.ContextMenus;
+using Server.Items;
+using Server.Mobiles;
+
+namespace Server.Custom.Dfi.Events;
+
+public static class EventSystem
+{
+    public const int SystemHue = 0x38A;
+
+    private static readonly Point3D[] _exitLocations =
+        [new(1522, 1757, 28), new(1519, 1619, 10), new(1457, 1538, 30), new(1607, 1568, 20), new(1643, 1680, 18)];
+
+    private static Timer _joinTimer;
+    private static Action _start;
+    private static Action _stop;
+
+    public static bool Open { get; private set; }
+    public static bool Running { get; private set; }
+    public static string EventName { get; private set; }
+    public static Action<Mobile> JoinMethod { get; private set; }
+    public static List<EventNpc> Npcs { get; } = [];
+
+    public static void Start(int joinMinutes, string name, Action start, Action stop, Action<Mobile> join)
+    {
+        Open = true;
+        Running = true;
+        EventName = name;
+        _start = start;
+        _stop = stop;
+        JoinMethod = join;
+
+        var broadcasts = Math.Max(2, joinMinutes);
+        _joinTimer?.Stop();
+        _joinTimer = Timer.DelayCall(TimeSpan.Zero, TimeSpan.FromMinutes(1.0), () => Announce(ref broadcasts));
+    }
+
+    private static void Announce(ref int broadcasts)
+    {
+        var name = EventName;
+
+        if (broadcasts == 0)
+        {
+            CommandHandlers.BroadcastMessage(AccessLevel.Player, SystemHue, $"---- {name} ----");
+            CommandHandlers.BroadcastMessage(AccessLevel.Player, SystemHue, $"The {name} is starting... Event Masters do not accept new players.");
+            StartGame();
+            return;
+        }
+
+        foreach (var npc in Npcs)
+        {
+            npc.Say("Hear Ye! Hear Ye!");
+            npc.Say(broadcasts == 1 ? $"Last call for the {name}!" : $"Hurry up and join the {name}!");
+        }
+
+        CommandHandlers.BroadcastMessage(AccessLevel.Player, SystemHue, $"---- {name} ----");
+        CommandHandlers.BroadcastMessage(AccessLevel.Player, SystemHue, $"A {name} will start in {broadcasts} minutes!");
+        CommandHandlers.BroadcastMessage(
+            AccessLevel.Player, SystemHue,
+            broadcasts == 1 ? "Event Masters will not accept new players soon..." : "Event Masters at Britain Bank will now accept new players."
+        );
+
+        broadcasts--;
+    }
+
+    public static void StartGame()
+    {
+        Open = false;
+        _joinTimer?.Stop();
+        _joinTimer = null;
+        _start?.Invoke();
+    }
+
+    public static void Stop()
+    {
+        if (!Open && !Running)
+        {
+            return;
+        }
+
+        Open = false;
+        Running = false;
+        _joinTimer?.Stop();
+        _joinTimer = null;
+        _stop?.Invoke();
+    }
+
+    public static void RemoveToRandomLoc(Mobile m)
+    {
+        m.Blessed = true;
+        Timer.DelayCall(TimeSpan.FromSeconds(20.0), () => m.Blessed = false);
+        m.MoveToWorld(_exitLocations.RandomElement(), Map.Felucca);
+    }
+}
+
+// What a player wore and carried when an event undressed them, held in a bag in their bank.
+public class UndressedPlayer
+{
+    public Bag Bag { get; init; }
+    public List<Item> Worn { get; } = [];
+    public List<Item> Pack { get; } = [];
+    public List<BaseCreature> Pets { get; } = [];
+}
+
+public class EventWardrobe : GenericPersistence
+{
+    private static readonly Dictionary<Mobile, UndressedPlayer> _undressed = [];
+
+    public EventWardrobe() : base("DfiEventWardrobe", 10)
+    {
+    }
+
+    public static void Configure()
+    {
+        _ = new EventWardrobe();
+    }
+
+    public static bool IsUndressed(Mobile m) => _undressed.ContainsKey(m);
+
+    public static bool Undress(Mobile m)
+    {
+        if (!m.Alive)
+        {
+            m.Resurrect();
+            m.Hits = m.HitsMax;
+        }
+
+        if (m.Backpack == null)
+        {
+            m.SendMessage("Unfortunately we could not undress you, as you have no backpack, please contact the staff.");
+            return false;
+        }
+
+        if (_undressed.ContainsKey(m))
+        {
+            return false;
+        }
+
+        var bag = new Bag();
+        m.BankBox.DropItem(bag);
+        var ud = new UndressedPlayer { Bag = bag };
+        _undressed[m] = ud;
+
+        if (m.Holding != null)
+        {
+            m.Backpack.DropItem(m.Holding);
+        }
+
+        StablePets(m, ud);
+
+        foreach (var item in new List<Item>(m.Items))
+        {
+            if (item.Layer is not (Layer.Backpack or Layer.Bank or Layer.FacialHair or Layer.Hair))
+            {
+                ud.Worn.Add(item);
+                bag.DropItem(item);
+            }
+        }
+
+        foreach (var item in new List<Item>(m.Backpack.Items))
+        {
+            ud.Pack.Add(item);
+            bag.DropItem(item);
+        }
+
+        return true;
+    }
+
+    public static bool Redress(Mobile m)
+    {
+        if (!_undressed.Remove(m, out var ud))
+        {
+            m.SendMessage("Unfortunately we could not find your belongings, please contact the staff.");
+            return false;
+        }
+
+        if (!m.Alive)
+        {
+            m.Resurrect();
+        }
+
+        foreach (var item in ud.Worn)
+        {
+            if (item.Deleted)
+            {
+                continue;
+            }
+
+            if (!item.CanEquip(m) || !m.EquipItem(item))
+            {
+                m.AddToBackpack(item);
+            }
+        }
+
+        foreach (var item in ud.Pack)
+        {
+            if (!item.Deleted)
+            {
+                m.AddToBackpack(item);
+            }
+        }
+
+        if (ud.Bag.Items.Count == 0)
+        {
+            ud.Bag.Delete();
+        }
+
+        foreach (var pet in ud.Pets)
+        {
+            if (pet.Deleted)
+            {
+                continue;
+            }
+
+            if (m is PlayerMobile pm)
+            {
+                pm.Stabled.Remove(pet);
+            }
+
+            pet.SetControlMaster(m);
+            pet.ControlTarget = m;
+            pet.ControlOrder = OrderType.Follow;
+            pet.MoveToWorld(m.Location, m.Map);
+            pet.IsStabled = false;
+        }
+
+        m.SendMessage("Your belongings have been returned to you.");
+        return true;
+    }
+
+    private static void StablePets(Mobile m, UndressedPlayer ud)
+    {
+        if (m.Mount != null)
+        {
+            m.Mount.Rider = null;
+        }
+
+        if (m.Followers == 0 || m is not PlayerMobile pm)
+        {
+            return;
+        }
+
+        var pets = new List<BaseCreature>();
+
+        foreach (var near in m.GetMobilesInRange(20))
+        {
+            if (near is BaseCreature bc && (bc.Summoned && bc.SummonMaster == m || bc.Controlled && bc.ControlMaster == m))
+            {
+                pets.Add(bc);
+            }
+        }
+
+        foreach (var pet in pets)
+        {
+            if (pet.Summoned)
+            {
+                pet.Delete();
+                continue;
+            }
+
+            ud.Pets.Add(pet);
+            pet.ControlTarget = null;
+            pet.ControlOrder = OrderType.Stay;
+            pet.Internalize();
+            pet.SetControlMaster(null);
+            pet.SummonMaster = null;
+            pet.IsStabled = true;
+            pm.Stabled.Add(pet);
+        }
+
+        if (pets.Count > 0)
+        {
+            m.SendMessage("Your pets have been stabled.");
+        }
+    }
+
+    public override void Serialize(IGenericWriter writer)
+    {
+        writer.WriteEncodedInt(0); // version
+        writer.WriteEncodedInt(_undressed.Count);
+
+        foreach (var (m, ud) in _undressed)
+        {
+            writer.Write(m);
+            writer.Write(ud.Bag);
+            writer.Write(ud.Worn);
+            writer.Write(ud.Pack);
+            writer.Write(ud.Pets);
+        }
+    }
+
+    public override void Deserialize(IGenericReader reader)
+    {
+        reader.ReadEncodedInt(); // version
+        var count = reader.ReadEncodedInt();
+
+        for (var i = 0; i < count; i++)
+        {
+            var m = reader.ReadEntity<Mobile>();
+            var ud = new UndressedPlayer { Bag = reader.ReadEntity<Bag>() };
+            ud.Worn.AddRange(reader.ReadEntityList<Item>());
+            ud.Pack.AddRange(reader.ReadEntityList<Item>());
+            ud.Pets.AddRange(reader.ReadEntityList<BaseCreature>());
+
+            if (m != null && ud.Bag != null)
+            {
+                _undressed[m] = ud;
+            }
+        }
+    }
+}
+
+// The event master: the way into whichever event is taking players.
+[SerializationGenerator(0)]
+public partial class EventNpc : BaseVendor
+{
+    private readonly List<SBInfo> _sbInfos = [];
+
+    [Constructible(AccessLevel.GameMaster)]
+    public EventNpc() : base("the event master") => EventSystem.Npcs.Add(this);
+
+    protected override List<SBInfo> SBInfos => _sbInfos;
+    public override VendorShoeType ShoeType => VendorShoeType.Sandals;
+
+    public override void InitSBInfo()
+    {
+    }
+
+    public override void InitOutfit()
+    {
+        base.InitOutfit();
+        AddItem(new Robe(Utility.RandomNeutralHue()));
+        AddItem(new WizardsHat(Utility.RandomNeutralHue()));
+        AddItem(new GnarledStaff());
+    }
+
+    [AfterDeserialization]
+    private void AfterDeserialization() => EventSystem.Npcs.Add(this);
+
+    public override void OnDelete()
+    {
+        EventSystem.Npcs.Remove(this);
+        base.OnDelete();
+    }
+
+    public override void AddCustomContextEntries(Mobile from, ref PooledRefList<ContextMenuEntry> list)
+    {
+        base.AddCustomContextEntries(from, ref list);
+
+        if (from.Alive && from is PlayerMobile)
+        {
+            list.Add(new TalkEntry());
+        }
+    }
+
+    private class TalkEntry : ContextMenuEntry
+    {
+        public TalkEntry() : base(6146) // Talk
+        {
+        }
+
+        public override void OnClick(Mobile from, IEntity target)
+        {
+            if (EventSystem.Open && EventSystem.JoinMethod != null)
+            {
+                EventSystem.JoinMethod(from);
+            }
+            else
+            {
+                (target as Mobile)?.SayTo(from, "Currently there is no game open.");
+            }
+        }
+    }
+}
