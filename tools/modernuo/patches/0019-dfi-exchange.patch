@@ -0,0 +1,698 @@
+// DFI Network's vendor advertisements, ported from DFI RUNUO Scripts/Custom/Mobiles/Townfolks and Vendors/VendorAd.
+// A player vendor's owner pays 50 gp every 12 hours to keep an advert up, plus a price of their choosing (10 gp
+// or more, half while they are online) each time someone uses it to travel to the vendor; each account travels
+// once per 12 hours on one payment. Higher prices rank higher. Advertisers announce a random advert every three
+// minutes; anyone near one can say "go", "show adds", "I wish to place a new advertisement" or "I wish to
+// review my advertisements".
+
+using System;
+using System.Collections.Generic;
+using ModernUO.Serialization;
+using Server.Collections;
+using Server.ContextMenus;
+using Server.Gumps;
+using Server.Items;
+using Server.Mobiles;
+using Server.Network;
+using Server.Spells;
+using Server.Targeting;
+
+namespace Server.Custom.Dfi;
+
+public class AdvertCategory
+{
+    public AdvertCategory(int index, string name)
+    {
+        Index = index;
+        Name = name;
+    }
+
+    public int Index { get; }
+    public string Name { get; }
+    public List<AdvertEntry> Entries { get; } = [];
+}
+
+public class AdvertEntry
+{
+    public AdvertEntry(Mobile owner) => Owner = owner;
+
+    public Mobile Owner { get; set; }
+    public PlayerVendor Vendor { get; set; }
+    public AdvertCategory Category { get; set; }
+    public string Description { get; set; } = "";
+    public int Price { get; set; }
+
+    // Accounts that have paid passage since the last 12-hour fee.
+    public HashSet<string> FreeAccounts { get; } = [];
+
+    public bool IsValid => AdvertSystem.Exists(Vendor) && AdvertSystem.Exists(Owner);
+}
+
+public class AdvertSystem : GenericPersistence
+{
+    public const int MinimumPrice = 10;
+    public const int DailyFee = 50;
+
+    public static readonly AdvertCategory[] Categories =
+        [new(0, "Weapons"), new(1, "Armor"), new(2, "Misc"), new(3, "Resources")];
+
+    public static List<AdvertMobile> Advertisers { get; } = [];
+    public static AdvertEntry CurrentPublicAdvert { get; private set; }
+
+    private static Timer _verify;
+    private static Timer _announce;
+
+    public AdvertSystem() : base("DfiAdverts", 10)
+    {
+    }
+
+    public static void Configure()
+    {
+        _ = new AdvertSystem();
+        _verify = Timer.DelayCall(TimeSpan.FromHours(12.0), TimeSpan.FromHours(12.0), VerifyAll);
+        _announce = Timer.DelayCall(TimeSpan.FromMinutes(3.0), TimeSpan.FromMinutes(3.0), AnnounceRandom);
+    }
+
+    public static bool Exists(Mobile m) => m?.Deleted == false;
+
+    // Ranks are by price, highest first.
+    public static void Add(AdvertEntry entry)
+    {
+        foreach (var category in Categories)
+        {
+            category.Entries.Remove(entry);
+        }
+
+        var list = entry.Category.Entries;
+        var i = list.FindIndex(e => e.Price < entry.Price);
+        list.Insert(i < 0 ? list.Count : i, entry);
+    }
+
+    public static void Remove(AdvertEntry entry) => entry.Category?.Entries.Remove(entry);
+
+    public static int RankFor(AdvertCategory category, int price)
+    {
+        var rank = 1;
+
+        foreach (var e in category.Entries)
+        {
+            if (e.Price < price)
+            {
+                break;
+            }
+
+            rank++;
+        }
+
+        return rank;
+    }
+
+    public static void AnnounceRandom()
+    {
+        var category = Categories.RandomElement();
+
+        if (category.Entries.Count == 0)
+        {
+            return;
+        }
+
+        var entry = category.Entries.RandomElement();
+
+        if (!entry.IsValid)
+        {
+            return;
+        }
+
+        CurrentPublicAdvert = entry;
+
+        foreach (var advertiser in Advertisers)
+        {
+            if (!advertiser.Deleted)
+            {
+                advertiser.Say($"[public advertisement]    {entry.Vendor.Name}: {entry.Description}");
+                advertiser.Say("Say \"Go\" to meet this vendor");
+            }
+        }
+    }
+
+    // Charges every advert its 12-hour fee, dropping those that cannot pay or whose vendor is gone.
+    public static void VerifyAll()
+    {
+        var lapsed = new List<AdvertEntry>();
+
+        foreach (var category in Categories)
+        {
+            foreach (var entry in category.Entries)
+            {
+                if (!entry.IsValid || !Banker.Withdraw(entry.Owner, DailyFee))
+                {
+                    lapsed.Add(entry);
+                }
+                else
+                {
+                    entry.FreeAccounts.Clear();
+                }
+            }
+        }
+
+        foreach (var entry in lapsed)
+        {
+            Remove(entry);
+        }
+    }
+
+    public static bool CanTravel(Mobile m) =>
+        Exists(m) && m.Player && m.Alive && !m.Criminal && !SpellHelper.CheckCombat(m) && m.Spell == null;
+
+    public static bool Use(Mobile m, AdvertEntry entry)
+    {
+        if (!CanTravel(m))
+        {
+            m.SendMessage("You cannot travel to a vendor right now.");
+            return false;
+        }
+
+        var account = m.Account?.Username ?? "";
+        var paid = entry?.IsValid == true && (entry.FreeAccounts.Contains(account) ||
+                                              Banker.Withdraw(entry.Owner, entry.Owner.NetState != null ? entry.Price / 2 : entry.Price));
+
+        if (!paid)
+        {
+            m.SendMessage("We are sorry, this is an old advertisement, please select a different one.");
+
+            if (entry != null)
+            {
+                Remove(entry);
+            }
+
+            m.SendGump(new AdvertCategoriesGump(), true);
+            return false;
+        }
+
+        entry.FreeAccounts.Add(account);
+        m.MoveToWorld(entry.Vendor.Location, entry.Vendor.Map);
+        m.SendMessage("You have been moved to the chosen vendor.");
+        return true;
+    }
+
+    public override void Serialize(IGenericWriter writer)
+    {
+        writer.WriteEncodedInt(0); // version
+        writer.WriteEncodedInt(Categories.Length);
+
+        foreach (var category in Categories)
+        {
+            writer.Write(category.Name);
+            writer.WriteEncodedInt(category.Entries.Count);
+
+            foreach (var e in category.Entries)
+            {
+                writer.Write(e.Vendor);
+                writer.Write(e.Owner);
+                writer.Write(e.Description);
+                writer.WriteEncodedInt(e.Price);
+            }
+        }
+    }
+
+    public override void Deserialize(IGenericReader reader)
+    {
+        reader.ReadEncodedInt(); // version
+        var count = reader.ReadEncodedInt();
+
+        for (var i = 0; i < count; i++)
+        {
+            var name = reader.ReadString();
+            var category = Array.Find(Categories, c => c.Name == name);
+            var entries = reader.ReadEncodedInt();
+
+            for (var j = 0; j < entries; j++)
+            {
+                var vendor = reader.ReadEntity<PlayerVendor>();
+                var owner = reader.ReadEntity<Mobile>();
+                var description = reader.ReadString();
+                var price = reader.ReadEncodedInt();
+
+                if (category != null && vendor != null && owner != null)
+                {
+                    category.Entries.Add(
+                        new AdvertEntry(owner) { Vendor = vendor, Category = category, Description = description, Price = price }
+                    );
+                }
+            }
+        }
+    }
+}
+
+[SerializationGenerator(0)]
+public partial class AdvertMobile : BaseCreature
+{
+    [Constructible(AccessLevel.GameMaster)]
+    public AdvertMobile() : base(AIType.AI_Vendor, FightMode.None, 2, 1)
+    {
+        InitStats(100, 100, 25);
+        Title = "the advertiser";
+        Hue = Race.Human.RandomSkinHue();
+        Body = 0x190;
+        Name = NameList.RandomName("male");
+        HairItemID = Race.Human.RandomHair(false);
+        HairHue = Race.Human.RandomHairHue();
+        Blessed = true;
+        CantWalk = true;
+
+        AddItem(new FancyShirt(Utility.RandomBlueHue()));
+        AddItem(new Kilt(Utility.RandomGreenHue()));
+        AddItem(new FeatheredHat(Utility.RandomGreenHue()));
+        AddItem(new ThighBoots());
+
+        AdvertSystem.Advertisers.Add(this);
+    }
+
+    public override bool CanBeDamaged() => false;
+    public override bool HandlesOnSpeech(Mobile from) => true;
+
+    [AfterDeserialization]
+    private void AfterDeserialization() => AdvertSystem.Advertisers.Add(this);
+
+    public override void OnDelete()
+    {
+        AdvertSystem.Advertisers.Remove(this);
+        base.OnDelete();
+    }
+
+    public override void GetContextMenuEntries(Mobile from, ref PooledRefList<ContextMenuEntry> list)
+    {
+        base.GetContextMenuEntries(from, ref list);
+
+        if (from.Alive)
+        {
+            list.Add(new InformationEntry());
+            list.Add(new TalkEntry());
+        }
+    }
+
+    public override void OnSpeech(SpeechEventArgs e)
+    {
+        base.OnSpeech(e);
+
+        if (e.Handled || !InRange(e.Mobile, 6))
+        {
+            return;
+        }
+
+        var m = e.Mobile;
+
+        switch (e.Speech.Trim().ToLowerInvariant())
+        {
+            case "go" when AdvertSystem.CurrentPublicAdvert != null:
+                {
+                    e.Handled = true;
+                    AdvertSystem.Use(m, AdvertSystem.CurrentPublicAdvert);
+                    break;
+                }
+            case "show adds":
+                {
+                    e.Handled = true;
+                    m.SendGump(new AdvertCategoriesGump(), true);
+                    break;
+                }
+            case "i wish to place a new advertisement":
+                {
+                    e.Handled = true;
+                    m.SendGump(new AddAdvertGump(new AdvertEntry(m)), true);
+                    break;
+                }
+            case "i wish to review my advertisements":
+                {
+                    e.Handled = true;
+                    m.SendGump(new AdvertEntriesGump(null, 0, m), true);
+                    break;
+                }
+        }
+    }
+
+    private class InformationEntry : ContextMenuEntry
+    {
+        public InformationEntry() : base(98, 12) // Information
+        {
+        }
+
+        public override void OnClick(Mobile from, IEntity target) => from.SendGump(new AdvertInfoGump(), true);
+    }
+
+    private class TalkEntry : ContextMenuEntry
+    {
+        public TalkEntry() : base(6146, 12) // Talk
+        {
+        }
+
+        public override void OnClick(Mobile from, IEntity target) => from.SendGump(new AdvertCategoriesGump(), true);
+    }
+}
+
+public abstract class AdvertGump : DynamicGump
+{
+    protected AdvertGump() : base(50, 50)
+    {
+    }
+
+    protected static void AddFrame(ref DynamicGumpBuilder builder, int width, int height, string subtitle)
+    {
+        builder.AddPage();
+        builder.AddBackground(0, 0, width, height, 9270);
+        builder.AddAlphaRegion(10, 10, width - 20, height - 20);
+        builder.AddHtml(0, 25, width, 20, "Advertisement System", "#FFFFFF", align: TextAlignment.Center);
+        builder.AddHtml(0, 45, width, 20, subtitle, "#FFFFFF", align: TextAlignment.Center);
+    }
+}
+
+public class AdvertInfoGump : AdvertGump
+{
+    public override bool Singleton => true;
+
+    protected override void BuildLayout(ref DynamicGumpBuilder builder)
+    {
+        AddFrame(ref builder, 400, 420, "Information");
+        builder.AddHtml(
+            40, 80, 320, 280,
+            "Welcome to the advertisement system. This system provides you with an opportunity to advertise your vendors.<br>In exchange for this service you have to pay a small fee. The fee is based on a daily fee of 50gp, and a fee based on the usage of your advertisement which you can determine yourself.<br>The higher you set the price per usage the higher it will be in the ranks when someone views the advertisements. The fee is substracted per usage, and has a maximum of once per 12 hours per account.<br><br>Commands you can say near an advertiser:<br>Go (to go to the current advertisement)<br>Show adds<br>I wish to place a new advertisement<br>I wish to review my advertisements<br><br>Advertisements that are used while the owner is online only cost half the fee.<br>The advertisers shout out a random advertisement every few minutes, players near them can say \"Go\" to go to the vendor.<br>If you do not have enough money to keep your advertisement campaign running, your advertisement will be removed. When adding an advertisement please keep it clean or we will see it our duty to take actions upon you.",
+            "#FFFFFF", scrollbar: true
+        );
+        builder.AddButton(168, 375, 247, 248, 0);
+    }
+}
+
+public class AddAdvertGump : AdvertGump
+{
+    private const int Commit = 1;
+    private const int PickVendor = 2;
+    private const int SetDescription = 3;
+    private const int SetPrice = 4;
+    private const int CategoryBase = 1000;
+
+    private readonly AdvertEntry _entry;
+
+    public AddAdvertGump(AdvertEntry entry) => _entry = entry;
+
+    public override bool Singleton => true;
+
+    protected override void BuildLayout(ref DynamicGumpBuilder builder)
+    {
+        AddFrame(ref builder, 560, 360, "Add an Advertisement");
+
+        builder.AddLabel(430, 75, 0x34, "Category:");
+
+        for (var i = 0; i < AdvertSystem.Categories.Length; i++)
+        {
+            var category = AdvertSystem.Categories[i];
+            builder.AddButton(400, 100 + i * 22, category == _entry.Category ? 209 : 208, 209, CategoryBase + i);
+            builder.AddLabel(430, 100 + i * 22, 0x481, category.Name);
+        }
+
+        builder.AddButton(30, 88, 4005, 4006, PickVendor);
+        builder.AddLabel(73, 89, 0x481, _entry.Vendor?.Name ?? "No vendor assigned");
+
+        builder.AddButton(30, 122, 4005, 4006, SetDescription);
+        builder.AddImageTiled(80, 125, 260, 90, 0xBBC);
+        builder.AddTextEntry(83, 128, 254, 85, 0, 0, _entry.Description.Length == 0 ? "No description entered" : _entry.Description);
+
+        builder.AddButton(30, 232, 4005, 4006, SetPrice);
+        builder.AddImageTiled(80, 233, 94, 20, 0xBBC);
+        builder.AddTextEntry(82, 233, 90, 20, 0, 1, $"{_entry.Price}");
+        builder.AddLabel(180, 233, 0x481, "gp/use");
+
+        builder.AddLabel(74, 266, 0x481, "Rank with this price:");
+        builder.AddLabel(
+            220, 266, 0x481,
+            _entry.Price < AdvertSystem.MinimumPrice ? $"Minimum price is {AdvertSystem.MinimumPrice}" :
+            _entry.Category == null ? "No category selected" : $"{AdvertSystem.RankFor(_entry.Category, _entry.Price)}"
+        );
+
+        builder.AddButton(271, 310, 247, 248, Commit);
+        builder.AddButton(78, 310, 241, 242, 0);
+    }
+
+    public override void OnResponse(NetState sender, in RelayInfo info)
+    {
+        var m = sender.Mobile;
+        var description = info.GetTextEntry(0)?.Trim();
+
+        if (description != null && description != "No description entered")
+        {
+            _entry.Description = description;
+        }
+
+        if (int.TryParse(info.GetTextEntry(1)?.Trim(), out var price))
+        {
+            _entry.Price = price;
+        }
+
+        var id = info.ButtonID;
+
+        if (id >= CategoryBase && id < CategoryBase + AdvertSystem.Categories.Length)
+        {
+            _entry.Category = AdvertSystem.Categories[id - CategoryBase];
+            m.SendGump(new AddAdvertGump(_entry), true);
+            return;
+        }
+
+        switch (id)
+        {
+            case Commit:
+                {
+                    if (_entry.Price >= AdvertSystem.MinimumPrice && _entry.Vendor != null && _entry.Description.Length > 0 &&
+                        _entry.Category != null)
+                    {
+                        AdvertSystem.Add(_entry);
+                        m.SendMessage("Your advertisement has been successfully added.");
+                    }
+                    else
+                    {
+                        m.SendMessage("Some of the required information was missing.");
+                        m.SendGump(new AddAdvertGump(_entry), true);
+                    }
+
+                    break;
+                }
+            case PickVendor:
+                {
+                    m.SendMessage("Please target your vendor.");
+                    m.Target = new VendorTarget(_entry);
+                    break;
+                }
+            case SetDescription or SetPrice:
+                {
+                    m.SendGump(new AddAdvertGump(_entry), true);
+                    break;
+                }
+        }
+    }
+
+    private class VendorTarget : Target
+    {
+        private readonly AdvertEntry _entry;
+
+        public VendorTarget(AdvertEntry entry) : base(18, false, TargetFlags.None) => _entry = entry;
+
+        protected override void OnTarget(Mobile from, object targeted)
+        {
+            if (targeted is PlayerVendor vendor && (vendor.Owner == from || from.AccessLevel >= AccessLevel.GameMaster))
+            {
+                _entry.Vendor = vendor;
+            }
+            else
+            {
+                from.SendMessage("That is not an eligible vendor.");
+            }
+
+            from.SendGump(new AddAdvertGump(_entry), true);
+        }
+    }
+}
+
+public class AdvertCategoriesGump : AdvertGump
+{
+    private AdvertEntry _featured;
+
+    public override bool Singleton => true;
+
+    protected override void BuildLayout(ref DynamicGumpBuilder builder)
+    {
+        AddFrame(ref builder, 400, 360, "Choose your category");
+
+        builder.AddLabel(69, 85, 0x34, "Categories:");
+        builder.AddLabel(296, 85, 0x34, "Entries:");
+
+        var withEntries = new List<AdvertCategory>();
+
+        for (var i = 0; i < AdvertSystem.Categories.Length; i++)
+        {
+            var category = AdvertSystem.Categories[i];
+            builder.AddButton(30, 110 + i * 25, 4005, 4006, 100 + i);
+            builder.AddLabel(69, 110 + i * 25, 0x481, category.Name);
+            builder.AddLabel(300, 110 + i * 25, 0x481, $"{category.Entries.Count}");
+
+            if (category.Entries.Count > 0)
+            {
+                withEntries.Add(category);
+            }
+        }
+
+        if (withEntries.Count > 0)
+        {
+            _featured = withEntries.RandomElement().Entries.RandomElement();
+
+            if (_featured.IsValid)
+            {
+                builder.AddButton(32, 245, 4005, 4006, 1);
+                builder.AddLabel(80, 245, 0x481, _featured.Vendor.Name);
+                builder.AddHtml(80, 268, 253, 65, _featured.Description, "#FFFFFF", scrollbar: true);
+            }
+        }
+    }
+
+    public override void OnResponse(NetState sender, in RelayInfo info)
+    {
+        var m = sender.Mobile;
+        var id = info.ButtonID;
+
+        if (id >= 100 && id < 100 + AdvertSystem.Categories.Length)
+        {
+            m.SendGump(new AdvertEntriesGump(AdvertSystem.Categories[id - 100], 0, m), true);
+        }
+        else if (id == 1 && _featured != null)
+        {
+            AdvertSystem.Use(m, _featured);
+        }
+    }
+}
+
+// A page of adverts: one category's, or (with no category) the viewer's own.
+public class AdvertEntriesGump : AdvertGump
+{
+    private const int PerPage = 8;
+    private const int Previous = 10;
+    private const int Next = 20;
+
+    private readonly AdvertCategory _category;
+    private readonly int _start;
+    private readonly List<AdvertEntry> _entries;
+
+    public AdvertEntriesGump(AdvertCategory category, int start, Mobile viewer)
+    {
+        _category = category;
+        _start = Math.Max(0, start);
+
+        if (category != null)
+        {
+            _entries = new List<AdvertEntry>(category.Entries);
+        }
+        else
+        {
+            _entries = [];
+
+            foreach (var c in AdvertSystem.Categories)
+            {
+                _entries.AddRange(c.Entries.FindAll(e => e.Owner == viewer && AdvertSystem.Exists(e.Vendor)));
+            }
+        }
+    }
+
+    public override bool Singleton => true;
+
+    protected override void BuildLayout(ref DynamicGumpBuilder builder)
+    {
+        var show = Math.Clamp(_entries.Count - _start, 0, PerPage);
+        var rows = Math.Max(Math.Min(show, 4), 1);
+        var wide = show > 4;
+        var width = wide ? 700 : 400;
+        var height = 150 + rows * 110;
+
+        AddFrame(ref builder, width, height, "Find your shop");
+
+        if (show == 0)
+        {
+            builder.AddLabel(80, 90, 0x481, "There are no advertisements here.");
+        }
+
+        for (var i = 0; i < show; i++)
+        {
+            var entry = _entries[_start + i];
+            var x = i < 4 ? 30 : 360;
+            var y = 85 + 110 * (i % 4);
+
+            builder.AddButton(x, y, 4005, 4006, 100 + i);
+            builder.AddButton(x, y + 25, 4011, 4012, 1000 + i);
+            builder.AddButton(x, y + 50, 4017, 4018, 1100 + i);
+            builder.AddLabel(x + 50, y + 5, 0x481, entry.Vendor?.Name ?? "a vendor");
+            builder.AddHtml(x + 50, y + 30, 253, 65, entry.Description, "#FFFFFF", scrollbar: true);
+        }
+
+        if (_start > 0)
+        {
+            builder.AddButton(29, height - 40, 4014, 4015, Previous);
+        }
+
+        if (_start + show < _entries.Count)
+        {
+            builder.AddButton(width - 70, height - 40, 4005, 4006, Next);
+        }
+    }
+
+    public override void OnResponse(NetState sender, in RelayInfo info)
+    {
+        var m = sender.Mobile;
+        var id = info.ButtonID;
+
+        AdvertEntry Pick(int baseId) => id - baseId + _start is var at && at >= 0 && at < _entries.Count ? _entries[at] : null;
+
+        bool MayEdit(AdvertEntry e) => m.AccessLevel >= AccessLevel.GameMaster || e.Owner == m;
+
+        switch (id)
+        {
+            case >= 1100:
+                {
+                    if (Pick(1100) is { } entry && MayEdit(entry))
+                    {
+                        AdvertSystem.Remove(entry);
+                        m.SendMessage("The advertisement has been removed.");
+                    }
+
+                    break;
+                }
+            case >= 1000:
+                {
+                    if (Pick(1000) is { } entry && MayEdit(entry))
+                    {
+                        m.SendGump(new AddAdvertGump(entry), true);
+                    }
+
+                    break;
+                }
+            case >= 100:
+                {
+                    if (Pick(100) is { } entry)
+                    {
+                        AdvertSystem.Use(m, entry);
+                    }
+
+                    break;
+                }
+            case Previous:
+                {
+                    m.SendGump(new AdvertEntriesGump(_category, _start - PerPage, m), true);
+                    break;
+                }
+            case Next:
+                {
+                    m.SendGump(new AdvertEntriesGump(_category, _start + PerPage, m), true);
+                    break;
+                }
+            case 0:
+                {
+                    m.SendGump(new AdvertCategoriesGump(), true);
+                    break;
+                }
+        }
+    }
+}
diff --git a/Projects/UOContent/Custom/DFI/Town/DfiTownGen.cs b/Projects/UOContent/Custom/DFI/Town/DfiTownGen.cs
