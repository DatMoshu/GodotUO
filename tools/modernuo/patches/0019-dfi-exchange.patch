+public class ExchangeCancelGump : ExchangeGump
+{
+    private readonly ExchangeCategory _category;
+    private readonly ExchangeOrder _order;
+
+    public ExchangeCancelGump(ExchangeCategory category, ExchangeOrder order)
+    {
+        _category = category;
+        _order = order;
+    }
+
+    public override bool Singleton => true;
+
+    protected override void BuildLayout(ref DynamicGumpBuilder builder)
+    {
+        AddFrame(ref builder, 500, 260, _order is ExchangeBid ? "Buying" : "Selling");
+
+        var warning = _order is ExchangeOffer offer
+            ? $"Warning!<br>Canceling this offer will result in the removal of {offer.Seizure} units of your goods."
+            : "Warning!<br>Canceling this bid will remove it from the exchange board, the incurred costs will not be returned";
+
+        builder.AddHtml(60, 90, 380, 90, warning, "#FFFFFF");
+        builder.AddButton(80, 200, 247, 248, 1);
+        builder.AddLabel(80, 180, 0x481, "Remove it");
+        builder.AddButton(340, 200, 241, 242, 0);
+    }
+
+    public override void OnResponse(NetState sender, in RelayInfo info)
+    {
+        var m = sender.Mobile;
+
+        if (info.ButtonID == 1 && _order.Mobile == m)
+        {
+            ExchangeSystem.Cancel(_order);
+            m.SendMessage("Your order has been removed from the exchange board; what it held went to your bank.");
+        }
+
+        m.SendGump(new ExchangeEntryGump(_category), true);
+    }
+}
