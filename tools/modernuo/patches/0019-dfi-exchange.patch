+using System;
+using System.Collections.Generic;
+using Server;
+using Server.Custom.Dfi;
+using Server.Custom.Dfi.Exchange;
+using Server.Items;
+using Server.Misc;
+using Server.Mobiles;
+using Xunit;
+
+namespace UOContent.Tests.Custom;
+
+[Collection("Sequential UOContent Tests")]
+public class DfiExchangeTests : IDisposable
+{
+    private readonly List<IEntity> _created = new();
+
+    public DfiExchangeTests()
+    {
+        if (NameList.GetNameList("male") == null)
+        {
+            NameList.Configure();
+        }
+    }
+
+    public void Dispose()
+    {
+        foreach (var e in _created)
+        {
+            e?.Delete();
+        }
+
+        _created.Clear();
+
+        foreach (var category in ExchangeConfig.Categories)
+        {
+            foreach (var c in category.Commodities)
+            {
+                c.Bids.Clear();
+                c.Offers.Clear();
+            }
+        }
+
+        foreach (var category in AdvertSystem.Categories)
+        {
+            category.Entries.Clear();
+        }
+
+        ExchangeSystem.History.Clear();
+    }
+
+    private T Track<T>(T e) where T : IEntity
+    {
+        _created.Add(e);
+        return e;
+    }
+
+    private PlayerMobile Player(int gold = 0)
+    {
+        var m = Track(new PlayerMobile());
+        m.Player = true;
+        m.Body = 0x190;
+        m.AddItem(new Backpack());
+        m.AddItem(new BankBox(m));
+        m.MoveToWorld(new Point3D(1434, 1690, 0), Map.Felucca);
+
+        if (gold > 0)
+        {
+            ExchangeSystem.GiveMoney(m, gold);
+        }
+
+        return m;
+    }
+
+    private CommodityDeed DeedIn(Mobile m, Type type, int amount)
+    {
+        var deed = ExchangeSystem.MakeDeed(type, amount);
+        m.Backpack.DropItem(deed);
+        return deed;
+    }
+
+    private static int DeedAmount(Mobile m, Type type)
+    {
+        var total = 0;
+
+        foreach (var item in m.BankBox.Items)
+        {
+            if (item is CommodityDeed { Commodity: { } c } && c.GetType() == type)
+            {
+                total += c.Amount;
+            }
+        }
+
+        return total;
+    }
+
+    private static ExchangeCommodity Iron => ExchangeSystem.Find(typeof(IronIngot));
+
+    [Fact]
+    public void Exchange_EveryCommodityIsFoundAndDeedable()
+    {
+        foreach (var category in ExchangeConfig.Categories)
+        {
+            foreach (var c in category.Commodities)
+            {
+                Assert.Same(c, ExchangeSystem.Find(c.Type));
+                var deed = ExchangeSystem.MakeDeed(c.Type, 30);
+                Assert.NotNull(deed);
+                deed.Delete();
+            }
+        }
+    }
+
+    [Fact]
+    public void Bid_TakesMoneyAndFeeFromTheBankAndWaits()
+    {
+        var buyer = Player(10_000);
+
+        Assert.Null(ExchangeSystem.PlaceBid(buyer, Iron, 5, 100));
+
+        Assert.Equal(10_000 - 500 - ExchangeConfig.BuyCosts, Banker.GetBalance(buyer));
+        Assert.Single(Iron.Bids);
+    }
+
+    [Fact]
+    public void Bid_RefusesTooFewOrUnaffordable()
+    {
+        var buyer = Player(100);
+
+        Assert.NotNull(ExchangeSystem.PlaceBid(buyer, Iron, 5, 10));
+        Assert.NotNull(ExchangeSystem.PlaceBid(buyer, Iron, 5, 100));
+        Assert.Empty(Iron.Bids);
+        Assert.Equal(100, Banker.GetBalance(buyer));
+    }
+
+    [Fact]
+    public void Offer_MeetingABid_TradesAtTheBidsPrice()
+    {
+        var buyer = Player(10_000);
+        var seller = Player();
+        ExchangeSystem.PlaceBid(buyer, Iron, 6, 100);
+
+        var deed = DeedIn(seller, typeof(IronIngot), 60);
+        Assert.Null(ExchangeSystem.PlaceOffer(seller, deed, 4));
+
+        Assert.True(deed.Deleted);
+        Assert.Equal(60, DeedAmount(buyer, typeof(IronIngot)));
+        Assert.Equal(360, Banker.GetBalance(seller));
+        Assert.Equal(40, Iron.Bids[0].Quantity);
+        Assert.Empty(Iron.Offers);
+        Assert.Equal(6, Iron.LastPrice);
+        Assert.Equal(60, Iron.LastQuantity);
+        Assert.Single(ExchangeSystem.History[seller]);
+    }
+
+    [Fact]
+    public void Bid_MeetingCheaperOffers_TakesTheCheapestFirst()
+    {
+        var sellerA = Player();
+        var sellerB = Player();
+        var buyer = Player(10_000);
+        ExchangeSystem.PlaceOffer(sellerA, DeedIn(sellerA, typeof(IronIngot), 50), 5);
+        ExchangeSystem.PlaceOffer(sellerB, DeedIn(sellerB, typeof(IronIngot), 50), 3);
+
+        Assert.Equal(3, Iron.Offers[0].Price);
+
+        ExchangeSystem.PlaceBid(buyer, Iron, 4, 80);
+
+        Assert.Equal(50, DeedAmount(buyer, typeof(IronIngot)));
+        Assert.Equal(200, Banker.GetBalance(sellerB));
+        Assert.Equal(0, Banker.GetBalance(sellerA));
+        Assert.Single(Iron.Offers);
+        Assert.Equal(30, Iron.Bids[0].Quantity);
+    }
+
+    [Fact]
+    public void Offer_RefusesSmallDeedsAndForeignGoods()
+    {
+        var seller = Player();
+
+        Assert.NotNull(ExchangeSystem.PlaceOffer(seller, DeedIn(seller, typeof(IronIngot), 10), 5));
+        Assert.NotNull(ExchangeSystem.PlaceOffer(seller, DeedIn(seller, typeof(Log), 100), 5));
+        Assert.Empty(Iron.Offers);
+    }
+
+    [Fact]
+    public void Cancel_ReturnsBidMoneyButNotTheFee_AndOfferGoodsLessTheSeizure()
+    {
+        var buyer = Player(10_000);
+        var seller = Player();
+        ExchangeSystem.PlaceBid(buyer, Iron, 5, 100);
+        ExchangeSystem.PlaceOffer(seller, DeedIn(seller, typeof(IronIngot), 200), 9);
+
+        ExchangeSystem.Cancel(Iron.Bids[0]);
+        ExchangeSystem.Cancel(Iron.Offers[0]);
+
+        Assert.Equal(10_000 - ExchangeConfig.BuyCosts, Banker.GetBalance(buyer));
+        Assert.Equal(195, DeedAmount(seller, typeof(IronIngot)));
+        Assert.Empty(Iron.Bids);
+        Assert.Empty(Iron.Offers);
+    }
+
+    [Fact]
+    public void Adverts_RankByPriceAndChargeOnlyOncePerAccount()
+    {
+        var owner = Player(1000);
+        var visitor = Player();
+        var vendor = Track(new PlayerVendor(owner, null));
+        vendor.MoveToWorld(new Point3D(1500, 1600, 0), Map.Felucca);
+        var category = AdvertSystem.Categories[0];
+
+        var cheap = new AdvertEntry(owner) { Vendor = vendor, Category = category, Description = "cheap", Price = 10 };
+        var dear = new AdvertEntry(owner) { Vendor = vendor, Category = category, Description = "dear", Price = 40 };
+        AdvertSystem.Add(cheap);
+        AdvertSystem.Add(dear);
+
+        Assert.Same(dear, category.Entries[0]);
+        Assert.Equal(2, AdvertSystem.RankFor(category, 20));
+
+        Assert.True(AdvertSystem.Use(visitor, dear));
+        Assert.Equal(vendor.Location, visitor.Location);
+        Assert.Equal(960, Banker.GetBalance(owner));
+
+        visitor.MoveToWorld(new Point3D(1434, 1690, 0), Map.Felucca);
+        Assert.True(AdvertSystem.Use(visitor, dear));
+        Assert.Equal(960, Banker.GetBalance(owner));
+    }
+
+    [Fact]
+    public void Adverts_ThatCannotPayTheFeeLapse()
+    {
+        var owner = Player(60);
+        var vendor = Track(new PlayerVendor(owner, null));
+        var category = AdvertSystem.Categories[1];
+        AdvertSystem.Add(new AdvertEntry(owner) { Vendor = vendor, Category = category, Description = "plate", Price = 10 });
+
+        AdvertSystem.VerifyAll();
+        Assert.Single(category.Entries);
+
+        AdvertSystem.VerifyAll();
+        Assert.Empty(category.Entries);
+    }
+}
