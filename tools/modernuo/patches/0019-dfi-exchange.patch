+public class ExchangeEntryGump : ExchangeGump
+{
+    private const int Info = 1;
+    private const int MyOrders = 2;
+    private const int BidBase = 100;
+    private const int SellBase = 200;
+
+    private readonly ExchangeCategory _category;
+
+    public ExchangeEntryGump(ExchangeCategory category) => _category = category;
+
+    public override bool Singleton => true;
+
+    protected override void BuildLayout(ref DynamicGumpBuilder builder)
+    {
+        var height = 160 + 20 * _category.Commodities.Count;
+        AddFrame(ref builder, 560, height, _category.Name);
+
+        builder.AddLabel(30, 72, 0x34, "Bid");
+        builder.AddLabel(65, 72, 0x34, "Sell");
+        builder.AddLabel(110, 72, 0x34, "Commodity");
+        builder.AddLabel(280, 72, 0x34, "Bids");
+        builder.AddLabel(350, 72, 0x34, "Offers");
+        builder.AddLabel(430, 72, 0x34, "Average Price");
+
+        for (var i = 0; i < _category.Commodities.Count; i++)
+        {
+            var c = _category.Commodities[i];
+            var y = 95 + 20 * i;
+            builder.AddButton(30, y, 4005, 4006, BidBase + i);
+            builder.AddButton(65, y, 4005, 4006, SellBase + i);
+            builder.AddLabel(110, y, 0x481, c.Name);
+            builder.AddLabel(280, y, 0x481, $"{c.Bids.Count}");
+            builder.AddLabel(350, y, 0x481, $"{c.Offers.Count}");
+            builder.AddLabel(430, y, 0x481, Price(c.AveragePrice));
+        }
+
+        builder.AddButton(30, height - 45, 4011, 4012, Info);
+        builder.AddLabel(65, height - 45, 0x481, "Information");
+        builder.AddButton(320, height - 45, 4011, 4012, MyOrders);
+        builder.AddLabel(355, height - 45, 0x481, "View My Offers/Biddings");
+    }
+
+    public override void OnResponse(NetState sender, in RelayInfo info)
+    {
+        var m = sender.Mobile;
+        var id = info.ButtonID;
+
+        if (id == Info)
+        {
+            m.SendGump(new ExchangeInfoGump(), true);
+        }
+        else if (id == MyOrders)
+        {
+            var orders = new List<ExchangeOrder>(ExchangeSystem.OrdersOf(m, _category));
+
+            if (orders.Count > 0)
+            {
+                m.SendGump(new ExchangeMyOrdersGump(_category, orders), true);
+            }
+            else
+            {
+                m.SendMessage("I am sorry i couldn't find any bids/offers from you.");
+            }
+        }
+        else if (id >= BidBase && id - BidBase < _category.Commodities.Count)
+        {
+            m.SendGump(new ExchangeBidGump(_category.Commodities[id - BidBase], 0, ExchangeConfig.MinimumQuantity), true);
+        }
+        else if (id >= SellBase && id - SellBase < _category.Commodities.Count)
+        {
+            m.SendMessage("Please target the commodity deed you wish to sell.");
+            m.Target = new SellTarget(_category);
+        }
+    }
+
+    private class SellTarget : Target
+    {
+        private readonly ExchangeCategory _category;
+
+        public SellTarget(ExchangeCategory category) : base(12, false, TargetFlags.None) => _category = category;
+
+        protected override void OnTarget(Mobile m, object targeted)
+        {
+            if (targeted is not CommodityDeed deed)
+            {
+                m.SendMessage("I am sorry we only accept deeded commodities.");
+            }
+            else if (!deed.IsChildOf(m.Backpack))
+            {
+                m.SendMessage("Please make sure your deed is in your backpack.");
+            }
+            else if (deed.Commodity == null)
+            {
+                m.SendMessage("We only accept deeds that are already filled.");
+            }
+            else if (deed.Commodity.Amount < ExchangeConfig.MinimumQuantity)
+            {
+                m.SendMessage("We only accept deeds that contain at least 25 goods.");
+            }
+            else if (_category.Find(deed.Commodity.GetType()) is not { } commodity)
+            {
+                m.SendMessage("I am sorry i do not exchange that kind of goods, you may want to try it at my collegues.");
+            }
+            else
+            {
+                m.SendGump(new ExchangeSellGump(commodity, deed, 0), true);
+            }
+        }
+    }
+}
