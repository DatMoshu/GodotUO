+public class ExchangeBidGump : ExchangeOrderGump
+{
+    private readonly double _price;
+    private readonly int _quantity;
+
+    public ExchangeBidGump(ExchangeCommodity commodity, double price, int quantity) : base(commodity)
+    {
+        _price = price;
+        _quantity = quantity;
+    }
+
+    public override bool Singleton => true;
+
+    protected override void BuildLayout(ref DynamicGumpBuilder builder)
+    {
+        AddBook(ref builder, $"Buying {Commodity.Name}");
+
+        builder.AddLabel(40, 260, 0x481, "Commodity:");
+        builder.AddLabel(130, 260, 0x481, Commodity.Name);
+        builder.AddLabel(40, 285, 0x481, "Price:");
+        builder.AddImageTiled(130, 285, 120, 20, 0xBBC);
+        builder.AddTextEntry(132, 285, 116, 20, 0, 1, $"{_price:0.##}");
+        builder.AddButton(260, 285, 4029, 4030, UpdatePrice);
+        builder.AddLabel(40, 310, 0x481, "Quantity:");
+        builder.AddImageTiled(130, 310, 120, 20, 0xBBC);
+        builder.AddTextEntry(132, 310, 116, 20, 0, 2, $"{_quantity}");
+        builder.AddButton(260, 310, 4029, 4030, UpdateQuantity);
+        builder.AddLabel(320, 285, 0x481, $"Immediate acquisitions: {Commodity.ImmediateBuy(_price, _quantity)}");
+        builder.AddLabel(320, 310, 0x481, $"Cost: {(long)(_price * _quantity) + ExchangeConfig.BuyCosts} gp from the bank");
+
+        builder.AddButton(40, 350, 4011, 4012, Commit);
+        builder.AddLabel(75, 350, 0x481, "Commit");
+        builder.AddButton(180, 350, 4020, 4021, 0);
+        builder.AddLabel(215, 350, 0x481, "Cancel");
+    }
+
+    public override void OnResponse(NetState sender, in RelayInfo info)
+    {
+        var m = sender.Mobile;
+        var price = ReadPrice(info, _price);
+        var quantity = int.TryParse(info.GetTextEntry(2)?.Trim(), out var q) ? q : _quantity;
+
+        switch (info.ButtonID)
+        {
+            case UpdatePrice or UpdateQuantity:
+                {
+                    m.SendGump(new ExchangeBidGump(Commodity, price, quantity), true);
+                    break;
+                }
+            case Commit:
+                {
+                    if (ExchangeSystem.PlaceBid(m, Commodity, price, quantity) is { } error)
+                    {
+                        m.SendMessage(error);
+                        m.SendGump(new ExchangeBidGump(Commodity, price, quantity), true);
+                    }
+
+                    break;
+                }
+            default:
+                {
+                    m.SendMessage("Your bid has not been added to the exchange board.");
+                    m.SendGump(new ExchangeEntryGump(Commodity.Category), true);
+                    break;
+                }
+        }
+    }
+}
