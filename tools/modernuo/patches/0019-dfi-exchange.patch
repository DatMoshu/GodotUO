+public class ExchangeMyOrdersGump : ExchangeGump
+{
+    private readonly ExchangeCategory _category;
+    private readonly List<ExchangeOrder> _orders;
+
+    public ExchangeMyOrdersGump(ExchangeCategory category, List<ExchangeOrder> orders)
+    {
+        _category = category;
+        _orders = orders;
+    }
+
+    public override bool Singleton => true;
+
+    protected override void BuildLayout(ref DynamicGumpBuilder builder)
+    {
+        var height = 150 + 20 * _orders.Count;
+        AddFrame(ref builder, 600, height, "Reviewing");
+
+        string[] heads = ["Commodity", "Action", "Price", "Quantity", "Revenue", "Days Left"];
+        int[] xs = [60, 190, 260, 340, 420, 510];
+
+        for (var i = 0; i < heads.Length; i++)
+        {
+            builder.AddLabel(xs[i], 72, 0x34, heads[i]);
+        }
+
+        for (var i = 0; i < _orders.Count; i++)
+        {
+            var o = _orders[i];
+            var y = 95 + 20 * i;
+            var daysLeft = Math.Max(0, (int)(o.Lifetime - (Core.Now - o.Date)).TotalDays);
+
+            builder.AddButton(25, y, 4017, 4018, 100 + i);
+            builder.AddLabel(xs[0], y, 0x481, o.Commodity.Name);
+            builder.AddLabel(xs[1], y, 0x481, o is ExchangeBid ? "Buying" : "Selling");
+            builder.AddLabel(xs[2], y, 0x481, Price(o.Price));
+            builder.AddLabel(xs[3], y, 0x481, $"{o.Quantity}");
+            builder.AddLabel(xs[4], y, 0x481, $"{(long)(o.Quantity * o.Price)}");
+            builder.AddLabel(xs[5], y, 0x481, $"{daysLeft}");
+        }
+
+        builder.AddLabel(60, height - 45, 0x3B2, "Press a red button to remove that order from the board.");
+        builder.AddButton(480, height - 45, 247, 248, 0);
+    }
+
+    public override void OnResponse(NetState sender, in RelayInfo info)
+    {
+        var index = info.ButtonID - 100;
+
+        if (index >= 0 && index < _orders.Count)
+        {
+            sender.Mobile.SendGump(new ExchangeCancelGump(_category, _orders[index]), true);
+        }
+    }
+}
