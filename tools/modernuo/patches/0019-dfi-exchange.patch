@@ -0,0 +1,79 @@
+// Places DFI's town services: the West Britain Exchange's five traders and an advertiser on the street by
+// Britain's west bank, and the criminal banker in Buccaneer's Den. DFI's saves kept none of their spots.
+// The stones, healers, necromancer, crier, prisoners and the Riddler are left for staff to place.
+
+using System.Collections.Generic;
+using Server.Commands;
+using Server.Custom.Dfi.Exchange;
+using Server.Logging;
+using Server.Mobiles;
+
+namespace Server.Custom.Dfi;
+
+public static class DfiTownGen
+{
+    private static readonly ILogger logger = LogFactory.GetLogger(typeof(DfiTownGen));
+
+    public static readonly Point3D[] TraderSpots =
+        [new(1427, 1689, 0), new(1428, 1689, 0), new(1429, 1689, 0), new(1430, 1689, 0), new(1431, 1689, 0)];
+
+    public static readonly Point3D AdvertiserSpot = new(1428, 1695, 0);
+    public static readonly Point3D CriminalBankerSpot = new(2730, 2188, 0);
+
+    public static void Configure()
+    {
+        CommandSystem.Register("DfiTown", AccessLevel.Administrator, OnCommand);
+    }
+
+    [Usage("DfiTown")]
+    [Description("Places DFI's exchange traders, an advertiser and the criminal banker, replacing any placed before.")]
+    private static void OnCommand(CommandEventArgs e)
+    {
+        var removed = Remove();
+        var placed = Place();
+        e.Mobile.SendMessage($"DfiTown: removed {removed}, placed {placed}.");
+        logger.Information("{User} placed {Placed} DFI town fixtures ({Removed} removed)", e.Mobile, placed, removed);
+    }
+
+    public static int Remove()
+    {
+        var doomed = new List<Mobile>();
+
+        foreach (var m in World.Mobiles.Values)
+        {
+            if (m is ExchangeNPC or CriminalBanker ||
+                m is AdvertMobile && m.Map == Map.Felucca && m.Location == AdvertiserSpot)
+            {
+                doomed.Add(m);
+            }
+        }
+
+        foreach (var m in doomed)
+        {
+            m.Delete();
+        }
+
+        return doomed.Count;
+    }
+
+    public static int Place()
+    {
+        for (var i = 0; i < TraderSpots.Length; i++)
+        {
+            Put(new ExchangeNPC { Category = (ExchangeNpcCategory)i, ItemHue = i * 4 }, TraderSpots[i]);
+        }
+
+        Put(new AdvertMobile(), AdvertiserSpot);
+        Put(new CriminalBanker(), CriminalBankerSpot);
+
+        return TraderSpots.Length + 2;
+    }
+
+    private static void Put(BaseCreature npc, Point3D at)
+    {
+        npc.Home = at;
+        npc.RangeHome = 0;
+        npc.Direction = Direction.South;
+        npc.MoveToWorld(at, Map.Felucca);
+    }
+}
diff --git a/Projects/UOContent/Custom/DFI/Town/Exchange.cs b/Projects/UOContent/Custom/DFI/Town/Exchange.cs
