@@ -0,0 +1,747 @@
+// DFI Network's West Britain Exchange, ported from DFI RUNUO Scripts/Custom/Mobiles/Townfolks and Vendors/Vendor
+// System. Traders take bids and offers on commodities: a bid of at least 25 units is paid up front from the
+// bank plus a 150 gp fee; an offer is a filled commodity deed of at least 25 units. Bids and offers that meet
+// trade at the bid's price, the buyer receiving a commodity deed and the seller gold in the bank. Unfilled
+// orders lapse after five days: a bid's money goes back, an offer's deed goes back less 2.5%.
+
+using System;
+using System.Collections.Generic;
+using ModernUO.CodeGeneratedEvents;
+using Server.Gumps;
+using Server.Items;
+using Server.Mobiles;
+
+namespace Server.Custom.Dfi.Exchange;
+
+public static class ExchangeConfig
+{
+    public const double SellGoodsSeizure = 0.025;
+    public const int BuyCosts = 150;
+    public const int MinimumQuantity = 25;
+    public const int DaysKept = 20;
+    public static readonly TimeSpan BidTime = TimeSpan.FromDays(5.0);
+    public static readonly TimeSpan SellTime = TimeSpan.FromDays(5.0);
+    public static readonly TimeSpan HistoryCleanTime = TimeSpan.FromDays(5.0);
+
+    public static readonly ExchangeCategory[] Categories =
+    [
+        new(0, "BlackSmith Resources", [
+            (typeof(IronIngot), "Iron Ingot"), (typeof(DullCopperIngot), "Dull Copper Ingot"),
+            (typeof(ShadowIronIngot), "Shadow Iron Ingot"), (typeof(CopperIngot), "Copper Ingot"), (typeof(BronzeIngot), "Bronze Ingot"),
+            (typeof(GoldIngot), "Gold Ingot"), (typeof(AgapiteIngot), "Agapite Ingot"), (typeof(VeriteIngot), "Verite Ingot"),
+            (typeof(ValoriteIngot), "Valorite Ingot"), (typeof(RedScales), "Red Scales"), (typeof(YellowScales), "Yellow Scales"),
+            (typeof(BlackScales), "Black Scales"), (typeof(GreenScales), "Green Scales"), (typeof(WhiteScales), "White Scales"),
+            (typeof(BlueScales), "Blue Scales")
+        ]),
+        new(1, "Magic Resources", [
+            (typeof(SulfurousAsh), "Sulfurous Ash"), (typeof(SpidersSilk), "Spider Silk"), (typeof(PigIron), "Pig Iron"),
+            (typeof(NoxCrystal), "Nox Crystal"), (typeof(Nightshade), "Night Shade"), (typeof(MandrakeRoot), "Mandrake Root"),
+            (typeof(GraveDust), "Grave Dust"), (typeof(Ginseng), "Ginseng"), (typeof(Garlic), "Garlic"),
+            (typeof(DaemonBlood), "Demon Blood"), (typeof(Bloodmoss), "Bloodmoss"), (typeof(BlackPearl), "Black Pearl"),
+            (typeof(BatWing), "Bat Wing")
+        ]),
+        new(2, "Tailor Resources", [
+            (typeof(UncutCloth), "Uncut Cloth"), (typeof(Leather), "Leather"), (typeof(SpinedLeather), "Spined Leather"),
+            (typeof(HornedLeather), "Horned Leather"), (typeof(BarbedLeather), "Barbed Leather"), (typeof(Cloth), "Cloth"),
+            (typeof(Bone), "Bones"), (typeof(BoltOfCloth), "Bolt of Cloth")
+        ]),
+        new(3, "Other Craft Resources", [
+            (typeof(Shaft), "Shaft"), (typeof(Feather), "Feather"), (typeof(Board), "Board"), (typeof(Sand), "Sand")
+        ]),
+        new(4, "Archery Related Resources", [(typeof(Arrow), "Arrow"), (typeof(Bolt), "Bolt")])
+    ];
+}
+
+public enum ExchangeNpcCategory
+{
+    BlackSmith = 0,
+    Magic = 1,
+    Tailor = 2,
+    OtherCrafts = 3,
+    Archery = 4
+}
+
+public class ExchangeCategory
+{
+    public ExchangeCategory(int id, string name, (Type Type, string Name)[] commodities)
+    {
+        ID = id;
+        Name = name;
+        Commodities = new List<ExchangeCommodity>();
+
+        foreach (var (type, commodityName) in commodities)
+        {
+            Commodities.Add(new ExchangeCommodity(this, type, commodityName));
+        }
+    }
+
+    public int ID { get; }
+    public string Name { get; }
+    public List<ExchangeCommodity> Commodities { get; }
+
+    public ExchangeCommodity Find(Type type) => Commodities.Find(c => c.Type == type);
+}
+
+public class ExchangeDay
+{
+    public int Day;
+    public double HighestPrice;
+    public double LowestPrice = double.MaxValue;
+    public long TotalQuantity;
+    public long TotalRevenue;
+
+    public double Average => TotalQuantity == 0 ? 0 : Math.Round((double)TotalRevenue / TotalQuantity, 2);
+
+    public void Add(double price, int quantity, long revenue)
+    {
+        TotalRevenue += revenue;
+        TotalQuantity += quantity;
+        HighestPrice = Math.Max(HighestPrice, price);
+        LowestPrice = Math.Min(LowestPrice, price);
+    }
+}
+
+public abstract class ExchangeOrder
+{
+    protected ExchangeOrder(Mobile mobile, ExchangeCommodity commodity, double price, int quantity, DateTime date)
+    {
+        Mobile = mobile;
+        Commodity = commodity;
+        Price = price;
+        Quantity = quantity;
+        Date = date;
+    }
+
+    public Mobile Mobile { get; }
+    public ExchangeCommodity Commodity { get; }
+    public double Price { get; }
+    public int Quantity { get; set; }
+    public DateTime Date { get; }
+
+    public bool OwnerExists => Mobile?.Deleted == false;
+
+    public abstract TimeSpan Lifetime { get; }
+}
+
+public class ExchangeBid : ExchangeOrder
+{
+    public ExchangeBid(Mobile mobile, ExchangeCommodity commodity, double price, int quantity, DateTime date)
+        : base(mobile, commodity, price, quantity, date)
+    {
+    }
+
+    public override TimeSpan Lifetime => ExchangeConfig.BidTime;
+}
+
+public class ExchangeOffer : ExchangeOrder
+{
+    public ExchangeOffer(Mobile mobile, ExchangeCommodity commodity, double price, int quantity, DateTime date)
+        : base(mobile, commodity, price, quantity, date)
+    {
+    }
+
+    public override TimeSpan Lifetime => ExchangeConfig.SellTime;
+
+    // What a lapsed or cancelled offer keeps back for the exchange's expenses.
+    public int Seizure => Math.Max((int)(Quantity * ExchangeConfig.SellGoodsSeizure), 1);
+}
+
+public record ExchangeTransaction(string Name, double Price, int Quantity, bool Bought, DateTime Date);
+
+public class ExchangeCommodity
+{
+    public ExchangeCommodity(ExchangeCategory category, Type type, string name)
+    {
+        Category = category;
+        Type = type;
+        Name = name;
+    }
+
+    public ExchangeCategory Category { get; }
+    public Type Type { get; }
+    public string Name { get; }
+
+    // Bids best (highest) first, offers best (lowest) first; earlier orders first at the same price.
+    public List<ExchangeBid> Bids { get; } = [];
+    public List<ExchangeOffer> Offers { get; } = [];
+    public List<ExchangeDay> Days { get; } = [];
+
+    public double LastPrice;
+    public int LastQuantity;
+    public DateTime LastExchangeTime;
+    public double HighestPrice;
+    public double LowestPrice = double.MaxValue;
+    public long TotalQuantity;
+    public long TotalRevenue;
+
+    public double AveragePrice => TotalQuantity == 0 ? 0 : Math.Round((double)TotalRevenue / TotalQuantity, 2);
+
+    // Units on the other side of the book that an order at this price would take at once.
+    public int ImmediateBuy(double price, int quantity)
+    {
+        var available = 0;
+
+        foreach (var offer in Offers)
+        {
+            if (offer.Price <= price)
+            {
+                available += offer.Quantity;
+            }
+        }
+
+        return Math.Min(quantity, available);
+    }
+
+    public int ImmediateSell(double price, int quantity)
+    {
+        var wanted = 0;
+
+        foreach (var bid in Bids)
+        {
+            if (bid.Price >= price)
+            {
+                wanted += bid.Quantity;
+            }
+        }
+
+        return Math.Min(quantity, wanted);
+    }
+
+    public void RecordTrade(double price, int quantity)
+    {
+        var revenue = (long)(price * quantity);
+        var now = Core.Now;
+
+        if (Days.Count == 0 || Days[^1].Day != now.Day)
+        {
+            Days.Add(new ExchangeDay { Day = now.Day });
+
+            if (Days.Count > ExchangeConfig.DaysKept)
+            {
+                var old = Days[0];
+                Days.RemoveAt(0);
+                TotalQuantity -= old.TotalQuantity;
+                TotalRevenue -= old.TotalRevenue;
+            }
+        }
+
+        Days[^1].Add(price, quantity, revenue);
+
+        LastPrice = price;
+        LastQuantity = quantity;
+        LastExchangeTime = now;
+        TotalQuantity += quantity;
+        TotalRevenue += revenue;
+        HighestPrice = Math.Max(HighestPrice, price);
+        LowestPrice = Math.Min(LowestPrice, price);
+    }
+
+    public void Insert(ExchangeBid bid)
+    {
+        var i = Bids.FindIndex(b => b.Price < bid.Price);
+        Bids.Insert(i < 0 ? Bids.Count : i, bid);
+    }
+
+    public void Insert(ExchangeOffer offer)
+    {
+        var i = Offers.FindIndex(o => o.Price > offer.Price);
+        Offers.Insert(i < 0 ? Offers.Count : i, offer);
+    }
+}
+
+public class ExchangeSystem : GenericPersistence
+{
+    public static Dictionary<Mobile, List<ExchangeTransaction>> History { get; } = [];
+
+    private static Timer _cleanup;
+
+    public ExchangeSystem() : base("DfiExchange", 10)
+    {
+    }
+
+    public static void Configure()
+    {
+        _ = new ExchangeSystem();
+        _cleanup = Timer.DelayCall(TimeSpan.FromHours(13.0), TimeSpan.FromHours(13.0), CleanUp);
+    }
+
+    public static ExchangeCategory GetCategory(ExchangeNpcCategory category) =>
+        ExchangeConfig.Categories[Math.Clamp((int)category, 0, ExchangeConfig.Categories.Length - 1)];
+
+    public static ExchangeCommodity Find(Type type)
+    {
+        foreach (var category in ExchangeConfig.Categories)
+        {
+            if (category.Find(type) is { } commodity)
+            {
+                return commodity;
+            }
+        }
+
+        return null;
+    }
+
+    [OnEvent(nameof(PlayerMobile.PlayerLoginEvent))]
+    public static void OnLogin(PlayerMobile pm) => SendHistoryTo(pm);
+
+    public static void SendHistoryTo(Mobile m)
+    {
+        if (m?.NetState != null && History.TryGetValue(m, out var list) && list.Count > 0)
+        {
+            m.SendGump(new ExchangeHistoryGump(list), true);
+        }
+    }
+
+    public static IEnumerable<ExchangeOrder> OrdersOf(Mobile m, ExchangeCategory category)
+    {
+        foreach (var commodity in category.Commodities)
+        {
+            foreach (var bid in commodity.Bids)
+            {
+                if (bid.Mobile == m)
+                {
+                    yield return bid;
+                }
+            }
+
+            foreach (var offer in commodity.Offers)
+            {
+                if (offer.Mobile == m)
+                {
+                    yield return offer;
+                }
+            }
+        }
+    }
+
+    // Pays for a bid from the bank and matches it against the offers; what is left waits on the board.
+    // Returns null on success, or why it failed.
+    public static string PlaceBid(Mobile m, ExchangeCommodity commodity, double price, int quantity)
+    {
+        price = Math.Round(price, 2);
+
+        if (price <= 0)
+        {
+            return "Please enter a valid price.";
+        }
+
+        if (quantity < ExchangeConfig.MinimumQuantity)
+        {
+            return "We do not accept bids of under 25 goods.";
+        }
+
+        var cost = (long)(price * quantity) + ExchangeConfig.BuyCosts;
+
+        if (cost > int.MaxValue || !Banker.Withdraw(m, (int)cost))
+        {
+            return "You would not be able to afford such a transaction.";
+        }
+
+        var bid = new ExchangeBid(m, commodity, price, quantity, Core.Now);
+        var traders = new HashSet<Mobile> { m };
+
+        for (var i = 0; i < commodity.Offers.Count && bid.Quantity > 0;)
+        {
+            var offer = commodity.Offers[i];
+
+            if (!offer.OwnerExists)
+            {
+                commodity.Offers.RemoveAt(i);
+                continue;
+            }
+
+            if (offer.Price > bid.Price)
+            {
+                break;
+            }
+
+            Trade(bid, offer, bid.Price, traders);
+
+            if (offer.Quantity == 0)
+            {
+                commodity.Offers.RemoveAt(i);
+            }
+            else
+            {
+                i++;
+            }
+        }
+
+        if (bid.Quantity > 0)
+        {
+            commodity.Insert(bid);
+            m.SendMessage("Your order has been added to the exchange board.");
+        }
+        else
+        {
+            m.SendMessage("Your order has been executed.");
+        }
+
+        foreach (var trader in traders)
+        {
+            SendHistoryTo(trader);
+        }
+
+        return null;
+    }
+
+    // Takes a filled commodity deed and matches it against the bids; what is left waits on the board.
+    public static string PlaceOffer(Mobile m, CommodityDeed deed, double price)
+    {
+        price = Math.Round(price, 2);
+
+        if (price <= 0)
+        {
+            return "Please enter a valid price.";
+        }
+
+        if (deed?.Deleted != false || deed.Commodity == null || !deed.IsChildOf(m.Backpack))
+        {
+            return "Please make sure your deed is in your backpack.";
+        }
+
+        if (deed.Commodity.Amount < ExchangeConfig.MinimumQuantity)
+        {
+            return "We only accept deeds that contain at least 25 goods.";
+        }
+
+        var commodity = Find(deed.Commodity.GetType());
+
+        if (commodity == null)
+        {
+            return "I am sorry i do not exchange that kind of goods, you may want to try it at my collegues.";
+        }
+
+        var offer = new ExchangeOffer(m, commodity, price, deed.Commodity.Amount, Core.Now);
+        deed.Delete();
+
+        var traders = new HashSet<Mobile> { m };
+
+        for (var i = 0; i < commodity.Bids.Count && offer.Quantity > 0;)
+        {
+            var bid = commodity.Bids[i];
+
+            if (!bid.OwnerExists)
+            {
+                commodity.Bids.RemoveAt(i);
+                continue;
+            }
+
+            if (bid.Price < offer.Price)
+            {
+                break;
+            }
+
+            Trade(bid, offer, bid.Price, traders);
+
+            if (bid.Quantity == 0)
+            {
+                commodity.Bids.RemoveAt(i);
+            }
+            else
+            {
+                i++;
+            }
+        }
+
+        if (offer.Quantity > 0)
+        {
+            commodity.Insert(offer);
+            m.SendMessage("Your order has been added to the exchange board.");
+        }
+        else
+        {
+            m.SendMessage("Your order has been executed.");
+        }
+
+        foreach (var trader in traders)
+        {
+            SendHistoryTo(trader);
+        }
+
+        return null;
+    }
+
+    private static void Trade(ExchangeBid bid, ExchangeOffer offer, double price, HashSet<Mobile> traders)
+    {
+        var quantity = Math.Min(bid.Quantity, offer.Quantity);
+
+        GiveGoods(bid.Mobile, offer.Commodity.Type, quantity);
+        GiveMoney(offer.Mobile, (long)(price * quantity));
+        bid.Quantity -= quantity;
+        offer.Quantity -= quantity;
+
+        offer.Commodity.RecordTrade(price, quantity);
+        AddHistory(bid.Mobile, new ExchangeTransaction(offer.Commodity.Name, price, quantity, true, Core.Now));
+        AddHistory(offer.Mobile, new ExchangeTransaction(offer.Commodity.Name, price, quantity, false, Core.Now));
+
+        traders.Add(bid.Mobile);
+        traders.Add(offer.Mobile);
+    }
+
+    private static void AddHistory(Mobile m, ExchangeTransaction t)
+    {
+        if (!History.TryGetValue(m, out var list))
+        {
+            History[m] = list = [];
+        }
+
+        list.Add(t);
+    }
+
+    public static CommodityDeed MakeDeed(Type type, int amount)
+    {
+        var item = type.CreateInstance<Item>();
+        item.Amount = amount;
+
+        var deed = new CommodityDeed();
+
+        if (!deed.SetCommodity(item))
+        {
+            deed.Delete();
+            item.Delete();
+            return null;
+        }
+
+        return deed;
+    }
+
+    private static void GiveGoods(Mobile m, Type type, int amount)
+    {
+        if (amount > 0 && MakeDeed(type, amount) is { } deed)
+        {
+            m.BankBox.DropItem(deed);
+        }
+    }
+
+    // Large sums go into the bank as checks of up to a million, the rest as gold.
+    public static void GiveMoney(Mobile m, long money)
+    {
+        if (m?.Deleted != false)
+        {
+            return;
+        }
+
+        while (money > 2000)
+        {
+            var check = (int)Math.Min(money, 1_000_000);
+            m.BankBox.DropItem(new BankCheck(check));
+            money -= check;
+        }
+
+        if (money > 0)
+        {
+            m.BankBox.DropItem(new Gold((int)money));
+        }
+    }
+
+    // A cancelled bid gets its money back but not the fee; a cancelled offer gets its deed back less the seizure.
+    public static void Cancel(ExchangeOrder order)
+    {
+        switch (order)
+        {
+            case ExchangeBid bid when bid.Commodity.Bids.Remove(bid):
+                {
+                    GiveMoney(bid.Mobile, (long)(bid.Price * bid.Quantity));
+                    break;
+                }
+            case ExchangeOffer offer when offer.Commodity.Offers.Remove(offer):
+                {
+                    if (offer.OwnerExists && offer.Quantity - offer.Seizure > 0)
+                    {
+                        GiveGoods(offer.Mobile, offer.Commodity.Type, offer.Quantity - offer.Seizure);
+                    }
+
+                    break;
+                }
+        }
+    }
+
+    public static void CleanUp()
+    {
+        var now = Core.Now;
+        var lapsed = new List<ExchangeOrder>();
+
+        foreach (var category in ExchangeConfig.Categories)
+        {
+            foreach (var commodity in category.Commodities)
+            {
+                lapsed.AddRange(commodity.Bids.FindAll(b => now - b.Date > b.Lifetime || !b.OwnerExists));
+                lapsed.AddRange(commodity.Offers.FindAll(o => now - o.Date > o.Lifetime || !o.OwnerExists));
+            }
+        }
+
+        foreach (var order in lapsed)
+        {
+            Cancel(order);
+        }
+
+        var stale = new List<Mobile>();
+
+        foreach (var (m, list) in History)
+        {
+            list.RemoveAll(t => now - t.Date > ExchangeConfig.HistoryCleanTime);
+
+            if (list.Count == 0 || m.Deleted)
+            {
+                stale.Add(m);
+            }
+        }
+
+        foreach (var m in stale)
+        {
+            History.Remove(m);
+        }
+    }
+
+    public override void Serialize(IGenericWriter writer)
+    {
+        writer.WriteEncodedInt(0); // version
+
+        var commodities = new List<ExchangeCommodity>();
+
+        foreach (var category in ExchangeConfig.Categories)
+        {
+            commodities.AddRange(category.Commodities);
+        }
+
+        writer.WriteEncodedInt(commodities.Count);
+
+        foreach (var c in commodities)
+        {
+            writer.Write(c.Type.FullName);
+            writer.Write(c.LastPrice);
+            writer.WriteEncodedInt(c.LastQuantity);
+            writer.Write(c.LastExchangeTime);
+            writer.Write(c.HighestPrice);
+            writer.Write(c.LowestPrice);
+            writer.Write(c.TotalQuantity);
+            writer.Write(c.TotalRevenue);
+
+            writer.WriteEncodedInt(c.Days.Count);
+
+            foreach (var d in c.Days)
+            {
+                writer.WriteEncodedInt(d.Day);
+                writer.Write(d.HighestPrice);
+                writer.Write(d.LowestPrice);
+                writer.Write(d.TotalQuantity);
+                writer.Write(d.TotalRevenue);
+            }
+
+            WriteOrders(writer, c.Bids);
+            WriteOrders(writer, c.Offers);
+        }
+
+        writer.WriteEncodedInt(History.Count);
+
+        foreach (var (m, list) in History)
+        {
+            writer.Write(m);
+            writer.WriteEncodedInt(list.Count);
+
+            foreach (var t in list)
+            {
+                writer.Write(t.Name);
+                writer.Write(t.Price);
+                writer.WriteEncodedInt(t.Quantity);
+                writer.Write(t.Bought);
+                writer.Write(t.Date);
+            }
+        }
+    }
+
+    private static void WriteOrders<T>(IGenericWriter writer, List<T> orders) where T : ExchangeOrder
+    {
+        writer.WriteEncodedInt(orders.Count);
+
+        foreach (var o in orders)
+        {
+            writer.Write(o.Mobile);
+            writer.Write(o.Price);
+            writer.WriteEncodedInt(o.Quantity);
+            writer.Write(o.Date);
+        }
+    }
+
+    public override void Deserialize(IGenericReader reader)
+    {
+        reader.ReadEncodedInt(); // version
+
+        var count = reader.ReadEncodedInt();
+
+        for (var i = 0; i < count; i++)
+        {
+            var type = AssemblyHandler.FindTypeByFullName(reader.ReadString());
+            // A commodity no longer traded still has to be read past.
+            var c = (type != null ? Find(type) : null) ?? new ExchangeCommodity(null, typeof(Gold), "removed");
+
+            c.LastPrice = reader.ReadDouble();
+            c.LastQuantity = reader.ReadEncodedInt();
+            c.LastExchangeTime = reader.ReadDateTime();
+            c.HighestPrice = reader.ReadDouble();
+            c.LowestPrice = reader.ReadDouble();
+            c.TotalQuantity = reader.ReadLong();
+            c.TotalRevenue = reader.ReadLong();
+
+            var days = reader.ReadEncodedInt();
+
+            for (var d = 0; d < days; d++)
+            {
+                c.Days.Add(
+                    new ExchangeDay
+                    {
+                        Day = reader.ReadEncodedInt(),
+                        HighestPrice = reader.ReadDouble(),
+                        LowestPrice = reader.ReadDouble(),
+                        TotalQuantity = reader.ReadLong(),
+                        TotalRevenue = reader.ReadLong()
+                    }
+                );
+            }
+
+            var bids = reader.ReadEncodedInt();
+
+            for (var b = 0; b < bids; b++)
+            {
+                var bid = new ExchangeBid(reader.ReadEntity<Mobile>(), c, reader.ReadDouble(), reader.ReadEncodedInt(), reader.ReadDateTime());
+
+                if (bid.OwnerExists)
+                {
+                    c.Bids.Add(bid);
+                }
+            }
+
+            var offers = reader.ReadEncodedInt();
+
+            for (var o = 0; o < offers; o++)
+            {
+                var offer = new ExchangeOffer(reader.ReadEntity<Mobile>(), c, reader.ReadDouble(), reader.ReadEncodedInt(), reader.ReadDateTime());
+
+                if (offer.OwnerExists)
+                {
+                    c.Offers.Add(offer);
+                }
+            }
+        }
+
+        var people = reader.ReadEncodedInt();
+
+        for (var i = 0; i < people; i++)
+        {
+            var m = reader.ReadEntity<Mobile>();
+            var list = new List<ExchangeTransaction>();
+            var n = reader.ReadEncodedInt();
+
+            for (var j = 0; j < n; j++)
+            {
+                list.Add(new ExchangeTransaction(reader.ReadString(), reader.ReadDouble(), reader.ReadEncodedInt(), reader.ReadBool(), reader.ReadDateTime()));
+            }
+
+            if (m?.Deleted == false && list.Count > 0)
+            {
+                History[m] = list;
+            }
+        }
+    }
+}
