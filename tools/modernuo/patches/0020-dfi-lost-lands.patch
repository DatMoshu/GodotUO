+        Stack(LostLandsCategory.Arrows, "100 Crossbow Bolts", 7163, 600, () => new Bolt(100)),
+        Stack(LostLandsCategory.Arrows, "1000 Crossbow Bolts", 7163, 6000, () => new Bolt(1000)),
+        Pet("A Horse", 8484, 1100, () => new Horse()),
+        Pet("A Pack Llama", 8487, 1130, () => new PackLlama()),
