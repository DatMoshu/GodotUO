+// Papun, the Lost Lands' variety dealer, ported from DFI RUNUO Scripts/Custom/Mobiles/Townfolks and Vendors/NPC/
+// LLVarietyDealer. He sells verite gems for gold (20 gp, 200 inside the Lost Lands), buys them back for 50, and
+// through his gump sells supplies for gems at three gems per 50 gp of DFI's gold price.
+
+using System;
+using System.Collections.Generic;
+using ModernUO.Serialization;
+using Server.Collections;
+using Server.ContextMenus;
+using Server.Engines.BulkOrders;
+using Server.Gumps;
+using Server.Items;
+using Server.Multis;
+using Server.Network;
+
+namespace Server.Mobiles;
+
+public enum LostLandsCategory
+{
+    MageRegs = 1,
+    NecroRegs,
+    Potions,
+    Bands,
+    Arrows,
+    Weaps,
+    Armors,
+    Misc
+}
+
+public record LostLandsWare(LostLandsCategory Category, string Name, int ItemID, int GoldPrice, Func<Mobile, bool> Give)
+{
+    public int GemPrice => (int)Math.Ceiling(GoldPrice * 3 / 50.0);
+}
+
+public static class LostLandsWares
+{
+    public static readonly LostLandsWare[] All =
+    [
