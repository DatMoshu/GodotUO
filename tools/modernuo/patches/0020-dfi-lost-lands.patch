@@ -0,0 +1,230 @@
+using System;
+using System.Collections.Generic;
+using Server;
+using Server.Custom.Dfi;
+using Server.Engines.Insurance;
+using Server.Items;
+using Server.Misc;
+using Server.Mobiles;
+using Xunit;
+
+namespace UOContent.Tests.Custom;
+
+[Collection("Sequential UOContent Tests")]
+public class DfiLostLandsTests : IDisposable
+{
+    private static readonly Point3D Inside = new(5672, 3130, 14);
+    private static readonly Point3D Britain = new(1440, 1702, 0);
+
+    private readonly List<IEntity> _created = new();
+
+    public DfiLostLandsTests()
+    {
+        if (NameList.GetNameList("male") == null)
+        {
+            NameList.Configure();
+        }
+    }
+
+    public void Dispose()
+    {
+        foreach (var e in _created)
+        {
+            e?.Delete();
+        }
+
+        _created.Clear();
+    }
+
+    private T Track<T>(T e) where T : IEntity
+    {
+        _created.Add(e);
+        return e;
+    }
+
+    private PlayerMobile Player(Point3D at, int gold = 0)
+    {
+        var m = Track(new PlayerMobile());
+        m.Player = true;
+        m.Body = 0x190;
+        m.RawStr = 100;
+        m.AddItem(new Backpack());
+        m.AddItem(new BankBox(m));
+        m.MoveToWorld(at, Map.Felucca);
+
+        if (gold > 0)
+        {
+            m.BankBox.DropItem(new BankCheck(gold));
+        }
+
+        return m;
+    }
+
+    [Fact]
+    public void Zone_IsFeluccaT2AOnly()
+    {
+        Assert.True(LostLands.Contains(Map.Felucca, Inside));
+        Assert.False(LostLands.Contains(Map.Felucca, Britain));
+        Assert.False(LostLands.Contains(Map.Trammel, Inside));
+    }
+
+    [Fact]
+    public void Vendors_ChargeTenTimesInside()
+    {
+        var inside = Track(new Mage());
+        inside.MoveToWorld(Inside, Map.Felucca);
+        var outside = Track(new Mage());
+        outside.MoveToWorld(Britain, Map.Felucca);
+
+        Assert.Equal(LostLands.PriceScalar, inside.GetPriceScalar());
+        Assert.NotEqual(LostLands.PriceScalar, outside.GetPriceScalar());
+    }
+
+    [Fact]
+    public void Insurance_CannotBeSetInside()
+    {
+        var player = Player(Inside);
+
+        Insurance.ToggleItemInsurance(player);
+
+        Assert.Null(player.Target);
+    }
+
+    [Fact]
+    public void Gate_RefusesClothingOnTheWayIn_AndChargesForEquipment()
+    {
+        var player = Player(Britain);
+        var gate = Track(new LostLandsGate(Inside, Map.Felucca));
+        gate.MoveToWorld(new Point3D(1440, 1700, 0), Map.Felucca);
+
+        player.Backpack.DropItem(new Katana());
+        player.Backpack.DropItem(new PlateHelm());
+        Assert.Equal(2000, gate.CalculateCost(player));
+
+        player.Backpack.DropItem(new Robe());
+        Assert.Equal(-1, gate.CalculateCost(player));
+
+        var exit = Track(new LostLandsGate(Britain, Map.Felucca));
+        Assert.False(exit.IsEntrance);
+        Assert.Equal(3000, exit.CalculateCost(player));
+    }
+
+    [Fact]
+    public void Gate_PassingInChargesTheBankAndStripsProtection()
+    {
+        var player = Player(new Point3D(1440, 1701, 0), 5000);
+        var gate = Track(new LostLandsGate(Inside, Map.Felucca));
+        gate.MoveToWorld(new Point3D(1440, 1700, 0), Map.Felucca);
+
+        var helm = new PlateHelm { Insured = true };
+        var hat = new WizardsHat { LootType = LootType.Blessed };
+        player.Backpack.DropItem(helm);
+        player.Backpack.DropItem(hat);
+
+        gate.Pass(player);
+
+        Assert.Equal(Inside, player.Location);
+        Assert.Equal(3000, Banker.GetBalance(player));
+        Assert.False(helm.Insured);
+        Assert.Equal(LootType.Regular, hat.LootType);
+    }
+
+    [Fact]
+    public void Gate_WithoutTheGoldLetsNobodyThrough()
+    {
+        var player = Player(new Point3D(1440, 1701, 0), 500);
+        var gate = Track(new LostLandsGate(Inside, Map.Felucca));
+        gate.MoveToWorld(new Point3D(1440, 1700, 0), Map.Felucca);
+        player.Backpack.DropItem(new Katana());
+
+        gate.Pass(player);
+
+        Assert.Equal(new Point3D(1440, 1701, 0), player.Location);
+        Assert.Equal(500, Banker.GetBalance(player));
+    }
+
+    [Fact]
+    public void Creatures_InsideLeaveGemsForGold()
+    {
+        var orc = Track(new Orc());
+        orc.MoveToWorld(Inside, Map.Felucca);
+        var corpse = Track(new Corpse(orc, []));
+        corpse.DropItem(new Gold(600));
+
+        LostLands.OnCreatureDeath(orc, corpse);
+
+        Assert.Null(corpse.FindItemByType<Gold>());
+        Assert.Equal(10, corpse.GetAmount(typeof(VeriteGem)));
+    }
+
+    [Fact]
+    public void Creatures_OutsideKeepTheirGold()
+    {
+        var orc = Track(new Orc());
+        orc.MoveToWorld(Britain, Map.Felucca);
+        var corpse = Track(new Corpse(orc, []));
+        corpse.DropItem(new Gold(600));
+
+        LostLands.OnCreatureDeath(orc, corpse);
+
+        Assert.Equal(600, corpse.GetAmount(typeof(Gold)));
+        Assert.Null(corpse.FindItemByType<VeriteGem>());
+    }
+
+    [Fact]
+    public void Papun_SellsForGemsAtThreePerFiftyGold()
+    {
+        var player = Player(Inside);
+        var pearl = Array.Find(LostLandsWares.All, w => w.Name == "999 Black Pearl");
+
+        Assert.Equal(300, pearl.GemPrice);
+        Assert.Equal(47, LostLandsWares.All.Length);
+
+        player.Backpack.DropItem(new VeriteGem(299));
+        LostLandsWares.Buy(player, pearl);
+        Assert.Null(player.Backpack.FindItemByType<BlackPearl>());
+
+        player.Backpack.DropItem(new VeriteGem(1));
+        LostLandsWares.Buy(player, pearl);
+        Assert.Equal(999, player.Backpack.GetAmount(typeof(BlackPearl)));
+        Assert.Equal(0, player.Backpack.GetAmount(typeof(VeriteGem)));
+    }
+
+    [Fact]
+    public void Papun_EveryWareCanBeBought()
+    {
+        var player = Player(Inside);
+        player.Backpack.MaxItems = 10000;
+
+        foreach (var ware in LostLandsWares.All)
+        {
+            player.Backpack.DropItem(new VeriteGem(ware.GemPrice));
+            LostLandsWares.Buy(player, ware);
+            Assert.Equal(0, player.Backpack.GetAmount(typeof(VeriteGem)));
+        }
+
+        foreach (var m in player.GetMobilesInRange(1))
+        {
+            if (m is BaseCreature pet && pet.ControlMaster == player)
+            {
+                _created.Add(pet);
+            }
+        }
+    }
+
+    [Fact]
+    public void ForgottenOne_IsCertainOfAnArtifactAtFirst()
+    {
+        var knight = Track(new LLKnight());
+
+        Assert.True(knight.ArtifactChance >= 100000);
+        Assert.Equal(25000, knight.HitsMax);
+
+        for (var i = 0; i < 40; i++)
+        {
+            var artifact = LLKnight.CreateRandomArtifact();
+            Assert.NotNull(artifact);
+            artifact.Delete();
+        }
+    }
+}
