+public class LostLandsWaresGump : LostLandsGump
+{
+    private readonly List<LostLandsWare> _wares;
+
+    public LostLandsWaresGump(LostLandsCategory category) => _wares = LostLandsWares.In(category);
+
+    public override bool Singleton => true;
+
+    protected override void BuildLayout(ref DynamicGumpBuilder builder)
+    {
+        AddFrame(ref builder, "Available Items");
+        builder.AddLabel(110, 100, 1152, "Select an item to buy for Verite Gems.");
+        builder.AddLabel(110, 135, 1152, "Item:");
+        builder.AddLabel(335, 135, 1152, "Price:");
+        builder.AddButton(200, 450, 242, 241, 0);
+
+        builder.AddPage(1);
+        var page = 1;
+        var row = 0;
+
+        for (var i = 0; i < _wares.Count; i++)
+        {
+            if (row >= 9)
+            {
+                builder.AddButton(360, 450, 5601, 5605, 0, GumpButtonType.Page, ++page);
+                row = 0;
+                builder.AddPage(page);
+                builder.AddButton(80, 450, 5603, 5607, 0, GumpButtonType.Page, page - 1);
+            }
+
+            var ware = _wares[i];
+            builder.AddButton(75, 165 + row * 30, 4005, 4006, 1000 + i);
+            builder.AddItem(100, 165 + row * 30, ware.ItemID);
+            builder.AddLabel(145, 165 + row * 30, 1152, ware.Name);
+            builder.AddLabel(335, 165 + row * 30, 1152, $"{ware.GemPrice}");
+            row++;
+        }
+    }
+
+    public override void OnResponse(NetState sender, in RelayInfo info)
+    {
+        var m = sender.Mobile;
+        var index = info.ButtonID - 1000;
+
+        if (info.ButtonID == 0)
+        {
+            m.SendGump(new LostLandsCategoriesGump(), true);
+        }
+        else if (index >= 0 && index < _wares.Count)
+        {
+            LostLandsWares.Buy(m, _wares[index]);
+        }
+    }
+}
