+    protected override void BuildLayout(ref DynamicGumpBuilder builder)
+    {
+        AddFrame(ref builder, "Item Categories");
+        builder.AddLabel(125, 110, 1152, "Category:");
+
+        for (var i = 0; i < _names.Length; i++)
