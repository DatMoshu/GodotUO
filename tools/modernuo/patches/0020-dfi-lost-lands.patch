+        Magic(LostLandsCategory.Armors, "Leather Gloves", 5062, 400, () => new LeatherGloves()),
+        Magic(LostLandsCategory.Armors, "Leather Gorget", 5063, 470, () => new LeatherGorget()),
+        Magic(LostLandsCategory.Armors, "Leather Leggings", 5067, 500, () => new LeatherLegs()),
+        Magic(LostLandsCategory.Armors, "Leather Cap", 7609, 150, () => new LeatherCap()),
+        Magic(LostLandsCategory.Armors, "Leather Sleeves", 5069, 500, () => new LeatherArms()),
+        Stack(LostLandsCategory.Misc, "300 Gold coins", 3823, 100, () => new Gold(300)),
+        Stack(LostLandsCategory.Misc, "3000 Gold coins", 3823, 1000, () => new Gold(3000)),
+        Stack(LostLandsCategory.Misc, "Bulk Order Book", 8793, 6000, () => new BulkOrderBook()),
+        Stack(LostLandsCategory.Misc, "Drums", 3740, 21, () => new Drums { Quality = InstrumentQuality.Exceptional }),
+        Stack(LostLandsCategory.Misc, "Exceptional Quality Tambourine", 3742, 5000,
+            () => new TambourineTassel { Quality = InstrumentQuality.Exceptional }),
+        Stack(LostLandsCategory.Misc, "Small Dragon Ship", 5364, 10177, () => new SmallDragonBoatDeed()),
+        Stack(LostLandsCategory.Misc, "Large Dragon Ship", 5364, 12927, () => new LargeDragonBoatDeed())
+    ];
+
+    public static List<LostLandsWare> In(LostLandsCategory category) => new(Array.FindAll(All, w => w.Category == category));
+
+    private static LostLandsWare Stack(LostLandsCategory category, string name, int itemID, int price, Func<Item> make) =>
+        new(category, name, itemID, price, m => m.AddToBackpack(make()));
+
+    private static LostLandsWare Potions(string name, int itemID, Func<Item> make) =>
+        new(LostLandsCategory.Potions, name, itemID, 45, m =>
+        {
+            m.AddToBackpack(new RefreshPotion());
+            m.AddToBackpack(new RefreshPotion());
+            return m.AddToBackpack(make());
+        });
+
+    private static LostLandsWare Magic(LostLandsCategory category, string name, int itemID, int price, Func<Item> make) =>
+        new(category, name, itemID, price, m =>
+        {
+            var item = make();
+            var props = Utility.RandomMinMax(1, 4);
+
+            switch (item)
+            {
+                case BaseWeapon weapon:
+                    {
+                        BaseRunicTool.ApplyAttributesTo(weapon, props, 40, 80);
+                        break;
+                    }
+                case BaseArmor armor:
+                    {
+                        BaseRunicTool.ApplyAttributesTo(armor, props, 40, 80);
+                        break;
+                    }
+            }
+
+            return m.AddToBackpack(item);
+        });
+
+    private static LostLandsWare Pet(string name, int itemID, int price, Func<BaseCreature> make) =>
+        new(LostLandsCategory.Misc, name, itemID, price, m =>
+        {
+            var pet = make();
+            pet.SetControlMaster(m);
+            pet.MoveToWorld(m.Location, m.Map);
+            return true;
+        });
+
+    public static void Buy(Mobile m, LostLandsWare ware)
+    {
+        if (m.Backpack?.ConsumeTotal(typeof(VeriteGem), ware.GemPrice) != true)
+        {
+            m.SendMessage("You do not have enough Verite Gems in your backpack.");
+            return;
+        }
+
+        ware.Give(m);
+        m.SendMessage(ware.Category == LostLandsCategory.Misc && ware.Name.StartsWith("A ") ? "Here is the pet you requested." : "Here are the goods you requested.");
+    }
+}
