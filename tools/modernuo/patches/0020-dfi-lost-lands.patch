diff --git a/Projects/UOContent/Custom/DFI/LostLands/DfiLostLandsGen.cs b/Projects/UOContent/Custom/DFI/LostLands/DfiLostLandsGen.cs
new file mode 100644
index 000000000..10789fb3f
--- /dev/null
+++ b/Projects/UOContent/Custom/DFI/LostLands/DfiLostLandsGen.cs
@@ -0,0 +1,75 @@
+// Places the way into the Lost Lands: a gate on Britain's main street to Papua, one back in Papua's bank, and
+// Papun beside Papua's banker. DFI's saves kept none of these; the Forgotten One is spawned by staff.
+
+using System.Collections.Generic;
+using Server.Commands;
+using Server.Items;
+using Server.Logging;
+using Server.Mobiles;
+
+namespace Server.Custom.Dfi;
+
+public static class DfiLostLandsGen
+{
+    private static readonly ILogger logger = LogFactory.GetLogger(typeof(DfiLostLandsGen));
+
+    public static readonly Point3D BritainGate = new(1440, 1700, 0);
+    public static readonly Point3D BritainArrival = new(1440, 1702, 0);
+    public static readonly Point3D PapuaGate = new(5673, 3131, 14);
+    public static readonly Point3D PapuaArrival = new(5672, 3130, 14);
+    public static readonly Point3D PapunSpot = new(5665, 3131, 14);
+
+    public static void Configure()
+    {
+        CommandSystem.Register("DfiLostLands", AccessLevel.Administrator, OnCommand);
+    }
+
+    [Usage("DfiLostLands")]
+    [Description("Places the Lost Lands gates (Britain and Papua) and Papun, replacing any placed before.")]
+    private static void OnCommand(CommandEventArgs e)
+    {
+        var removed = Remove();
+        var placed = Place();
+        e.Mobile.SendMessage($"DfiLostLands: removed {removed}, placed {placed}.");
+        logger.Information("{User} placed {Placed} Lost Lands fixtures ({Removed} removed)", e.Mobile, placed, removed);
+    }
+
+    public static int Remove()
+    {
+        var doomed = new List<IEntity>();
+
+        foreach (var item in World.Items.Values)
+        {
+            if (item is LostLandsGate)
+            {
+                doomed.Add(item);
+            }
+        }
+
+        foreach (var m in World.Mobiles.Values)
+        {
+            if (m is LostLandsVendor)
+            {
+                doomed.Add(m);
+            }
+        }
+
+        foreach (var entity in doomed)
+        {
+            entity.Delete();
+        }
+
+        return doomed.Count;
+    }
+
+    public static int Place()
+    {
+        new LostLandsGate(PapuaArrival, Map.Felucca).MoveToWorld(BritainGate, Map.Felucca);
+        new LostLandsGate(BritainArrival, Map.Felucca).MoveToWorld(PapuaGate, Map.Felucca);
+
+        var papun = new LostLandsVendor { Home = PapunSpot, RangeHome = 0, Direction = Direction.South };
+        papun.MoveToWorld(PapunSpot, Map.Felucca);
+
+        return 3;
+    }
+}
diff --git a/Projects/UOContent/Custom/DFI/LostLands/ForgottenOne.cs b/Projects/UOContent/Custom/DFI/LostLands/ForgottenOne.cs
new file mode 100644
index 000000000..cda3d0d97
--- /dev/null
+++ b/Projects/UOContent/Custom/DFI/LostLands/ForgottenOne.cs
@@ -0,0 +1,224 @@
+// "The Forgotten One", DFI Network's Lost Lands knight, ported from DFI RUNUO Scripts/Custom/Mobiles/Monsters/
+// LLDemonKnight.cs (class LLKnight). A 25,000-hit dark knight staff spawn for events. The longer he lives the
+// smaller the chance he leaves an artifact: certain in his first ten minutes, 40% after an hour (plus luck).
+// Every few minutes he is announced to the shard with his health and the current chance; in Khaldun he may
+// vanish once the chance has fallen and nobody has hurt him. Without an artifact he leaves copper bars.
+
+using System;
+using ModernUO.Serialization;
+using Server.Commands;
+using Server.Custom.Dfi;
+using Server.Engines.Quests.Midas;
+using Server.Engines.Quests.Plague;
+using Server.Items;
+
+namespace Server.Mobiles;
+
+[SerializationGenerator(0)]
+public partial class LLKnight : DemonKnight
+{
+    private static readonly Type[] _artifacts =
+    [
+        typeof(TheTaskmaster), typeof(LegacyOfTheDreadLord), typeof(TheDragonSlayer), typeof(GauntletsOfNobility),
+        typeof(HolyKnightsBreastplate), typeof(LeggingsOfBane), typeof(MidnightBracers), typeof(OrnateCrownOfTheHarrower),
+        typeof(ShadowDancerLeggings), typeof(TunicOfFire), typeof(VoiceOfTheFallenKing), typeof(BraceletOfHealth),
+        typeof(RingOfTheElements), typeof(RingOfTheVile), typeof(Aegis), typeof(AxeOfTheHeavens), typeof(BladeOfInsanity),
+        typeof(BoneCrusher), typeof(BreathOfTheDead), typeof(Frostbringer), typeof(SerpentsFang), typeof(StaffOfTheMagi),
+        typeof(TheBeserkersMaul), typeof(TheDryadBow), typeof(DivineCountenance),
+        // From here on the more valuable ones.
+        typeof(ArcaneShield), typeof(ArmorOfFortune), typeof(JackalsCollar), typeof(HelmOfInsight),
+        typeof(OrnamentOfTheMagician), typeof(HatOfTheMagi), typeof(HuntersHeaddress), typeof(SpiritOfTheTotem),
+        // DFI's own.
+        typeof(BookOfLostKnowledge), typeof(BowOfWeakening), typeof(GlovesOfTheLepracon), typeof(GrizzlysCourage)
+    ];
+
+    [SerializableField(0, fieldChanged: nameof(OnBroadcastChanged))]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private bool _broadcast;
+
+    private void OnBroadcastChanged(bool oldValue, bool newValue)
+    {
+        if (newValue && !oldValue && _announcer?.Running != true)
+        {
+            StartAnnouncer(TimeSpan.FromMinutes(5.0));
+        }
+    }
+
+    [SerializableField(1)]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private bool _curseArtifact;
+
+    [SerializableField(2)]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private int _cursedDurationMinutes = 7;
+
+    [SerializableField(3)]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private string _knightLocation;
+
+    [SerializableField(4, setter: "private")]
+    private DateTime _spawnTime;
+
+    private Timer _announcer;
+
+    [Constructible(AccessLevel.GameMaster)]
+    public LLKnight(int broadcastDelayMinutes = 5)
+    {
+        Name = NameList.RandomName("male");
+        Title = "the Forgotten One";
+        Body = 256;
+        SetHits(25000);
+        _spawnTime = Core.Now;
+        StartAnnouncer(TimeSpan.FromMinutes(Math.Max(1, broadcastDelayMinutes)));
+    }
+
+    public override string CorpseName => "a dark knight corpse";
+
+    public bool InKhaldun => Region?.IsPartOf("Khaldun") == true;
+
+    public override void GenerateLoot()
+    {
+        AddLoot(LootPack.SuperBoss, 2);
+
+        for (var i = 0; i < 8; i++)
+        {
+            var reg = Loot.RandomPossibleReagent();
+            reg.Amount = Utility.RandomMinMax(20, 50);
+            PackItem(reg);
+        }
+    }
+
+    // Out of 100,000.
+    public int ArtifactChance
+    {
+        get
+        {
+            var minutes = (Core.Now - _spawnTime).TotalMinutes;
+            var chance = minutes switch
+            {
+                > 60 => 40000,
+                > 50 => 50000,
+                > 40 => 60000,
+                > 30 => 70000,
+                > 20 => 80000,
+                > 10 => 90000,
+                _    => 100000
+            };
+
+            return chance + LootPack.GetLuckChanceForKiller(this) / 5;
+        }
+    }
+
+    // A quarter of the time from the whole list, half the time only from the regular ones, else up to DFI's own.
+    public static Item CreateRandomArtifact() =>
+        Loot.Construct(_artifacts[Utility.Random(Utility.Random(4) switch { 0 => _artifacts.Length, 1 => 33, _ => 25 })]);
+
+    public override void OnDeath(Container c)
+    {
+        base.OnDeath(c);
+
+        Item artifact = null;
+
+        if (!Summoned && !NoKillAwards && ArtifactChance > Utility.Random(100000))
+        {
+            artifact = CreateRandomArtifact();
+            DistributeArtifact(this, artifact);
+
+            if (_curseArtifact && artifact != null)
+            {
+                new CursedArtifactTimer(artifact, _cursedDurationMinutes).Start();
+            }
+        }
+        else
+        {
+            c.DropItem(new CopperBar(Utility.Random(1, 5)));
+        }
+
+        CommandHandlers.BroadcastMessage(AccessLevel.Player, 1150, "The Forgotten One has been killed.");
+
+        if (artifact?.Name != null)
+        {
+            CommandHandlers.BroadcastMessage(AccessLevel.Player, 1150, $"The reward was {artifact.Name}.");
+        }
+
+        _announcer?.Stop();
+    }
+
+    [AfterDeserialization]
+    private void AfterDeserialization()
+    {
+        if (InKhaldun || _broadcast)
+        {
+            StartAnnouncer(TimeSpan.FromMinutes(5.0));
+        }
+    }
+
+    public override void OnAfterDelete()
+    {
+        _announcer?.Stop();
+        _announcer = null;
+        base.OnAfterDelete();
+    }
+
+    private void StartAnnouncer(TimeSpan delay)
+    {
+        _announcer?.Stop();
+        _announcer = Timer.DelayCall(TimeSpan.Zero, delay, Announce);
+    }
+
+    private void Announce()
+    {
+        if (Deleted)
+        {
+            _announcer?.Stop();
+            return;
+        }
+
+        var chance = ArtifactChance / 1000;
+
+        if (InKhaldun)
+        {
+            if (chance <= 40 && Utility.Random(3) == 0)
+            {
+                if (Hits == HitsMax && Utility.RandomBool())
+                {
+                    CommandHandlers.BroadcastMessage(AccessLevel.Player, 1150, "The Forgotten One has vanished.");
+                    Delete();
+                    return;
+                }
+
+                var hurry = Hits == HitsMax ? " Hurry up, it will vanish soon!" : "";
+                CommandHandlers.BroadcastMessage(
+                    AccessLevel.Player, 1150,
+                    $"The Forgotten one is still in Khaldun! If you find and kill him, you have {chance}% chance to receive an artifact!{hurry}"
+                );
+                return;
+            }
+
+            AnnounceHealth("Khaldun", chance);
+        }
+        else if (_broadcast)
+        {
+            AnnounceHealth(string.IsNullOrEmpty(_knightLocation) ? "the world" : _knightLocation, chance);
+        }
+        else
+        {
+            _announcer?.Stop();
+        }
+    }
+
+    private void AnnounceHealth(string where, int chance)
+    {
+        var health = Hits < HitsMax / 4 ? ", and it has less than 1/4 of its health!" :
+            Hits < HitsMax / 2 ? ", and it has less than half of its health!" :
+            Hits < HitsMax - HitsMax / 4 ? ", and it has less than 3/4 of its health!" : "!";
+
+        CommandHandlers.BroadcastMessage(AccessLevel.Player, 1150, $"The Forgotten one roams in {where}{health}");
+        CommandHandlers.BroadcastMessage(AccessLevel.Player, 1150, $"If you kill him, you have {chance}% chance to receive an artifact!");
+
+        if (chance >= 90)
+        {
+            CommandHandlers.BroadcastMessage(AccessLevel.Player, 1150, "The slower you kill him, the lower the chance gets.");
+        }
+    }
+}
diff --git a/Projects/UOContent/Custom/DFI/LostLands/LostLands.cs b/Projects/UOContent/Custom/DFI/LostLands/LostLands.cs
new file mode 100644
index 000000000..f617b4b11
--- /dev/null
+++ b/Projects/UOContent/Custom/DFI/LostLands/LostLands.cs
@@ -0,0 +1,311 @@
+// DFI Network's Lost Lands: T2A Felucca and Khaldun played by harder rules. Ported from DFI RUNUO
+// Scripts/Custom/Items/Misc/LLTeleporter.cs, Custom/Engines/LostLandsVendor/VeriteGem.cs and the "Lost Lands"
+// changes DFI made to RunUO's BaseCreature, BaseChampion, Banker, BaseVendor and PlayerMobile.
+//
+// Inside: no insurance, no bank box (balance, withdraw and deposit still work), shop prices ten times over,
+// creatures carry verite gems and magic items instead of gold, and champions may drop the Armor of the Sun.
+// The way in is a Lost Lands gate, which takes only equipment, charges 1,000 gp per item and on entry ends
+// every item's insurance and unblesses blessed hats.
+
+using System;
+using System.Collections.Generic;
+using ModernUO.Serialization;
+using Server.Custom.Dfi;
+using Server.Engines.CannedEvil;
+using Server.Gumps;
+using Server.Mobiles;
+using Server.Network;
+using Server.Spells;
+
+namespace Server.Items
+{
+    public static class LostLands
+    {
+        public const int PriceScalar = 1000;
+        public const int GatePricePerItem = 1000;
+
+        public static bool Contains(Map map, Point3D loc) =>
+            SpellHelper.IsFeluccaT2A(map, loc) || map != null && map != Map.Internal && Region.Find(loc, map).IsPartOf("Khaldun");
+
+        public static bool Contains(Mobile m) => m != null && Contains(m.Map, m.Location);
+
+        // Called from DfiLoot.OnCreatureDeath with the corpse. Each 50 gold becomes a verite gem (up to ten) and
+        // pays for a chance at a magic item (up to six); champions may leave a piece of the Armor of the Sun.
+        public static void OnCreatureDeath(BaseCreature creature, Container corpse)
+        {
+            if (!Contains(creature.Map, creature.Location))
+            {
+                return;
+            }
+
+            if (corpse.FindItemByType<Gold>() is { } gold)
+            {
+                var amount = gold.Amount;
+                gold.Delete();
+
+                if (creature.LastKiller != null)
+                {
+                    DfiLoot.AddRandomLoot(
+                        corpse, Math.Min(6, Utility.Random(amount / 50)), LootPack.GetLuckChanceForKiller(creature), 4, 4, 60, 90
+                    );
+                }
+
+                if (amount >= 50)
+                {
+                    corpse.DropItem(new VeriteGem(Math.Min(10, amount / 50)));
+                }
+            }
+
+            if (creature is BaseChampion && Utility.RandomDouble() < 0.6)
+            {
+                corpse.DropItem(
+                    Utility.Random(6) switch
+                    {
+                        0 => new SunChest(),
+                        1 => new SunGloves(),
+                        2 => new SunArms(),
+                        3 => new SunLegs(),
+                        4 => new SunGorget(),
+                        _ => (Item)new SunHelm()
+                    }
+                );
+            }
+        }
+    }
+
+    // The Lost Lands' currency, spent at Papun's.
+    [SerializationGenerator(0)]
+    public partial class VeriteGem : Item
+    {
+        [Constructible]
+        public VeriteGem(int amount = 1) : base(0x3191)
+        {
+            Stackable = true;
+            Amount = Math.Max(1, amount);
+            Hue = 2210;
+        }
+
+        public override string DefaultName => "verite gem";
+        public override double DefaultWeight => 0.02;
+
+        public override int GetDropSound() => 0x2E4;
+    }
+
+    // A gate into or out of the Lost Lands. Its direction is where it leads: a gate whose target is in the Lost
+    // Lands is an entrance.
+    [SerializationGenerator(0)]
+    public partial class LostLandsGate : Moongate
+    {
+        [Constructible(AccessLevel.Administrator)]
+        public LostLandsGate() : this(Point3D.Zero, null)
+        {
+        }
+
+        // A red moongate: DFI's own gate art (14170) is an effect graphic that does not draw as an item.
+        public LostLandsGate(Point3D target, Map targetMap) : base(target, targetMap, false) => Hue = 0x21;
+
+        public override string DefaultName => "a Lost Lands gate";
+
+        public bool IsEntrance => LostLands.Contains(TargetMap, Target);
+
+        private static bool AllowedThrough(Item item) =>
+            item is BaseArmor or BaseWeapon or BaseJewel or BaseHat or Spellbook or Runebook;
+
+        // The gold the passage costs, or -1 (with a message) when the player carries what may not go in.
+        public int CalculateCost(Mobile m)
+        {
+            if (m.AccessLevel > AccessLevel.Player || m.Backpack == null)
+            {
+                return 0;
+            }
+
+            if (m.Holding != null)
+            {
+                m.Backpack.DropItem(m.Holding);
+            }
+
+            var entrance = IsEntrance;
+            var cost = 0;
+
+            foreach (var item in m.Backpack.Items)
+            {
+                if (AllowedThrough(item) || item is EtherealMount || !entrance)
+                {
+                    cost += LostLands.GatePricePerItem;
+                }
+                else
+                {
+                    m.SendMessage("You can only carry armors, weapons, jewels, spellbooks, runebooks and ethereal mounts through this gate.");
+                    return -1;
+                }
+            }
+
+            foreach (var item in m.Items)
+            {
+                if (item.Layer is Layer.Backpack or Layer.Bank or Layer.Hair or Layer.FacialHair ||
+                    item.Layer == Layer.Mount && m.Mount is EtherealMount)
+                {
+                    continue;
+                }
+
+                if (AllowedThrough(item) || !entrance)
+                {
+                    cost += LostLands.GatePricePerItem;
+                }
+                else
+                {
+                    m.SendMessage("You can only wear armors, weapons, jewels and spellbooks through this gate. Please remove all clothing.");
+                    return -1;
+                }
+            }
+
+            return cost;
+        }
+
+        public override void UseGate(Mobile m)
+        {
+            if (m.AccessLevel > AccessLevel.Player && m.AccessLevel < AccessLevel.Administrator)
+            {
+                m.SendLocalizedMessage(1019004); // You are not allowed to travel there.
+                return;
+            }
+
+            if (TargetMap == null || TargetMap == Map.Internal)
+            {
+                m.SendMessage("This moongate does not seem to go anywhere.");
+                return;
+            }
+
+            if (!m.Alive)
+            {
+                m.SendLocalizedMessage(500590); // You're a ghost, and can't do that.
+                return;
+            }
+
+            var cost = CalculateCost(m);
+
+            if (cost < 0)
+            {
+                return;
+            }
+
+            if (Banker.GetBalance(m) < cost)
+            {
+                m.SendMessage(
+                    "You do not have enough gold in bank to use this gate. It costs 1000 gp per item, so you must either drop your items on the ground, or collect more gold in your bank."
+                );
+                return;
+            }
+
+            m.SendGump(new LostLandsGateGump(this, cost), true);
+        }
+
+        public void Pass(Mobile m)
+        {
+            if (!ValidateUse(m, true) || !m.Alive)
+            {
+                return;
+            }
+
+            var cost = CalculateCost(m);
+
+            if (cost < 0)
+            {
+                return;
+            }
+
+            if (cost > 0 && !Banker.Withdraw(m, cost))
+            {
+                m.SendLocalizedMessage(1062507); // You do not have that much money in your bank account.
+                return;
+            }
+
+            if (IsEntrance && m.AccessLevel == AccessLevel.Player)
+            {
+                StripProtection(m);
+            }
+
+            // Pets stay behind: the Lost Lands are crossed alone.
+            m.MoveToWorld(Target, TargetMap);
+
+            if (m.AccessLevel == AccessLevel.Player || !m.Hidden)
+            {
+                m.PlaySound(0x1FE);
+            }
+        }
+
+        public static void StripProtection(Mobile m)
+        {
+            var items = new List<Item>(m.Items);
+
+            if (m.Backpack != null)
+            {
+                items.AddRange(m.Backpack.Items);
+            }
+
+            foreach (var item in items)
+            {
+                if (item is BaseHat && item.LootType == LootType.Blessed)
+                {
+                    item.LootType = LootType.Regular;
+                }
+                else
+                {
+                    item.Insured = false;
+                }
+            }
+
+            m.SendMessage("The insurance of all your items has been cancelled and all your blessed armors are regular now.");
+        }
+    }
+
+    public class LostLandsGateGump : StaticGump<LostLandsGateGump>
+    {
+        private readonly LostLandsGate _gate;
+        private readonly int _cost;
+
+        public LostLandsGateGump(LostLandsGate gate, int cost) : base(150, 150)
+        {
+            _gate = gate;
+            _cost = cost;
+        }
+
+        public override bool Singleton => true;
+
+        protected override void BuildLayout(ref StaticGumpBuilder builder)
+        {
+            builder.AddPage();
+            builder.AddBackground(0, 0, 300, 210, 5054);
+            builder.AddImageTiled(10, 10, 280, 22, 2624);
+            builder.AddAlphaRegion(10, 10, 280, 22);
+            builder.AddHtmlLocalized(10, 12, 280, 20, 1019005, 0x7800); // Warning!
+            builder.AddImageTiled(10, 40, 280, 130, 2624);
+            builder.AddAlphaRegion(10, 40, 280, 130);
+            builder.AddHtmlPlaceholder(14, 44, 272, 122, "message");
+            builder.AddButton(10, 180, 0xFA5, 0xFA7, 1);
+            builder.AddHtmlLocalized(40, 182, 100, 20, 1011036, 0x7FFF); // OKAY
+            builder.AddButton(160, 180, 0xFB1, 0xFB2, 0);
+            builder.AddHtmlLocalized(190, 182, 100, 20, 1011012, 0x7FFF); // CANCEL
+        }
+
+        protected override void BuildStrings(ref GumpStringsBuilder builder)
+        {
+            var entrance = _gate.IsEntrance;
+            var charge = _cost > 0 ? $"You will be charged {_cost} gp for the items you are carrying (1000 gp per item)." : "";
+
+            builder.SetHtmlText(
+                "message",
+                $"If you select OKAY, you will {(entrance ? "enter" : "exit")} the Lost Lands and insurance {(entrance ? "will NOT work anymore, and all your blessed items will become regular" : "will work again")}. {charge}<BR><BR>Are you sure you wish to pass?",
+                "#FFFFFF"
+            );
+        }
+
+        public override void OnResponse(NetState sender, in RelayInfo info)
+        {
+            if (info.ButtonID == 1 && !_gate.Deleted)
+            {
+                _gate.Pass(sender.Mobile);
+            }
+        }
+    }
+}
