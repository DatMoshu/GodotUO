+        Stack(LostLandsCategory.MageRegs, "999 Blood Moss", 3963, 5000, () => new Bloodmoss(999)),
+        Stack(LostLandsCategory.MageRegs, "999 Mandrake Root", 3974, 3000, () => new MandrakeRoot(999)),
