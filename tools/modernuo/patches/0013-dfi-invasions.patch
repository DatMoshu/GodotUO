@@ -0,0 +1,213 @@
+using System;
+using Server;
+using Server.Custom.Dfi;
+using Server.Misc;
+using Server.Mobiles;
+using Server.Regions;
+using Xunit;
+
+namespace UOContent.Tests.Custom;
+
+[Collection("Sequential UOContent Tests")]
+public class DfiInvasionTests : IDisposable
+{
+    private readonly TownRegion _britain;
+
+    public DfiInvasionTests()
+    {
+        if (NameList.GetNameList("male") == null)
+        {
+            NameList.Configure();
+        }
+
+        // The test server loads no regions.json; a stand-in Britain the invasions can find by name.
+        if (Invasions.FindTown("Britain") == null)
+        {
+            _britain = new TownRegion("Britain", Map.Felucca, 50, new Rectangle3D(1416, 1498, -128, 324, 279, 256))
+            {
+                GoLocation = new Point3D(1495, 1629, 0)
+            };
+            _britain.Register();
+        }
+    }
+
+    public void Dispose()
+    {
+        Invasions.StopAll();
+        _britain?.Unregister();
+    }
+
+    public static TheoryData<string> Presets
+    {
+        get
+        {
+            var data = new TheoryData<string>();
+
+            foreach (var preset in Invasions.Presets)
+            {
+                data.Add(preset.Name);
+            }
+
+            return data;
+        }
+    }
+
+    [Theory]
+    [MemberData(nameof(Presets))]
+    public void Preset_EveryCreatureAndTheBossConstruct(string name)
+    {
+        var preset = Invasions.FindPreset(name);
+
+        Assert.Equal(Invasion.Levels, preset.Levels.Length);
+
+        foreach (var level in preset.Levels)
+        {
+            Assert.NotEmpty(level);
+
+            foreach (var type in level)
+            {
+                type.CreateInstance<BaseCreature>().Delete();
+            }
+        }
+
+        preset.Boss.CreateInstance<BaseCreature>().Delete();
+    }
+
+    [Theory]
+    [InlineData("britain", "Britain")]
+    [InlineData("SERP", "Serpent's Hold")]
+    [InlineData("skara", "Skara Brae")]
+    [InlineData("nujelm", "Nujel'm")]
+    [InlineData("bucc", "Buccaneer's Den")]
+    [InlineData("m", null)]
+    [InlineData("atlantis", null)]
+    public void MatchTown_TakesAnyCaseOrAUniqueBeginning(string text, string expected)
+    {
+        Assert.Equal(expected, Invasions.MatchTown(text));
+    }
+
+    [Fact]
+    public void Settings_RejectBadValues_AndTakeGoodOnes()
+    {
+        var s = new InvasionSettings();
+
+        Assert.NotNull(s.Set("bosskills", "3"));
+        Assert.NotNull(s.Set("maxalive", "lots"));
+        Assert.NotNull(s.Set("preset", "pirates"));
+        Assert.NotNull(s.Set("boss", "Backpack"));
+        Assert.NotNull(s.Set("colour", "red"));
+
+        Assert.Null(s.Set("bosskills", "200"));
+        Assert.Null(s.Set("preset", "UNDEAD"));
+        Assert.Null(s.Set("boss", "balron"));
+        Assert.Null(s.Set("guards", "on"));
+        Assert.Null(s.Set("buffs", "off"));
+
+        Assert.Equal(200, s.BossKills);
+        Assert.Equal("undead", s.Preset);
+        Assert.Equal("Balron", s.Boss);
+        Assert.False(s.GuardsOff);
+        Assert.False(s.Buffs);
+    }
+
+    [Fact]
+    public void Buff_DoublesHitsAndAddsDamage()
+    {
+        var orc = new Orc();
+        var hits = orc.HitsMaxSeed;
+        var damage = orc.DamageMax;
+
+        Invasion.Buff(orc);
+
+        Assert.Equal(hits * 2, orc.HitsMaxSeed);
+        Assert.Equal(damage + 5, orc.DamageMax);
+        orc.Delete();
+    }
+
+    [Fact]
+    public void Level_RisesWithKillsTowardsTheBoss()
+    {
+        var invasion = new Invasion("Britain", new InvasionSettings { BossKills = 840 });
+
+        Assert.Equal(0, invasion.Level);
+        Assert.Equal("Britain", invasion.Town);
+    }
+
+    [Fact]
+    public void Command_StartsChangesAndStopsAnInvasion()
+    {
+        Assert.Contains("started", InvasionCommand.Run(["start", "britain", "undead"]));
+
+        var invasion = Invasions.Find("Britain");
+        Assert.NotNull(invasion);
+        Assert.Equal("undead", invasion.Settings.Preset);
+        Assert.True(invasion.Region.GuardsDisabled);
+
+        Assert.Contains("already", InvasionCommand.Run(["start", "britain"]));
+
+        InvasionCommand.Run(["set", "bosskills", "50"]);
+        Assert.Equal(50, invasion.Settings.BossKills);
+
+        Assert.Contains("Britain", InvasionCommand.Status());
+
+        Assert.Contains("stopped", InvasionCommand.Run(["stop", "britain"]));
+        Assert.Null(Invasions.Find("Britain"));
+        Assert.False(invasion.Region.GuardsDisabled);
+        Assert.Empty(invasion.Invaders);
+    }
+
+    [Fact]
+    public void Kills_CountCreditAndSummonTheBoss()
+    {
+        Assert.Null(Invasions.Start("Britain", new InvasionSettings { BossKills = 10, MaxAlive = 12, Buffs = false }));
+        var invasion = Invasions.Find("Britain");
+
+        Assert.True(invasion.Invaders.Count > 0, "nothing spawned in the test Britain");
+
+        var player = new PlayerMobile(World.NewMobile);
+        player.DefaultMobileInit();
+
+        try
+        {
+            while (invasion.Kills < 10)
+            {
+                var invaders = new BaseCreature[invasion.Invaders.Count];
+                ((System.Collections.Generic.ICollection<BaseCreature>)invasion.Invaders).CopyTo(invaders, 0);
+
+                foreach (var bc in invaders)
+                {
+                    if (invasion.Kills >= 10)
+                    {
+                        break;
+                    }
+
+                    invasion.Credit(player);
+                    invasion.OnCreatureDeath(bc);
+                    bc.Delete();
+                }
+
+                invasion.Spawn(12);
+            }
+
+            Assert.True(invasion.BossPhase);
+            Assert.IsType<OgreLord>(invasion.BossCreature);
+            Assert.Equal(0, invasion.Spawn());
+
+            var top = invasion.TopList();
+            Assert.Equal(player, Assert.Single(top).Player);
+            Assert.Equal(10, top[0].Kills);
+
+            var boss = invasion.BossCreature;
+            invasion.OnCreatureDeath(boss);
+            boss.Delete();
+
+            Assert.Null(Invasions.Find("Britain"));
+            Assert.True(invasion.Finished);
+            Assert.False(invasion.Region.GuardsDisabled);
+        }
+        finally
+        {
+            player.Delete();
+        }
+    }
+}
diff --git a/Projects/UOContent/Custom/DFI/Invasion/InvasionCommand.cs b/Projects/UOContent/Custom/DFI/Invasion/InvasionCommand.cs
