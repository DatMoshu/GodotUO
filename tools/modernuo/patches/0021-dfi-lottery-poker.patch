+
+    public override void OnResponse(NetState sender, in RelayInfo info)
+    {
+        var m = sender.Mobile;
+
+        if (m is not PlayerMobile)
+        {
+            return;
+        }
+
+        var entry = LotterySystem.GetEntry(m);
+        string status;
+
+        switch (info.ButtonID)
+        {
+            case BuyTickets when !entry.Bought:
+                {
+                    status = LotterySystem.Buy(m) ?? $"{LotterySystem.TicketPrice * entry.Tickets.Count}gp has been removed from your bankbox.";
+                    break;
+                }
+            case ClearTickets:
+                {
+                    status = LotterySystem.Clear(m);
+                    break;
+                }
+            case AddTicket when !entry.Bought:
+                {
+                    if (entry.Tickets.Count < LotterySystem.MaxTicketsPerPlayer)
+                    {
