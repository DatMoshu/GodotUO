+            background: true, scrollbar: true
+        );
+
+        builder.AddHtml(217, 63, 246, 121, LotterySystem.FormatTickets(entry, false), background: true, scrollbar: true);
+
+        if (!entry.Bought)
+        {
+            builder.AddHtml(217, 187, 246, 47, $"Total cost of tickets: {LotterySystem.TicketPrice * entry.Tickets.Count}", background: true);
+            builder.AddButton(432, 236, 4023, 4024, AddTicket);
+            builder.AddLabel(324, 236, 0, "Add a new ticket");
+            builder.AddButton(432, 281, 4023, 4024, BuyTickets);
+            builder.AddLabel(265, 281, 0, "Buy the tickets in the list");
+        }
+        else
+        {
+            builder.AddHtml(217, 187, 246, 47, "Please wait for the number drawing to see if you have won.", background: true);
+        }
+
+        builder.AddButton(432, 258, 4023, 4024, ClearTickets);
+        builder.AddLabel(324, 258, 0, "Clear ticket list");
+        builder.AddHtml(28, 308, 349, 24, _status);
+        builder.AddButton(442, 308, 4017, 4018, Close);
+        builder.AddLabel(403, 308, 0, "Close");
