+
+    private readonly LotteryEntry _entry;
+    private readonly string _status;
+
+    public LotteryGump(Mobile from, string status) : base(40, 40)
+    {
+        _entry = LotterySystem.GetEntry(from);
+        _status = status;
+    }
+
+    public override bool Singleton => true;
+
+    protected override void BuildLayout(ref DynamicGumpBuilder builder)
+    {
+        var entry = _entry;
+
+        builder.AddPage();
+        builder.AddBackground(0, 0, 500, 350, 9200);
+        builder.AddLabel(219, 20, 0, "Lottery Tickets");
+        builder.AddLabel(34, 45, 0, "Information");
