+public class LotteryNumbersGump : DynamicGump
+{
+    private readonly string _status;
+
+    public LotteryNumbersGump(string status) : base(20, 20) => _status = status;
+
+    public override bool Singleton => true;
+
+    protected override void BuildLayout(ref DynamicGumpBuilder builder)
+    {
+        builder.AddPage();
+        builder.AddBackground(0, 0, 580, 360, 9200);
+        builder.AddLabel(242, 21, 0, "Lottery Ticket");
+        builder.AddHtml(
+            375, 57, 172, 227,
+            $"Choose {LotterySystem.NumbersPerTicket} numbers to add to the ticket.<br><br>You can buy up to {LotterySystem.MaxTicketsPerPlayer} tickets.",
+            background: true
+        );
+        builder.AddHtml(35, 326, 522, 23, _status);
+
+        for (var n = 1; n <= LotterySystem.MaxNumbers; n++)
+        {
+            var col = (n - 1) % 10 + 1;
+            var row = (n - 1) / 10;
+            builder.AddLabel(20 + col * 30, 55 + row * 50, 0, $"{n}");
+            builder.AddCheckbox(15 + col * 30, 77 + row * 50, 210, 211, false, n);
+        }
+
+        builder.AddButton(414, 297, 247, 248, 2);
+        builder.AddButton(482, 297, 241, 242, 1);
+    }
+
+    public override void OnResponse(NetState sender, in RelayInfo info)
+    {
+        var m = sender.Mobile;
+
+        if (m is not PlayerMobile || info.ButtonID == 0)
+        {
+            return;
+        }
+
+        if (info.ButtonID == 1)
+        {
+            m.SendGump(new LotteryGump(m, ""), true);
+            return;
+        }
+
+        var picked = new List<int>();
+
+        for (var n = 1; n <= LotterySystem.MaxNumbers; n++)
+        {
+            if (info.IsSwitched(n))
+            {
+                picked.Add(n);
+            }
+        }
+
+        var entry = LotterySystem.GetEntry(m);
+
+        if (picked.Count != LotterySystem.NumbersPerTicket)
+        {
+            m.SendGump(
+                new LotteryNumbersGump($"Invalid amount of numbers! Choose {LotterySystem.NumbersPerTicket} numbers and click the Okay button."),
+                true
+            );
+            return;
+        }
+
+        if (!entry.Bought && entry.Tickets.Count < LotterySystem.MaxTicketsPerPlayer)
+        {
+            entry.Tickets.Add([..picked]);
+        }
+
+        m.SendGump(new LotteryGump(m, "Ticket added to the list."), true);
+    }
+}
