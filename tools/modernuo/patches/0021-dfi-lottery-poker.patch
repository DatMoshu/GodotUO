@@ -0,0 +1,720 @@
+// DFI Network's lottery, ported from DFI RUNUO Scripts/Custom/Engines/LotterySystem. Players pick four numbers
+// from 1 to 49 per ticket, up to five tickets at 100 gp each paid from the bank, at a lottery master. A drawing
+// every day at 17:00 (UTC here) pays 5,000 gp for two correct numbers, 30,000 for three and the jackpot, 80% of
+// the money in the system (never under a million), split between all four-number tickets. Results wait at the
+// lottery master; lottery masters cry the drawing out every minute.
+
+using System;
+using System.Collections.Generic;
+using ModernUO.Serialization;
+using Server.Collections;
+using Server.Commands;
+using Server.ContextMenus;
+using Server.Gumps;
+using Server.Items;
+using Server.Mobiles;
+using Server.Network;
+
+namespace Server.Custom.Dfi.Lottery;
+
+public class LotteryEntry
+{
+    public LotteryEntry(Mobile player) => Player = player;
+
+    public Mobile Player { get; }
+    public List<int[]> Tickets { get; } = [];
+    public bool Bought { get; set; }
+    public bool ShowWinnings { get; set; }
+    public DateTime TicketBought { get; set; }
+    public DateTime LastAccess { get; set; }
+    public int WinMoney { get; set; }
+    public int[] WinningNumbers { get; set; } = new int[LotterySystem.NumbersPerTicket];
+    public int[] CorrectNumbers { get; set; } = [];
+    public int[] TotalCorrectNumbers { get; set; } = new int[LotterySystem.NumbersPerTicket + 1];
+}
+
+public class LotterySystem : GenericPersistence
+{
+    public const int MaxNumbers = 49;
+    public const int NumbersPerTicket = 4;
+    public const int MaxTicketsPerPlayer = 5;
+    public const int SystemHue = 0x38A;
+    public const int MinimumSystemGold = 1_000_000;
+    public const int TicketPrice = 100;
+    public const double JackpotPercent = 0.8;
+    public const int Prize1 = 0;
+    public const int Prize2 = 5000;
+    public const int Prize3 = 30000;
+
+    public static readonly TimeSpan DrawTime = TimeSpan.FromHours(17.0);
+    public static readonly TimeSpan DecayTime = TimeSpan.FromDays(30.0);
+
+    public static int Jackpot { get; private set; }
+    public static long TotalLotteryMoney { get; private set; } = MinimumSystemGold;
+    public static DateTime NextDrawing { get; private set; }
+    public static List<LotteryEntry> Register { get; } = [];
+    public static List<LotteryNpc> Npcs { get; } = [];
+
+    private static Timer _timer;
+
+    public LotterySystem() : base("DfiLottery", 10)
+    {
+    }
+
+    public static void Configure()
+    {
+        _ = new LotterySystem();
+    }
+
+    public static void Initialize()
+    {
+        UpdateTime();
+
+        if (Jackpot == 0)
+        {
+            UpdateJackpot();
+        }
+
+        Register.RemoveAll(e => e.LastAccess + DecayTime < Core.Now || e.Player?.Deleted != false);
+        _timer = Timer.DelayCall(TimeSpan.FromMinutes(1.0), TimeSpan.FromMinutes(1.0), OnTick);
+    }
+
+    private static void OnTick()
+    {
+        foreach (var npc in Npcs)
+        {
+            if (!npc.Deleted)
+            {
+                npc.Advertise();
+            }
+        }
+
+        if (NextDrawing < Core.Now)
+        {
+            UpdateTime();
+            Draw();
+        }
+    }
+
+    public static void UpdateTime()
+    {
+        NextDrawing = Core.Now.Date + DrawTime;
+
+        if (NextDrawing < Core.Now)
+        {
+            NextDrawing += TimeSpan.FromDays(1.0);
+        }
+    }
+
+    public static void UpdateJackpot()
+    {
+        TotalLotteryMoney = Math.Max(TotalLotteryMoney, MinimumSystemGold);
+        Jackpot = (int)Math.Min(int.MaxValue, TotalLotteryMoney * JackpotPercent);
+    }
+
+    public static bool TakeGold(Mobile from, int amount)
+    {
+        if (!Banker.Withdraw(from, amount))
+        {
+            return false;
+        }
+
+        TotalLotteryMoney += amount;
+        return true;
+    }
+
+    public static void GiveGold(Mobile to, int amount)
+    {
+        if (to?.Deleted == false && amount > 0)
+        {
+            Banker.Deposit(to, amount);
+            TotalLotteryMoney -= amount;
+        }
+    }
+
+    public static LotteryEntry GetEntry(Mobile from)
+    {
+        var entry = Register.Find(e => e.Player == from);
+
+        if (entry == null)
+        {
+            entry = new LotteryEntry(from);
+            Register.Add(entry);
+        }
+
+        entry.LastAccess = Core.Now;
+        return entry;
+    }
+
+    // Returns null when bought, or why not.
+    public static string Buy(Mobile from)
+    {
+        var entry = GetEntry(from);
+
+        if (entry.Tickets.Count == 0)
+        {
+            return "No tickets have been added to the list!";
+        }
+
+        var cost = TicketPrice * entry.Tickets.Count;
+
+        if (!TakeGold(from, cost))
+        {
+            return "Not enough gold in your bankbox.";
+        }
+
+        entry.Bought = true;
+        entry.TicketBought = Core.Now;
+        return null;
+    }
+
+    public static string Clear(Mobile from)
+    {
+        var entry = GetEntry(from);
+        var refund = "";
+
+        if (entry.Bought)
+        {
+            var gold = TicketPrice * entry.Tickets.Count;
+            GiveGold(from, gold);
+            refund = $" {gold}gp added to your bankbox.";
+            entry.Bought = false;
+        }
+
+        entry.Tickets.Clear();
+        return $"Number list cleared.{refund}";
+    }
+
+    // Draws four numbers (or uses the ones given), pays out and returns them.
+    public static int[] Draw(int[] winning = null)
+    {
+        if (winning == null)
+        {
+            var drawn = new HashSet<int>();
+
+            while (drawn.Count < NumbersPerTicket)
+            {
+                drawn.Add(Utility.Random(MaxNumbers) + 1);
+            }
+
+            winning = [..drawn];
+        }
+
+        var winSet = new HashSet<int>(winning);
+        var totals = new int[NumbersPerTicket + 1];
+
+        foreach (var entry in Register)
+        {
+            if (!entry.Bought)
+            {
+                continue;
+            }
+
+            entry.CorrectNumbers = new int[entry.Tickets.Count];
+
+            for (var i = 0; i < entry.Tickets.Count; i++)
+            {
+                var correct = 0;
+
+                foreach (var n in entry.Tickets[i])
+                {
+                    if (winSet.Contains(n))
+                    {
+                        correct++;
+                    }
+                }
+
+                entry.CorrectNumbers[i] = correct;
+                totals[correct]++;
+            }
+
+            entry.TotalCorrectNumbers = totals;
+            entry.WinningNumbers = (int[])winning.Clone();
+            entry.ShowWinnings = true;
+        }
+
+        int[] prizes = [0, Prize1, Prize2, Prize3, totals[NumbersPerTicket] == 0 ? Jackpot : Jackpot / totals[NumbersPerTicket]];
+
+        foreach (var entry in Register)
+        {
+            if (!entry.Bought)
+            {
+                continue;
+            }
+
+            entry.WinMoney = 0;
+
+            foreach (var correct in entry.CorrectNumbers)
+            {
+                if (prizes[correct] > 0 && entry.Player?.Deleted == false)
+                {
+                    entry.WinMoney += prizes[correct];
+                    GiveGold(entry.Player, prizes[correct]);
+                }
+            }
+
+            entry.Bought = false;
+        }
+
+        UpdateJackpot();
+        CommandHandlers.BroadcastMessage(AccessLevel.Player, SystemHue, $"Lottery drawing... {string.Join(" ", winning)}");
+        return winning;
+    }
+
+    public static string FormatTickets(LotteryEntry entry, bool showCorrect)
+    {
+        var text = "";
+
+        for (var i = 0; i < entry.Tickets.Count; i++)
+        {
+            text += $"#{i + 1} Numbers: {string.Join(" ", entry.Tickets[i])}";
+            text += showCorrect && i < entry.CorrectNumbers.Length ? $"  Correct Numbers: {entry.CorrectNumbers[i]}<br>" : "<br>";
+        }
+
+        return text;
+    }
+
+    public override void Serialize(IGenericWriter writer)
+    {
+        writer.WriteEncodedInt(0); // version
+        writer.Write(NextDrawing);
+        writer.Write(Jackpot);
+        writer.Write(TotalLotteryMoney);
+
+        writer.WriteEncodedInt(Register.Count);
+
+        foreach (var e in Register)
+        {
+            writer.Write(e.Player);
+            writer.Write(e.Bought);
+            writer.Write(e.ShowWinnings);
+            writer.Write(e.WinMoney);
+            writer.Write(e.LastAccess);
+            writer.Write(e.TicketBought);
+            writer.WriteEncodedInt(e.Tickets.Count);
+
+            foreach (var t in e.Tickets)
+            {
+                WriteInts(writer, t);
+            }
+
+            WriteInts(writer, e.CorrectNumbers);
+            WriteInts(writer, e.TotalCorrectNumbers);
+            WriteInts(writer, e.WinningNumbers);
+        }
+    }
+
+    private static void WriteInts(IGenericWriter writer, int[] values)
+    {
+        writer.WriteEncodedInt(values.Length);
+
+        foreach (var v in values)
+        {
+            writer.WriteEncodedInt(v);
+        }
+    }
+
+    private static int[] ReadInts(IGenericReader reader)
+    {
+        var values = new int[reader.ReadEncodedInt()];
+
+        for (var i = 0; i < values.Length; i++)
+        {
+            values[i] = reader.ReadEncodedInt();
+        }
+
+        return values;
+    }
+
+    public override void Deserialize(IGenericReader reader)
+    {
+        reader.ReadEncodedInt(); // version
+        NextDrawing = reader.ReadDateTime();
+        Jackpot = reader.ReadInt();
+        TotalLotteryMoney = reader.ReadLong();
+
+        var count = reader.ReadEncodedInt();
+
+        for (var i = 0; i < count; i++)
+        {
+            var entry = new LotteryEntry(reader.ReadEntity<Mobile>())
+            {
+                Bought = reader.ReadBool(),
+                ShowWinnings = reader.ReadBool(),
+                WinMoney = reader.ReadInt(),
+                LastAccess = reader.ReadDateTime(),
+                TicketBought = reader.ReadDateTime()
+            };
+
+            var tickets = reader.ReadEncodedInt();
+
+            for (var t = 0; t < tickets; t++)
+            {
+                entry.Tickets.Add(ReadInts(reader));
+            }
+
+            entry.CorrectNumbers = ReadInts(reader);
+            entry.TotalCorrectNumbers = ReadInts(reader);
+            entry.WinningNumbers = ReadInts(reader);
+
+            if (entry.Player != null)
+            {
+                Register.Add(entry);
+            }
+        }
+    }
+}
+
+[SerializationGenerator(0)]
+public partial class LotteryNpc : BaseVendor
+{
+    private readonly List<SBInfo> _sbInfos = [];
+
+    [Constructible(AccessLevel.GameMaster)]
+    public LotteryNpc() : base("the lottery master")
+    {
+        SetSkill(SkillName.Inscribe, 90.0, 100.0);
+        LotterySystem.Npcs.Add(this);
+    }
+
+    protected override List<SBInfo> SBInfos => _sbInfos;
+    public override VendorShoeType ShoeType => VendorShoeType.Shoes;
+
+    public override void InitSBInfo()
+    {
+        _sbInfos.Add(new SBLotteryNpc());
+    }
+
+    public override void InitOutfit()
+    {
+        base.InitOutfit();
+        AddItem(new Robe(Utility.RandomNeutralHue()));
+        AddItem(new JesterHat(Utility.RandomNeutralHue()));
+    }
+
+    [AfterDeserialization]
+    private void AfterDeserialization() => LotterySystem.Npcs.Add(this);
+
+    public override void OnDelete()
+    {
+        LotterySystem.Npcs.Remove(this);
+        base.OnDelete();
+    }
+
+    public void Advertise()
+    {
+        switch (Utility.Random(6))
+        {
+            case 0:
+                {
+                    Say("Buy a lottery ticket and try your luck!");
+                    break;
+                }
+            case 1:
+                {
+                    Say($"The next Lottery Drawing is at {LotterySystem.NextDrawing:HH:mm} UTC!");
+                    break;
+                }
+            case 2:
+                {
+                    Say($"If you get {LotterySystem.NumbersPerTicket} correct numbers you will win {LotterySystem.Jackpot}gp!");
