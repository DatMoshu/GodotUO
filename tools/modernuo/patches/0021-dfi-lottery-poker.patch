+namespace Server.Items
+{
+    [SerializationGenerator(0)]
+    public abstract partial class PokerMachine : Item
+    {
+        public static readonly TimeSpan RefillDelay = TimeSpan.FromHours(2.0);
+        private static readonly List<PokerMachine> _machines = [];
+        private static Timer _refill;
+
+        [SerializableField(0)]
+        [InvalidateProperties]
+        [SerializedCommandProperty(AccessLevel.Administrator)]
+        private int _goldInMachine;
+
+        protected PokerMachine() : base(0x1173)
+        {
+            Movable = false;
+            Hue = 0x58;
+            _goldInMachine = 30000 + (Utility.Random(700) + 1) * 100;
+            Register();
+        }
+
+        public override string DefaultName => "a Poker Machine";
+
+        public abstract int MinBet { get; }
+        public abstract int MaxBet { get; }
+        public abstract int BetChange { get; }
+        public abstract int[] WinningsTable { get; }
+
+        private void Register()
+        {
+            _machines.Add(this);
+            _refill ??= Timer.DelayCall(RefillDelay, RefillDelay, RefillAll);
+        }
+
+        [AfterDeserialization]
+        private void AfterDeserialization() => Register();
+
+        public override void OnAfterDelete()
+        {
+            _machines.Remove(this);
+            base.OnAfterDelete();
+        }
+
+        private static void RefillAll()
+        {
+            foreach (var machine in _machines)
+            {
+                Timer.DelayCall(TimeSpan.FromSeconds(Utility.Random(200)), machine.Refill);
+            }
+        }
+
+        public void Refill()
+        {
+            if (Deleted || GoldInMachine >= 50000)
+            {
+                return;
+            }
+
+            GoldInMachine = 100000 + Utility.Random(10000);
+            Visible = true;
+            PublicOverheadMessage(MessageType.Regular, 0x0, true, "Calculating gold in machine");
+
+            for (var i = 0; i <= 6; i += 2)
+            {
+                Timer.DelayCall(TimeSpan.FromSeconds(i), () => Effects.PlaySound(Location, Map, 0x36));
+            }
+        }
+
+        public override void GetProperties(IPropertyList list)
+        {
+            base.GetProperties(list);
+            list.Add(1060658, $"{"Bets"}\t{MinBet}gp - {MaxBet}gp"); // ~1_val~: ~2_val~
+            list.Add(1060659, $"{"Jackpot"}\t{_goldInMachine / 3}gp"); // ~1_val~: ~2_val~
+        }
+
+        public override void OnDoubleClick(Mobile from)
+        {
+            if (!from.InRange(GetWorldLocation(), 2))
+            {
+                from.SendLocalizedMessage(500446); // That is too far away.
+            }
+            else if (_goldInMachine <= 0)
+            {
+                from.SendMessage("This machine is out of gold.");
+            }
+            else
+            {
+                Effects.PlaySound(Location, Map, 533);
+                from.SendGump(new PokerGump(from, new PokerSession(this), "Welcome to Defiance AOS Poker Machine.", false), true);
+            }
+        }
+
+        public bool Charge(Mobile player, int amount, bool useBank)
+        {
+            var paid = useBank ? Banker.Withdraw(player, amount) : player.Backpack?.ConsumeTotal(typeof(Gold), amount) == true;
+
+            if (!paid)
+            {
+                return false;
+            }
+
+            player.SendMessage(useBank ? $"{amount}gp has been removed from your bankbox." : $"{amount}gp has been removed from your backpack.");
+            Effects.PlaySound(Location, Map, 0x36);
+            GoldInMachine += amount;
+            return true;
+        }
+
+        // Pays the hand's winnings out of the machine and returns what to tell the player.
+        public string Settle(Mobile player, PokerSession session)
+        {
+            var hand = PokerCards.Evaluate(session.Hand);
+
+            if (hand == PokerHand.None)
+            {
+                return "You did not win anything.";
+            }
+
+            var amount = Math.Min(session.Winning(hand), GoldInMachine);
+            GoldInMachine -= amount;
+
+            if (GoldInMachine == 0)
+            {
+                Visible = false;
+            }
+
+            Effects.PlaySound(Location, Map, 0x36);
+            PublicOverheadMessage(MessageType.Regular, 0x0, true, "Winner!");
+            PublicOverheadMessage(MessageType.Regular, 0x0, true, $"{hand}");
+
+            if (Banker.Deposit(player, amount))
+            {
+                return $"You won! ( {hand} ) {amount} gp have been placed in your bank box.";
+            }
+
+            for (var left = amount; left > 0; left -= 1_000_000)
+            {
+                player.AddToBackpack(new BankCheck(Math.Min(left, 1_000_000)));
+            }
+
+            return $"You won! ( {hand} ) {amount} gp have been placed in your backpack, because your bank box is full.";
+        }
+    }
