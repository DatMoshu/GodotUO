+// Places DFI's town games: a lottery master and the three poker machines on Britain's main street, by the Lost
+// Lands gate. DFI's saves kept none of their spots.
+
+using System.Collections.Generic;
+using Server.Commands;
+using Server.Custom.Dfi.Lottery;
+using Server.Items;
+using Server.Logging;
+
+namespace Server.Custom.Dfi;
+
+public static class DfiGamesGen
+{
+    private static readonly ILogger logger = LogFactory.GetLogger(typeof(DfiGamesGen));
+
+    public static readonly Point3D LotterySpot = new(1442, 1700, 0);
+    public static readonly Point3D[] PokerSpots = [new(1439, 1698, 0), new(1440, 1697, 0), new(1441, 1698, 0)];
+
+    public static void Configure()
+    {
+        CommandSystem.Register("DfiGames", AccessLevel.Administrator, OnCommand);
+    }
+
+    [Usage("DfiGames")]
+    [Description("Places DFI's lottery master and poker machines in Britain, replacing any placed before.")]
+    private static void OnCommand(CommandEventArgs e)
+    {
+        var removed = Remove();
+        var placed = Place();
+        e.Mobile.SendMessage($"DfiGames: removed {removed}, placed {placed}.");
+        logger.Information("{User} placed {Placed} DFI game fixtures ({Removed} removed)", e.Mobile, placed, removed);
+    }
+
+    public static int Remove()
+    {
+        var doomed = new List<IEntity>();
+
+        foreach (var m in World.Mobiles.Values)
+        {
+            if (m is LotteryNpc && m.Map == Map.Felucca && m.Location == LotterySpot)
+            {
+                doomed.Add(m);
+            }
+        }
+
+        foreach (var item in World.Items.Values)
+        {
+            if (item is PokerMachine && item.Map == Map.Felucca && System.Array.IndexOf(PokerSpots, item.Location) >= 0)
+            {
+                doomed.Add(item);
+            }
+        }
+
+        foreach (var entity in doomed)
+        {
+            entity.Delete();
+        }
+
+        return doomed.Count;
+    }
+
+    public static int Place()
+    {
+        var npc = new LotteryNpc { Home = LotterySpot, RangeHome = 0, CantWalk = true, Direction = Direction.South };
+        npc.MoveToWorld(LotterySpot, Map.Felucca);
+
+        new PokerMachineLow().MoveToWorld(PokerSpots[0], Map.Felucca);
+        new PokerMachineMedium().MoveToWorld(PokerSpots[1], Map.Felucca);
+        new PokerMachineHigh().MoveToWorld(PokerSpots[2], Map.Felucca);
+
+        return 1 + PokerSpots.Length;
+    }
+}
diff --git a/Projects/UOContent/Custom/DFI/Games/Lottery.cs b/Projects/UOContent/Custom/DFI/Games/Lottery.cs
