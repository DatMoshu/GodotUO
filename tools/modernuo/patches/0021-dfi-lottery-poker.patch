+// DFI Network's video poker machines, ported from DFI RUNUO Scripts/Custom/Engines/PokerSystem. Five-card draw:
+// the bet is paid from the backpack (or the bank), five cards are dealt, the player holds any and draws once.
+// Winnings come out of the machine's gold into the bank; a royal flush wins a third of the machine. Machines
+// with under 50,000 gold are refilled every two hours. Three machines: low (10-50 gp), medium (100-500 gp) and
+// high (1,000-5,000 gp).
+
+using System;
+using System.Collections.Generic;
+using ModernUO.Serialization;
+using Server.Custom.Dfi.Poker;
+using Server.Gumps;
+using Server.Items;
+using Server.Mobiles;
+using Server.Network;
+
+namespace Server.Custom.Dfi.Poker
+{
+    public enum PokerHand
+    {
+        RoyalFlush,
+        StraightFlush,
+        FourOfAKind,
+        FullHouse,
+        Flush,
+        Straight,
+        ThreeOfAKind,
+        TwoPairs,
+        Pair,
+        None
+    }
+
+    // A card is 0-51: suit = card / 13 (hearts, diamonds, spades, clubs), value = card % 13 + 1 (1 is the ace).
+    public static class PokerCards
+    {
+        public static int Value(int card) => card % 13 + 1;
+        public static int Suit(int card) => card / 13;
+
+        public static string ValueText(int card) =>
+            Value(card) switch
+            {
+                1  => "A",
+                11 => "J",
+                12 => "Q",
+                13 => "K",
+                var v => $"{v}"
+            };
+
+        public static string SuitText(int card) => Suit(card) switch { 0 => "H", 1 => "D", 2 => "S", _ => "C" };
+
+        public static bool IsRed(int card) => Suit(card) < 2;
+
+        public static PokerHand Evaluate(IReadOnlyList<int> hand)
+        {
+            var values = new List<int>(hand.Count);
+            var flush = true;
+
+            for (var i = 0; i < hand.Count; i++)
+            {
+                values.Add(Value(hand[i]));
+                flush &= Suit(hand[i]) == Suit(hand[0]);
+            }
+
+            values.Sort();
+
+            var counts = new Dictionary<int, int>();
+
+            foreach (var v in values)
+            {
+                counts[v] = counts.GetValueOrDefault(v) + 1;
+            }
+
+            var groups = new List<int>(counts.Values);
+            groups.Sort((a, b) => b.CompareTo(a));
+
+            var distinct = counts.Count == 5;
+            var lowStraight = distinct && values[4] - values[0] == 4;
+            var broadway = distinct && values[0] == 1 && values[1] == 10; // 10 J Q K A
+            var straight = lowStraight || broadway;
+
+            return (flush, straight, broadway, groups[0], groups.Count > 1 ? groups[1] : 0) switch
+            {
+                (true, true, true, _, _)  => PokerHand.RoyalFlush,
+                (true, true, _, _, _)     => PokerHand.StraightFlush,
+                (_, _, _, 4, _)           => PokerHand.FourOfAKind,
+                (_, _, _, 3, 2)           => PokerHand.FullHouse,
+                (true, _, _, _, _)        => PokerHand.Flush,
+                (_, true, _, _, _)        => PokerHand.Straight,
+                (_, _, _, 3, _)           => PokerHand.ThreeOfAKind,
+                (_, _, _, 2, 2)           => PokerHand.TwoPairs,
+                (_, _, _, 2, _)           => PokerHand.Pair,
+                _                         => PokerHand.None
+            };
+        }
+    }
+
+    // One player's game at a machine: the deck, the hand, what is held and the bet.
+    public class PokerSession
+    {
+        private readonly List<int> _deck = [];
+
+        public PokerSession(PokerMachine machine)
+        {
+            Machine = machine;
+            Bet = machine.MinBet;
+        }
+
+        public PokerMachine Machine { get; }
+        public int Bet { get; set; }
+        public int[] Hand { get; } = [-1, -1, -1, -1, -1];
+        public bool[] Held { get; } = new bool[5];
+        public bool Drawing { get; set; }
+
+        private int NextCard()
+        {
+            if (_deck.Count == 0)
+            {
+                for (var i = 0; i < 52; i++)
+                {
+                    _deck.Add(i);
+                }
+            }
+
+            var at = Utility.Random(_deck.Count);
+            var card = _deck[at];
+            _deck.RemoveAt(at);
+            return card;
+        }
+
+        public void Deal()
+        {
+            _deck.Clear();
+            Array.Clear(Held);
+
+            for (var i = 0; i < Hand.Length; i++)
+            {
+                Hand[i] = NextCard();
+            }
+        }
+
+        public void Draw()
+        {
+            for (var i = 0; i < Hand.Length; i++)
+            {
+                if (!Held[i])
+                {
+                    Hand[i] = NextCard();
+                }
+            }
+        }
+
+        public void NextBet() => Bet = Bet >= Machine.MaxBet ? Machine.MinBet : Bet + Machine.BetChange;
+
+        public int Winning(PokerHand hand) =>
+            hand == PokerHand.RoyalFlush ? Machine.GoldInMachine / 3 : Machine.WinningsTable[(int)hand] * (Bet / Machine.BetChange);
+    }
+
+    public class PokerGump : DynamicGump
+    {
+        private const int Close = 0;
+        private const int Ok = 1;
+        private const int HoldBase = 2;
+        private const int ChangeBet = 7;
+        private const int UseBankCheck = 8;
+
+        private const int CardWidth = 50;
+        private const int CardHeight = 74;
+        private const int CardX = 25;
+        private const int CardY = 100;
+        private const int CardSpace = 70;
+
+        private readonly PokerSession _session;
+        private readonly string _status;
+        private readonly bool _useBank;
+        private readonly int _balance;
+
+        public PokerGump(Mobile from, PokerSession session, string status, bool useBank) : base(50, 35)
+        {
+            _session = session;
+            _status = status;
+            _useBank = useBank;
+            _balance = Banker.GetBalance(from);
+        }
+
+        public override bool Singleton => true;
+
+        protected override void BuildLayout(ref DynamicGumpBuilder builder)
+        {
+            builder.AddPage();
+            builder.AddBackground(0, 0, 524, 341, 2620);
+            builder.AddAlphaRegion(5, 7, 513, 326);
+
+            for (var i = 0; i < 5; i++)
+            {
+                var x = CardX + CardSpace * i;
+                var card = _session.Hand[i];
+                builder.AddImageTiled(x, CardY, CardWidth, CardHeight, 9354);
+
+                if (card < 0)
+                {
+                    builder.AddImage(x + CardWidth / 2 - 12, CardY + CardHeight / 2 - 12, 11320);
+                }
+                else
+                {
+                    var value = PokerCards.ValueText(card);
+                    builder.AddLabel(x + 4, CardY + 1, 0, value);
+                    builder.AddLabel(x + CardWidth - (8 + value.Length * 4), CardY + CardHeight - 20, 0, value);
+                    builder.AddLabel(x + CardWidth / 2 - 3, CardY + CardHeight / 2 - 10, PokerCards.IsRed(card) ? 1171 : 0, PokerCards.SuitText(card));
+                }
+
+                if (_session.Drawing)
+                {
+                    builder.AddCheckbox(x + CardWidth / 2 - 10, CardY + CardHeight + 10, 210, 211, _session.Held[i], HoldBase + i);
+                }
+            }
+
+            builder.AddButton(476, 275, 4017, 4018, Close);
+            builder.AddLabel(434, 277, 940, "Close");
+            builder.AddButton(175, 218, 4023, 4024, Ok);
+            builder.AddLabel(210, 218, 940, _session.Drawing ? "Draw" : "Deal");
+
+            if (!_session.Drawing)
+            {
+                builder.AddButton(476, 246, 4014, 4015, ChangeBet);
+                builder.AddLabel(398, 248, 940, "Change Bet");
+            }
+
+            builder.AddCheckbox(191, 271, 210, 211, _useBank, UseBankCheck);
+            builder.AddLabel(18, 272, 940, "Withdraw money from bank.");
+            builder.AddLabel(18, 252, 940, $"Bank balance: {_balance}gp.");
+
+            builder.AddBackground(366, 16, 144, 226, 3000);
+
+            for (var i = 0; i < (int)PokerHand.None; i++)
+            {
+                builder.AddLabel(370, 20 + i * 20, 0, $"{(PokerHand)i}");
+                builder.AddLabel(450, 20 + i * 20, 0, $"{_session.Winning((PokerHand)i)}gp");
+            }
+
+            builder.AddLabel(370, 200, 0, $"Current Bet: {_session.Bet}gp");
+            builder.AddHtml(13, 302, 497, 27, _status, background: true);
+        }
+
+        public override void OnResponse(NetState sender, in RelayInfo info)
+        {
+            var m = sender.Mobile;
+            var machine = _session.Machine;
+
+            if (m is not PlayerMobile || info.ButtonID == Close || machine.Deleted)
+            {
+                return;
+            }
+
+            if (!m.InRange(machine.GetWorldLocation(), 2))
+            {
+                m.SendLocalizedMessage(1060178); // You are too far away to perform that action!
+                return;
+            }
+
+            if (machine.GoldInMachine <= 0)
+            {
+                m.SendMessage("This machine is out of gold.");
+                return;
+            }
+
+            var useBank = info.IsSwitched(UseBankCheck);
+            var status = "";
+
+            for (var i = 0; i < 5; i++)
+            {
+                _session.Held[i] = info.IsSwitched(HoldBase + i);
+            }
+
+            switch (info.ButtonID)
+            {
+                case ChangeBet when !_session.Drawing:
+                    {
+                        _session.NextBet();
+                        break;
+                    }
+                case Ok when !_session.Drawing:
+                    {
+                        if (!machine.Charge(m, _session.Bet, useBank))
+                        {
+                            status = useBank ? "You do not have enough gold in your bankbox!" : "You do not have enough gold in your backpack!";
+                            break;
+                        }
+
+                        _session.Deal();
+                        _session.Drawing = true;
+                        status = "Choose the cards to hold, then draw.";
+                        break;
+                    }
+                case Ok:
+                    {
+                        _session.Draw();
+                        _session.Drawing = false;
+                        status = machine.Settle(m, _session);
+                        break;
+                    }
+            }
+
+            m.SendGump(new PokerGump(m, _session, status, useBank), true);
+        }
+    }
+}
