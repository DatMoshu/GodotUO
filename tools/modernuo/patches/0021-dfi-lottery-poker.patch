@@ -0,0 +1,212 @@
+using System;
+using System.Collections.Generic;
+using Server;
+using Server.Custom.Dfi.Lottery;
+using Server.Custom.Dfi.Poker;
+using Server.Items;
+using Server.Misc;
+using Server.Mobiles;
+using Xunit;
+
+namespace UOContent.Tests.Custom;
+
+[Collection("Sequential UOContent Tests")]
+public class DfiGamesTests : IDisposable
+{
+    private readonly List<IEntity> _created = new();
+
+    public DfiGamesTests()
+    {
+        if (NameList.GetNameList("male") == null)
+        {
+            NameList.Configure();
+        }
+    }
+
+    public void Dispose()
+    {
+        foreach (var e in _created)
+        {
+            e?.Delete();
+        }
+
+        _created.Clear();
+        LotterySystem.Register.Clear();
+    }
+
+    private T Track<T>(T e) where T : IEntity
+    {
+        _created.Add(e);
+        return e;
+    }
+
+    private PlayerMobile Player(int bank = 0)
+    {
+        var m = Track(new PlayerMobile());
+        m.Player = true;
+        m.Body = 0x190;
+        m.AddItem(new Backpack());
+        m.AddItem(new BankBox(m));
+        m.MoveToWorld(new Point3D(1434, 1690, 0), Map.Felucca);
+
+        if (bank > 0)
+        {
+            m.BankBox.DropItem(new BankCheck(bank));
+        }
+
+        return m;
+    }
+
+    // Cards: suit * 13 + value - 1, suits hearts 0, diamonds 1, spades 2, clubs 3.
+    private static int C(int value, int suit) => suit * 13 + value - 1;
+
+    public static TheoryData<int[], PokerHand> Hands => new()
+    {
+        { [C(10, 0), C(11, 0), C(12, 0), C(13, 0), C(1, 0)], PokerHand.RoyalFlush },
+        { [C(5, 2), C(6, 2), C(7, 2), C(8, 2), C(9, 2)], PokerHand.StraightFlush },
+        { [C(7, 0), C(7, 1), C(7, 2), C(7, 3), C(2, 0)], PokerHand.FourOfAKind },
+        { [C(3, 0), C(3, 1), C(3, 2), C(9, 3), C(9, 0)], PokerHand.FullHouse },
+        { [C(2, 1), C(5, 1), C(9, 1), C(11, 1), C(13, 1)], PokerHand.Flush },
+        { [C(1, 0), C(2, 1), C(3, 2), C(4, 3), C(5, 0)], PokerHand.Straight },
+        { [C(10, 0), C(11, 1), C(12, 2), C(13, 3), C(1, 0)], PokerHand.Straight },
+        { [C(8, 0), C(8, 1), C(8, 2), C(2, 3), C(5, 0)], PokerHand.ThreeOfAKind },
+        { [C(8, 0), C(8, 1), C(4, 2), C(4, 3), C(5, 0)], PokerHand.TwoPairs },
+        { [C(8, 0), C(8, 1), C(4, 2), C(11, 3), C(5, 0)], PokerHand.Pair },
+        { [C(2, 0), C(4, 1), C(6, 2), C(9, 3), C(11, 0)], PokerHand.None }
+    };
+
+    [Theory]
+    [MemberData(nameof(Hands))]
+    public void Poker_RanksEveryHand(int[] hand, PokerHand expected)
+    {
+        Assert.Equal(expected, PokerCards.Evaluate(hand));
+    }
+
+    [Fact]
+    public void Poker_DealsFiveDifferentCardsAndDrawsOnlyWhatIsNotHeld()
+    {
+        var machine = Track(new PokerMachineLow());
+        var session = new PokerSession(machine);
+
+        session.Deal();
+        Assert.Equal(5, new HashSet<int>(session.Hand).Count);
+
+        session.Held[0] = session.Held[2] = true;
+        var kept = (session.Hand[0], session.Hand[2]);
+        session.Draw();
+
+        Assert.Equal(kept, (session.Hand[0], session.Hand[2]));
+    }
+
+    [Fact]
+    public void Poker_PaysByTheBetAndRoyalFlushTakesAThird()
+    {
+        var player = Player();
+        var machine = Track(new PokerMachineMedium());
+        machine.GoldInMachine = 90000;
+        var session = new PokerSession(machine) { Bet = 300 };
+
+        Assert.Equal(80 * 3, session.Winning(PokerHand.Pair));
+        Assert.Equal(30000, session.Winning(PokerHand.RoyalFlush));
+
+        session.Hand[0] = C(8, 0);
+        session.Hand[1] = C(8, 1);
+        session.Hand[2] = C(4, 2);
+        session.Hand[3] = C(11, 3);
+        session.Hand[4] = C(5, 0);
+        machine.Settle(player, session);
+
+        Assert.Equal(240, Banker.GetBalance(player));
+        Assert.Equal(90000 - 240, machine.GoldInMachine);
+    }
+
+    [Fact]
+    public void Poker_BetsCycleAndChargeTheBackpack()
+    {
+        var player = Player();
+        var machine = Track(new PokerMachineHigh());
+        var session = new PokerSession(machine);
+        var before = machine.GoldInMachine;
+
+        Assert.Equal(1000, session.Bet);
+        for (var i = 0; i < 5; i++)
+        {
+            session.NextBet();
+        }
+
+        Assert.Equal(1000, session.Bet);
+
+        Assert.False(machine.Charge(player, 1000, false));
+        player.Backpack.DropItem(new Gold(1500));
+        Assert.True(machine.Charge(player, 1000, false));
+        Assert.Equal(500, player.Backpack.GetAmount(typeof(Gold)));
+        Assert.Equal(before + 1000, machine.GoldInMachine);
+    }
+
+    [Fact]
+    public void Lottery_BuyingTakesTicketsFromTheBankAndClearingRefunds()
+    {
+        var player = Player(1000);
+        var entry = LotterySystem.GetEntry(player);
+        entry.Tickets.Add([1, 2, 3, 4]);
+        entry.Tickets.Add([5, 6, 7, 8]);
+
+        Assert.Null(LotterySystem.Buy(player));
+        Assert.True(entry.Bought);
+        Assert.Equal(1000 - 2 * LotterySystem.TicketPrice, Banker.GetBalance(player));
+
+        LotterySystem.Clear(player);
+        Assert.False(entry.Bought);
+        Assert.Empty(entry.Tickets);
+        Assert.Equal(1000, Banker.GetBalance(player));
+    }
+
+    [Fact]
+    public void Lottery_DrawingPaysByCorrectNumbersAndSplitsTheJackpot()
+    {
+        LotterySystem.UpdateJackpot();
+        var jackpot = LotterySystem.Jackpot;
+
+        var a = Player(10_000);
+        var b = Player(10_000);
+        var c = Player(10_000);
+        LotterySystem.GetEntry(a).Tickets.Add([1, 2, 3, 4]);
+        LotterySystem.GetEntry(b).Tickets.Add([1, 2, 3, 4]);
+        LotterySystem.GetEntry(c).Tickets.Add([1, 2, 30, 40]);
+        LotterySystem.GetEntry(c).Tickets.Add([1, 2, 3, 40]);
+
+        foreach (var m in (Mobile[])[a, b, c])
+        {
+            LotterySystem.Buy(m);
+        }
+
+        var balanceA = Banker.GetBalance(a);
+        var balanceC = Banker.GetBalance(c);
+
+        LotterySystem.Draw([1, 2, 3, 4]);
+
+        Assert.Equal(balanceA + jackpot / 2, Banker.GetBalance(a));
+        Assert.Equal(balanceC + LotterySystem.Prize2 + LotterySystem.Prize3, Banker.GetBalance(c));
+        Assert.False(LotterySystem.GetEntry(a).Bought);
+        Assert.True(LotterySystem.GetEntry(c).ShowWinnings);
+        Assert.Equal(2, LotterySystem.GetEntry(c).TotalCorrectNumbers[4]);
+    }
+
+    [Fact]
+    public void Lottery_UnboughtTicketsWinNothing()
+    {
+        var player = Player();
+        LotterySystem.GetEntry(player).Tickets.Add([1, 2, 3, 4]);
+
+        LotterySystem.Draw([1, 2, 3, 4]);
+
+        Assert.Equal(0, Banker.GetBalance(player));
+    }
+
+    [Fact]
+    public void Lottery_NpcAndMachinesConstruct()
+    {
+        Assert.False(Track(new LotteryNpc()).Deleted);
+        Assert.Contains(Track(new LotteryNpc()), LotterySystem.Npcs);
+    }
+}
