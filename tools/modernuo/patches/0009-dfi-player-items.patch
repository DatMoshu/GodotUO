+using System;
+using System.Collections.Generic;
+using Server;
+using Server.Items;
+using Server.Mobiles;
+using UOContent.Tests.Mobiles.AI;
+using Xunit;
+
+namespace UOContent.Tests.Custom;
+
+[Collection("Sequential UOContent Tests")]
+public class DfiItemTests : IDisposable
+{
+    private readonly List<IEntity> _created = new();
+
+    public static TheoryData<Type> Items =>
+    [
+        typeof(HoodedRobe), typeof(DonationShroud), typeof(EquipBag), typeof(PvPBag), typeof(Emblem),
+        typeof(ItemBlessDeed), typeof(SashLayerDeed), typeof(SpellChannelingDeed), typeof(SelfRepairDeed),
+        typeof(TitleChangeDeed), typeof(PetResurrectionDeed), typeof(PetBondingDeed), typeof(WarHorseBondingDeed),
+        typeof(SexChangeDeed), typeof(BeardRestylingDeed), typeof(ItemIDDeed), typeof(SpellbookDeed),
+        typeof(FullMagerySpellbook), typeof(FullNecroSpellbook), typeof(FullChivalrySpellbook),
+        typeof(FullBushidoSpellbook), typeof(FullNinjitsuSpellbook), typeof(FullSpellweavingSpellbook),
+        typeof(ArtifactDeed), typeof(ChampionArtifactDeed), typeof(MinorArtieDeed), typeof(SkillBall),
+        typeof(DonationSkillBall), typeof(PetSkillBall), typeof(TemplateSkillBall), typeof(StatBall),
+        typeof(ShrinkPotion), typeof(EverlastingShrinkPotion), typeof(Shrinkbag), typeof(ShrinkStone),
+        typeof(HitchingPost), typeof(HitchingPostEastAddon), typeof(HitchingPostEastDeed),
+        typeof(HitchingPostSouthAddon), typeof(HitchingPostSouthDeed), typeof(AgapiteFletcherTools),
+        typeof(BronzeFletcherTools), typeof(CopperFletcherTools), typeof(DullCopperFletcherTools),
+        typeof(GoldFletcherTools), typeof(ShadowIronFletcherTools), typeof(ValoriteFletcherTools),
+        typeof(VeriteFletcherTools), typeof(AgapiteHammer), typeof(BronzeHammer), typeof(CopperHammer),
+        typeof(DullCopperHammer), typeof(GoldHammer), typeof(ShadowIronHammer), typeof(ValoriteHammer),
+        typeof(VeriteHammer), typeof(AgapiteSaw), typeof(BronzeSaw), typeof(CopperSaw), typeof(DullCopperSaw),
+        typeof(GoldSaw), typeof(ShadowIronSaw), typeof(ValoriteSaw), typeof(VeriteSaw), typeof(BarbedSewingKit),
+        typeof(HornedSewingKit), typeof(SpinedSewingKit), typeof(AgapiteTinkerTools), typeof(BronzeTinkerTools),
+        typeof(CopperTinkerTools), typeof(DullCopperTinkerTools), typeof(GoldTinkerTools),
+        typeof(ShadowIronTinkerTools), typeof(ValoriteTinkerTools), typeof(VeriteTinkerTools), typeof(BagOfHammers),
+        typeof(BagOfSaws), typeof(BagOfTinkerTools), typeof(BagOfFletcherTools), typeof(BagOfSewingKits),
+        typeof(BagOfRunicTools), typeof(BagOfCraft), typeof(RunicStone), typeof(CraftingStone)
+    ];
+
+    public void Dispose()
+    {
+        foreach (var e in _created)
+        {
+            e?.Delete();
+        }
+
+        _created.Clear();
+    }
+
+    private T Track<T>(T entity) where T : IEntity
+    {
+        _created.Add(entity);
+        return entity;
+    }
+
+    private PlayerMobile NewPlayer()
+    {
+        var m = Track(new PlayerMobile(World.NewMobile));
+        m.DefaultMobileInit();
+        m.MoveToWorld(new Point3D(1500, 1600, 0), Map.Felucca);
+        m.AddItem(new Backpack());
+        return m;
+    }
+
+    [Theory]
+    [MemberData(nameof(Items))]
+    public void Item_Constructs_WithANameOrLabel(Type type)
+    {
+        // ModernUO's activator fills optional parameters, as [add does; Activator.CreateInstance does not.
+        var item = Track(type.CreateInstance<Item>());
+
+        Assert.False(item.Deleted);
+        Assert.True(item.ItemID > 0);
+        Assert.True(!string.IsNullOrEmpty(item.Name) || item.LabelNumber > 0);
+    }
+
+    [Fact]
+    public void EquipBag_HoldsTenJewelsWithFiveProperties()
+    {
+        var bag = Track(new EquipBag());
+
+        Assert.Equal(10, bag.Items.Count);
+        Assert.All(bag.Items, i => Assert.IsAssignableFrom<BaseJewel>(i));
+    }
+
+    [Fact]
+    public void PvPBag_HoldsSixteenStacksOfSixtyThousand()
+    {
+        var bag = Track(new PvPBag());
+
+        Assert.Equal(16, bag.Items.Count);
+        Assert.All(bag.Items, i => Assert.Equal(60000, i.Amount));
+        Assert.Equal(LootType.Blessed, bag.LootType);
+    }
+
+    [Fact]
+    public void SexChangeDeed_TogglesSexAndRemovesBeard()
+    {
+        var m = NewPlayer();
+        m.Body = 400;
+        m.Female = false;
+        m.FacialHairItemID = 0x203F;
+        var deed = Track(new SexChangeDeed());
+        m.AddToBackpack(deed);
+
+        deed.Apply(m);
+
+        Assert.True(m.Female);
+        Assert.Equal(401, m.Body.BodyID);
+        Assert.Equal(0, m.FacialHairItemID);
+        Assert.True(deed.Deleted);
+    }
+
+    [Fact]
+    public void TemplateSkillBall_SetsSevenSkillsToHundredAndWipesTheRest()
+    {
+        var m = NewPlayer();
+        m.Skills.Cooking.Base = 50;
+        var ball = Track(new TemplateSkillBall());
+        m.AddToBackpack(ball);
+
+        ball.Apply(m, [0, 1, 2, 3, 4, 5, 6]); // Tactics, Anatomy, Swords, Fencing, Archery, Macing, Parry
+
+        Assert.Equal(100, m.Skills.Tactics.Base);
+        Assert.Equal(100, m.Skills.Parry.Base);
+        Assert.Equal(0, m.Skills.Cooking.Base);
+        Assert.Equal(700, m.Skills.Total / 10);
+        Assert.True(ball.Deleted);
+    }
+
+    [Fact]
+    public void StatBall_AcceptsOnlyTotalsEqualToTheStatCap()
+    {
+        var m = NewPlayer();
+        var ball = Track(new StatBall());
+        m.AddToBackpack(ball);
+        var cap = m.StatCap;
+
+        Assert.False(ball.TryApply(m, 5, cap / 2, cap - 5 - cap / 2));
+        Assert.False(ball.Deleted);
+
+        var str = 100;
+        var dex = (cap - str) / 2;
+        Assert.True(ball.TryApply(m, str, dex, cap - str - dex));
+        Assert.Equal(str, m.RawStr);
+        Assert.True(ball.Deleted);
+    }
+
+    [Fact]
+    public void SkillBall_RaisesTheSkillByItsBonus()
+    {
+        var m = NewPlayer();
+        m.Skills.Magery.Base = 50;
+        var ball = Track(new SkillBall(25));
+
+        ball.IncreaseSkill(m, m, m.Skills.Magery);
+
+        Assert.Equal(75, m.Skills.Magery.Base);
+        Assert.Equal(0, ball.SkillBonus);
+    }
+
+    [Fact]
+    public void Shrink_StoresAControlledPetAndUnshrinkBringsItBack()
+    {
+        var (master, pet) = PetTestSetup.SpawnControlledPet(new Point3D(1500, 1600, 0), new Point3D(1501, 1600, 0));
+        Track(master);
+        Track(pet);
+        master.AddItem(new Backpack());
+
+        Assert.True(ShrinkFunctions.Shrink(master, pet));
+
+        var statuette = master.Backpack.FindItemByType<ShrinkItem>();
+        Assert.NotNull(statuette);
+        Assert.Equal(Map.Internal, pet.Map);
+
+        statuette.OnDoubleClick(master);
+
+        Assert.True(statuette.Deleted);
+        Assert.Equal(Map.Felucca, pet.Map);
+        Assert.Same(master, pet.ControlMaster);
+        Assert.False(pet.IsStabled);
+    }
+
+    [Fact]
+    public void Emblem_DeathReturnsTheFiveKills()
+    {
+        var m = NewPlayer();
+        m.Kills = 2;
+        var emblem = Track(new Emblem());
+
+        Assert.True(emblem.OnEquip(m));
+        Assert.Equal(7, m.Kills);
+        Assert.False(emblem.Movable);
+
+        emblem.OnParentDeath(m);
+
+        Assert.Equal(2, m.Kills);
+        Assert.True(emblem.Movable);
+        Assert.Equal(-1, m.SolidHueOverride);
+    }
+}
