+
+// Cursed earrings: once worn they cannot be taken off, mark the wearer a criminal with five extra kills
+// and grant bonuses by the wearer's main school. Only death removes them, and the kills with them.
+[SerializationGenerator(0)]
+public partial class Emblem : GoldEarrings
+{
+    [Constructible]
+    public Emblem()
+    {
+        LootType = LootType.Cursed;
+        Weight = 0.1;
+    }
+
+    public override string DefaultName => " Royal Emblem of Britannia ";
+
+    public override bool OnEquip(Mobile from)
+    {
+        Movable = false;
+        from.SolidHueOverride = from.Kills > 4 ? 33 : 1266;
+        from.Criminal = true;
+        from.Kills += 5;
+
+        if (from.Skills.Magery.Value > 50)
+        {
+            Attributes.BonusHits = 15;
+            Attributes.SpellDamage = 5;
+            Attributes.LowerManaCost = 5;
+            Attributes.RegenHits = 5;
+            Attributes.RegenStam = 10;
+        }
+        else if (from.Skills.Necromancy.Value > 50)
+        {
+            Attributes.BonusStam = 20;
+            Attributes.BonusHits = 10;
+            Attributes.RegenMana = 2;
+            Attributes.RegenHits = 2;
+            Attributes.RegenStam = 5;
+        }
+        else if (from.Skills.Healing.Value > 50)
+        {
+            Attributes.BonusHits = 15;
+            Attributes.WeaponSpeed = 10;
+            Attributes.WeaponDamage = 20;
+            Attributes.RegenMana = 2;
+            Attributes.RegenHits = 3;
+        }
+
+        from.SendMessage("The voice in your head tells you :  I am thy blessing and thy curse.");
+        from.SendMessage("You feel the power of the Royal Britannian Emblem surge through you!");
+
+        return base.OnEquip(from);
+    }
+
+    public override void OnDoubleClick(Mobile from)
+    {
+        if (from == RootParent)
+        {
+            from.SendMessage("POWER OVERWHELMING");
+        }
+    }
+
+    public override bool OnDragLift(Mobile from)
+    {
+        from.SendMessage(" Only death can save thee");
+        return true;
+    }
+
+    public override DeathMoveResult OnParentDeath(Mobile parent)
+    {
+        Movable = true;
+        Attributes.BonusHits = 0;
+        Attributes.SpellDamage = 0;
+        Attributes.LowerManaCost = 0;
+        Attributes.RegenHits = 0;
+        Attributes.RegenStam = 0;
+        Attributes.BonusStam = 0;
+        Attributes.RegenMana = 0;
+        Attributes.WeaponSpeed = 0;
+        Attributes.WeaponDamage = 0;
+
+        parent.SolidHueOverride = -1;
+
+        // DFI negated the kill count when it was under five; kept so old murder counts behave the same.
+        parent.Kills = parent.Kills >= 5 ? parent.Kills - 5 : -parent.Kills;
+
+        return base.OnParentDeath(parent);
+    }
+}
