+            return;
+        }
+
+        Use(from);
+    }
+
+    protected abstract void Use(Mobile from);
+
+    protected sealed class DeedTarget : Target
+    {
+        private readonly DfiDeed _deed;
+        private readonly Action<Mobile, object> _onTarget;
