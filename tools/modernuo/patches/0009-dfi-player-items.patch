+    public override string DefaultName => "a Shrink potion";
+    protected virtual bool Consumed => true;
+
+    public override void OnDoubleClick(Mobile from)
+    {
+        if (!Movable)
+        {
+            return;
+        }
+
+        if (!from.InRange(GetWorldLocation(), 2))
+        {
+            from.SendLocalizedMessage(500486); // That is too far away.
+            return;
+        }
+
+        if (Parent != from && Parent != from.Backpack)
+        {
+            from.SendLocalizedMessage(1042001); // That must be in your pack for you to use it.
+            return;
+        }
+
+        from.SendMessage("What do you wish to shrink?");
+        from.Target = new ShrinkFunctions.ShrinkTarget(3, (m, targ) =>
+            {
+                if (!Deleted && ShrinkFunctions.Shrink(m, targ) && Consumed)
+                {
+                    Delete();
+                }
+            }
+        );
+    }
+}
