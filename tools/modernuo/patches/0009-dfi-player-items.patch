+        public DeedTarget(DfiDeed deed, int range, Action<Mobile, object> onTarget) : base(range, false, TargetFlags.None)
+        {
+            _deed = deed;
+            _onTarget = onTarget;
+        }
+
+        protected override void OnTarget(Mobile from, object targeted)
+        {
+            if (!_deed.Deleted && _deed.IsChildOf(from.Backpack))
+            {
+                _onTarget(from, targeted);
+            }
+        }
+    }
