+        DropItem(new MandrakeRoot(60000));
+        DropItem(new Nightshade(60000));
+        DropItem(new SulfurousAsh(60000));
+        DropItem(new SpidersSilk(60000));
+        DropItem(new BatWing(60000));
+        DropItem(new GraveDust(60000));
+        DropItem(new DaemonBlood(60000));
