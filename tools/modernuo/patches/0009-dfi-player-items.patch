@@ -0,0 +1,275 @@
+// Player items from the kopia 2012 RunUO shard (Scripts/Custom/DonationShroud.cs, EquipBag.cs, PvPBag.cs,
+// Pozostale/otherHoodedRobe.cs) and DFI RunUO (Scripts/Custom/Opticon/Misc/Kale/Emblem.cs).
+
+using ModernUO.Serialization;
+using Server.Mobiles;
+
+namespace Server.Items;
+
+// An anonymity robe: with the hood up its wearer shows no name, guild title or murderer flag.
+[Flippable(0x2683, 0x2684)]
+[SerializationGenerator(0)]
+public partial class HoodedRobe : BaseOuterTorso
+{
+    [Constructible]
+    public HoodedRobe() : base(0x2683)
+    {
+    }
+
+    public override double DefaultWeight => 5.0;
+    public override string DefaultName => "Shroud";
+
+    private bool HoodUp => ItemID is 0x2683 or 0x2684;
+
+    public override void OnDoubleClick(Mobile m)
+    {
+        if (Parent != m)
+        {
+            m.SendMessage("You must be wearing the robe to use it!");
+            return;
+        }
+
+        m.PlaySound(0x57);
+
+        if (HoodUp)
+        {
+            m.SendMessage("You lower the hood.");
+            ItemID = 0x1F03;
+            Reveal(m);
+        }
+        else
+        {
+            m.SendMessage("You pull the hood over your head.");
+            ItemID = 0x2683;
+            Conceal(m);
+        }
+
+        m.RemoveItem(this);
+        m.EquipItem(this);
+    }
+
+    public override bool OnEquip(Mobile from)
+    {
+        if (ItemID == 0x2683)
+        {
+            Conceal(from);
+        }
+
+        return base.OnEquip(from);
+    }
+
+    public override void OnRemoved(IEntity parent)
+    {
+        if (parent is Mobile m)
+        {
+            Reveal(m);
+        }
+
+        base.OnRemoved(parent);
+    }
+
+    private static void Conceal(Mobile m)
+    {
+        m.NameMod = ".";
+        m.DisplayGuildTitle = false;
+        m.Criminal = false;
+    }
+
+    private static void Reveal(Mobile m)
+    {
+        m.NameMod = null;
+
+        if (m.Kills >= 5)
+        {
+            m.Criminal = true;
+        }
+
+        if (m.GuildTitle != null)
+        {
+            m.DisplayGuildTitle = true;
+        }
+    }
+}
