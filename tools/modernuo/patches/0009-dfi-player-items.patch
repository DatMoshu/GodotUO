diff --git a/Projects/UOContent/Custom/DFI/Items/Shrink.cs b/Projects/UOContent/Custom/DFI/Items/Shrink.cs
new file mode 100644
index 000000000..162b102cf
--- /dev/null
+++ b/Projects/UOContent/Custom/DFI/Items/Shrink.cs
@@ -0,0 +1,366 @@
+// The shrink system from the kopia 2012 RunUO shard (Scripts/Custom/Pozostale/shrink): potions, an
+// everlasting potion, a bag of ten, a stone that sells the bag, hitching posts and the [Shrink command.
+// A shrunk pet is stabled out of the world and comes back to whoever double-clicks the statuette.
+
+using System;
+using ModernUO.Serialization;
+using Server.Commands;
+using Server.Mobiles;
+using Server.Targeting;
+
+namespace Server.Items;
+
+public static class ShrinkFunctions
+{
+    public static void Configure()
+    {
+        CommandSystem.Register("Shrink", AccessLevel.GameMaster, e =>
+            {
+                e.Mobile.SendMessage("What do you wish to shrink?");
+                e.Mobile.Target = new ShrinkTarget(15, (from, targ) => Shrink(from, targ, false));
+            }
+        );
+    }
+
+    public static bool Shrink(Mobile from, object targ, bool restricted = true)
+    {
+        string error = null;
+        var errorCliloc = 0;
+
+        if (from == targ)
+        {
+            error = "You can't shrink yourself!";
+        }
+        else if (targ is not BaseCreature t)
+        {
+            error = "You can't shrink that!";
+        }
+        else if (restricted)
+        {
+            if (t.Summoned)
+            {
+                error = "You cannot shrink summoned creatures.";
+            }
+            else if (t.Combatant != null && t.InRange(t.Combatant, 12) && t.Map == t.Combatant.Map)
+            {
+                error = "You cannot shrink your pet while it is in combat.";
+            }
+            else if (!(t.Controlled && t.ControlMaster == from))
+            {
+                errorCliloc = 1042562; // That is not your pet!
+            }
+            else if (t is PackLlama or PackHorse or Beetle && t.Backpack?.Items.Count > 0)
+            {
+                errorCliloc = 1042563; // Unload the pet first
+            }
+        }
+
+        if (error != null || errorCliloc != 0)
+        {
+            if (errorCliloc != 0)
+            {
+                from?.SendLocalizedMessage(errorCliloc);
+            }
+            else
+            {
+                from?.SendMessage(error);
+            }
+
+            return false;
+        }
+
+        var pet = (BaseCreature)targ;
+        var shrunk = new ShrinkItem(pet);
+
+        if (from != null)
+        {
+            from.SendMessage("You shrink the pet");
+
+            if (!from.AddToBackpack(shrunk))
+            {
+                shrunk.MoveToWorld(from.Location, from.Map);
+                from.SendMessage("Your backpack is full so the shrunken pet falls to the ground");
+            }
+        }
+        else
+        {
+            shrunk.MoveToWorld(pet.Location, pet.Map);
+        }
+
+        // Controlled so a spawner stops counting it as its own.
+        pet.Controlled = true;
+        pet.SetControlMaster(null);
+        pet.SummonMaster = null;
+        pet.Internalize();
+        pet.IsStabled = true;
+        return true;
+    }
+
+    public sealed class ShrinkTarget : Target
+    {
+        private readonly Action<Mobile, object> _onTarget;
+
+        public ShrinkTarget(int range, Action<Mobile, object> onTarget) : base(range, false, TargetFlags.None) =>
+            _onTarget = onTarget;
+
+        protected override void OnTarget(Mobile from, object targeted) => _onTarget(from, targeted);
+    }
+}
+
+[SerializationGenerator(0)]
+public partial class ShrinkItem : Item
+{
+    [SerializableField(0)]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private BaseCreature _link;
+
+    [SerializableField(1)]
+    private bool _deletePetWithItem;
+
+    public ShrinkItem(BaseCreature pet) : base(ShrinkTable.Lookup(pet))
+    {
+        _link = pet;
+        _deletePetWithItem = true;
+
+        if (pet.Body != 400 && pet.Body != 401)
+        {
+            Hue = pet.Hue;
+        }
+
+        Name = $"{pet.Name} [shrunk]";
+    }
+
+    public override void OnDoubleClick(Mobile from)
+    {
+        if (!Movable)
+        {
+            return;
+        }
+
+        if (!from.InRange(GetWorldLocation(), 2))
+        {
+            from.SendLocalizedMessage(500486); // That is too far away.
+        }
+        else if (_link?.Deleted != false)
+        {
+            from.SendMessage("Your pet is lost forever...");
+        }
+        else if (!from.CheckAlive())
+        {
+            from.SendLocalizedMessage(1060190); // You cannot do that while dead!
+        }
+        else if (from.Followers + _link.ControlSlots > from.FollowersMax)
+        {
+            from.SendMessage("You have too many followers to unshrink that creature.");
+        }
+        else
+        {
+            var pet = _link;
+
+            if (!pet.Owners.Contains(from))
+            {
+                pet.Owners.Add(from);
+            }
+
+            pet.IsStabled = false;
+            pet.SetControlMaster(from);
+            pet.MoveToWorld(from.Location, from.Map);
+            pet.ControlTarget = from;
+            pet.ControlOrder = OrderType.Follow;
+
+            if (pet.Summoned)
+            {
+                pet.SummonMaster = from;
+            }
+
+            DeletePetWithItem = false;
+            Delete();
+        }
+    }
+
+    public override void OnDelete()
+    {
+        if (_deletePetWithItem)
+        {
+            _link?.Delete();
+        }
+
+        base.OnDelete();
+    }
+
+    public override void OnAfterDelete()
+    {
+        _link = null;
+        base.OnAfterDelete();
+    }
+}
