+}
+
+// Raises a skill of the user's own pet, from a list that depends on whether it poisons or casts.
+[SerializationGenerator(0)]
+public partial class PetSkillBall : SkillBall
+{
+    private static readonly SkillName[] _meleeSkills =
+    [
+        SkillName.Anatomy, SkillName.MagicResist, SkillName.Tactics, SkillName.Wrestling, SkillName.Meditation
+    ];
+
+    private static readonly SkillName[] _mageSkills =
+    [
+        SkillName.Anatomy, SkillName.EvalInt, SkillName.Magery, SkillName.MagicResist, SkillName.Tactics,
+        SkillName.Wrestling, SkillName.Meditation
+    ];
+
+    private static readonly SkillName[] _poisonSkills =
+    [
+        SkillName.Anatomy, SkillName.MagicResist, SkillName.Tactics, SkillName.Wrestling, SkillName.Meditation,
+        SkillName.Poisoning
+    ];
+
+    [Constructible]
+    public PetSkillBall(int bonus = 25, int maxcap = 100, bool limited = true, int days = 0, int mincap = 120)
+        : base(bonus, maxcap, limited, days, mincap)
+    {
+    }
+
+    public override string DefaultName => "pet skill ball";
+    public override int BallHue => 1428;
+
+    public override SkillName[] GetAllowedSkills(Mobile target)
+    {
+        if (target.Skills.Poisoning.Base > 0)
+        {
+            return _poisonSkills;
+        }
+
+        return target.Skills.Magery.Base > 0 ? _mageSkills : _meleeSkills;
+    }
+
+    protected override void Use(Mobile from)
+    {
+        from.SendMessage("Target your pet to use the skill ball.");
+        from.Target = new PetSkillBallTarget(this);
+    }
+
+    public override void SendConfirmMessage(Mobile from, Mobile target, Skill skill) =>
+        from.SendMessage($"Your pet, {target.Name}'s skill in {skill.Name} has been raised by {SkillBonus}");
+
+    private class PetSkillBallTarget : Target
+    {
+        private readonly PetSkillBall _ball;
+
+        public PetSkillBallTarget(PetSkillBall ball) : base(12, false, TargetFlags.None) => _ball = ball;
+
+        protected override void OnTarget(Mobile from, object targeted)
+        {
+            if (targeted is not BaseCreature { Controlled: true } creature || creature.ControlMaster != from)
+            {
+                from.SendMessage("You cannot use this skill ball on that.");
+            }
+            else if (from.HasGump<SkillBallGump>())
+            {
+                from.SendMessage("You are already using a skill ball.");
+            }
+            else if (_ball.IsExpired)
+            {
+                _ball.SendLocalizedMessageTo(from, 1042544); // This item is out of charges.
+            }
+            else if (_ball.IsNotOwner(from))
+            {
+                from.SendMessage("Only the owner can use this skill ball.");
+            }
+            else
+            {
+                from.SendGump(new SkillBallGump(_ball, creature));
+            }
+        }
+    }
+}
+
+public class SkillBallGump : DynamicGump
+{
+    private const int FieldsPerPage = 14;
+
+    private readonly SkillBall _ball;
+    private readonly Mobile _target;
+
+    public SkillBallGump(SkillBall ball, Mobile target) : base(20, 30)
+    {
+        _ball = ball;
+        _target = target;
+    }
+
+    protected override void BuildLayout(ref DynamicGumpBuilder builder)
+    {
+        builder.AddPage();
+        builder.AddBackground(0, 0, 260, 351, 5054);
+        builder.AddImageTiled(10, 10, 240, 23, 0x52);
+        builder.AddImageTiled(11, 11, 238, 21, 0xBBC);
+        builder.AddLabel(45, 11, 0, "Select a skill to raise");
+
+        builder.AddPage(1);
+
+        var page = 1;
+        var index = 0;
+        var allowed = _ball.GetAllowedSkills(_target);
+
+        for (var i = 0; i < allowed.Length; ++i)
+        {
+            if (index >= FieldsPerPage)
+            {
+                builder.AddButton(231, 13, 0x15E1, 0x15E5, 0, GumpButtonType.Page, page + 1);
+                ++page;
+                index = 0;
+                builder.AddPage(page);
+                builder.AddButton(213, 13, 0x15E3, 0x15E7, 0, GumpButtonType.Page, page - 1);
+            }
+
+            var skill = _target.Skills[allowed[i]];
+
+            if (!CanRaise(skill, allowed[i]))
+            {
+                continue;
+            }
+
+            var y = 32 + index * 22;
+            builder.AddImageTiled(10, y, 240, 23, 0x52);
+            builder.AddImageTiled(11, y + 1, 238, 21, 0xBBC);
+            builder.AddLabelCropped(13, y + 1, 150, 21, 0, skill.Name);
+            builder.AddImageTiled(180, y + 2, 50, 19, 0x52);
+            builder.AddImageTiled(181, y + 3, 48, 17, 0xBBC);
+            builder.AddLabelCropped(182, y + 3, 234, 21, 0, $"{skill.Base:F1}");
+            builder.AddButton(231, y + 3, 0x15E1, 0x15E5, i + 1);
+            ++index;
+        }
+    }
+
+    private bool CanRaise(Skill skill, SkillName name)
+    {
+        var raised = skill.BaseFixedPoint + _ball.SkillBonus * 10;
+
+        return skill.BaseFixedPoint <= _ball.MinCap * 10 && raised <= _ball.MaxCap * 10 &&
+               raised <= skill.CapFixedPoint && skill.Lock == SkillLock.Up &&
+               (name != SkillName.Stealth || _target.Skills.Hiding.BaseFixedPoint >= 800);
+    }
+
+    public override void OnResponse(NetState state, in RelayInfo info)
+    {
+        var from = state.Mobile;
+
+        if (from == null || _ball.Deleted || info.ButtonID <= 0)
+        {
+            return;
+        }
+
+        var allowed = _ball.GetAllowedSkills(_target);
+
+        if (_ball.IsExpired)
+        {
+            _ball.SendLocalizedMessageTo(from, 1042544); // This item is out of charges.
+            return;
+        }
+
+        if (!_ball.IsChildOf(from.Backpack))
+        {
+            from.SendLocalizedMessage(1042001); // That must be in your pack for you to use it.
+            return;
+        }
+
+        if (_ball.IsNotOwner(from))
+        {
+            from.SendMessage("Only the owner can use this skill ball.");
+            return;
+        }
+
+        if (info.ButtonID > allowed.Length)
+        {
+            return;
+        }
+
+        var name = allowed[info.ButtonID - 1];
+        var skill = _target.Skills[name];
+        var raised = skill.BaseFixedPoint + _ball.SkillBonus * 10;
+
+        if (name == SkillName.Stealth && _target.Skills.Hiding.BaseFixedPoint < 800)
+        {
+            from.SendMessage("You cannot train stealth until you have at least 80% hiding skill.");
+        }
+        else if (skill.BaseFixedPoint > _ball.MinCap * 10)
+        {
+            from.SendMessage($"You may only choose skills which are below {_ball.MinCap}.");
+        }
+        else if (raised > _ball.MaxCap * 10)
+        {
+            from.SendMessage($"You may only choose skills which raise your skill to a maximum of {_ball.MaxCap}.");
+        }
+        else if (raised > skill.CapFixedPoint)
+        {
+            from.SendMessage($"You may only choose skills which raise your skill to a maximum of {skill.Cap}.");
+        }
+        else if (skill.Lock != SkillLock.Up)
+        {
+            from.SendMessage("You must set the skill to be increased in order to raise it further.");
+        }
+        else
+        {
+            var count = _target.SkillsTotal;
+            var cap = _target.SkillsCap;
+
+            // DFI counts the target's total but lowers the user's own skills; for a pet ball that means
+            // the owner's. Kept as it was.
+            var decreased = _ball.GetDecreasableSkills(from, count, cap, out var decreaseAmount);
+
+            if (cap - count + decreaseAmount >= _ball.SkillBonus * 10)
+            {
+                _ball.DecreaseSkills(decreased, count, cap);
+                _ball.IncreaseSkill(from, _target, skill);
+
+                if (!_ball.Rechargable)
+                {
+                    _ball.Delete();
+                }
+            }
+            else
+            {
+                from.SendMessage("You have exceeded the skill cap and do not have enough skill set to be decreased.");
+            }
+        }
+    }
+}
