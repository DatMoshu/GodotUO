+
+// Ten random jewels with five properties each, 40-70% minimum intensity.
+[SerializationGenerator(0)]
+public partial class EquipBag : Bag
+{
+    [Constructible]
+    public EquipBag()
+    {
+        for (var i = 0; i < 10; ++i)
+        {
+            if (Loot.RandomJewelry() is not { } jewel)
+            {
+                continue;
+            }
+
+            var min = Utility.Random(10) switch
+            {
+                < 2 => 40,
+                < 4 => 50,
+                < 6 => 60,
+                < 8 => 65,
+                _   => 70
+            };
+
+            BaseRunicTool.ApplyAttributesTo(jewel, 5, min, 100);
+            DropItem(jewel);
+        }
+    }
+}
