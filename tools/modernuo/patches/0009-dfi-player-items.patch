+// Skill and stat balls. SkillBall, DonationSkillBall and PetSkillBall are DFI RunUO's
+// (Scripts/Custom/Items/SkillBalls); TemplateSkillBall is kopia 2012's SkillBall and StatBall its StatBall
+// (Scripts/Custom/Pozostale), renamed where the two shards clashed.
+
+using System;
+using System.Collections.Generic;
+using ModernUO.Serialization;
+using Server.Gumps;
+using Server.Mobiles;
+using Server.Network;
+using Server.Targeting;
+
+namespace Server.Items;
+
+// A GM-configured "+N to one skill" ball: Limited restricts it to combat and utility skills, MinCap is
+// the highest a chosen skill may start at, MaxCap the highest it may end at, and it can expire or be
+// bound to a player or an account. Over the skill cap it lowers skills set to go down.
+[SerializationGenerator(0)]
+public partial class SkillBall : Item
+{
+    private static readonly SkillName[] _limitedSkills =
+    [
+        SkillName.Anatomy, SkillName.AnimalLore, SkillName.ItemID, SkillName.ArmsLore, SkillName.Parry,
+        SkillName.Begging, SkillName.Peacemaking, SkillName.Camping, SkillName.DetectHidden, SkillName.Discordance,
+        SkillName.EvalInt, SkillName.Healing, SkillName.Forensics, SkillName.Herding, SkillName.Hiding,
+        SkillName.Magery, SkillName.MagicResist, SkillName.Tactics, SkillName.Snooping, SkillName.Musicianship,
+        SkillName.Archery, SkillName.SpiritSpeak, SkillName.Stealing, SkillName.TasteID, SkillName.Tracking,
+        SkillName.Veterinary, SkillName.Swords, SkillName.Macing, SkillName.Fencing, SkillName.Wrestling,
+        SkillName.Meditation, SkillName.Stealth, SkillName.RemoveTrap, SkillName.Necromancy, SkillName.Focus,
+        SkillName.Chivalry
+    ];
+
+    private static readonly SkillName[] _allSkills =
+    [
+        SkillName.Alchemy, SkillName.Anatomy, SkillName.AnimalLore, SkillName.ItemID, SkillName.ArmsLore,
+        SkillName.Parry, SkillName.Begging, SkillName.Blacksmith, SkillName.Fletching, SkillName.Peacemaking,
+        SkillName.Camping, SkillName.Carpentry, SkillName.Cartography, SkillName.Cooking, SkillName.DetectHidden,
+        SkillName.Discordance, SkillName.EvalInt, SkillName.Healing, SkillName.Fishing, SkillName.Forensics,
+        SkillName.Herding, SkillName.Hiding, SkillName.Provocation, SkillName.Inscribe, SkillName.Lockpicking,
+        SkillName.Magery, SkillName.MagicResist, SkillName.Tactics, SkillName.Snooping, SkillName.Musicianship,
+        SkillName.Poisoning, SkillName.Archery, SkillName.SpiritSpeak, SkillName.Stealing, SkillName.Tailoring,
+        SkillName.AnimalTaming, SkillName.TasteID, SkillName.Tinkering, SkillName.Tracking, SkillName.Veterinary,
+        SkillName.Swords, SkillName.Macing, SkillName.Fencing, SkillName.Wrestling, SkillName.Lumberjacking,
+        SkillName.Mining, SkillName.Meditation, SkillName.Stealth, SkillName.RemoveTrap, SkillName.Necromancy,
+        SkillName.Focus, SkillName.Chivalry
+    ];
+
+    [SerializableField(0)]
+    [InvalidateProperties]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private int _skillBonus;
+
+    [SerializableField(1)]
+    [InvalidateProperties]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private bool _limited;
+
+    [SerializableField(2)]
+    [InvalidateProperties]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private int _minCap;
+
+    [SerializableField(3)]
+    [InvalidateProperties]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private int _maxCap;
+
+    [SerializableField(4)]
+    [InvalidateProperties]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private bool _expires;
+
+    [SerializableField(5)]
+    [InvalidateProperties]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private DateTime _expireDate;
+
+    [SerializableField(6)]
+    [InvalidateProperties]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private Mobile _ownerPlayer;
+
+    [SerializableField(7)]
+    [InvalidateProperties]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private string _ownerAccount;
+
+    [Constructible]
+    public SkillBall(int bonus = 25, int maxcap = 100, bool limited = true, int days = 0, int mincap = 120) : base(7885)
+    {
+        _skillBonus = bonus;
+        _maxCap = maxcap;
+        _limited = limited;
+        _minCap = mincap;
+
+        if (days > 0)
+        {
+            _expireDate = Core.Now.AddDays(days);
+            _expires = true;
+        }
+
+        Hue = BallHue;
+    }
+
+    public override string DefaultName => "skill ball";
+    public override bool DisplayLootType => false;
+    public virtual int BallHue => 3;
+    public virtual bool Rechargable => false;
+
+    public bool IsExpired => _expires && Core.Now >= _expireDate;
+
+    public virtual SkillName[] GetAllowedSkills(Mobile target) => _limited ? _limitedSkills : _allSkills;
+
+    public override void GetProperties(IPropertyList list)
+    {
+        base.GetProperties(list);
+
+        if (_skillBonus > 0)
+        {
+            list.Add(1060658, $"{"bonus"}\t{_skillBonus} {(_limited ? "[Limited]" : "")}");
+        }
+        else
+        {
+            list.Add(1060658, $"{"bonus"}\t{"uncharged"}");
+        }
+
+        if (_minCap != 120)
+        {
+            list.Add(1060659, $"{"max skill"}\t{_minCap}");
+        }
+
+        if (_maxCap != 100)
+        {
+            list.Add(1060660, $"{"max bonus"}\t{_maxCap}");
+        }
+
+        if (_expires)
+        {
+            if (Core.Now < _expireDate)
+            {
+                list.Add(1074884, $"{(_expireDate - Core.Now).Days} days");
+            }
+            else if (_skillBonus > 0)
+            {
+                list.Add(1074884, $"{"none"}");
+            }
+        }
+
+        if (_ownerPlayer != null)
+        {
+            list.Add(1041522, $"\t{"player bound"}\t\t");
+        }
+        else if (!string.IsNullOrEmpty(_ownerAccount))
+        {
+            list.Add(1041522, $"\t{"account bound"}\t\t");
+        }
+    }
+
+    // True when someone other than the bound owner tries to use it.
+    public bool IsNotOwner(Mobile from) =>
+        _ownerPlayer != null && from != _ownerPlayer ||
+        !string.IsNullOrEmpty(_ownerAccount) && from.Account?.Username != _ownerAccount;
+
+    public override void OnDoubleClick(Mobile from)
+    {
+        if (_skillBonus <= 0 || IsExpired)
+        {
+            if (from.AccessLevel >= AccessLevel.GameMaster)
+            {
+                from.SendGump(new PropertiesGump(from, this));
+            }
+
+            SendLocalizedMessageTo(from, 1042544); // This item is out of charges.
+        }
+        else if (!IsChildOf(from.Backpack))
+        {
+            from.SendLocalizedMessage(1042001); // That must be in your pack for you to use it.
+        }
+        else if (IsNotOwner(from))
+        {
+            from.SendMessage("Only the owner can use this skill ball.");
+        }
+        else if (from.HasGump<SkillBallGump>())
+        {
+            from.SendMessage("You are already using a skill ball.");
+        }
+        else
+        {
+            Use(from);
+        }
+    }
+
+    protected virtual void Use(Mobile from) => from.SendGump(new SkillBallGump(this, from));
+
+    public List<Skill> GetDecreasableSkills(Mobile from, int count, int cap, out int decreaseAmount)
+    {
+        var skills = from.Skills;
+        var decreased = new List<Skill>();
+        decreaseAmount = 0;
+
+        if (count + _skillBonus * 10 > cap)
+        {
+            for (var i = 0; i < skills.Length; i++)
+            {
+                var amount = skills[i].BaseFixedPoint;
+
+                if (skills[i].Lock == SkillLock.Down && amount > 0)
+                {
+                    decreased.Add(skills[i]);
+                    decreaseAmount += amount;
+                }
+            }
+        }
+
+        return decreased;
+    }
+
+    public void DecreaseSkills(List<Skill> decreased, int count, int cap)
+    {
+        var bonus = _skillBonus * 10;
+        var freePool = cap - count;
+
+        if (freePool >= bonus)
+        {
+            return;
+        }
+
+        bonus -= freePool;
+
+        foreach (var s in decreased)
+        {
+            if (s.BaseFixedPoint >= bonus)
+            {
+                s.BaseFixedPoint -= bonus;
+                return;
+            }
+
+            bonus -= s.BaseFixedPoint;
+            s.BaseFixedPoint = 0;
+        }
+    }
+
+    public virtual void IncreaseSkill(Mobile from, Mobile target, Skill skill)
+    {
+        skill.BaseFixedPoint += _skillBonus * 10;
+        SendConfirmMessage(from, target, skill);
+        SkillBonus = 0;
+    }
+
+    public virtual void SendConfirmMessage(Mobile from, Mobile target, Skill skill) =>
+        from.SendMessage($"{skill.Name} skill has been raised by {_skillBonus}");
+
+    // DFI purged expired balls at the next world save; this removes them as they load.
+    [AfterDeserialization]
+    private void AfterDeserialization()
+    {
+        if (IsExpired)
+        {
+            Timer.DelayCall(Delete);
+        }
+    }
+}
+
+[SerializationGenerator(0)]
+public partial class DonationSkillBall : SkillBall
+{
+    private static readonly SkillName[] _limitedSkills =
+    [
+        SkillName.Anatomy, SkillName.AnimalLore, SkillName.ItemID, SkillName.ArmsLore, SkillName.Parry,
+        SkillName.Begging, SkillName.Peacemaking, SkillName.Camping, SkillName.Cartography, SkillName.DetectHidden,
+        SkillName.Discordance, SkillName.EvalInt, SkillName.Healing, SkillName.Fishing, SkillName.Forensics,
+        SkillName.Herding, SkillName.Hiding, SkillName.Provocation, SkillName.Inscribe, SkillName.Lockpicking,
+        SkillName.Magery, SkillName.MagicResist, SkillName.Tactics, SkillName.Snooping, SkillName.Musicianship,
+        SkillName.Poisoning, SkillName.Archery, SkillName.SpiritSpeak, SkillName.Stealing, SkillName.AnimalTaming,
+        SkillName.TasteID, SkillName.Tracking, SkillName.Veterinary, SkillName.Swords, SkillName.Macing,
+        SkillName.Fencing, SkillName.Wrestling, SkillName.Lumberjacking, SkillName.Mining, SkillName.Meditation,
+        SkillName.Stealth, SkillName.RemoveTrap, SkillName.Necromancy, SkillName.Focus, SkillName.Chivalry
+    ];
+
+    [Constructible]
+    public DonationSkillBall(int bonus = 25, int maxcap = 100, bool limited = true, int days = 0, int mincap = 120)
+        : base(bonus, maxcap, limited, days, mincap)
+    {
+    }
+
+    public override string DefaultName => "donation skill ball";
+    public override int BallHue => 33;
+
+    public override SkillName[] GetAllowedSkills(Mobile target) => Limited ? _limitedSkills : base.GetAllowedSkills(target);
+
+    public override void IncreaseSkill(Mobile from, Mobile target, Skill skill)
