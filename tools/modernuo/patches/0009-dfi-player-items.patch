+// Despite its name kopia's deed adds 5 self repair to armor and hats and 1 to weapons; capped at 10.
+[SerializationGenerator(0)]
+public partial class SelfRepairDeed : DfiDeed
+{
+    [Constructible]
+    public SelfRepairDeed() : base(1289)
+    {
+    }
+
+    public override string DefaultName => "Self Repair +1 Deed";
+
+    protected override void Use(Mobile from)
+    {
+        from.SendMessage("What item would you like to increase the self repair on?");
+        from.Target = new DeedTarget(this, 5, OnTarget);
+    }
+
+    private void OnTarget(Mobile from, object targeted)
+    {
+        int current;
+        int step;
+        Action<int> set;
+
+        switch (targeted)
+        {
+            case BaseArmor a:
+                {
+                    current = a.ArmorAttributes.SelfRepair;
+                    step = 5;
+                    set = v => a.ArmorAttributes.SelfRepair = v;
+                    break;
+                }
+            case BaseWeapon w:
+                {
+                    current = w.WeaponAttributes.SelfRepair;
+                    step = 1;
+                    set = v => w.WeaponAttributes.SelfRepair = v;
+                    break;
+                }
+            case BaseHat h:
+                {
+                    current = h.ClothingAttributes.SelfRepair;
+                    step = 5;
+                    set = v => h.ClothingAttributes.SelfRepair = v;
+                    break;
+                }
+            default:
+                {
+                    from.SendMessage("You cannot put self repair on that!");
+                    return;
+                }
+        }
+
+        if (current >= 10)
+        {
+            from.SendMessage("That item has reached the maximum self repair!");
+        }
+        else if (((Item)targeted).RootParent != from)
+        {
+            from.SendMessage("You cannot add self repair to that item there!");
+        }
+        else
+        {
+            var value = Math.Min(current + step, 10);
+            set(value);
+            from.SendMessage(
+                value >= 10
+                    ? "You increase the self repair on the item... it has now reached it's max."
+                    : "You increase the self repair on the item..."
+            );
+            Delete();
+        }
+    }
+}
