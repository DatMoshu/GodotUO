+    {
+        if (targeted is not BaseCreature creature)
+        {
+            from.SendMessage("You cannot bond that!");
+        }
+        else if (creature.ControlMaster != from || !creature.Controlled || !creature.IsBondable)
+        {
+            from.SendMessage("You cannot bond that creature!");
+        }
+        else if (creature.IsBonded)
+        {
+            from.SendMessage("Creature is already bonded!");
+        }
+        else if (creature.MinTameSkill > 29.1 && from.Skills.AnimalTaming.Value < creature.MinTameSkill)
+        {
+            from.SendLocalizedMessage(1075268); // Your pet cannot form a bond with you until your animal taming ability has risen.
+        }
+        else
+        {
+            creature.IsBonded = true;
+            creature.BondingBegin = DateTime.MinValue;
+            from.SendLocalizedMessage(1049666); // Your pet has bonded with you!
+            Delete();
+        }
+    }
