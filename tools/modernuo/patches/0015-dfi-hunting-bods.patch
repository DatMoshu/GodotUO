index 000000000..cfddab79e
--- /dev/null
+++ b/Projects/UOContent/Custom/DFI/HuntingBods/HuntingBods.cs
@@ -0,0 +1,775 @@
+// DFI Network's hunting bulk orders, ported from DFI RUNUO Scripts/Custom/Engines/HuntingBods and the hunting
+// branches DFI added to RunUO's bulk order deeds, gumps and books. A hunter hands out contracts to kill a number
+// of one creature (small) or of a set of them (large); a small contract fills by targeting the corpses, a large
+// one by combining finished small ones, as crafting deeds do. The creatures come from Data/Bulk Orders/Hunting.
+
+using System;
+using System.Collections.Generic;
+using ModernUO.Serialization;
+using Server.Custom.Dfi;
+using Server.Engines.BulkOrders;
+using Server.Gumps;
+using Server.Items;
+using Server.Mobiles;
+using Server.Targeting;
+
+namespace Server.Engines.BulkOrders
+{
+    public static class HuntBodUtility
+    {
+        public const int DeedHue = 0x1B0;
+        public const double SkillNeeded = 60.0;
+        public const double LargeSkillNeeded = 80.0;
+
+        private static readonly SkillName[] _fightingSkills =
+        [
+            SkillName.Archery, SkillName.Fencing, SkillName.Macing, SkillName.Magery, SkillName.Necromancy,
+            SkillName.AnimalTaming, SkillName.Swords, SkillName.Provocation
+        ];
+
+        private static readonly string[] _smallFiles = ["smalleasy", "smallmedium", "smallhard", "smallveryhard"];
+
+        // DFI's large sets in order of difficulty: the first 10 easy, then up to 19 medium, 22 hard, 23 very hard.
+        private static readonly string[] _largeFiles =
+        [
+            "largeorc", "largeratmen", "largesavage", "largeserpent", "largeskeleton", "largesnake", "largeundead",
+            "largespider", "largeplant", "largeharpy", "largedragon", "largeophidian", "largeelemental", "largejuka",
+            "largegargoyle", "largemeer", "largeogre", "largeredsolen", "largeblacksolen", "largewyrm",
+            "largegargoylehard", "largedoom", "largeveryhard"
+        ];
+
+        private static readonly int[] _largeLevelEnds = [10, 19, 22, 23];
+
+        public static SkillName GetBestFightingSkill(Mobile from)
+        {
+            var best = 0.0;
+            var skill = SkillName.Archery;
+
+            foreach (var name in _fightingSkills)
+            {
+                if (from.Skills[name].Base > best)
+                {
+                    best = from.Skills[name].Base;
+                    skill = name;
+                }
+            }
+
+            return skill;
+        }
+
+        public static double BestFightingSkill(Mobile from) => from.Skills[GetBestFightingSkill(from)].Base;
+
+        public static bool CanUseContract(Mobile from) => from is PlayerMobile && BestFightingSkill(from) >= SkillNeeded;
+
+        // The highest level a hunter of this skill is offered, and how many kills a contract asks.
+        public static void GetProps(double skill, out int levelMax, out int amountMax)
+        {
+            (levelMax, amountMax) = skill switch
+            {
+                >= 100 => (4, Utility.RandomList(10, 15, 20, 20)),
+                >= 90  => (3, Utility.RandomList(10, 15, 15, 20)),
+                >= 60  => (2, Utility.RandomList(10, 10, 15, 20)),
+                _      => (1, Utility.RandomList(10, 10, 15, 20))
+            };
+        }
+
+        public static SmallBulkEntry[] GetSmallEntries(out int level, int levelMax)
+        {
+            level = Utility.Random(levelMax);
+            return SmallBulkEntry.GetEntries("Hunting", _smallFiles[level]);
+        }
+
+        public static SmallBulkEntry[] GetLargeEntries(out int level, int levelMax)
+        {
+            var pick = Utility.Random(_largeLevelEnds[Math.Clamp(levelMax, 1, 4) - 1]);
+            level = 0;
+
+            while (level < 3 && pick >= _largeLevelEnds[level])
+            {
+                level++;
+            }
+
+            return SmallBulkEntry.GetEntries("Hunting", _largeFiles[pick]);
+        }
+
+        public static string DifficultyName(int level) =>
+            level switch
+            {
+                1 => "Medium",
+                2 => "Hard",
+                3 => "Very Hard",
+                _ => "Easy"
+            };
+
+        public static Item GetSmallRewardItem(int level)
+        {
+            Item Map() => new TreasureMap(level + Utility.RandomMinMax(1, 2), Server.Map.Felucca);
+
+            return level switch
+            {
+                0 => Utility.Random(100) < 5 ? new PowderOfTemperament() : Utility.Random(1, 3) switch
+                {
+                    1 => new VerySmallRedCarpetDeed(),
+                    2 => new VerySmallBlueCarpetDeed(),
+                    _ => Map()
+                },
+                1 => Utility.Random(100) < 8 ? new PowderOfTemperament() : Utility.Random(4) switch
+                {
+                    0 => new SmallBrownCarpetDeed(),
+                    1 => new VerySmallRedCarpetDeed(),
+                    2 => new VerySmallBlueCarpetDeed(),
+                    _ => Map()
+                },
+                2 => Utility.Random(3, 6) switch
+                {
+                    3 => Map(),
+                    4 => new PowderOfTemperament(),
+                    5 => new PetSkillBall(3),
+                    6 => new SmallRedCarpetDeed(),
+                    7 => Map(),
+                    _ => new RedCarpetDeed()
+                },
+                _ => Utility.RandomMinMax(4, 6) switch
+                {
+                    4 => new PowderOfTemperament(),
+                    5 => new PetSkillBall(3),
+                    _ => new SmallRedCarpetDeed()
+                }
+            };
+        }
+
+        public static Item GetLargeRewardItem(int level)
+        {
+            var petBall = (level + 1) * 5;
+
+            Item[] Pick(params Func<Item>[] items) => [items[Utility.Random(items.Length)]()];
+
+            return (level switch
+            {
+                0 => Pick(
+                    () => new FancyBlueCarpetDeed(), () => new FancyRedCarpetDeed(), () => new RoyalRedCarpetDeed(),
+                    () => new RoyalBlueCarpetDeed(), () => new LargeBannerSouth2AddonDeed(),
+                    () => new LargeBannerEast2AddonDeed(), () => new PetSkillBall(petBall)
+                ),
+                1 => Pick(
+                    () => new PetSkillBall(petBall), () => new LargeStretchedHideEastDeed(),
+                    () => new LargeStretchedHideSouthDeed(), () => new LargeBlueCarpetDeed(), () => new LargeRedCarpetDeed(),
+                    () => new LargeBannerSouth3AddonDeed(), () => new LargeBannerEast3AddonDeed()
+                ),
+                2 => Pick(
+                    () => new LargeGoldCarpetDeed(), () => new LargeBrownCarpetDeed(), () => new OrcishBannerEastDeed(),
+                    () => new OrcishBannerSouthDeed(), () => new NecklaceOfFortune(), () => new LargeBannerSouthAddonDeed(),
+                    () => new LargeBannerEastAddonDeed(), () => new PetSkillBall(petBall)
+                ),
+                _ => Utility.RandomDouble() < 0.10
+                    ? [new WarForkOfChaos()]
+                    : Pick(
+                        () => new LargeBannerSouthAddonDeed(), () => new LargeBannerEastAddonDeed(),
+                        () => new PetSkillBall(petBall), () => new BoneThroneDeed(), () => new BoneCouchDeed(),
+                        () => new BoneTableDeed()
+                    )
+            })[0];
+        }
+    }
+
+    // A small hunting contract: kill the creature AmountMax times and target each corpse with the deed.
+    [SerializationGenerator(0)]
+    public partial class SmallHuntBOD : SmallBOD
+    {
+        [SerializableField(0)]
+        [SerializedCommandProperty(AccessLevel.GameMaster)]
+        private int _level;
+
+        [Constructible]
+        public SmallHuntBOD() : this(Utility.RandomMinMax(80, 120))
+        {
+        }
+
+        public SmallHuntBOD(double skill)
+        {
+            HuntBodUtility.GetProps(skill, out var levelMax, out var amountMax);
+            var entries = HuntBodUtility.GetSmallEntries(out var level, levelMax);
+            Hue = HuntBodUtility.DeedHue;
+            AmountMax = amountMax;
+            _level = level;
+
+            if (entries.Length > 0)
+            {
+                var entry = entries.RandomElement();
+                Type = entry.Type;
+                Number = entry.Number;
+                Graphic = entry.Graphic;
+            }
+        }
+
+        public override RewardGroup GetRewardGroup() => null;
+
+        public override int ComputeFame() => 10 + Utility.Random((_level + 1) * 10);
+
+        public override int ComputeGold() => (_level + 1) * 300 + AmountMax * 10 + Utility.Random(300);
+
+        public override void GetRewards(out Item reward, out int gold, out int fame)
+        {
+            gold = ComputeGold();
+            fame = ComputeFame();
+
+            var bag = new Bag();
+            DfiLoot.AddRandomLoot(bag, (_level + 1) * 3, (int)(_level * 300 + AmountMax / 20.0 * 300), Math.Min(3, _level + 1), 5, 10, 100);
+            bag.DropItem(HuntBodUtility.GetSmallRewardItem(_level));
+            reward = bag;
+        }
+
+        public override void GetProperties(IPropertyList list)
+        {
+            base.GetProperties(list);
+            list.Add(1042971, $"Difficulty Level: {HuntBodUtility.DifficultyName(_level)}"); // ~1_NOTHING~
+        }
+
+        public override void OnDoubleClick(Mobile from)
+        {
+            if (IsChildOf(from.Backpack) && !HuntBodUtility.CanUseContract(from))
+            {
+                from.SendMessage($"You need to have atleast {HuntBodUtility.SkillNeeded} in a figthing skill to use this.");
+                return;
+            }
+
+            base.OnDoubleClick(from);
+        }
+
+        public override void BeginCombine(Mobile from)
+        {
+            if (Complete)
+            {
+                // The maximum amount of requested items have already been combined to this deed.
+                from.SendLocalizedMessage(1045166);
+                return;
+            }
+
+            from.SendMessage("Target the corpse to add.");
+            from.Target = new HuntTarget(this);
+        }
+
+        public override void EndCombine(Mobile from, Item item)
+        {
+            if (item is Corpse corpse)
+            {
+                AddCorpse(from, corpse);
+            }
+            else
+            {
+                from.SendLocalizedMessage(1042600); // That is not a corpse!
+            }
+        }
+
+        // A corpse counts once it is half a minute old, if the deed's holder had the right to loot it.
+        public void AddCorpse(Mobile from, Corpse corpse)
+        {
+            if (corpse.Deleted || !from.InRange(corpse.Location, 4))
+            {
+                from.SendLocalizedMessage(500446); // That is too far away.
+                return;
+            }
+
+            if (corpse.Owner?.GetType() != Type)
+            {
+                from.SendMessage("The creature is not in the request.");
+                return;
+            }
+
+            if (corpse.IsCriminalAction(from))
+            {
+                from.SendMessage("You did not earn the right to use this creature in the deed.");
+                return;
+            }
+
+            var ready = corpse.TimeOfDeath + TimeSpan.FromSeconds(30.0);
+
+            if (ready > Core.Now)
+            {
+                from.SendMessage($"This corpse cannot be added yet, try again in {Math.Max(0, (int)(ready - Core.Now).TotalSeconds)} seconds.");
+                return;
+            }
+
+            corpse.Delete();
+            AmountCur++;
+            from.SendMessage("The corpse has been combined with the deed.");
+            from.SendGump(new SmallBODGump(this));
+        }
+
+        // A bulk order book would rebuild this as a crafting deed when it hands it back.
+        public override bool OnDroppedOnto(Mobile from, Item target)
+        {
+            if (target is BulkOrderBook)
+            {
+                from.SendMessage("Hunting contracts cannot be kept in a bulk order book.");
+                return false;
+            }
+
+            return base.OnDroppedOnto(from, target);
+        }
+
+        private class HuntTarget : Target
+        {
+            private readonly SmallHuntBOD _deed;
+
+            public HuntTarget(SmallHuntBOD deed) : base(18, false, TargetFlags.None) => _deed = deed;
+
+            protected override void OnTarget(Mobile from, object targeted)
+            {
+                if (_deed.Deleted || !_deed.IsChildOf(from.Backpack) || targeted is not IEntity e || !from.CanSee(e))
+                {
+                    return;
+                }
+
+                if (targeted is Corpse corpse)
+                {
+                    _deed.AddCorpse(from, corpse);
+                }
+                else
+                {
+                    from.SendLocalizedMessage(1042600); // That is not a corpse!
+                }
+            }
+        }
+    }
+
