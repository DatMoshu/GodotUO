diff --git a/Projects/UOContent.Tests/Tests/Custom/DfiHuntingBodTests.cs b/Projects/UOContent.Tests/Tests/Custom/DfiHuntingBodTests.cs
new file mode 100644
index 000000000..157b30f1f
--- /dev/null
+++ b/Projects/UOContent.Tests/Tests/Custom/DfiHuntingBodTests.cs
@@ -0,0 +1,222 @@
+using System;
+using System.Collections.Generic;
+using Server;
+using Server.Engines.BulkOrders;
+using Server.Items;
+using Server.Misc;
+using Server.Mobiles;
+using Xunit;
+
+namespace UOContent.Tests.Custom;
+
+[Collection("Sequential UOContent Tests")]
+public class DfiHuntingBodTests : IDisposable
+{
+    private readonly List<IEntity> _created = new();
+
+    public DfiHuntingBodTests()
+    {
+        if (NameList.GetNameList("male") == null)
+        {
+            NameList.Configure();
+        }
+    }
+
+    public static TheoryData<Type> Deeds
+    {
+        get
+        {
+            var data = new TheoryData<Type>();
+
+            foreach (var type in HuntDecor)
+            {
+                data.Add(type);
+            }
+
+            return data;
+        }
+    }
+
+    private static readonly Type[] HuntDecor =
+    [
+        typeof(SmallBrownCarpetDeed), typeof(VerySmallBlueCarpetDeed), typeof(VerySmallRedCarpetDeed),
+        typeof(SmallRedCarpetDeed), typeof(RedCarpetDeed), typeof(BlueCarpetDeed), typeof(FancyBlueCarpetDeed),
+        typeof(FancyRedCarpetDeed), typeof(RoyalRedCarpetDeed), typeof(RoyalBlueCarpetDeed), typeof(LargeGoldCarpetDeed),
+        typeof(LargeBlueCarpetDeed), typeof(LargeRedCarpetDeed), typeof(LargeBrownCarpetDeed),
+        typeof(LargeStretchedHideSouthDeed), typeof(LargeStretchedHideEastDeed), typeof(OrcishBannerSouthDeed),
+        typeof(OrcishBannerEastDeed), typeof(LargeBannerEast2AddonDeed), typeof(LargeBannerEast3AddonDeed),
+        typeof(LargeBannerEastAddonDeed), typeof(LargeBannerSouth2AddonDeed), typeof(LargeBannerSouth3AddonDeed),
+        typeof(LargeBannerSouthAddonDeed)
+    ];
+
+    public void Dispose()
+    {
+        foreach (var e in _created)
+        {
+            e?.Delete();
+        }
+
+        _created.Clear();
+    }
+
+    private T Track<T>(T e) where T : IEntity
+    {
+        _created.Add(e);
+        return e;
+    }
+
+    private PlayerMobile Fighter(double swords)
+    {
+        var m = Track(new PlayerMobile());
+        m.Player = true;
+        m.Body = 0x190;
+        m.AddItem(new Backpack());
+        m.Skills.Swords.Base = swords;
+        m.MoveToWorld(new Point3D(1432, 1615, 20), Map.Felucca);
+        return m;
+    }
+
+    [Theory]
+    [MemberData(nameof(Deeds))]
+    public void Decor_DeedBuildsItsAddonAndBack(Type type)
+    {
+        var deed = Track(type.CreateInstance<BaseAddonDeed>());
+        var addon = Track(deed.Addon);
+
+        Assert.NotEmpty(addon.Components);
+        Assert.Equal(type, addon.Deed.GetType());
+    }
+
+    [Theory]
+    [InlineData("smalleasy")]
+    [InlineData("smallmedium")]
+    [InlineData("smallhard")]
+    [InlineData("smallveryhard")]
+    [InlineData("largeorc")]
+    [InlineData("largedoom")]
+    [InlineData("largeveryhard")]
+    public void Entries_LoadFromTheHuntingFiles(string name)
+    {
+        var entries = SmallBulkEntry.GetEntries("Hunting", name);
+
+        Assert.NotEmpty(entries);
+        Assert.All(entries, e => Assert.True(typeof(BaseCreature).IsAssignableFrom(e.Type)));
+    }
+
+    [Fact]
+    public void SmallContract_AsksForACreature()
+    {
+        var bod = Track(new SmallHuntBOD(100.0));
+
+        Assert.NotNull(bod.Type);
+        Assert.InRange(bod.Level, 0, 3);
+        Assert.Contains(bod.AmountMax, new[] { 10, 15, 20 });
+    }
+
+    [Fact]
+    public void SmallContract_TakesOnlyItsCreaturesSettledCorpses()
+    {
+        var player = Fighter(100);
+        var bod = Track(new SmallHuntBOD(100.0) { Type = typeof(Orc), AmountMax = 10 });
+
+        // The test server makes no corpse on death; this one stands in for a fresh orc's. A corpse made this way
+        // reads as innocent, so the hunter acts as staff to get past the looting-rights check.
+        player.AccessLevel = AccessLevel.GameMaster;
+        var orc = Track(new Orc());
+        var corpse = Track(new Corpse(orc, []));
+        corpse.MoveToWorld(new Point3D(1433, 1615, 20), Map.Felucca);
+
+        bod.AddCorpse(player, corpse);
+        Assert.Equal(0, bod.AmountCur);
+
+        corpse.TimeOfDeath = Core.Now - TimeSpan.FromMinutes(1);
+        bod.Type = typeof(Ettin);
+        bod.AddCorpse(player, corpse);
+        Assert.Equal(0, bod.AmountCur);
+
+        bod.Type = typeof(Orc);
+        bod.AddCorpse(player, corpse);
+        Assert.Equal(1, bod.AmountCur);
+        Assert.True(corpse.Deleted);
+    }
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(1)]
+    [InlineData(2)]
+    [InlineData(3)]
+    public void Rewards_AreABagWithADecorPrize(int level)
+    {
+        var small = Track(new SmallHuntBOD(100.0) { Level = level });
+        small.GetRewards(out var reward, out var gold, out var fame);
+        Track(reward);
+
+        Assert.IsType<Bag>(reward);
+        Assert.True(gold >= (level + 1) * 300);
+        Assert.True(fame >= 10);
+
+        var large = Track(new LargeHuntBOD(100.0) { Level = level });
+        large.GetRewards(out var largeReward, out var largeGold, out _);
+        Track(largeReward);
+
+        Assert.IsType<Bag>(largeReward);
+        Assert.True(largeGold >= 3000 + level * 2000);
+    }
+
+    [Fact]
+    public void LargeContract_TakesFinishedSmallContractsOnly()
+    {
+        var player = Fighter(100);
+        var large = Track(new LargeHuntBOD(100.0) { AmountMax = 10 });
+        var type = large.Entries[0].Details.Type;
+
+        var smith = Track(new SmallSmithBOD());
+        large.EndCombine(player, smith);
+        Assert.Equal(0, large.Entries[0].Amount);
+
+        var small = Track(new SmallHuntBOD(100.0) { Type = type, AmountMax = 10, AmountCur = 10 });
+        player.Backpack.DropItem(small);
+        large.EndCombine(player, small);
+
+        Assert.Equal(10, large.Entries[0].Amount);
+        Assert.True(small.Deleted);
+    }
+
+    [Fact]
+    public void Hunter_GivesAContractThenMakesTheFighterWait()
+    {
+        var hunter = Track(new Hunter());
+        var player = Fighter(100);
+
+        var first = Track(hunter.CreateBulkOrder(player, true));
+
+        Assert.True(first is SmallHuntBOD or LargeHuntBOD);
+        Assert.True(hunter.GetNextBulkOrder(player) > TimeSpan.FromHours(5.9));
+        Assert.Null(hunter.CreateBulkOrder(player, true));
+
+        hunter.OnSuccessfulBulkOrderReceive(player);
+        Assert.Equal(TimeSpan.Zero, hunter.GetNextBulkOrder(player));
+    }
+
+    [Fact]
+    public void Hunter_RefusesContractsFromTheUnskilled()
+    {
+        var hunter = Track(new Hunter());
+        var novice = Fighter(30);
+
+        Assert.False(HuntBodUtility.CanUseContract(novice));
+        Assert.False(hunter.OnDragDrop(novice, Track(new SmallHuntBOD(100.0))));
+    }
+
+    [Fact]
+    public void WarForkOfChaos_LevelsOnTheFey()
+    {
+        var fork = Track(new WarForkOfChaos());
+
+        LevelItemManager.CheckLevelable(fork, Track(new Orc()));
+        Assert.Equal(0, fork.Experience);
+
+        LevelItemManager.CheckLevelable(fork, Track(new Pixie()));
+        Assert.True(fork.Experience > 0);
+    }
+}
