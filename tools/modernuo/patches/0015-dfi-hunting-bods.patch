+            HuntBodUtility.GetProps(skill, out var levelMax, out var amountMax);
+            Hue = HuntBodUtility.DeedHue;
+            AmountMax = amountMax;
+            Entries = LargeBulkEntry.ConvertEntries(this, HuntBodUtility.GetLargeEntries(out var level, levelMax));
+            _level = level;
+        }
+
+        public override RewardGroup GetRewardGroup() => null;
+
+        public override int ComputeFame() => 100 + Utility.Random(20 * (_level + 1));
+
+        public override int ComputeGold() => 3000 + _level * 2000 + AmountMax * 40 + Entries.Length * 100 + Utility.Random(500);
+
+        // A bag of magic items, a decor reward, and now and then a power scroll; the chance grows with the
+        // level, the amount asked and the number of creatures.
+        public override void GetRewards(out Item reward, out int gold, out int fame)
+        {
+            gold = ComputeGold();
+            fame = ComputeFame();
+
+            var (psChance, psLevel) = _level switch
+            {
+                1 => (0.05, 5),
+                2 => (0.10, 5),
+                3 => (0.20, 10),
+                _ => (0.03, 5)
+            };
+
+            psChance += AmountMax / 200.0 + Entries.Length / 60.0;
+
+            var bag = new Bag();
+            DfiLoot.AddRandomLoot(
+                bag,
+                (_level + 1) * 3,
+                (int)(_level * 300 + AmountMax / 20.0 * 150 + Entries.Length / 6.0 * 150),
+                Math.Min(5, _level + 3),
+                5,
+                50,
+                100
+            );
+            bag.DropItem(HuntBodUtility.GetLargeRewardItem(_level));
+
+            if (psChance >= Utility.RandomDouble())
+            {
+                bag.DropItem(PowerScroll.CreateRandomNoCraft(psLevel, psLevel));
+            }
+
+            reward = bag;
+        }
+
+        public override void GetProperties(IPropertyList list)
+        {
+            base.GetProperties(list);
+            list.Add(1042971, $"Difficulty Level: {HuntBodUtility.DifficultyName(_level)}"); // ~1_NOTHING~
+        }
