+    // When each player may next be offered a hunting contract: an hour, two at 80 skill, six at 100.
+    public class HuntContracts : GenericPersistence
+    {
+        private static readonly Dictionary<Mobile, DateTime> _next = new();
+
+        public HuntContracts() : base("HuntContracts", 10)
+        {
+        }
+
+        public static void Configure()
+        {
+            _ = new HuntContracts();
+        }
+
+        public static TimeSpan Remaining(Mobile m) =>
+            _next.TryGetValue(m, out var next) && next > Core.Now ? next - Core.Now : TimeSpan.Zero;
+
+        public static void Set(Mobile m, TimeSpan delay) => _next[m] = Core.Now + delay;
+
+        public static void Clear(Mobile m) => _next.Remove(m);
+
+        public override void Serialize(IGenericWriter writer)
+        {
+            writer.WriteEncodedInt(0); // version
+
+            var live = new List<KeyValuePair<Mobile, DateTime>>();
+
+            foreach (var kv in _next)
+            {
+                if (!kv.Key.Deleted && kv.Value > Core.Now)
+                {
+                    live.Add(kv);
+                }
+            }
+
+            writer.WriteEncodedInt(live.Count);
+
+            foreach (var (m, next) in live)
+            {
+                writer.Write(m);
+                writer.Write(next);
+            }
+        }
+
+        public override void Deserialize(IGenericReader reader)
+        {
+            reader.ReadEncodedInt(); // version
+            var count = reader.ReadEncodedInt();
+
+            for (var i = 0; i < count; i++)
+            {
+                var m = reader.ReadEntity<Mobile>();
+                var next = reader.ReadDateTime();
+
+                if (m != null)
+                {
+                    _next[m] = next;
+                }
+            }
+        }
+    }
+}
