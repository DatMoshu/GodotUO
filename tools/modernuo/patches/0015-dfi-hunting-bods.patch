+
+        public override TimeSpan GetNextBulkOrder(Mobile from) => HuntContracts.Remaining(from);
+
+        public override Item CreateBulkOrder(Mobile from, bool fromContextMenu)
+        {
+            if (from is not PlayerMobile pm || HuntContracts.Remaining(pm) > TimeSpan.Zero ||
+                !fromContextMenu && Utility.RandomDouble() >= 0.2)
+            {
+                return null;
+            }
+
+            var skill = HuntBodUtility.BestFightingSkill(pm);
+
+            HuntContracts.Set(
+                pm,
+                skill switch
+                {
+                    >= 100 => TimeSpan.FromHours(6.0),
+                    >= 80  => TimeSpan.FromHours(2.0),
+                    _      => TimeSpan.FromHours(1.0)
+                }
+            );
+
+            if (skill >= HuntBodUtility.LargeSkillNeeded && (skill - 40.0) / 300.0 > Utility.RandomDouble())
+            {
+                return new LargeHuntBOD(skill);
+            }
+
+            return new SmallHuntBOD(skill);
+        }
+
+        public override void OnSuccessfulBulkOrderReceive(Mobile from)
+        {
+            HuntContracts.Clear(from);
+        }
+
+        public override bool OnDragDrop(Mobile from, Item dropped)
+        {
+            if (IsValidBulkOrder(dropped) && !HuntBodUtility.CanUseContract(from))
