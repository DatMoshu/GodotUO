+// Places DFI's events: the Last Man Pentagram in Luna, started every evening at 19:15 UTC, and the Event Reward
+// Vendor on the street by Britain's bank. DFI's saves kept neither spot; both are open ground at a town centre.
+// [SpawnEIC turns the dungeons' locked chests into treasure chests separately.
+
+using System.Collections.Generic;
+using Server.Commands;
+using Server.Logging;
+using Server.Mobiles;
+
+namespace Server.Custom.Dfi;
+
+public static class DfiEventsGen
+{
+    private static readonly ILogger logger = LogFactory.GetLogger(typeof(DfiEventsGen));
+
+    public static readonly Point3D PentagramSpot = new(995, 512, -50);
+    public static readonly Point3D RewardVendorSpot = new(1434, 1689, 0);
+
+    public static void Configure()
+    {
+        CommandSystem.Register("DfiEvents", AccessLevel.Administrator, OnCommand);
+    }
+
+    [Usage("DfiEvents")]
+    [Description("Places DFI's Last Man Pentagram in Luna and the Event Reward Vendor in Britain, replacing any placed before.")]
+    private static void OnCommand(CommandEventArgs e)
+    {
+        var removed = Remove();
+        var placed = Place();
+        e.Mobile.SendMessage($"DfiEvents: removed {removed}, placed {placed}.");
+        logger.Information("{User} placed {Placed} DFI event fixtures ({Removed} removed)", e.Mobile, placed, removed);
+    }
+
+    public static int Remove()
+    {
+        var doomed = new List<IEntity>();
+
+        foreach (var m in World.Mobiles.Values)
+        {
+            if (m is EventRewardNPC)
+            {
+                doomed.Add(m);
+            }
+        }
+
+        foreach (var item in World.Items.Values)
+        {
+            if (item is LastManPentagram)
+            {
+                doomed.Add(item);
+            }
+        }
+
+        foreach (var entity in doomed)
+        {
+            entity.Delete();
+        }
+
+        return doomed.Count;
+    }
+
+    public static int Place()
+    {
+        var pentagram = new LastManPentagram { PentagramLocation = "Luna" };
+        pentagram.MoveToWorld(PentagramSpot, Map.Malas);
+        pentagram.AutoDaily = true;
+
+        var vendor = new EventRewardNPC { Home = RewardVendorSpot, RangeHome = 0 };
+        vendor.MoveToWorld(RewardVendorSpot, Map.Felucca);
+
+        return 2;
+    }
+}
