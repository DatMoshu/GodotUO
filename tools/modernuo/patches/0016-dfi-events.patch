+// [SpawnEIC replaces the locked decorative chests in dungeons with treasure chests of the same look, the
+// chest's art setting its level.
+public static class SpawnEIC
+{
+    private static readonly ILogger logger = LogFactory.GetLogger(typeof(SpawnEIC));
+
+    private static readonly int[][] _chestIds =
+        [[0x9A9, 0xE7E], [0xE3F, 0xE3E], [0xE3D, 0xE3C], [0xE43, 0xE42], [0x9AB, 0xE7C], [0xE41, 0xE40]];
+
+    public static void Configure()
+    {
+        CommandSystem.Register("SpawnEIC", AccessLevel.Administrator, OnCommand);
+    }
+
+    private static BaseItemChest ChestFor(int index) =>
+        index switch
+        {
+            0 => new EICSmallCrate(),
+            1 => new EICMediumCrate(),
+            2 => new EICLargeCrate(),
+            3 => new EICWooden(),
+            4 => new EICMetal(),
+            _ => new EICMetalGolden()
+        };
+
+    [Usage("SpawnEIC")]
+    [Description("Replaces the locked chests in dungeons with DFI's treasure chests.")]
+    private static void OnCommand(CommandEventArgs e)
+    {
+        e.Mobile.SendMessage("Spawning Item Chests...");
+        var count = Spawn();
+        e.Mobile.SendMessage($"Done... {count} Item Chests added.");
+        logger.Information("{User} placed {Count} treasure chests", e.Mobile, count);
+    }
+
+    public static int Spawn()
+    {
+        var found = new List<LockableContainer>();
+
+        foreach (var item in World.Items.Values)
+        {
+            if (item is LockableContainer c and not BaseItemChest and not BaseTreasureChest && !c.Movable &&
+                c.Parent == null && Region.Find(c.Location, c.Map) is DungeonRegion)
+            {
+                found.Add(c);
+            }
+        }
+
+        var count = 0;
+
+        foreach (var cont in found)
+        {
+            for (var a = 0; a < _chestIds.Length; a++)
+            {
+                if (Array.IndexOf(_chestIds[a], cont.ItemID) < 0)
+                {
+                    continue;
+                }
+
+                var chest = ChestFor(a);
+                chest.ItemID = cont.ItemID;
+                chest.Hue = cont.Hue;
+                chest.MoveToWorld(cont.Location, cont.Map);
+                cont.Delete();
+                count++;
+                break;
+            }
+        }
+
+        return count;
+    }
+}
