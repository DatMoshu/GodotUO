+// Keeps an event prize cursed for a while and hues whoever carries it, so the rest can hunt them down. It cannot
+// be banked meanwhile.
+public class CursedArtifactTimer : Timer
+{
+    public const int DefaultMinutes = 7;
+
+    private readonly Item _artifact;
+    private Mobile _carrier;
+    private Container _container;
+    private int _ticksLeft;
+
+    public CursedArtifactTimer(Item artifact, int minutes) : base(TimeSpan.Zero, TimeSpan.FromSeconds(1.0))
+    {
+        _artifact = artifact;
+        _artifact.LootType = LootType.Cursed;
+        _ticksLeft = (minutes <= 0 ? DefaultMinutes : minutes) * 60;
+    }
+
+    protected override void OnTick()
+    {
+        if (_artifact.Deleted)
+        {
+            Clear();
+            Stop();
+            return;
+        }
+
+        if (_ticksLeft <= 0)
+        {
+            _artifact.LootType = _artifact switch
+            {
+                PetBondingDeed or BankCheck or ClothingBlessDeed => LootType.Blessed,
+                PowerScroll or StatCapScroll                     => LootType.Cursed,
+                _                                                => LootType.Regular
+            };
+
+            Clear();
+            Stop();
+            return;
+        }
+
+        switch (_artifact.RootParent)
+        {
+            case Mobile mob:
+                {
+                    if (_container != null)
+                    {
+                        _container.Hue = 0;
+                        _container = null;
+                    }
+                    else if (_carrier != mob)
+                    {
+                        if (_carrier != null)
+                        {
+                            _carrier.SolidHueOverride = -1;
+                        }
+
+                        _carrier = mob;
+                        _carrier.SolidHueOverride = 18;
+                    }
+
+                    for (var parent = _artifact.Parent as Container; parent != null; parent = parent.Parent as Container)
+                    {
+                        if (parent is BankBox)
+                        {
+                            mob.AddToBackpack(_artifact);
+                            mob.SendMessage("You are not allowed to bank event items.");
+                            mob.Kill();
+                            break;
+                        }
+                    }
+
+                    if (_carrier != null)
+                    {
+                        _carrier.Criminal = true;
+                    }
+
+                    break;
+                }
+            case Container root:
+                {
+                    if (_carrier != null)
+                    {
+                        _carrier.SolidHueOverride = -1;
+                        _carrier = null;
+                    }
+                    else if (_container != root)
+                    {
+                        if (_container != null)
+                        {
+                            _container.Hue = 0;
+                        }
+
+                        _container = root;
+                        _container.Hue = 18;
+                    }
+
+                    break;
+                }
+            default:
+                {
+                    if (_carrier != null && _carrier.Holding != _artifact)
+                    {
+                        _carrier.SolidHueOverride = -1;
+                        _carrier = null;
+                    }
+
+                    if (_container != null)
+                    {
+                        _container.Hue = 0;
+                        _container = null;
+                    }
+
+                    break;
+                }
+        }
+
+        _ticksLeft--;
+
+        if (_carrier?.Hidden == true)
+        {
+            _carrier.Hidden = false;
+        }
+    }
+
+    private void Clear()
+    {
+        if (_carrier != null)
+        {
+            _carrier.SolidHueOverride = -1;
+        }
+
+        if (_container != null)
+        {
+            _container.Hue = 0;
+        }
+    }
+}
+
+public static class CurseArtifactCommand
+{
+    public static void Configure()
+    {
+        CommandSystem.Register("CurseArtifact", AccessLevel.GameMaster, OnCommand);
+    }
+
+    [Usage("CurseArtifact [duration minutes]")]
+    [Description("Temporarily makes an item Cursed and highlights whoever player is carrying it.")]
+    private static void OnCommand(CommandEventArgs e)
+    {
+        var minutes = e.Length >= 1 ? e.GetInt32(0) : CursedArtifactTimer.DefaultMinutes;
+        e.Mobile.SendMessage("Target the item you want to curse.");
+        e.Mobile.Target = new InternalTarget(minutes);
+    }
+
+    private class InternalTarget : Target
+    {
+        private readonly int _minutes;
+
+        public InternalTarget(int minutes) : base(12, true, TargetFlags.None) => _minutes = minutes;
+
+        protected override void OnTarget(Mobile from, object targeted)
+        {
+            if (targeted is not Item item)
+            {
+                return;
+            }
+
+            if (!item.Movable)
+            {
+                from.SendMessage("That item is not movable");
+            }
+            else
+            {
+                new CursedArtifactTimer(item, _minutes).Start();
+            }
+        }
+    }
+}
