+    public static void AddLoot(Mobile from, Container c, int level)
+    {
+        var luck = (int)(Math.Pow(Math.Min(1200, from.Luck), 1 / 1.8) / 1000); // up to 0.05
+
+        if (CheckLootChance(level, 0.15 + luck))
+        {
+            c.DropItem(new Gold(level * 40, level * 80));
+        }
+
+        if (CheckLootChance(level, 0.10 + luck))
+        {
+            for (var i = 0; i < level; i++)
+            {
+                var necro = Utility.RandomBool();
+                var regs = Utility.RandomMinMax(1, 5);
+
+                for (var r = 0; r < regs; r++)
+                {
+                    c.DropItem(necro ? Loot.RandomNecromancyReagent() : Loot.RandomReagent());
+                }
+            }
+        }
+
+        if (CheckLootChance(level, 0.10 + luck))
+        {
+            for (var i = 0; i < level; i++)
+            {
+                c.DropItem(
+                    Utility.RandomBool()
+                        ? Loot.RandomScroll(0, 15, SpellbookType.Necromancer)
+                        : Loot.RandomScroll(0, 62, SpellbookType.Regular)
+                );
+            }
+        }
+
+        var minIntensity = level == 7 ? 50 + luck * 200 : level * luck * 200;
+        var minProps = Math.Max(1, Math.Min(4, (level + luck * 100) / 3));
+        var percentScale = luck * 10 + (level == 7 ? 30 : level * 3);
+        DfiLoot.AddRandomLoot(c, level, percentScale * 12, minProps, 5, minIntensity, 100);
+
+        if (CheckLootChance(level, 0.10))
+        {
+            if (level == 7)
+            {
+                var count = Utility.RandomMinMax(1, 5);
+
+                for (var i = 0; i < count; ++i)
+                {
+                    c.DropItem(Loot.Construct(_sePotions));
+                }
+            }
+
+            var potions = Utility.Random(level) + 1;
+
+            for (var i = 0; i < potions; i++)
+            {
+                c.DropItem(Loot.RandomPotion());
+            }
+        }
+
+        if (level == 7 && Utility.RandomDouble() < 0.05)
+        {
+            c.DropItem(new CCKey());
+        }
+
+        if (CheckLootChance(level, 0.10))
+        {
+            CursedCave.PackSkullsAndSmallBones(c, Utility.Random(1, 3));
+        }
+    }
