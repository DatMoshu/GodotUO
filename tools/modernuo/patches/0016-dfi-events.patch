+    // One time in ten a relock calls a guard from the dungeon's own kind of creature.
+    private void SpawnGuard()
+    {
+        if (Map == null || Map == Map.Internal || Utility.Random(10) != 0)
+        {
+            return;
+        }
+
+        var region = Region.Find(Location, Map);
+        var group = region switch
+        {
+            _ when region.IsPartOf("Khaldun") || region.IsPartOf("Deceit") => 1,
+            _ when region.IsPartOf("Despise")                               => 2,
+            _ when region.IsPartOf("Shame")                                 => 3,
+            _ when region.IsPartOf("Orc Cave")                              => 4,
+            _ when region.IsPartOf("Hythloth")                              => 5,
+            _ when region.IsPartOf("Covetous")                              => 6,
+            _ when region.IsPartOf("Destard")                               => 7,
+            _ when region.IsPartOf("Fire")                                  => 8,
+            _ when region.IsPartOf("Ice")                                   => 9,
+            _ when region is CursedCaveRegion || _level == 7               => 10,
+            _ when _level == 6                                              => 11,
+            _ when _level == 5                                              => 12,
+            _ when _level == 4                                              => 13,
+            _                                                               => 0
+        };
+
+        var bc = _guards[group].RandomElement().CreateInstance<BaseCreature>();
+        bc.Home = Location;
+        bc.RangeHome = 5;
+
+        for (var i = 0; i < 10; ++i)
+        {
+            var x = X - 3 + Utility.Random(7);
+            var y = Y - 3 + Utility.Random(7);
+
+            if (Map.CanSpawnMobile(x, y, Z))
+            {
+                bc.MoveToWorld(new Point3D(x, y, Z), Map);
+                return;
+            }
+
+            var z = Map.GetAverageZ(x, y);
+
+            if (Map.CanSpawnMobile(x, y, z))
+            {
+                bc.MoveToWorld(new Point3D(x, y, z), Map);
+                return;
+            }
+        }
+
+        bc.Delete();
+    }
