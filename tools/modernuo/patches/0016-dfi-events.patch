+// The items DFI Network's event reward vendor sells for copper bars, ported from DFI RUNUO
+// Scripts/Custom/Engines/EventRewardSystem/RewardItems, Items/Misc/WhisperingRose.cs, Items/Skill Items/Tailoring/
+// MagicSewingKit.cs and the donation deeds (AntiBlessDeed, KillResetDeedAOS).
+
+using System;
+using System.Collections.Generic;
+using ModernUO.Serialization;
+using Server.Mobiles;
+using Server.Targeting;
+
+namespace Server.Items;
+
+// Event rewards that last a set number of days; TemporaryItems deletes them when the time is up.
+public interface ITempItem
+{
+    DateTime RemovalTime { get; }
+}
+
+public static class TemporaryItems
+{
+    private static readonly HashSet<Item> _items = [];
+    private static Timer _timer;
+
+    public static void Register(Item item)
+    {
+        _items.Add(item);
+        _timer ??= Timer.DelayCall(TimeSpan.FromMinutes(6.0), TimeSpan.FromHours(1.0), Check);
+    }
+
+    public static string DeletionText(DateTime removal)
+    {
+        var days = (removal - Core.Now).Days;
+
+        return days switch
+        {
+            <= 0 => "Deletion today",
+            1    => "Deletion tomorrow",
+            _    => $"Deletion in {days} days"
+        };
+    }
+
+    public static void Check()
+    {
+        foreach (var item in new List<Item>(_items))
+        {
+            if (item.Deleted)
+            {
+                _items.Remove(item);
+            }
+            else if (item is ITempItem temp && temp.RemovalTime <= Core.Now)
+            {
+                _items.Remove(item);
+                item.Delete();
+            }
+        }
+    }
+}
+
+[SerializationGenerator(0)]
+public partial class TempRobe : Robe, ITempItem
+{
+    [SerializableField(0, setter: "private")]
+    private DateTime _removalTime;
+
+    [Constructible]
+    public TempRobe(int days = 30)
+    {
+        _removalTime = Core.Now + TimeSpan.FromDays(Math.Min(days, 365));
+        TemporaryItems.Register(this);
+    }
+
+    [CommandProperty(AccessLevel.GameMaster)]
+    public int DaysLeft
+    {
+        get => (int)(_removalTime - Core.Now).TotalDays;
+        set
+        {
+            RemovalTime = Core.Now + TimeSpan.FromDays(Math.Min(value, 365));
+            InvalidateProperties();
+        }
+    }
+
+    public override void GetProperties(IPropertyList list)
+    {
+        base.GetProperties(list);
+        list.Add(TemporaryItems.DeletionText(_removalTime));
+    }
+
+    [AfterDeserialization]
+    private void AfterDeserialization() => TemporaryItems.Register(this);
+}
