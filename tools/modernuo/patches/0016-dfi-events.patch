+using System;
+using System.Collections.Generic;
+using Server;
+using Server.Custom.Dfi;
+using Server.Items;
+using Server.Misc;
+using Server.Mobiles;
+using Xunit;
+
+namespace UOContent.Tests.Custom;
+
+[Collection("Sequential UOContent Tests")]
+public class DfiEventTests : IDisposable
+{
+    private readonly List<IEntity> _created = new();
+
+    public DfiEventTests()
+    {
+        if (NameList.GetNameList("male") == null)
+        {
+            NameList.Configure();
+        }
+    }
+
+    public static TheoryData<Type> Types =>
+    [
+        typeof(EICSmallCrate), typeof(EICMediumCrate), typeof(EICLargeCrate), typeof(EICWooden), typeof(EICMetal),
+        typeof(EICMetalGolden), typeof(EICMetalGoldenRed), typeof(CopperBar), typeof(EventRewardNPC), typeof(LastManPentagram),
+        typeof(TempRobe), typeof(TempCloak), typeof(TempHorseEthereal), typeof(LayeredSashDeed), typeof(PersonalisationDeed),
+        typeof(AntiBlessDeed), typeof(KillResetDeed), typeof(MagicSewingKit), typeof(WhisperingRose), typeof(FireDeed),
+        typeof(CampfireDeed), typeof(CrystalPedestalAddonDeed), typeof(FountainStoneAddonDeed), typeof(FountainSandstoneAddonDeed)
+    ];
+
+    public static TheoryData<Type> AddonDeeds =>
+    [
+        typeof(FireDeed), typeof(CampfireDeed), typeof(CrystalPedestalAddonDeed), typeof(FountainStoneAddonDeed),
+        typeof(FountainSandstoneAddonDeed)
+    ];
+
+    public void Dispose()
+    {
+        foreach (var e in _created)
+        {
+            e?.Delete();
+        }
+
+        _created.Clear();
+    }
+
+    private T Track<T>(T e) where T : IEntity
+    {
+        _created.Add(e);
+        return e;
+    }
+
+    private PlayerMobile Player()
+    {
+        var m = Track(new PlayerMobile());
+        m.Player = true;
+        m.Body = 0x190;
+        m.AddItem(new Backpack());
+        m.MoveToWorld(new Point3D(1434, 1690, 0), Map.Felucca);
+        return m;
+    }
+
+    [Theory]
+    [MemberData(nameof(Types))]
+    public void Type_Constructs(Type type)
+    {
+        var entity = Track(type.CreateInstance<IEntity>());
+
+        Assert.False(entity.Deleted);
+    }
+
+    [Theory]
+    [MemberData(nameof(AddonDeeds))]
+    public void AddonDeed_BuildsItsAddonAndBack(Type type)
+    {
+        var deed = Track(type.CreateInstance<BaseAddonDeed>());
+        var addon = Track(deed.Addon);
+
+        Assert.NotEmpty(addon.Components);
+        Assert.Equal(type, Track(addon.Deed).GetType());
+    }
+
+    [Fact]
+    public void Catalogue_EveryRewardMakesAnItem()
+    {
+        var player = Player();
+
+        foreach (var info in EventRewardSystem.Rewards)
+        {
+            var item = Track(info.Create(player));
+            Assert.NotNull(item);
+            Assert.True(info.Price > 0, info.Name);
+        }
+
+        Assert.Equal(EventRewardSystem.Rewards.Length,
+            EventRewardSystem.GetList(EventRewardCategory.PlayItem).Count +
+            EventRewardSystem.GetList(EventRewardCategory.Deco).Count +
+            EventRewardSystem.GetList(EventRewardCategory.Fancy).Count);
+    }
+
+    [Fact]
+    public void Buy_TakesTheBarsOnlyWhenThereAreEnough()
+    {
+        var player = Player();
+        var rose = Array.Find(EventRewardSystem.Rewards, r => r.Name == "A Whispering Rose");
+
+        player.Backpack.DropItem(new CopperBar(rose.Price - 1));
+        Assert.False(EventRewardSystem.Buy(player, rose));
+        Assert.Equal(rose.Price - 1, player.Backpack.GetAmount(typeof(CopperBar)));
+
+        player.Backpack.DropItem(new CopperBar(1));
+        Assert.True(EventRewardSystem.Buy(player, rose));
+        Assert.Equal(0, player.Backpack.GetAmount(typeof(CopperBar)));
+        Assert.NotNull(player.Backpack.FindItemByType<WhisperingRose>());
+    }
+
+    [Fact]
+    public void HandOut_StopsAGameMasterAtTheDailyLimit()
+    {
+        var gm = Player();
+        gm.AccessLevel = AccessLevel.GameMaster;
+
+        Assert.True(EventRewardSystem.HandOut(gm, EventRewardSystem.MaxCopper, "test", ""));
+        Assert.False(EventRewardSystem.HandOut(gm, 1, "test", ""));
+        Assert.Equal(EventRewardSystem.MaxCopper, gm.Backpack.GetAmount(typeof(CopperBar)));
+    }
+
+    [Fact]
+    public void TemporaryItem_IsDeletedWhenItsTimeIsUp()
+    {
+        var robe = Track(new TempRobe());
+        var cloak = Track(new TempCloak());
+        robe.DaysLeft = -1;
+
+        TemporaryItems.Check();
+
+        Assert.True(robe.Deleted);
+        Assert.False(cloak.Deleted);
+    }
+
+    [Fact]
+    public void MagicSewingKit_GivesARobePhysicalResistOnce()
+    {
+        var player = Player();
+        var robe = new Robe();
+        player.Backpack.DropItem(robe);
+        var kit = Track(new MagicSewingKit());
+        player.Backpack.DropItem(kit);
+
+        kit.OnDoubleClick(player);
+        player.Target.Invoke(player, robe);
+
+        Assert.Equal(3, robe.PhysicalResistance);
+        Assert.True(kit.Deleted);
+    }
+
+    [Fact]
+    public void KillResetDeed_ClearsMurders()
+    {
+        var player = Player();
+        player.Kills = 7;
+        var deed = new KillResetDeed();
+        player.Backpack.DropItem(deed);
+
+        deed.OnDoubleClick(player);
+
+        Assert.Equal(0, player.Kills);
+        Assert.True(deed.Deleted);
+    }
+
+    [Theory]
+    [InlineData(1)]
+    [InlineData(4)]
+    [InlineData(7)]
+    public void TreasureChest_IsLockedToItsLevelAndRelocksEmpty(int level)
+    {
+        var chest = Track(level switch
+        {
+            1 => (BaseItemChest)new EICSmallCrate(),
+            4 => new EICWooden(),
+            _ => new EICMetalGoldenRed()
+        });
+        var player = Player();
+
+        Assert.True(chest.Locked);
+        Assert.InRange(chest.LockLevel, 13 * level, 14 * level);
+        Assert.Equal(level, chest.Level);
+
+        chest.TrapType = TrapType.None;
+        chest.LockPick(player);
+        Assert.False(chest.Locked);
+        Assert.True(chest.ItemsCreated);
+
+        chest.DropItem(new Gold(10));
+        chest.Relock();
+
+        Assert.True(chest.Locked);
+        Assert.Empty(chest.Items);
+        Assert.False(chest.ItemsCreated);
+    }
+
+    [Fact]
+    public void ChestLoot_FillsAContainerAtEveryLevel()
+    {
+        var player = Player();
+
+        for (var level = 1; level <= BaseItemChest.MaxLevel; level++)
+        {
+            var bag = Track(new Bag());
+
+            for (var i = 0; i < 20; i++)
+            {
+                BaseItemChest.AddLoot(player, bag, level);
+            }
+
+            Assert.NotEmpty(bag.Items);
+        }
+    }
+
+    [Fact]
+    public void PentagramRewards_AlwaysNameWhatTheWinnerGot()
+    {
+        var player = Player();
+        player.Backpack.MaxItems = 10000;
+
+        for (var i = 0; i < 300; i++)
+        {
+            Assert.False(string.IsNullOrEmpty(PentagramRewards.Give(player)));
+        }
+
+        var spawned = new List<Mobile>();
+
+        foreach (var m in player.Map.GetMobilesInRange(player.Location, 2))
+        {
+            if (m is Barracoon)
+            {
+                spawned.Add(m);
+            }
+        }
+
+        spawned.ForEach(m => m.Delete());
+
+        Assert.NotEmpty(player.Backpack.Items);
+    }
+
+    [Fact]
+    public void Pentagram_SettingsRoundTripAndTheAddonFollowsIt()
+    {
+        var pentagram = Track(new LastManPentagram { SecondsRequired = 90 });
+        pentagram.MoveToWorld(DfiEventsGen.PentagramSpot, Map.Malas);
+
+        Assert.Equal(90, pentagram.SecondsRequired);
+        Assert.Equal(10, pentagram.Count);
+
+        pentagram.Start();
+        Assert.True(pentagram.Running);
+        pentagram.Running = false;
+        Assert.False(pentagram.Running);
+    }
+}
