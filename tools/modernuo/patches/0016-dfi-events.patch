+    public static List<EventRewardInfo> GetList(EventRewardCategory category)
+    {
+        var list = new List<EventRewardInfo>();
+
+        foreach (var info in Rewards)
+        {
+            if (info.Category == category)
+            {
+                list.Add(info);
+            }
+        }
+
+        return list;
+    }
+
+    public static void CreateCopperBar(Mobile receiver, int amount, string reason)
+    {
+        if (receiver?.Backpack == null)
+        {
+            return;
+        }
+
+        receiver.AddToBackpack(new CopperBar(amount));
+        logger.Information("System created {Amount} copper bars for {Receiver}: {Reason}", amount, receiver, reason);
+    }
+
+    public static bool Buy(Mobile m, EventRewardInfo info)
+    {
+        if (m.Backpack?.ConsumeTotal(typeof(CopperBar), info.Price) != true)
+        {
+            m.SendMessage("You do not have enough copper bars in your backpack.");
+            return false;
+        }
+
+        m.AddToBackpack(info.Create(m));
+        m.SendMessage("The reward item has been placed into your backpack, have fun!");
+        return true;
+    }
+
+    // Returns false when the staff member has reached the day's limit.
+    public static bool HandOut(Mobile staff, int amount, string eventName, string explanation)
+    {
+        var today = Core.Now.Date;
+
+        if (today != _handedOutDay)
+        {
+            _handedOut.Clear();
+            _handedOutDay = today;
+        }
+
+        _handedOut.TryGetValue(staff, out var old);
+        var allowed = staff.AccessLevel >= AccessLevel.Administrator || old + amount <= MaxCopper;
+
+        logger.Information(
+            "{Status} copper bar request by {Staff}: {Amount} for {Event} ({Explanation})",
+            allowed ? "Allowed" : "Disallowed", staff, amount, eventName, explanation
+        );
+
+        if (!allowed)
+        {
+            return false;
+        }
+
+        _handedOut[staff] = old + amount;
+        staff.AddToBackpack(new CopperBar(amount));
+        return true;
+    }
