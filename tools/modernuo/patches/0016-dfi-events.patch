+    private static Item RandomCactus()
+    {
+        Item cactus = Utility.Random(6) switch
+        {
+            0 => new PottedCactus(),
+            1 => new PottedCactus1(),
+            2 => new PottedCactus2(),
+            3 => new PottedCactus3(),
+            4 => new PottedCactus4(),
+            _ => new PottedCactus5()
+        };
+
+        cactus.Weight = 100;
+        return cactus;
+    }
