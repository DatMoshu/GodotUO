+// Gives a robe or cloak 3% physical resistance, once per use.
+[SerializationGenerator(0)]
+public partial class MagicSewingKit : Item, IUsesRemaining
+{
+    [SerializableField(0)]
+    [InvalidateProperties]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private int _usesRemaining;
+
+    [Constructible]
+    public MagicSewingKit(int uses = 1) : base(0xF9D)
+    {
+        _usesRemaining = uses;
+        Hue = 1165;
+    }
+
+    public override string DefaultName => "Magic Sewing Kit";
+
+    public bool ShowUsesRemaining
+    {
+        get => true;
+        set { }
+    }
+
+    public override void GetProperties(IPropertyList list)
+    {
+        base.GetProperties(list);
+        list.Add(1060584, _usesRemaining); // uses remaining: ~1_val~
+    }
+
+    public override void OnDoubleClick(Mobile from)
+    {
+        if (!IsChildOf(from.Backpack))
+        {
+            from.SendLocalizedMessage(1042001); // That must be in your pack for you to use it.
+            return;
+        }
+
+        from.Target = new SewingTarget(this);
+        from.SendMessage("Please target the Cloak or Robe that you wish to enhance.");
+    }
+
+    private class SewingTarget : Target
+    {
+        private readonly MagicSewingKit _kit;
+
+        public SewingTarget(MagicSewingKit kit) : base(30, false, TargetFlags.None) => _kit = kit;
+
+        protected override void OnTarget(Mobile from, object targeted)
+        {
+            if (targeted is not (Robe or Cloak))
+            {
+                from.SendMessage("You cannot enhance that item.");
+                return;
+            }
+
+            var cloth = (BaseClothing)targeted;
+
+            if (!cloth.IsChildOf(from.Backpack))
+            {
+                from.SendLocalizedMessage(1061005); // The item must be in your backpack to enhance it.
+            }
+            else if (cloth.PhysicalResistance != 0 || cloth.BasePhysicalResistance != 0)
+            {
+                from.SendMessage("That item is already enhanced.");
+            }
+            else if (!_kit.Deleted)
+            {
+                cloth.Resistances.Physical = 3;
+                from.SendMessage("You have enhanced the item.");
+                EventRewardEffects.Play(from);
+
+                if (--_kit.UsesRemaining < 1)
+                {
+                    _kit.Delete();
+                    from.SendMessage("The magic sewing kit broke.");
+                }
+            }
+        }
+    }
+}
