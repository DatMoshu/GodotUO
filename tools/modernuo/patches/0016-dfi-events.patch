+// Takes the blessing off a blessed piece of dyable clothing, so a holy bless deed can go on it instead.
+[SerializationGenerator(0)]
+public partial class AntiBlessDeed : DfiDeed
+{
+    [Constructible]
+    public AntiBlessDeed() : base(0)
+    {
+    }
+
+    public override string DefaultName => "an Anti Bless Deed";
+
+    protected override void Use(Mobile from)
+    {
+        from.SendMessage("What item would you like to unbless? (Clothes Only)");
+        from.Target = new DeedTarget(this, 1, OnTarget);
+    }
+
+    private void OnTarget(Mobile from, object targeted)
+    {
+        if (targeted is not BaseClothing item || targeted is not IDyable || targeted is HoodedShroudOfShadows)
+        {
+            from.SendMessage("You cannot unbless that object.");
+        }
+        else if (item.LootType != LootType.Blessed || item.BlessedFor == from || item.Insured)
+        {
+            from.SendMessage("That item is not blessed.");
+        }
+        else if (item.RootParent != from)
+        {
+            from.SendLocalizedMessage(1045158); // You must have the item in your backpack to target it.
+        }
+        else
+        {
+            item.LootType = LootType.Regular;
+            from.SendLocalizedMessage(1075289); // Your item has been unblessed
+            Delete();
+        }
+    }
+}
