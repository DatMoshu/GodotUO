+// DFI Network's dungeon treasure chests, ported from DFI RUNUO Scripts/Custom/Items/Containers/ItemChest
+// (BaseItemChest.cs, ItemChests.cs, SpawnEIC.cs, WorldTimer).
+
+using System;
+using System.Collections.Generic;
+using ModernUO.Serialization;
+using Server.Commands;
+using Server.Custom.Dfi;
+using Server.Logging;
+using Server.Mobiles;
+using Server.Regions;
+
+namespace Server.Items;
+
+// A locked, often trapped chest that fills when it is picked and locks itself again 20 to 40 minutes later,
+// emptied. Its level (1 to 7) sets the lock, the trap and the loot; relocking may call up a guard from the
+// dungeon it stands in. Level 7 is the Cursed Cave's.
+[SerializationGenerator(0)]
+public abstract partial class BaseItemChest : LockableContainer
+{
+    public const int MaxLevel = 7;
+
+    private static readonly HashSet<BaseItemChest> _waiting = [];
+    private static Timer _timer;
+
+    private static readonly Type[] _sePotions =
+        [typeof(ConflagrationPotion), typeof(GreaterConflagrationPotion), typeof(ConfusionBlastPotion), typeof(GreaterConfusionBlastPotion)];
