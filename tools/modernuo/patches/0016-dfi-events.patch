+        }
+
+        if (!int.TryParse(info.GetTextEntry(0)?.Trim(), out var amount) || amount <= 0)
+        {
+            m.SendMessage("Enter how many copper bars the event needs.");
+            return;
+        }
+
+        var eventName = info.GetTextEntry(1)?.Trim() ?? "";
+        var explanation = info.GetTextEntry(2)?.Trim() ?? "";
+
+        if (EventRewardSystem.HandOut(m, amount, eventName, explanation))
+        {
+            m.SendMessage("The copper bars have been created, good luck with your event!");
+        }
+        else
+        {
+            m.SendMessage("You have reached the daily limit of copper requests for this day.");
+        }
+    }
+}
