+// DFI Network's Last Man Pentagram: after a countdown, the first player to stand alone on the pentagram long
+// enough wins a random reward, which stays cursed and marks its carrier for ten minutes. Ported from DFI RUNUO
+// Scripts/Custom/Items/Misc/LastManPentagram.cs and Misc/CursedArtifactSystem.cs; DFI's world timer started it
+// every evening, here the item's own daily schedule does.
+
+using System;
+using System.Collections.Generic;
+using ModernUO.Serialization;
+using Server.Commands;
+using Server.Engines.Events;
+using Server.Gumps;
+using Server.Items;
+using Server.Mobiles;
+using Server.Targeting;
+
+namespace Server.Custom.Dfi;
+
+[SerializationGenerator(0)]
+public partial class LastManPentagram : Item
+{
+    // The timer ticks every six seconds.
+    private const double TickSeconds = 6.0;
+
+    [SerializableField(0)]
+    [InvalidateProperties]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private string _pentagramLocation = "Luna";
+
+    [SerializableField(1)]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private bool _giveReward = true;
+
+    [SerializableField(2, getter: "private", setter: "private")]
+    private int _ticksRequired = 10;
+
+    // Minutes of countdown before the pentagram becomes active.
+    [SerializableField(3)]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private int _count = 10;
+
+    [SerializableField(4, getter: "private", setter: "private")]
+    private PentagramAddon _addon;
+
+    [SerializableField(5, setter: "private")]
+    private bool _daily;
+
+    [SerializableField(6, setter: "private")]
+    private TimeSpan _dailyAt = new(19, 15, 0);
+
+    private PentagramTimer _timer;
+    private CallbackScheduledEvent _schedule;
+
+    [Constructible(AccessLevel.Administrator)]
+    public LastManPentagram() : base(0x1F1C)
+    {
+        Movable = false;
+        Visible = false;
+        _addon = new PentagramAddon();
+    }
+
+    public override string DefaultName => "last man pentagram";
+
+    [CommandProperty(AccessLevel.GameMaster)]
+    public int SecondsRequired
+    {
+        get => (int)(_ticksRequired * TickSeconds);
+        set => TicksRequired = Math.Max(1, (int)(value / TickSeconds));
+    }
+
+    // Starts the event every day at DailyAt (UTC).
+    [CommandProperty(AccessLevel.GameMaster)]
+    public bool AutoDaily
+    {
+        get => _daily;
+        set
+        {
+            Daily = value;
+            Reschedule();
+        }
+    }
+
+    [CommandProperty(AccessLevel.GameMaster)]
+    public TimeSpan DailyAtUtc
+    {
+        get => _dailyAt;
+        set
+        {
+            DailyAt = new TimeSpan(value.Hours, value.Minutes, 0);
+            Reschedule();
+        }
+    }
+
+    [CommandProperty(AccessLevel.GameMaster)]
+    public bool Running
+    {
+        get => _timer?.Running == true;
+        set
+        {
+            if (value == Running)
+            {
+                return;
+            }
+
+            if (value)
+            {
+                Start();
+            }
+            else
+            {
+                Cancel();
+            }
+        }
+    }
+
+    public void Start()
+    {
+        if (Running || Map == null || Map == Map.Internal)
+        {
+            return;
+        }
+
+        _timer = new PentagramTimer(this);
+        _timer.Start();
+    }
+
+    public void Cancel()
+    {
+        if (!Running)
+        {
+            return;
+        }
+
+        _timer.Stop();
+        _timer = null;
+        CommandHandlers.BroadcastMessage(AccessLevel.Player, 1150, "The pentagram event has been cancelled.");
+    }
+
+    private void Reschedule()
+    {
+        _schedule?.Cancel();
+        _schedule = null;
+
+        if (_daily && !Deleted)
+        {
+            _schedule = new CallbackScheduledEvent(TimeOnly.FromTimeSpan(_dailyAt), Start, EventScheduler.Daily);
+            _schedule.Schedule(DateTime.UtcNow);
+        }
+    }
+
+    [AfterDeserialization]
+    private void AfterDeserialization()
+    {
+        if (_ticksRequired <= 0)
+        {
+            _ticksRequired = 10;
+        }
+
+        Reschedule();
+    }
+
+    public override void OnDoubleClick(Mobile from)
+    {
+        if (from.AccessLevel > AccessLevel.Player)
+        {
+            from.SendGump(new PropertiesGump(from, this));
+        }
+    }
+
+    public override void OnLocationChange(Point3D oldLocation)
+    {
+        base.OnLocationChange(oldLocation);
+
+        if (_addon?.Deleted == false)
+        {
+            _addon.Location = Location;
+        }
+    }
+
+    public override void OnMapChange()
+    {
+        base.OnMapChange();
+
+        if (_addon?.Deleted == false)
+        {
+            _addon.Map = Map;
+        }
+    }
+
+    public override void OnAfterDelete()
+    {
+        _timer?.Stop();
+        _timer = null;
+        _schedule?.Cancel();
+        _schedule = null;
+        _addon?.Delete();
+        _addon = null;
+        base.OnAfterDelete();
+    }
+
+    private string Announcement(int minutes) =>
+        $"The pentagram at {_pentagramLocation} will be active in {minutes} minutes. The first one who stands on it alone for {SecondsRequired} seconds will receive a random reward. Hiding at this pentagram is deadly mistake.";
+
+    private class PentagramTimer : Timer
+    {
+        private readonly LastManPentagram _pentagram;
+        private int _countdown;
+        private bool _active;
+        private Mobile _winner;
+        private int _held;
+
+        public PentagramTimer(LastManPentagram pentagram) : base(TimeSpan.FromSeconds(TickSeconds), TimeSpan.FromSeconds(TickSeconds))
+        {
+            _pentagram = pentagram;
+            _countdown = pentagram._count * 10;
+            CommandHandlers.BroadcastMessage(AccessLevel.Player, 1150, pentagram.Announcement(pentagram._count));
+        }
+
+        protected override void OnTick()
+        {
+            var p = _pentagram;
+
+            if (p.Deleted || p.Map == null || p.Map == Map.Internal)
+            {
+                Stop();
+                return;
+            }
+
+            string message = null;
+
+            if (!_active)
+            {
+                if (--_countdown < 1)
+                {
+                    _active = true;
+                    CommandHandlers.BroadcastMessage(AccessLevel.Player, 1150, $"The pentagram at {p._pentagramLocation} is active!");
+                }
+                else if (_countdown % 10 == 0)
+                {
+                    CommandHandlers.BroadcastMessage(AccessLevel.Player, 1150, p.Announcement(_countdown / 10));
+                }
+            }
+            else
+            {
+                message = CheckWinner(p);
+            }
+
+            if (!Running)
+            {
+                return;
+            }
+
+            // Everyone near the pentagram may be attacked freely.
+            var near = new List<Mobile>();
+
+            foreach (var m in p.Map.GetMobilesInRange(p.Location, 20))
+            {
+                if (m.Player && m.Alive)
+                {
+                    near.Add(m);
+                }
+            }
+
+            foreach (var m in near)
+            {
+                if (m.AccessLevel == AccessLevel.Player)
+                {
+                    m.Criminal = true;
+                }
+
+                if (message != null)
+                {
+                    m.SendMessage(message);
+                }
+            }
+        }
+
+        private string CheckWinner(LastManPentagram p)
+        {
+            var standing = new List<Mobile>();
+
+            foreach (var m in p.Map.GetMobilesInRange(p.Location, 2))
+            {
+                if (m.Player && m.Alive && m.AccessLevel == AccessLevel.Player)
+                {
+                    standing.Add(m);
+                }
+            }
+
+            for (var i = standing.Count - 1; i >= 0; i--)
+            {
+                if (standing[i].Hidden)
+                {
+                    standing[i].Kill();
+                    standing.RemoveAt(i);
+                }
+            }
+
+            var location = p._pentagramLocation;
+
+            if (standing.Count != 1)
+            {
+                _held = 0;
+                var none = $"No person could be appointed to be the only one standing on the {location} pentagram";
+
+                if (Utility.Random(6) == 0)
+                {
+                    CommandHandlers.BroadcastMessage(AccessLevel.Player, 1150, none);
+                    return null;
+                }
+
+                return none;
+            }
+
+            string message = null;
+
+            if (standing[0] == _winner)
+            {
+                var appointed = $"{_winner.Name} was appointed as the sole person standing on the {location} pentagram!";
+
+                if (_held == 0)
+                {
+                    CommandHandlers.BroadcastMessage(AccessLevel.Player, 1150, appointed);
+                }
+                else
+                {
+                    message = appointed;
+                }
+
+                _held++;
+            }
+            else
+            {
+                _winner = standing[0];
+                _held = 0;
+            }
+
+            if (_held >= p._ticksRequired)
+            {
+                if (p._giveReward)
+                {
+                    var reward = PentagramRewards.Give(_winner);
+                    CommandHandlers.BroadcastMessage(AccessLevel.Player, 1150, $"{_winner.Name} has won the pentagram event, and received {reward}.");
+                }
+                else
+                {
+                    CommandHandlers.BroadcastMessage(AccessLevel.Player, 1150, $"{_winner.Name} has won the pentagram event.");
+                }
+
+                Stop();
+                return null;
+            }
+
+            return message;
+        }
+    }
+}
