+    private static EventRewardInfo SkillBallReward(int points, int price) =>
+        new(EventRewardCategory.PlayItem, $"+{points} Skill Ball",
+            $"A limited skillball that adds {points} skillpoint{(points == 1 ? "" : "s")} to the skill you choose. It will not work for hard and crafting skills.",
+            price, 7885, 215, 160, _ => new SkillBall(points));
