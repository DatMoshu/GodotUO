+[SerializationGenerator(0)]
+public partial class LayeredSashDeed : DfiDeed
+{
+    [Constructible]
+    public LayeredSashDeed() : base(0) => LootType = LootType.Regular;
+
+    public override string DefaultName => "Layered Sash Deed";
+
+    protected override void Use(Mobile from)
+    {
+        from.Target = new DeedTarget(this, 30, OnTarget);
+        from.SendMessage("Please target the Sash, that you wish to enhance.");
+    }
+
+    private void OnTarget(Mobile from, object targeted)
+    {
+        if (targeted is not BodySash sash)
+        {
+            from.SendMessage("You cannot enhance that item.");
+        }
+        else if (!sash.IsChildOf(from.Backpack))
+        {
+            from.SendLocalizedMessage(1061005); // The item must be in your backpack to enhance it.
+        }
+        else
+        {
+            // The earrings layer is drawn over a robe, so the sash shows on top of one.
+            sash.Layer = Layer.Earrings;
+            sash.Name = sash.Name == null ? "Body Sash [Layered]" : $"{sash.Name} [Layered]";
+            from.SendMessage("You have enhanced the item.");
+            EventRewardEffects.Play(from);
+            Delete();
+        }
+    }
+}
