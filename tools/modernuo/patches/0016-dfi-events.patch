+    private void ScheduleRelock()
+    {
+        RelockAt = Core.Now + TimeSpan.FromSeconds(Utility.RandomMinMax((int)_minDelay.TotalSeconds, (int)_maxDelay.TotalSeconds));
+        _waiting.Add(this);
+        _timer ??= Timer.DelayCall(TimeSpan.FromSeconds(30.0), TimeSpan.FromSeconds(30.0), CheckRelocks);
+    }
+
+    private static void CheckRelocks()
+    {
+        foreach (var chest in new List<BaseItemChest>(_waiting))
+        {
+            if (chest.Deleted)
+            {
+                _waiting.Remove(chest);
+            }
+            else if (chest._relockAt <= Core.Now)
+            {
+                _waiting.Remove(chest);
+                chest.Relock();
+            }
+        }
+    }
+
+    public void Relock()
+    {
+        for (var i = Items.Count - 1; i >= 0; --i)
+        {
+            Items[i].Delete();
+        }
+
+        SetLockAndTrap();
+    }
+
+    [AfterDeserialization]
+    private void AfterDeserialization()
+    {
+        if (!Locked || LockLevel == -255 || _itemsCreated)
+        {
+            ScheduleRelock();
+        }
+    }
+
+    public override void OnAfterDelete()
+    {
+        _waiting.Remove(this);
+        base.OnAfterDelete();
+    }
