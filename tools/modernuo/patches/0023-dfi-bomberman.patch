+    // A blast front: one tile at a time, every fifty milliseconds, until it runs out of strength or hits something.
+    public static class BombBlast
+    {
+        public static void Start(Point3D origin, Map map, BlastDirection dir, BombBag bag, int strength, bool baddaBoom)
+        {
+            var (dx, dy) = dir switch
+            {
+                BlastDirection.West  => (-1, 0),
+                BlastDirection.East  => (1, 0),
+                BlastDirection.North => (0, -1),
+                _                    => (0, 1)
+            };
+
+            var at = new Point3D(origin.X + dx, origin.Y + dy, origin.Z);
+            bag?.Control?.CheckForVictims(at, map, bag);
+            Timer.DelayCall(BombermanSettings.BlastDelay, () => Burn(at, map, dir, bag, strength, baddaBoom));
+        }
+
+        private static void Burn(Point3D at, Map map, BlastDirection dir, BombBag bag, int strength, bool baddaBoom)
+        {
+            if (map == null)
+            {
+                return;
+            }
+
+            var hitWall = false;
+            BombermanObstacle obstacle = null;
+            Bomb bomb = null;
+
+            foreach (var item in map.GetItemsAt(at))
+            {
+                if (item is BombermanObstacle o and not BombermanFloorTile)
+                {
+                    obstacle = o;
+                    break;
+                }
+
+                if (item is Bomb b && !b.Deleted)
+                {
+                    bomb = b;
+                    break;
+                }
+            }
+
+            if (obstacle != null)
+            {
+                if (obstacle.Destructible)
+                {
+                    obstacle.Destroy();
+                }
+                else
+                {
+                    hitWall = true;
+                    strength = 0;
+                }
+
+                if (!baddaBoom)
+                {
+                    strength = 0;
+                }
+            }
+            else if (bomb != null)
+            {
+                // The bomb this blast set off is credited to the bag that set it off.
+                bomb.Planter = bag?.Owner;
+                bomb.Explode(Reverse(dir));
+                strength = 0;
+            }
+
+            if (!hitWall)
+            {
+                Effects.SendLocationEffect(new Point3D(at.X + 1, at.Y + 1, at.Z), map, Utility.RandomList(0x36CB, 0x36BD, 0x36B0), 10);
+            }
+
+            bag?.Control?.CheckForVictims(at, map, bag);
+
+            if (!hitWall && strength > 0)
+            {
+                Start(at, map, dir, bag, strength - 1, baddaBoom);
+            }
+        }
+
+        public static BlastDirection Reverse(BlastDirection dir) =>
+            dir switch
+            {
+                BlastDirection.West  => BlastDirection.East,
+                BlastDirection.East  => BlastDirection.West,
+                BlastDirection.North => BlastDirection.South,
+                BlastDirection.South => BlastDirection.North,
+                _                    => BlastDirection.None
+            };
+    }
