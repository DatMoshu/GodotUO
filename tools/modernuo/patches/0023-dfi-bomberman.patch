+    public partial class BombBag : Item
+    {
+        private Mobile _owner;
+
+        public BombBag(BombermanControlItem control, int maxBombs, int strength) : base(0xE76)
+        {
+            Control = control;
+            Hue = 1161;
+            Movable = false;
+            MaxBombs = maxBombs;
+            BombStrength = strength;
+            Active = true;
+        }
+
+        public override string DefaultName => "Bomb Bag";
+
+        public BombermanControlItem Control { get; }
+        public List<Bomb> Bombs { get; } = [];
+        public int MaxBombs { get; set; }
+        public int BombStrength { get; set; }
+        public bool BaddaBoom { get; set; }
+        public bool SpeedUpgraded { get; private set; }
+        public BombDetonator Detonator { get; set; }
+        public bool Active { get; set; }
+
+        public Mobile Owner
+        {
+            get => _owner;
+            set
+            {
+                _owner = value;
+                // No speed from other sources, so every player starts even.
