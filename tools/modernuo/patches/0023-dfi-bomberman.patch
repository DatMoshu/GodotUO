+// Places a Bomberman join stone at the caller's feet; its board (21 by 21 tiles by default) is built two tiles
+// south-east of it, so the ground there should be flat and empty.
+
+using Server.Commands;
+using Server.Items;
+using Server.Logging;
+
+namespace Server.Custom.Dfi;
+
+public static class DfiBombermanGen
+{
+    private static readonly ILogger logger = LogFactory.GetLogger(typeof(DfiBombermanGen));
+
+    public static void Configure()
+    {
+        CommandSystem.Register("DfiBomberman", AccessLevel.Administrator, OnCommand);
+    }
+
+    [Usage("DfiBomberman")]
+    [Description("Places a Bomberman join stone at your feet, with its board two tiles south-east of it.")]
+    private static void OnCommand(CommandEventArgs e)
+    {
+        var stone = new BombermanControlItem();
+        stone.MoveToWorld(e.Mobile.Location, e.Mobile.Map);
+        e.Mobile.SendMessage("DfiBomberman: placed a join stone and its board.");
+        logger.Information("{User} placed a Bomberman stone at {Location}", e.Mobile, stone.Location);
+    }
+}
