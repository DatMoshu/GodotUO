+            }
+        }
+
+        public override void OnDoubleClick(Mobile from) => Plant(from);
+
+        public bool Plant(Mobile from)
+        {
+            if (from != Owner || !IsChildOf(from.Backpack) || !Active)
+            {
+                from.SendMessage("You cannot use that");
+                return false;
+            }
+
+            if (from.Followers > 0)
+            {
+                from.SendMessage("You can't use this with pets!");
+                return false;
+            }
+
+            foreach (var item in from.Map.GetItemsAt(from.Location))
+            {
+                if (item is Bomb)
+                {
+                    from.SendMessage("There is a bomb at your feet already!");
+                    return false;
+                }
+            }
+
+            if (Bombs.Count >= MaxBombs)
+            {
+                from.SendMessage("You have too many bombs on the field.");
+                return false;
+            }
+
+            var bomb = new Bomb(this);
+            from.PlaySound(0x42);
+            bomb.MoveToWorld(from.Location, from.Map);
+            Bombs.Add(bomb);
+            from.SendMessage("Planting bomb!");
+            return true;
+        }
+
+        public void Apply(UpgradeKind kind)
+        {
+            switch (kind)
+            {
+                case UpgradeKind.BombCount:
+                    {
+                        MaxBombs++;
+                        break;
+                    }
+                case UpgradeKind.BlastStrength:
+                    {
+                        BombStrength++;
+                        break;
+                    }
+                case UpgradeKind.Speed:
+                    {
+                        SpeedUpgraded = true;
+                        Owner?.NetState.SendSpeedControl(SpeedControlSetting.Mount);
+                        break;
+                    }
+                case UpgradeKind.Detonator when Detonator == null:
+                    {
+                        Detonator = new BombDetonator(this);
+                        Owner?.Backpack?.DropItem(Detonator);
+                        break;
+                    }
+                case UpgradeKind.BaddaBoom:
+                    {
+                        BaddaBoom = true;
+                        break;
+                    }
+            }
+        }
+
+        public void DetonateFirstBomb()
+        {
+            if (Bombs.Count > 0)
+            {
+                Bombs[0].Detonate();
+            }
+        }
