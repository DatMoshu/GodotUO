+using System;
+using System.Collections.Generic;
+using Server;
+using Server.Custom.Dfi.Bomberman;
+using Server.Items;
+using Server.Misc;
+using Server.Mobiles;
+using Server.Network;
+using Server.Tests.Network;
+using Xunit;
+
+namespace UOContent.Tests.Custom;
+
+[Collection("Sequential UOContent Tests")]
+public class DfiBombermanTests : IDisposable
+{
+    private static readonly Point3D StoneAt = new(5300, 1400, 0);
+
+    private readonly List<IEntity> _created = new();
+    private readonly List<NetState> _connections = new();
+
+    public DfiBombermanTests()
+    {
+        if (NameList.GetNameList("male") == null)
+        {
+            NameList.Configure();
+        }
+    }
+
+    public void Dispose()
+    {
+        foreach (var e in _created)
+        {
+            e?.Delete();
+        }
+
+        _created.Clear();
+
+        foreach (var ns in _connections)
+        {
+            ns.Dispose();
+        }
+
+        _connections.Clear();
+        BoardGameData.ResetScores(BombermanSettings.GameName);
+    }
+
+    private T Track<T>(T e) where T : IEntity
+    {
+        _created.Add(e);
+        return e;
+    }
+
+    private PlayerMobile Player()
+    {
+        var m = Track(new PlayerMobile());
+        m.Player = true;
+        m.Body = 0x190;
+        m.AddItem(new Backpack());
+        m.AddItem(new BankBox(m));
+        m.MoveToWorld(new Point3D(StoneAt.X - 1, StoneAt.Y - 1, StoneAt.Z), Map.Felucca);
+        // Players without a connection count as logged out and are dropped when the game starts. It is attached
+        // once the player is on the map, since a map change would want an account behind it.
+        var ns = PacketTestUtilities.CreateTestNetState();
+        _connections.Add(ns);
+        m.NetState = ns;
+        return m;
+    }
+
+    private BombermanControlItem Stone()
+    {
+        var stone = Track(new BombermanControlItem());
+        stone.MoveToWorld(StoneAt, Map.Felucca);
+        stone.ResetBoard();
+        return stone;
+    }
+
+    private static int Count<T>(BombermanControlItem stone) => stone.BackgroundItems.FindAll(p => p is T).Count;
+
+    [Fact]
+    public void Board_HasFloorEverywhereAndAGridOfWalls()
+    {
+        var stone = Stone();
+        var w = stone.Width;
+        var h = stone.Height;
+
+        Assert.Equal(BombermanSettings.DefaultBoardSize, w);
+        Assert.Equal(w * h, Count<BombermanFloorTile>(stone));
+        // The border, and a pillar on every even-even cell inside it.
+        Assert.Equal(2 * w + 2 * (h - 2) + (w - 3) / 2 * ((h - 3) / 2), Count<IndestructibleWall>(stone));
+        Assert.Equal(0, Count<DestructibleWall>(stone));
+    }
+
+    [Theory]
+    [InlineData(4, 11)]
+    [InlineData(30, 31)]
+    [InlineData(100, 65)]
+    public void Board_SizesAreOddAndBounded(int asked, int expected)
+    {
+        var stone = Stone();
+
+        stone.Width = asked;
+
+        Assert.Equal(expected, stone.Width);
+    }
+
+    [Fact]
+    public void Game_StartsWhenEnoughPlayersJoinAndTheLeaderIsReady()
+    {
+        var stone = Stone();
+        var a = Player();
+        var b = Player();
+        stone.CurrentMaxPlayers = 2;
+
+        stone.AddPlayer(a);
+        Assert.Equal(BoardGameState.Recruiting, stone.State);
+
+        stone.AddPlayer(b);
+        Assert.Equal(BoardGameState.Recruiting, stone.State);
+
+        stone.SetReady(true);
+        Assert.Equal(BoardGameState.Active, stone.State);
+
+        Assert.Equal(stone.StartPoint(0), a.Location);
+        Assert.Equal(stone.StartPoint(1), b.Location);
+        Assert.NotNull(a.Backpack.FindItemByType<BombBag>());
+        Assert.True(Count<DestructibleWall>(stone) > 0);
+
+        foreach (var wall in stone.BackgroundItems.FindAll(p => p is DestructibleWall))
+        {
+            var cell = ((DestructibleWall)wall).Cell;
+            Assert.False(stone.IsStartArea(cell.X, cell.Y));
+        }
+    }
+
+    [Fact]
+    public void Bombs_AreLimitedAndOnePerTile()
+    {
+        var stone = Stone();
+        var player = Player();
+        var bag = Track(new BombBag(stone, 1, 1) { Owner = player });
+        player.Backpack.DropItem(bag);
+
+        Assert.True(bag.Plant(player));
+        Assert.False(bag.Plant(player));
+
+        player.Location = new Point3D(player.X + 1, player.Y, player.Z);
+        Assert.False(bag.Plant(player));
+
+        bag.Apply(UpgradeKind.BombCount);
+        Assert.True(bag.Plant(player));
+        Assert.Equal(2, bag.Bombs.Count);
+    }
+
+    [Fact]
+    public void Upgrades_ImproveTheBag()
+    {
+        var stone = Stone();
+        var player = Player();
+        var bag = Track(new BombBag(stone, 1, 1) { Owner = player });
+        player.Backpack.DropItem(bag);
+
+        bag.Apply(UpgradeKind.BlastStrength);
+        bag.Apply(UpgradeKind.BaddaBoom);
+        bag.Apply(UpgradeKind.Detonator);
+        bag.Apply(UpgradeKind.Detonator);
+
+        Assert.Equal(2, bag.BombStrength);
+        Assert.True(bag.BaddaBoom);
+        Assert.NotNull(bag.Detonator);
+        Assert.Single(player.Backpack.Items, i => i is BombDetonator);
+    }
+
+    [Fact]
+    public void Blast_PutsOutTheOtherPlayerAndTheLastOneStandingWins()
+    {
+        var stone = Stone();
+        var a = Player();
+        var b = Player();
+        stone.CurrentMaxPlayers = 2;
+        stone.AddPlayer(a);
+        stone.AddPlayer(b);
+        stone.SetReady(true);
+
+        var bag = a.Backpack.FindItemByType<BombBag>();
+        b.Location = a.Location;
+
+        stone.CheckForVictims(a.Location, a.Map, bag);
+
+        Assert.DoesNotContain(b, stone.Players);
+        Assert.Null(b.Backpack.FindItemByType<BombBag>());
+        Assert.Equal(new Point3D(StoneAt.X - 1, StoneAt.Y - 1, StoneAt.Z), b.Location);
+
+        var scores = BoardGameData.GetScores(BombermanSettings.GameName);
+        Assert.Equal(BombermanSettings.KillScore, scores.Find(s => s.Player == a).Score);
+        Assert.Equal(1, scores.Find(s => s.Player == b).Losses);
+    }
+
+    [Fact]
+    public void Ending_ClearsTheBoardAndReturnsToInactive()
+    {
+        var stone = Stone();
+        var a = Player();
+        var b = Player();
+        stone.CurrentMaxPlayers = 2;
+        stone.AddPlayer(a);
+        stone.AddPlayer(b);
+        stone.SetReady(true);
+
+        stone.EndGame();
+
+        Assert.Equal(BoardGameState.Inactive, stone.State);
+        Assert.Empty(stone.Players);
+        Assert.Null(a.Backpack.FindItemByType<BombBag>());
+        Assert.Equal(0, Count<DestructibleWall>(stone));
+    }
+
+    [Fact]
+    public void Leaving_EmptiesTheGame()
+    {
+        var stone = Stone();
+        var a = Player();
+        stone.CurrentMaxPlayers = 3;
+
+        stone.AddPlayer(a);
+        stone.RemovePlayer(a);
+
+        Assert.Equal(BoardGameState.Inactive, stone.State);
+    }
+}
