+// Bomberman, from the "Solaris BoardGames" scripts DFI Network ran (DFI RUNUO Scripts/Custom/Opticon/BoardGames).
+// Two to eight players start at the corners and edges of a walled board, each with a bomb bag that plants a bomb
+// at their feet. Bombs go off after three seconds (or on a detonator), their blasts running along the rows and
+// chaining into other bombs; they break the destructible walls, which sometimes leave an upgrade (more bombs,
+// a stronger blast, speed, a detonator, or blasts that tear through walls). A player caught in a blast is out;
+// the last one standing wins. Scores are kept per player.
+//
+// The board is built beside the join stone from its settings; its pieces are not saved, the stone builds them
+// again after a restart.
+
+using System;
+using System.Collections.Generic;
+using ModernUO.Serialization;
+using Server.Collections;
+using Server.ContextMenus;
+using Server.Custom.Dfi.Bomberman;
+using Server.Gumps;
+using Server.Items;
+using Server.Mobiles;
+using Server.Network;
+using Server.Regions;
+
+namespace Server.Custom.Dfi.Bomberman
+{
+    public enum BoardGameState
+    {
+        Disabled,
+        Inactive,
+        Pending,
+        Recruiting,
+        Active,
+        GameOver
+    }
+
+    public enum BombermanStyle
+    {
+        Default,
+        Rocky,
+        Woodland,
+        Warehouse,
+        Ruins,
+        Graveyard,
+        Crystal
+    }
+
+    [Flags]
+    public enum BlastDirection
+    {
+        None = 0x0,
+        West = 0x1,
+        North = 0x2,
+        East = 0x4,
+        South = 0x8
+    }
+
+    public static class BombermanSettings
+    {
+        public const string GameName = "Bomberman";
+        public const int MaxBoardSize = 65;
+        public const int MinBoardSize = 11;
+        public const int DefaultBoardSize = 21;
+        public const double ObstacleChance = 0.7;
+        public const double UpgradeSpawnChance = .2;
+        public static readonly TimeSpan ExplodeDelay = TimeSpan.FromSeconds(3);
+        public static readonly TimeSpan BlastDelay = TimeSpan.FromMilliseconds(50);
+        public static readonly TimeSpan UpgradeDecay = TimeSpan.FromSeconds(20);
+        public const int KillScore = 1;
+        public const int DeathScore = -1;
+        public const int WinScore = 2;
+        public const int SuicideScore = -2;
+
+        public static int DestructibleWallID(BombermanStyle style) =>
+            style switch
+            {
+                BombermanStyle.Rocky     => Utility.RandomMinMax(0x1363, 0x136D),
+                BombermanStyle.Woodland  => Utility.RandomMinMax(0xCC8, 0xCC9),
+                BombermanStyle.Warehouse => Utility.RandomMinMax(0xE3C, 0xE3F),
+                BombermanStyle.Ruins     => Utility.RandomMinMax(0x3B7, 0x3BD),
+                BombermanStyle.Graveyard => Utility.RandomMinMax(0x1AD8, 0x1ADC),
+                BombermanStyle.Crystal   => Utility.RandomMinMax(0x2224, 0x222C),
+                _                        => 1900
+            };
+
+        public static int IndestructibleWallID(BombermanStyle style) =>
+            style switch
+            {
+                BombermanStyle.Rocky     => 0x177A,
+                BombermanStyle.Woodland  => Utility.RandomList(0xE57, 0xE59),
+                BombermanStyle.Warehouse => Utility.RandomList(0x720, 0x721),
+                BombermanStyle.Ruins     => Utility.RandomMinMax(0x3BE, 0x3C1),
+                BombermanStyle.Graveyard => Utility.RandomMinMax(0x1165, 0x1184),
+                BombermanStyle.Crystal   => Utility.RandomList(0x35EB, 0x35EC, 0x35EF, 0x35F6, 0x35F7),
+                _                        => 1801
+            };
+
+        public static int FloorTileID(BombermanStyle style) =>
+            style switch
+            {
+                BombermanStyle.Rocky     => Utility.RandomMinMax(0x53B, 0x53F),
+                BombermanStyle.Woodland  => Utility.RandomMinMax(0x177D, 0x1781),
+                BombermanStyle.Warehouse => Utility.RandomMinMax(0x4A9, 0x4AC),
+                BombermanStyle.Ruins     => Utility.RandomMinMax(0x525, 0x528),
+                BombermanStyle.Graveyard => Utility.RandomMinMax(0x515, 0x518),
+                BombermanStyle.Crystal   => Utility.RandomMinMax(0x579, 0x57E),
+                _                        => 0x496
+            };
+    }
+
+    public class BoardGamePlayerScore
+    {
+        public BoardGamePlayerScore(Mobile player) => Player = player;
+
+        public Mobile Player { get; }
+        public int Score;
+        public int Wins;
+        public int Losses;
+    }
+
+    // Scores per game, kept across restarts.
+    public class BoardGameData : GenericPersistence
+    {
+        private static readonly Dictionary<string, List<BoardGamePlayerScore>> _games = [];
+
+        public BoardGameData() : base("DfiBoardGames", 10)
+        {
+        }
+
+        public static void Configure()
+        {
+            _ = new BoardGameData();
+        }
+
+        public static List<BoardGamePlayerScore> GetScores(string game)
+        {
+            if (!_games.TryGetValue(game, out var list))
+            {
+                _games[game] = list = [];
+            }
+
+            return list;
+        }
+
+        public static BoardGamePlayerScore Get(string game, Mobile player)
+        {
+            var list = GetScores(game);
+            var score = list.Find(s => s.Player == player);
+
+            if (score == null)
+            {
+                list.Add(score = new BoardGamePlayerScore(player));
+            }
+
+            return score;
+        }
+
+        public static void ChangeScore(string game, Mobile player, int delta)
+        {
+            var score = Get(game, player);
+            score.Score = Math.Max(0, score.Score + delta);
+        }
+
+        public static void AddWin(string game, Mobile player) => Get(game, player).Wins++;
+        public static void AddLoss(string game, Mobile player) => Get(game, player).Losses++;
+        public static void ResetScores(string game) => _games.Remove(game);
+
+        public override void Serialize(IGenericWriter writer)
+        {
+            writer.WriteEncodedInt(0); // version
+            writer.WriteEncodedInt(_games.Count);
+
+            foreach (var (game, list) in _games)
+            {
+                writer.Write(game);
+                writer.WriteEncodedInt(list.Count);
+
+                foreach (var s in list)
+                {
+                    writer.Write(s.Player);
+                    writer.WriteEncodedInt(s.Score);
+                    writer.WriteEncodedInt(s.Wins);
+                    writer.WriteEncodedInt(s.Losses);
+                }
+            }
+        }
+
+        public override void Deserialize(IGenericReader reader)
+        {
+            reader.ReadEncodedInt(); // version
+            var games = reader.ReadEncodedInt();
+
+            for (var g = 0; g < games; g++)
+            {
+                var list = GetScores(reader.ReadString());
+                var count = reader.ReadEncodedInt();
+
+                for (var i = 0; i < count; i++)
+                {
+                    var player = reader.ReadEntity<Mobile>();
+                    var score = new BoardGamePlayerScore(player)
+                    {
+                        Score = reader.ReadEncodedInt(), Wins = reader.ReadEncodedInt(), Losses = reader.ReadEncodedInt()
+                    };
+
+                    if (player?.Deleted == false)
+                    {
+                        list.Add(score);
+                    }
+                }
+            }
+        }
+    }
+
+    public class BombermanRegion : BaseRegion
+    {
+        private static int _index;
+        private readonly BombermanControlItem _control;
+
+        public BombermanRegion(BombermanControlItem control, Rectangle2D area)
+            : base($"{BombermanSettings.GameName} {_index++}", control.Map, 255, area) =>
+            _control = control;
+
+        public override bool AllowHousing(Mobile from, Point3D p) => false;
+        public override bool AllowSpawn() => false;
+        public override bool CanUseStuckMenu(Mobile m) => false;
+        public override bool AllowHarmful(Mobile from, Mobile target) => from.AccessLevel > AccessLevel.Player;
+        public override bool OnSkillUse(Mobile m, int skill) => m.AccessLevel > AccessLevel.Player;
+        public override bool OnBeginSpellCast(Mobile from, ISpell s) => from.AccessLevel > AccessLevel.Player;
+
+        public override bool OnDamage(Mobile m, ref int damage) => false;
+
+        public override bool OnMoveInto(Mobile m, Direction d, Point3D newLocation, Point3D oldLocation) =>
+            m.AccessLevel > AccessLevel.Player || _control.Players.Contains(m) || m is not (PlayerMobile or BaseCreature);
+
+        public override void OnEnter(Mobile m)
+        {
+            if (m.AccessLevel == AccessLevel.Player && !_control.Players.Contains(m))
+            {
+                m.SendMessage("You are not allowed in there.");
+                Timer.DelayCall(() => m.MoveToWorld(_control.Location, _control.Map));
+            }
+        }
+    }
+
+    // A piece of the board: not saved, the stone rebuilds the board after a restart.
+    [SerializationGenerator(0)]
+    public partial class GamePiece : Item
+    {
+        private LOSBlocker _blocker;
+
+        public GamePiece(int itemID, string name, bool blockLos = false) : base(itemID)
+        {
+            Movable = false;
+            Name = name;
+
+            if (blockLos)
+            {
+                _blocker = new LOSBlocker();
+            }
+        }
+
+        public BombermanControlItem Control { get; set; }
+
+        public void Place(BombermanControlItem control, int x, int y, int z = 0)
+        {
+            Control = control;
+            MoveToWorld(new Point3D(control.BoardLocation.X + x, control.BoardLocation.Y + y, control.BoardLocation.Z + z), control.Map);
+            _blocker?.MoveToWorld(Location, Map);
+        }
+
+        public override void OnAfterDelete()
+        {
+            _blocker?.Delete();
+            _blocker = null;
+            base.OnAfterDelete();
+        }
+
+        [AfterDeserialization]
+        private void AfterDeserialization() => Timer.DelayCall(Delete);
+    }
+
+    [SerializationGenerator(0)]
+    public partial class BombermanObstacle : GamePiece
+    {
+        public BombermanObstacle(int itemID, string name, bool blockLos = false) : base(itemID, name, blockLos)
+        {
+        }
+
+        public virtual bool Destructible => false;
+
+        public virtual void Destroy()
+        {
+            Control?.BackgroundItems.Remove(this);
+            Control = null;
+            Delete();
+        }
+    }
+
+    [SerializationGenerator(0)]
+    public partial class BombermanFloorTile : BombermanObstacle
+    {
+        public BombermanFloorTile(BombermanStyle style) : base(BombermanSettings.FloorTileID(style), "Floor")
+        {
+            if (style == BombermanStyle.Default)
+            {
+                Hue = 0x237;
+            }
+        }
+    }
+
+    [SerializationGenerator(0)]
+    public partial class IndestructibleWall : BombermanObstacle
+    {
+        public IndestructibleWall(BombermanStyle style) : base(BombermanSettings.IndestructibleWallID(style), "Wall", true)
+        {
+            if (style == BombermanStyle.Default)
+            {
+                Hue = 0x3E4;
+            }
+        }
+    }
+
+    [SerializationGenerator(0)]
+    public partial class DestructibleWall : BombermanObstacle
+    {
+        public DestructibleWall(BombermanStyle style) : base(BombermanSettings.DestructibleWallID(style), "Bombable Wall")
+        {
+            if (style == BombermanStyle.Default)
+            {
+                Hue = 0x3BB;
+            }
+        }
+
+        public Point2D Cell { get; set; }
+
+        public override bool Destructible => true;
+
+        public override void Destroy()
+        {
+            var control = Control;
+
+            if (control?.State == BoardGameState.Active && Utility.RandomDouble() < BombermanSettings.UpgradeSpawnChance)
+            {
+                control.SpawnUpgrade(Cell);
+            }
+
+            base.Destroy();
+        }
+    }
+
+    public enum UpgradeKind
+    {
+        BombCount,
+        BlastStrength,
+        Speed,
+        Detonator,
+        BaddaBoom
+    }
+
+    // An upgrade lying on the board; a player who walks onto it picks it up, and it decays after twenty seconds.
+    [SerializationGenerator(0)]
+    public partial class BombermanUpgrade : BombermanObstacle
+    {
+        private Timer _decay;
+
+        public BombermanUpgrade(UpgradeKind kind) : base(ItemIDFor(kind), NameFor(kind))
+        {
+            Kind = kind;
+            Hue = kind == UpgradeKind.Speed ? 1152 : 1161;
+            _decay = Timer.DelayCall(BombermanSettings.UpgradeDecay, Destroy);
+        }
+
+        public UpgradeKind Kind { get; }
+        public override bool Destructible => true;
+        public override bool HandlesOnMovement => true;
+
+        private static int ItemIDFor(UpgradeKind kind) =>
+            kind switch
+            {
+                UpgradeKind.BombCount     => 0x2256,
+                UpgradeKind.BlastStrength => 0x1F15,
+                UpgradeKind.Speed         => 0x2308,
+                UpgradeKind.Detonator     => 0xFC1,
+                _                         => 0x1858
+            };
+
+        private static string NameFor(UpgradeKind kind) =>
+            kind switch
+            {
+                UpgradeKind.BombCount     => "Bomb Count Upgrade",
+                UpgradeKind.BlastStrength => "Blast Strength Upgrade",
+                UpgradeKind.Speed         => "Speed Upgrade",
+                UpgradeKind.Detonator     => "Detonator",
+                _                         => "Big BaddaBoom Upgrade"
+            };
+
+        public static UpgradeKind Roll(BombermanControlItem control)
+        {
+            var roll = Utility.RandomDouble();
+
+            return roll switch
+            {
+                < .1 when control.AllowSpeedUpgrade          => UpgradeKind.Speed,
+                < .15 when control.AllowDetonatorUpgrade     => UpgradeKind.Detonator,
+                < .2 when control.AllowBaddaBoomUpgrade      => UpgradeKind.BaddaBoom,
+                < .6 when control.AllowBlastStrengthUpgrade  => UpgradeKind.BlastStrength,
+                _                                            => UpgradeKind.BombCount
+            };
+        }
+
+        public override void OnMovement(Mobile m, Point3D oldLocation)
+        {
+            base.OnMovement(m, oldLocation);
+
+            if (Control?.Players.Contains(m) == true && m.Location != oldLocation && m.X == X && m.Y == Y)
+            {
+                PickUp(m);
+            }
+        }
+
+        public void PickUp(Mobile m)
+        {
+            var bag = m.Backpack?.FindItemByType<BombBag>();
+
+            if (bag != null)
+            {
+                bag.Apply(Kind);
+                m.SendMessage("You picked up an upgrade: ");
+                m.SendMessage(Name);
+                m.PlaySound(m.Female ? 0x337 : 0x44A);
+            }
+
+            Destroy();
+        }
+
+        public override void OnAfterDelete()
+        {
+            _decay?.Stop();
+            _decay = null;
+            base.OnAfterDelete();
+        }
+    }
+
+    [SerializationGenerator(0)]
+    public partial class Bomb : GamePiece
+    {
+        private Item _topper;
+        private Timer _fuse;
+
+        public Bomb(BombBag bag) : base(0x2256, $"{bag.Owner?.Name}'s Bomb")
+        {
+            Hue = 1;
+            Bag = bag;
+            Planter = bag.Owner;
+            Strength = bag.BombStrength;
+            BaddaBoom = bag.BaddaBoom;
+
+            _topper = BaddaBoom
+                ? new Static(0x1858) { Hue = 1161, Name = "If you can read this, you are probably going to die..." }
+                : bag.Detonator != null
+                    ? new Static(0xF13) { Name = Name }
+                    : new Static(0x1430) { Hue = 1, Name = Name };
+
+            if (bag.Detonator == null)
+            {
+                _fuse = Timer.DelayCall(BombermanSettings.ExplodeDelay, () => Explode());
+            }
+        }
+
+        public BombBag Bag { get; }
+        public Mobile Planter { get; set; }
+        public int Strength { get; }
+        public bool BaddaBoom { get; }
+
+        public override void OnLocationChange(Point3D oldLocation)
+        {
