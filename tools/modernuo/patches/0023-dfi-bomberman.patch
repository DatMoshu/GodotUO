+// Bomberman's gumps, from the Solaris BoardGames scripts DFI Network ran (Base/Gumps, Bomberman/Gumps): the offer
+// to play, waiting for players, the leader's board settings, the result, the scores and the staff score reset.
+
+using System;
+using System.Collections.Generic;
+using Server.Gumps;
+using Server.Items;
+using Server.Network;
+
+namespace Server.Custom.Dfi.Bomberman;
+
+public abstract class BombermanGump : DynamicGump
+{
+    protected BombermanGump() : base(100, 100)
+    {
+    }
+
+    protected static void AddFrame(ref DynamicGumpBuilder builder, int width, int height)
+    {
+        builder.AddPage();
+        builder.AddBackground(0, 0, width, height, 9270);
+        builder.AddAlphaRegion(10, 10, width - 20, height - 20);
+        builder.AddLabel(40, 20, 1152, "Game:");
+        builder.AddLabel(140, 20, 1172, BombermanSettings.GameName);
+    }
+
+    public const string Description =
+        "Blow up walls and players with bombs.  Collect upgrades to improve your number of bombs, blast size, etc.";
+
+    public const string Rules =
+        "Each game can have up to eight players, and everyone starts in a corner or edge of the arena.  A bomb bag is placed in the players' backpacks.  Players use this bag to place bombs at their feet.  A bomb will detonate after some time, and has a limited blast size.  The number of bombs any player can place at any time is limited.<BR><BR>Players must blast at the breakable walls to navigate the arena.  While blasting, upgrades can be found which improve the blast size or number of bombs a player can place at once.  There is also a detonator upgrade that lets a player choose when they want their bombs to blow up.  Watch out for other players' blasts!  A bomb can trigger another bomb to go off, creating interesting chain reactions!<BR><BR>The game ends when there is only one player left standing.";
+}
+
+public class BombermanOfferGump : BombermanGump
+{
+    private readonly BombermanControlItem _control;
+    private readonly bool _choosePlayers;
+
+    public BombermanOfferGump(BombermanControlItem control, bool choosePlayers)
+    {
+        _control = control;
+        _choosePlayers = choosePlayers;
+    }
+
+    public override bool Singleton => true;
+
+    protected override void BuildLayout(ref DynamicGumpBuilder builder)
+    {
+        AddFrame(ref builder, 400, 500);
+        builder.AddLabel(40, 50, 1152, "Description:");
+        builder.AddHtml(40, 70, 300, 100, Description, background: true, scrollbar: true);
+        builder.AddLabel(40, 180, 1152, "Rules:");
+        builder.AddHtml(40, 200, 300, 150, Rules, background: true, scrollbar: true);
+
+        if (_control.CostToPlay > 0)
+        {
+            builder.AddLabel(40, 370, 1152, "Cost to play:");
+            builder.AddLabel(240, 370, 1172, $"{_control.CostToPlay} gold");
+        }
+
+        builder.AddLabel(40, 430, 1152, $"# of players ({BombermanControlItem.MinPlayers}-{BombermanControlItem.MaxPlayers}):");
+
+        if (_choosePlayers)
+        {
+            builder.AddLabel(60, 410, 1172, "Pick the number of players");
+            builder.AddImageTiled(240, 430, 30, 20, 0xBBC);
+            builder.AddTextEntry(242, 430, 26, 20, 0, 0, $"{_control.CurrentMaxPlayers}");
+        }
+        else
+        {
+            builder.AddLabel(240, 430, 1152, $"{_control.CurrentMaxPlayers}");
+        }
+
+        builder.AddLabel(40, 470, 1152, "Play this game?");
+        builder.AddButton(200, 460, 0xF7, 0xF8, 1);
+        builder.AddButton(300, 460, 0xF1, 0xF2, 0);
+    }
+
+    public override void OnResponse(NetState sender, in RelayInfo info)
+    {
+        var m = sender.Mobile;
+
+        if (info.ButtonID == 0)
+        {
+            _control.RemovePlayer(m);
+            m.SendMessage("You decide not to play this game");
+            return;
+        }
+
+        if (_choosePlayers)
+        {
+            if (!int.TryParse(info.GetTextEntry(0)?.Trim(), out var count) ||
+                count is < BombermanControlItem.MinPlayers or > BombermanControlItem.MaxPlayers)
+            {
+                m.SendMessage("Invalid number of players selected.  Please try again.");
+                m.SendGump(new BombermanOfferGump(_control, true), true);
+                return;
+            }
+
+            _control.CurrentMaxPlayers = count;
+        }
+
+        m.SendMessage("You have signed up for this game.");
+        _control.AddPlayer(m);
+    }
+}
+
+public class BombermanAwaitGump : BombermanGump
+{
+    private readonly BombermanControlItem _control;
+
+    public BombermanAwaitGump(BombermanControlItem control) => _control = control;
+
+    public override bool Singleton => true;
+
+    protected override void BuildLayout(ref DynamicGumpBuilder builder)
+    {
+        builder.SetNoClose();
+        AddFrame(ref builder, 400, 200);
+        builder.AddHtml(
+            40, 50, 320, 80,
+            "You are waiting for more players to join this game.  When there are enough, this window will automatically close and the game will start.",
+            background: true
+        );
+        builder.AddButton(160, 160, 0xF1, 0xF2, 1);
+    }
+
+    public override void OnResponse(NetState sender, in RelayInfo info)
+    {
+        if (info.ButtonID == 1)
+        {
+            _control.RemovePlayer(sender.Mobile);
+            sender.Mobile.SendMessage("You are no longer waiting to play this game.");
+        }
+    }
+}
+
+// The first player chooses the board's style and size, and says when to start.
+public class BombermanStyleGump : BombermanGump
+{
+    private const int Ready = 1000;
+
+    private readonly BombermanControlItem _control;
+
+    public BombermanStyleGump(BombermanControlItem control) => _control = control;
+
+    public override bool Singleton => true;
+
+    protected override void BuildLayout(ref DynamicGumpBuilder builder)
+    {
+        var styles = Enum.GetValues<BombermanStyle>();
+        var height = 220 + styles.Length * 20;
+
+        builder.AddPage();
+        builder.AddBackground(0, 0, 260, height, 9270);
+        builder.AddAlphaRegion(10, 10, 240, height - 20);
+        builder.AddLabel(20, 14, 1152, "Bomberman Board Style");
+
+        var y = 50;
+
+        foreach (var style in styles)
+        {
+            var button = _control.BoardStyle == style ? 0x2C92 : 0x2C88;
+            builder.AddButton(20, y += 20, button, button, (int)style + 1);
+            builder.AddLabel(40, y - 2, 1152, $"{style}");
+        }
+
+        builder.AddLabel(20, y += 30, 1152, "Width:");
+        builder.AddLabel(110, y, 1152, "Height:");
+
+        if (!_control.SettingsReady)
+        {
+            builder.AddImageTiled(70, y, 30, 20, 0xBBC);
+            builder.AddTextEntry(72, y, 26, 20, 0, 1, $"{_control.Width}");
+            builder.AddImageTiled(160, y, 30, 20, 0xBBC);
+            builder.AddTextEntry(162, y, 26, 20, 0, 2, $"{_control.Height}");
+        }
+        else
+        {
+            builder.AddLabel(70, y, 1152, $"{_control.Width}");
+            builder.AddLabel(160, y, 1152, $"{_control.Height}");
+        }
+
+        builder.AddLabel(20, y += 40, 1152, "Ready to start:");
+        var readyButton = _control.SettingsReady ? 0xD3 : 0xD2;
+        builder.AddButton(140, y, readyButton, readyButton, Ready);
+    }
+
+    public override void OnResponse(NetState sender, in RelayInfo info)
+    {
+        var m = sender.Mobile;
+
+        if (_control.Players.Count == 0 || _control.Players[0] != m || _control.State >= BoardGameState.Active)
+        {
+            return;
+        }
+
+        if (!_control.SettingsReady &&
+            int.TryParse(info.GetTextEntry(1)?.Trim(), out var w) && int.TryParse(info.GetTextEntry(2)?.Trim(), out var h) &&
+            (w != _control.Width || h != _control.Height))
+        {
+            _control.SetBoardSize(w, h);
+        }
+
+        if (info.ButtonID is > 0 and < Ready && !_control.SettingsReady)
+        {
+            _control.BoardStyle = (BombermanStyle)(info.ButtonID - 1);
+        }
+
+        if (info.ButtonID == Ready)
+        {
+            _control.SetReady(!_control.SettingsReady);
+        }
+
+        if (info.ButtonID != 0 && _control.State < BoardGameState.Active)
+        {
+            m.SendGump(new BombermanStyleGump(_control), true);
+        }
+    }
+}
+
+public class BombermanResultGump : BombermanGump
+{
+    private readonly bool _won;
+
+    public BombermanResultGump(bool won) => _won = won;
+
+    public override bool Singleton => true;
+
+    protected override void BuildLayout(ref DynamicGumpBuilder builder)
+    {
+        AddFrame(ref builder, 400, 120);
+        builder.AddLabel(40, 50, 1152, _won ? "Congratulations, you won the game!!" : "You've lost the game!");
+        builder.AddButton(160, 80, 0xF7, 0xF8, 0);
+    }
+}
+
+public class BombermanScoresGump : BombermanGump
+{
+    private const int PerPage = 15;
+    private readonly int _page;
+
+    public BombermanScoresGump(int page) => _page = Math.Max(0, page);
+
+    public override bool Singleton => true;
+
+    protected override void BuildLayout(ref DynamicGumpBuilder builder)
+    {
+        var scores = new List<BoardGamePlayerScore>(BoardGameData.GetScores(BombermanSettings.GameName));
+        scores.Sort((a, b) => b.Score.CompareTo(a.Score));
+
+        AddFrame(ref builder, 400, 140 + PerPage * 20);
+        builder.AddLabel(40, 50, 1152, "Scores");
+
+        if (scores.Count == 0)
+        {
+            builder.AddLabel(40, 80, 1152, "- NO SCORES SET YET -");
+            return;
+        }
+
+        builder.AddLabel(40, 80, 1152, "Name");
+        builder.AddLabel(190, 80, 1152, "Score");
+        builder.AddLabel(240, 80, 1152, "Wins");
+        builder.AddLabel(290, 80, 1152, "Losses");
+
+        var start = Math.Min(_page * PerPage, Math.Max(0, scores.Count - 1) / PerPage * PerPage);
+
+        for (var i = start; i < Math.Min(scores.Count, start + PerPage); i++)
+        {
+            var y = 100 + (i - start) * 20;
+            builder.AddLabel(40, y, 1152, scores[i].Player.Name);
+            builder.AddLabel(190, y, 1152, $"{scores[i].Score}");
+            builder.AddLabel(240, y, 1152, $"{scores[i].Wins}");
+            builder.AddLabel(290, y, 1152, $"{scores[i].Losses}");
+        }
+
+        if (start > 0)
+        {
+            builder.AddButton(40, 110 + PerPage * 20, 4014, 4015, 1);
+        }
+
+        if (start + PerPage < scores.Count)
+        {
+            builder.AddButton(320, 110 + PerPage * 20, 4005, 4006, 2);
+        }
+    }
+
+    public override void OnResponse(NetState sender, in RelayInfo info)
+    {
+        if (info.ButtonID is 1 or 2)
+        {
+            sender.Mobile.SendGump(new BombermanScoresGump(_page + (info.ButtonID == 1 ? -1 : 1)), true);
+        }
+    }
+}
+
+public class BombermanResetScoresGump : BombermanGump
+{
+    public override bool Singleton => true;
+
+    protected override void BuildLayout(ref DynamicGumpBuilder builder)
+    {
+        AddFrame(ref builder, 400, 200);
+        builder.AddHtml(
+            40, 50, 320, 80,
+            $"You are about to reset all the score data for {BombermanSettings.GameName}.  Once you do this, it cannot be undone.  Are you sure you wish to do this?",
+            background: true
+        );
+        builder.AddButton(100, 160, 0xF7, 0xF8, 1);
+        builder.AddButton(240, 160, 0xF1, 0xF2, 0);
+    }
+
+    public override void OnResponse(NetState sender, in RelayInfo info)
+    {
+        if (info.ButtonID == 1 && sender.Mobile.AccessLevel >= AccessLevel.GameMaster)
+        {
+            BoardGameData.ResetScores(BombermanSettings.GameName);
+            sender.Mobile.SendMessage("Score data has been reset.");
+        }
+    }
+}
