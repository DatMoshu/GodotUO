+
+        // Puts out every player standing on the spot, crediting the bag's owner.
+        public void CheckForVictims(Point3D location, Map map, BombBag source)
+        {
+            if (State != BoardGameState.Active || source == null)
+            {
+                return;
+            }
+
+            var victims = new List<Mobile>();
+
+            foreach (var m in map.GetMobilesInRange(location, 0))
+            {
+                if (Players.Contains(m))
+                {
+                    victims.Add(m);
+                }
+            }
+
+            foreach (var m in victims)
+            {
+                var killer = source.Owner;
+
+                if (m != killer)
+                {
+                    m.SendMessage($"You've been blown up by {killer?.Name}'s blast!");
+                    killer?.SendMessage($"You've blown {m.Name}!");
+
+                    if (_saveScore)
+                    {
+                        BoardGameData.ChangeScore(BombermanSettings.GameName, killer, BombermanSettings.KillScore);
+                        BoardGameData.ChangeScore(BombermanSettings.GameName, m, BombermanSettings.DeathScore);
+                    }
+
+                    PublicOverheadMessage(MessageType.Regular, 1153, false, $"{killer?.Name} has blown up {m.Name}!");
+                }
+                else
+                {
+                    m.SendMessage("You just blew yourself up!!");
+                    PublicOverheadMessage(MessageType.Regular, 1153, false, $"{m.Name} has just blown themself up!");
+
+                    if (_saveScore)
+                    {
+                        BoardGameData.ChangeScore(BombermanSettings.GameName, m, BombermanSettings.SuicideScore);
+                    }
+                }
+
+                if (_saveScore)
+                {
+                    BoardGameData.AddLoss(BombermanSettings.GameName, m);
+                }
+
+                m.PlaySound(m.Female ? 0x32E : 0x549);
+                Players.Remove(m);
+                m.Backpack?.FindItemByType<BombBag>()?.Delete();
+                m.MoveToWorld(new Point3D(X - 1, Y - 1, Z), Map);
+                m.SendGump(new BombermanResultGump(false), true);
+            }
+
+            if (victims.Count > 0)
+            {
+                _endCheck?.Stop();
+                _endCheck = Timer.DelayCall(TimeSpan.FromSeconds(1), CheckForWinner);
+            }
+        }
+
+        private void CheckForWinner()
+        {
+            if (State != BoardGameState.Active || Players.Count >= 2)
+            {
+                return;
+            }
+
+            State = BoardGameState.GameOver;
+
+            if (Players.Count == 1)
+            {
+                var winner = Players[0];
+                winner.SendGump(new BombermanResultGump(true), true);
+
+                if (_saveScore)
+                {
+                    BoardGameData.ChangeScore(BombermanSettings.GameName, winner, BombermanSettings.WinScore);
+                    BoardGameData.AddWin(BombermanSettings.GameName, winner);
+                }
+
+                var bag = winner.Backpack?.FindItemByType<BombBag>();
+
+                if (bag != null)
+                {
+                    bag.Active = false;
+                }
+
+                PublicOverheadMessage(MessageType.Regular, 1153, false, $"{winner.Name} wins the game!");
+            }
+            else
+            {
+                PublicOverheadMessage(MessageType.Regular, 1153, false, "It's a draw!");
+            }
+
+            _winner?.Stop();
+            _winner = Timer.DelayCall(WinDelay, EndGame);
+        }
+
+        public void EndGame()
+        {
+            _endCheck?.Stop();
+            _winner?.Stop();
+
+            foreach (var player in Players)
+            {
+                player.MoveToWorld(new Point3D(X - 1, Y - 1, Z), Map);
+                player.SendMessage("You've won the game!");
+            }
+
+            foreach (var bag in BombBags.ToArray())
+            {
+                bag.Delete();
+            }
+
+            BombBags.Clear();
+            Players.Clear();
+            PendingPlayers.Clear();
+            State = _isDisabled ? BoardGameState.Disabled : BoardGameState.Inactive;
+            ResetBoard();
+            InvalidateProperties();
+        }
+
+        public override void OnLocationChange(Point3D oldLocation)
+        {
+            base.OnLocationChange(oldLocation);
+            ResetBoard();
+        }
+
+        public override void OnMapChange()
+        {
+            base.OnMapChange();
+            ResetBoard();
+        }
+
+        [AfterDeserialization]
+        private void AfterDeserialization()
+        {
+            State = _isDisabled ? BoardGameState.Disabled : BoardGameState.Inactive;
+            Timer.DelayCall(ResetBoard);
+        }
+
+        public override void OnAfterDelete()
+        {
+            _endCheck?.Stop();
+            _winner?.Stop();
+
+            foreach (var bag in BombBags.ToArray())
+            {
+                bag.Delete();
+            }
+
+            WipeBoard();
+            base.OnAfterDelete();
+        }
+
+        private class ScoresEntry : ContextMenuEntry
+        {
+            public ScoresEntry() : base(6239, 10) // View scores
+            {
+            }
+
+            public override void OnClick(Mobile from, IEntity target) => from.SendGump(new BombermanScoresGump(0), true);
+        }
+
+        private class ResetScoresEntry : ContextMenuEntry
+        {
+            public ResetScoresEntry() : base(6162, 10) // Reset
+            {
+            }
+
+            public override void OnClick(Mobile from, IEntity target)
+            {
+                if (from.AccessLevel >= AccessLevel.GameMaster)
+                {
+                    from.SendGump(new BombermanResetScoresGump(), true);
+                }
+            }
+        }
+    }
+}
diff --git a/Projects/UOContent/Custom/DFI/Games/BombermanGumps.cs b/Projects/UOContent/Custom/DFI/Games/BombermanGumps.cs
