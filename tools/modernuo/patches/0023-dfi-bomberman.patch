+        public override void OnAfterDelete()
+        {
+            foreach (var bomb in Bombs.ToArray())
+            {
+                bomb.Delete();
+            }
+
+            Detonator?.Delete();
+
+            if (SpeedUpgraded)
+            {
+                Owner?.NetState.SendSpeedControl(SpeedControlSetting.Disable);
+            }
+
+            base.OnAfterDelete();
+        }
+
+        [AfterDeserialization]
+        private void AfterDeserialization() => Timer.DelayCall(Delete);
