index 000000000..ec42b4e15
--- /dev/null
+++ b/Projects/UOContent/Custom/DFI/Loot/DfiLoot.cs
@@ -0,0 +1,173 @@
+// DFI Network loot rules, ported from the DefianceUO-based DFI RunUO shard
+// (Scripts/Misc/LootPack.cs helpers and Scripts/Custom/Misc/BaseCreatureLoot.cs).
+// The plague and elder bonuses are not ported: ModernUO has neither creature state.
+
+using System;
+using System.Collections.Generic;
+using Server.Engines.CannedEvil;
+using Server.Items;
+using Server.Mobiles;
+
+namespace Server.Custom.Dfi;
+
+public static class DfiLoot
+{
+    // Index by fame / 5000, clamped to Average..SuperBoss, exactly as DFI did.
+    public static LootPack GetLootPackFromFame(int fame) =>
+        Math.Clamp(fame / 5000, 2, 6) switch
+        {
+            2 => LootPack.Average,
+            3 => LootPack.Rich,
+            4 => LootPack.FilthyRich,
+            5 => LootPack.UltraRich,
+            _ => LootPack.SuperBoss
+        };
+
+    public static Item Mutate(Item item, int attributeCount, int min, int max, int luckChance)
+    {
+        switch (item)
+        {
+            case BaseWeapon weapon:
+                {
+                    BaseRunicTool.ApplyAttributesTo(weapon, false, luckChance, attributeCount, min, max);
+                    break;
+                }
+            case BaseArmor armor:
+                {
+                    BaseRunicTool.ApplyAttributesTo(armor, false, luckChance, attributeCount, min, max);
+                    break;
+                }
+            case BaseJewel jewel:
+                {
+                    BaseRunicTool.ApplyAttributesTo(jewel, false, luckChance, attributeCount, min, max);
+                    break;
+                }
+            case BaseHat hat:
+                {
+                    BaseRunicTool.ApplyAttributesTo(hat, false, luckChance, attributeCount, min, max);
+                    break;
+                }
+            case BaseInstrument instrument:
+                {
+                    instrument.Quality = InstrumentQuality.Regular;
+                    instrument.Slayer = BaseRunicTool.GetRandomSlayer();
+                    break;
+                }
+        }
+
+        return item;
+    }
+
+    // 2% of the rolls are a slayer instrument; the rest are a random armor, shield, weapon or jewel.
+    public static void AddRandomLoot(
+        Container c, int amount, int luckChance, int minAttributeCount, int maxAttributeCount, int min, int max
+    )
+    {
+        if (c == null)
+        {
+            return;
+        }
+
+        for (var i = 0; i < amount; i++)
+        {
+            if (Utility.RandomDouble() < 0.02)
+            {
+                var instrument = Loot.RandomInstrument();
+                instrument.Slayer = BaseRunicTool.GetRandomSlayer();
+                c.DropItem(instrument);
+                continue;
+            }
+
+            var item = Loot.RandomArmorOrShieldOrWeaponOrJewelry();
+
+            if (item != null)
+            {
+                var count = Utility.RandomMinMax(minAttributeCount, maxAttributeCount);
+                c.DropItem(Mutate(item, count, min, max, luckChance));
+            }
+        }
+    }
+
+    public static void AddMoreLoot(BaseCreature creature, Container c, bool spawning, int luckChance, int packs)
+    {
+        if (creature == null || c == null)
+        {
+            return;
+        }
+
+        for (var i = 0; i < packs; ++i)
+        {
+            GetLootPackFromFame(creature.Fame).Generate(creature, c, spawning, luckChance);
+        }
+    }
+
+    public static void OnCreatureDeath(BaseCreature creature, Container c)
+    {
+        if (creature.Controlled || creature.Summoned || creature.NoKillAwards || c == null)
+        {
+            return;
+        }
+
+        if (Utility.RandomDouble() < 0.0005 && IsChampionSpawnCreature(creature))
+        {
+            GivePowerScroll(creature);
+        }
+
+        if (creature.IsParagon)
+        {
+            AddMoreLoot(creature, c, false, 1000, 1);
+            MultiplyGold(c, 1.50);
+        }
+    }
+
+    private static bool IsChampionSpawnCreature(BaseCreature creature) =>
+        creature.Region.GetRegion<ChampionSpawnRegion>()?.Spawn?.IsChampionSpawn(creature) == true;
+
+    private static void MultiplyGold(Container c, double factor)
+    {
+        var gold = c.FindItemByType<Gold>();
+
+        if (gold != null)
+        {
+            gold.Amount = (int)(gold.Amount * factor);
+        }
+    }
+
+    private static void GivePowerScroll(BaseCreature creature)
+    {
+        if (creature.Map != Map.Felucca)
+        {
+            return;
+        }
+
+        var rights = BaseCreature.GetLootingRights(creature.DamageEntries, creature.HitsMax);
+        var eligible = new List<Mobile>();
+
+        for (var i = 0; i < rights.Count; ++i)
+        {
+            if (rights[i].m_HasRight)
+            {
+                eligible.Add(rights[i].m_Mobile);
+            }
+        }
+
+        if (eligible.Count == 0)
+        {
+            return;
+        }
+
+        var m = eligible[Utility.Random(eligible.Count)];
+        var ps = PowerScroll.CreateRandomNoCraft(5, 5);
+
+        m.SendLocalizedMessage(1049524); // You have received a scroll of power!
+
+        if (m.Alive || m.Corpse?.Deleted != false)
+        {
+            m.AddToBackpack(ps);
+        }
+        else
+        {
+            m.Corpse.DropItem(ps);
+        }
+    }
+}
