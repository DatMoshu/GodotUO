+// The cursed bandage themselves, pick a weapon back up out of their pack when disarmed, and use
+// either of their weapon's special moves.
+[SerializationGenerator(0)]
+public abstract partial class BaseCursedCreature : BaseCreature
+{
+    private DateTime _nextBandageTime;
+    private DateTime _nextRearmTime;
+    private bool _tryToRearm;
+
+    public BaseCursedCreature(AIType ai, int rangeFight = 1) : base(ai, FightMode.Closest, 10, rangeFight) =>
+        SetSpeed(0.2, 0.4);
+
+    public virtual bool UseRearm => false;
+    public virtual int RearmMinDelay => 15;
+    public virtual int RearmMaxDelay => 20;
+    public virtual bool UseBandages => true;
+    public virtual int BandagesMinDelay => 15;
+    public virtual int BandagesMaxDelay => 20;
+    public override bool ShowFameTitle => false;
+    public override double WeaponAbilityChance => 0.3;
+
+    public override WeaponAbility GetWeaponAbility() =>
+        Weapon is BaseWeapon wep
+            ? Utility.RandomBool() ? wep.PrimaryAbility : wep.SecondaryAbility
+            : base.GetWeaponAbility();
+
+    public override void OnDamage(int amount, Mobile from, bool willKill)
+    {
+        base.OnDamage(amount, from, willKill);
+
+        if (willKill || from is not PlayerMobile || Utility.RandomDouble() >= 0.01)
+        {
+            return;
+        }
+
+        var line = from.Weapon switch
+        {
+            LongswordOfJustice  => "He has got the Sword Of Justice!",
+            HarvesterOfTheGhost => "He has got the Harvester Of The Ghost!",
+            BowOfHephaestus     => "He has got the Bow Of Hephaestus!",
+            _                   => null
+        };
+
+        if (line != null)
+        {
+            Say(line);
+            PlaySound(432);
+        }
+    }
+
+    public override void OnThink()
+    {
+        base.OnThink();
+
+        if (_tryToRearm && _nextRearmTime < Core.Now)
+        {
+            if (TryRearm())
+            {
+                _tryToRearm = false;
+            }
+            else
+            {
+                _nextRearmTime = Core.Now + TimeSpan.FromHours(1.0);
+            }
+        }
+        else if (UseRearm && !_tryToRearm && Weapon is null or Fists)
+        {
+            _tryToRearm = true;
+            _nextRearmTime = Core.Now + TimeSpan.FromSeconds(Utility.RandomMinMax(RearmMinDelay, RearmMaxDelay));
+        }
+
+        if (UseBandages && _nextBandageTime < Core.Now && Hits < HitsMax - 10)
+        {
+            var bandage = Backpack?.FindItemByType<Bandage>();
+
+            if (bandage != null)
+            {
+                if (BandageContext.BeginHeal(this, this) != null)
+                {
+                    bandage.Consume();
+                }
+
+                _nextBandageTime = Core.Now + TimeSpan.FromSeconds(Utility.RandomMinMax(BandagesMinDelay, BandagesMaxDelay));
+            }
+            else
+            {
+                _nextBandageTime = Core.Now + TimeSpan.FromHours(1.0);
+            }
+        }
+    }
+
+    private bool TryRearm()
+    {
+        if (Backpack == null)
+        {
+            return false;
+        }
+
+        var needArcherWeapon = AI == AIType.AI_Archer;
+
+        foreach (var item in Backpack.Items)
+        {
+            if (item is not BaseWeapon wep || needArcherWeapon && wep.Skill != SkillName.Archery)
+            {
+                continue;
+            }
+
+            if (Skills[wep.Skill].Base > 0 && EquipItem(wep))
+            {
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    public override void GenerateLoot()
+    {
+        PackItem(new Bandage(Utility.RandomMinMax(10, 30)));
+    }
+
+    protected void DressInBone(int hue = 0)
+    {
+        foreach (var piece in (Item[])[new BoneLegs(), new BoneArms(), new BoneGloves(), new BoneChest(), new BoneHelm()])
+        {
+            if (hue != 0)
+            {
+                piece.Hue = hue;
+            }
+
+            AddItem(CursedCave.MutateItem(piece, 10));
+        }
+    }
+
+    protected static CraftResource RandomScales() =>
+        Utility.Random(6) switch
+        {
+            1 => CraftResource.BlueScales,
+            2 => CraftResource.GreenScales,
+            3 => CraftResource.RedScales,
+            4 => CraftResource.WhiteScales,
+            5 => CraftResource.YellowScales,
+            _ => CraftResource.BlackScales
+        };
+
+    protected static CraftResource RandomMetal() =>
+        Utility.Random(4) switch
+        {
+            1 => CraftResource.DullCopper,
+            2 => CraftResource.ShadowIron,
+            3 => CraftResource.Copper,
+            _ => CraftResource.Iron
+        };
+
+    protected void EquipResource(BaseArmor armor, CraftResource resource)
+    {
+        armor.Resource = resource;
+        AddItem(CursedCave.MutateItem(armor, 10));
+    }
+}
