+// DFI's ESpecialAbilities life drain: 5 fire-free damage a second for five seconds, given to the drainer.
+public static class CursedCaveLifeDrain
+{
+    private static readonly Dictionary<Mobile, TimerExecutionToken> _table = new();
+
+    public static void Begin(Mobile defender, Mobile from)
+    {
+        if (_table.ContainsKey(defender))
+        {
+            return;
+        }
+
+        defender.SendLocalizedMessage(1070848); // You feel your life force being stolen away.
+        defender.FixedParticles(0x3779, 10, 15, 5009, EffectLayer.Waist);
+
+        var ticks = 0;
+        Timer.StartTimer(
+            TimeSpan.FromSeconds(1.0),
+            TimeSpan.FromSeconds(1.0),
+            5,
+            () =>
+            {
+                if (!defender.Alive || from.Deleted)
+                {
+                    End(defender);
+                    return;
+                }
+
+                from.Hits += AOS.Damage(defender, from, 5, 100, 0, 0, 0, 0);
+
+                if (++ticks == 5)
+                {
+                    End(defender);
+                }
+            },
+            out var token
+        );
+
+        _table[defender] = token;
+    }
+
+    private static void End(Mobile m)
+    {
+        if (_table.Remove(m, out var token))
+        {
+            token.Cancel();
+            m.SendLocalizedMessage(1070849); // The drain on your life force is gone.
+        }
+    }
+
+    [OnEvent(nameof(PlayerMobile.PlayerDeletedEvent))]
+    public static void OnPlayerDeleted(PlayerMobile m) => _table.Remove(m);
+}
