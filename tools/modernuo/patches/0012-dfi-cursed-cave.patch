+public class CursedCaveRaresGump : DynamicGump
+{
+    private readonly List<Item> _found;
+    private readonly WarrenTheGuard _warren;
+
+    public CursedCaveRaresGump(List<Item> found, WarrenTheGuard warren) : base(50, 50)
+    {
+        _found = found;
+        _warren = warren;
+    }
+
+    public override bool Singleton => true;
+
+    protected override void BuildLayout(ref DynamicGumpBuilder builder)
+    {
+        builder.AddPage();
+        builder.AddBackground(0, 0, 467, 234, 9200);
+        builder.AddLabel(148, 6, 0, "Lost Treasures Of Cursed Cave");
+
+        using var html = ValueStringBuilder.Create();
+        html.Append(
+            $"I see that you have enough cursed cave rares in your backpack to earn a reward. Do you wish to turn in the following {WarrenTheGuard.ArtifactAmount} rares to recive a reward and maybe even a special artifact?<br><br>Rares Found<br>"
+        );
+
+        foreach (var item in _found)
+        {
+            html.Append($"{CursedCaveRares.NameOf(item)}<br>");
+        }
+
+        builder.AddHtml(15, 35, 434, 137, html.AsSpan(), background: true, scrollbar: true);
+        builder.AddButton(161, 190, 247, 248, 1);
+        builder.AddButton(239, 190, 242, 241, 0);
+    }
+
+    public override void OnResponse(NetState sender, in RelayInfo info)
+    {
+        var from = sender.Mobile;
+
+        if (info.ButtonID != 1 || _warren.Deleted)
+        {
+            return;
+        }
+
+        var held = 0;
+
+        foreach (var item in _found)
+        {
+            if (!item.Deleted && item.IsChildOf(from.Backpack))
+            {
+                held++;
+            }
+        }
+
+        if (held < WarrenTheGuard.ArtifactAmount)
+        {
+            return;
+        }
+
+        var bag = WarrenTheGuard.CreateRareRewardBag();
+
+        if (from.PlaceInBackpack(bag))
+        {
+            foreach (var item in _found)
+            {
+                item.Delete();
+            }
+
+            // You have earned the gratitude of the Empire. I have placed the ~1_OBJTYPE~ in your backpack.
+            _warren.Say(1070984, "Reward Bag");
+        }
+        else
+        {
+            bag.Delete();
+            // You need to clear some space in your inventory to continue with the quest.  Come back here when you have more space in your inventory.
+            from.SendLocalizedMessage(1046260);
+        }
