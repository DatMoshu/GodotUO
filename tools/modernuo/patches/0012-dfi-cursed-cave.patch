@@ -0,0 +1,374 @@
+// DFI's summoning altar, ported from DFI RUNUO Scripts/Custom/Engines/BaseSummoningAltar
+// (BaseSummoningAltar.cs, BaseAltar.cs, BasePlatform.cs) and CursedCave/Altar/CCSummoningAltar.cs.
+
+using System;
+using System.Collections.Generic;
+using ModernUO.CodeGeneratedEvents;
+using ModernUO.Serialization;
+using Server.Mobiles;
+
+namespace Server.Items;
+
+// An invisible marker 20 above a hued platform and pentagram. Every use of the chamber's key queues a
+// champion; queued champions show as red skulls round the pentagram, every 17 of them as a white skull,
+// and while the altar is active and no champion lives, the next one rises on the pentagram.
+[SerializationGenerator(0)]
+public abstract partial class BaseSummoningAltar : Item
+{
+    private static readonly HashSet<BaseSummoningAltar> _altars = [];
+
+    [SerializableField(0)]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private BaseCreature _champion;
+
+    [SerializableField(1)]
+    private SummoningPentagram _pentagram;
+
+    [SerializableField(2)]
+    private SummoningPlatform _platform;
+
+    [SerializableField(3, setter: "private")]
+    private bool _active;
+
+    [SerializableField(4, getter: "private", setter: "private")]
+    private int _queued;
+
+    [SerializableField(5)]
+    private List<Item> _redSkulls;
+
+    [SerializableField(6)]
+    private List<Item> _whiteSkulls;
+
+    public BaseSummoningAltar() : base(0xBD2)
+    {
+        Movable = false;
+        Visible = false;
+
+        _pentagram = new SummoningPentagram(this) { Hue = HueInactive };
+        _platform = new SummoningPlatform(this);
+        _redSkulls = [];
+        _whiteSkulls = [];
+        _altars.Add(this);
+    }
+
+    public override string DefaultName => "summoning altar";
+
+    public abstract Type ChampionType { get; }
+    public virtual int HueActive => 0;
+    public virtual int HueInactive => 0;
+    public virtual int MaxInQueue => 84;
+
+    [CommandProperty(AccessLevel.GameMaster)]
+    public bool IsActive
+    {
+        get => _active;
+        set
+        {
+            Active = value;
+            InvalidateProperties();
+
+            if (value)
+            {
+                CheckSpawn();
+            }
+        }
+    }
+
+    [CommandProperty(AccessLevel.GameMaster)]
+    public int MainQueue
+    {
+        get => _queued;
+        set
+        {
+            _queued = Math.Clamp(value, 0, MaxInQueue);
+            this.MarkDirty();
+            UpdateSkulls();
+            CheckSpawn();
+        }
+    }
+
+    [CommandProperty(AccessLevel.GameMaster)]
+    public int Level => _whiteSkulls.Count;
+
+    public override void GetProperties(IPropertyList list)
+    {
+        base.GetProperties(list);
+        list.Add(_active ? 1060742 : 1060743); // active / inactive
+    }
+
+    private bool ChampionAlive => _champion?.Deleted == false && _champion.Alive;
+
+    public void CheckAltarHue()
+    {
+        if (!ChampionAlive)
+        {
+            Champion = null;
+        }
+
+        if (_pentagram != null)
+        {
+            _pentagram.Hue = ChampionAlive ? HueActive : HueInactive;
+        }
+    }
+
+    private void UpdateSkulls()
+    {
+        var white = _queued / 17;
+        SetSkullCount(_redSkulls, _queued - white * 17, 0x26, GetRedSkullLocation);
+        SetSkullCount(_whiteSkulls, white, 0, GetWhiteSkullLocation);
+        this.MarkDirty();
+    }
+
+    private void SetSkullCount(List<Item> skulls, int count, int hue, Func<int, Point3D> location)
+    {
+        for (var i = skulls.Count - 1; i >= count; --i)
+        {
+            skulls[i].Delete();
+            skulls.RemoveAt(i);
+        }
+
+        for (var i = skulls.Count; i < count; ++i)
+        {
+            var skull = new Static(0x1854) { Hue = hue, Light = LightType.Circle150 };
+            skull.MoveToWorld(location(i), Map);
+            skulls.Add(skull);
+
+            Effects.PlaySound(skull.Location, skull.Map, 0x29);
+            Effects.SendLocationEffect(new Point3D(skull.X + 1, skull.Y + 1, skull.Z), skull.Map, 0x3728, 10);
+        }
+    }
+
+    private Point3D GetRedSkullLocation(int index)
+    {
+        var (x, y) = index switch
+        {
+            < 5  => (index - 2, -2),
+            < 9  => (2, index - 6),
+            < 13 => (10 - index, 2),
+            _    => (-2, 14 - index)
+        };
+
+        return new Point3D(X + x, Y + y, Z - 15);
+    }
+
+    private Point3D GetWhiteSkullLocation(int index)
+    {
+        var (x, y) = index switch
+        {
+            1 => (1, -1),
+            2 => (1, 1),
+            3 => (-1, 1),
+            _ => (-1, -1)
+        };
+
+        return new Point3D(X + x, Y + y, Z - 15);
+    }
+
+    public void CheckSpawn()
+    {
+        if (!_active || Deleted || ChampionAlive || _queued <= 0 || ChampionType == null)
+        {
+            return;
+        }
+
+        _queued--;
+        UpdateSkulls();
+
+        var champion = ChampionType.CreateInstance<BaseCreature>();
+        champion.Home = Location;
+        champion.RangeHome = 10;
+        champion.MoveToWorld(new Point3D(X, Y, Z - 15), Map);
+        Champion = champion;
+
+        CheckAltarHue();
+    }
+
+    [OnEvent(nameof(CreatureEvents.CreatureDeathEvent))]
+    public static void OnCreatureDeath(BaseCreature bc)
+    {
+        foreach (var altar in _altars)
+        {
+            if (altar._champion == bc)
+            {
+                altar.Champion = null;
+                altar.CheckAltarHue();
+                Timer.StartTimer(altar.CheckSpawn);
+                return;
+            }
+        }
+    }
+
+    public override void OnLocationChange(Point3D oldLoc)
+    {
+        if (Deleted)
+        {
+            return;
+        }
+
+        _platform?.MoveToWorld(new Point3D(X, Y, Z - 20), Map);
+        _pentagram?.MoveToWorld(new Point3D(X, Y, Z - 15), Map);
+
+        for (var i = 0; i < _redSkulls.Count; ++i)
+        {
+            _redSkulls[i].Location = GetRedSkullLocation(i);
+        }
+
+        for (var i = 0; i < _whiteSkulls.Count; ++i)
+        {
+            _whiteSkulls[i].Location = GetWhiteSkullLocation(i);
+        }
+    }
+
+    public override void OnMapChange()
+    {
+        if (Deleted)
+        {
+            return;
+        }
+
+        OnLocationChange(Location);
+
+        foreach (var skull in _redSkulls)
+        {
+            skull.Map = Map;
+        }
+
+        foreach (var skull in _whiteSkulls)
+        {
+            skull.Map = Map;
+        }
+    }
+
+    public override void OnAfterDelete()
+    {
+        base.OnAfterDelete();
+        _altars.Remove(this);
+
+        _platform?.Delete();
+        _pentagram?.Delete();
+
+        foreach (var skull in _redSkulls)
+        {
+            skull.Delete();
+        }
+
+        foreach (var skull in _whiteSkulls)
+        {
+            skull.Delete();
+        }
+
+        _redSkulls.Clear();
+        _whiteSkulls.Clear();
+    }
+
+    [AfterDeserialization]
+    private void AfterDeserialization()
+    {
+        if (_platform == null || _pentagram == null)
+        {
+            Delete();
+            return;
+        }
+
+        _altars.Add(this);
+        CheckAltarHue();
+        CheckSpawn();
+    }
+}
+
+[SerializationGenerator(0)]
+public partial class SummoningPentagram : PentagramAddon
+{
+    [SerializableField(0)]
+    private BaseSummoningAltar _owner;
+
+    public SummoningPentagram(BaseSummoningAltar owner) => _owner = owner;
+
+    public override BaseAddonDeed Deed => null;
+
+    public override void OnAfterDelete()
+    {
+        base.OnAfterDelete();
+        _owner?.Delete();
+    }
+
+    [AfterDeserialization]
+    private void AfterDeserialization()
+    {
+        if (_owner == null)
+        {
+            Delete();
+        }
+    }
+}
+
+[SerializationGenerator(0)]
+public partial class SummoningPlatform : BaseAddon
+{
+    [SerializableField(0)]
+    private BaseSummoningAltar _owner;
+
+    public SummoningPlatform(BaseSummoningAltar owner)
+    {
+        _owner = owner;
+
+        for (var x = -2; x <= 2; ++x)
+        {
+            for (var y = -2; y <= 2; ++y)
+            {
+                AddPiece(0x750, x, y, -5);
+            }
+        }
+
+        for (var x = -1; x <= 1; ++x)
+        {
+            for (var y = -1; y <= 1; ++y)
+            {
+                AddPiece(0x750, x, y, 0);
+            }
+        }
+
+        for (var i = -1; i <= 1; ++i)
+        {
+            AddPiece(0x751, i, 2, 0);
+            AddPiece(0x752, 2, i, 0);
+            AddPiece(0x753, i, -2, 0);
+            AddPiece(0x754, -2, i, 0);
+        }
+
+        AddPiece(0x759, -2, -2, 0);
+        AddPiece(0x75A, 2, 2, 0);
+        AddPiece(0x75B, -2, 2, 0);
+        AddPiece(0x75C, 2, -2, 0);
+    }
+
+    private void AddPiece(int itemID, int x, int y, int z) => AddComponent(new AddonComponent(itemID) { Hue = 0x497 }, x, y, z);
+
+    public override void OnAfterDelete()
+    {
+        base.OnAfterDelete();
+        _owner?.Delete();
+    }
+
+    [AfterDeserialization]
+    private void AfterDeserialization()
+    {
+        if (_owner == null)
+        {
+            Delete();
+        }
+    }
+}
+
+[SerializationGenerator(0)]
+public partial class CCSummoningAltar : BaseSummoningAltar
+{
+    [Constructible]
+    public CCSummoningAltar()
+    {
+    }
+
+    public override Type ChampionType => typeof(Hephaestus);
+    public override int HueActive => 0x21;
+    public override int HueInactive => 0x472;
+}
