+// Gives the Cursed Cave quest, and buys back the cave's rares: walk up with ten of them in your pack and
+// he offers a reward bag, sometimes with the Harvester of the Ghost in it.
+[SerializationGenerator(0)]
+public partial class WarrenTheGuard : BaseQuester
+{
+    public const int ArtifactAmount = 10;
+
+    private static readonly SkillName[] _fightingSkills = [SkillName.Fencing, SkillName.Macing, SkillName.Swords, SkillName.Archery];
+
+    [Constructible]
+    public WarrenTheGuard() : base("the Paladin Guard")
+    {
+    }
+
+    public override string DefaultName => "Warren";
+
+    public override void InitBody()
+    {
+        InitStats(100, 100, 25);
+
+        Hue = 33770;
+        Female = false;
+        Body = 0x190;
+
+        HairItemID = 0x203B;
+        HairHue = 0x44E;
+    }
+
+    public override void InitOutfit()
+    {
+        AddItem(CreatePaladinArmor(new PlateChest(), "Platemail Tunic", 5));
+        AddItem(CreatePaladinArmor(new PlateArms(), "Platemail Arms", 5));
+        AddItem(CreatePaladinArmor(new PlateGloves(), "Platemail Gloves", 5));
+        AddItem(CreatePaladinArmor(new PlateLegs(), "Platemail Legs", 5));
+        AddItem(CreatePaladinArmor(new PlateGorget(), "Platemail Gorget", 5));
+        AddItem(new Cloak(1150));
+        AddItem(new LongswordOfJustice());
+        AddItem(new OrderShield());
+    }
+
+    private static BaseArmor CreatePaladinArmor(BaseArmor armor, string name, int props)
+    {
+        BaseRunicTool.ApplyAttributesTo(armor, props, 40, 80);
+        armor.Hue = 0x528;
+        armor.Name = $"{name} of the Paladin";
+        armor.SkillBonuses.SetValues(0, SkillName.Chivalry, 5.0);
+        return armor;
+    }
+
+    private static BaseArmor RandomPaladinPiece() =>
+        Utility.Random(5) switch
+        {
+            0 => CreatePaladinArmor(new PlateChest(), "Platemail Tunic", Utility.Random(5)),
+            1 => CreatePaladinArmor(new PlateArms(), "Platemail Arms", Utility.Random(5)),
+            2 => CreatePaladinArmor(new PlateGloves(), "Platemail Gloves", Utility.Random(5)),
+            3 => CreatePaladinArmor(new PlateLegs(), "Platemail Legs", Utility.Random(5)),
+            _ => CreatePaladinArmor(new PlateGorget(), "Platemail Gorget", Utility.Random(5))
+        };
+
+    public override void OnMovement(Mobile m, Point3D oldLocation)
+    {
+        base.OnMovement(m, oldLocation);
+
+        if (m.Alive && m is PlayerMobile pm && InRange(m, 4) && !InRange(oldLocation, 4))
+        {
+            OnRareTalk(pm);
+        }
+    }
+
+    public static List<Item> FindRares(Mobile player, int max)
+    {
+        var found = new List<Item>();
+
+        foreach (var item in player.Backpack?.Items ?? [])
+        {
+            if (CursedCaveRares.NameOf(item) != null)
+            {
+                found.Add(item);
+
+                if (found.Count >= max)
+                {
+                    break;
+                }
+            }
+        }
+
+        return found;
+    }
+
+    private void OnRareTalk(PlayerMobile player)
+    {
+        var found = FindRares(player, ArtifactAmount);
+
+        if (found.Count >= ArtifactAmount)
+        {
+            player.SendGump(new CursedCaveRaresGump(found, this), true);
+        }
+        else if (found.Count > 0)
+        {
+            Say(
+                $"I found {found.Count} of the lost treasures of the Cursed Cave in your backpack, bring me {ArtifactAmount} of them to get a reward."
+            );
+        }
+    }
+
+    public static Bag CreateRareRewardBag()
+    {
+        var bag = new Bag { Hue = Utility.RandomDyedHue() };
+        DfiLoot.AddRandomLoot(bag, 5, 600, 5, 5, 50, 100);
+        bag.DropItem(new Bandage(Utility.RandomMinMax(200, 300)));
+        bag.DropItem(new Gold(2000, 4000));
+        bag.DropItem(new TreasureMap(Utility.RandomMinMax(2, 6), Map.Felucca));
+
+        if (Utility.RandomDouble() < 0.40)
+        {
+            bag.DropItem(new HarvesterOfTheGhost());
+        }
+
+        return bag;
+    }
+
+    public static Bag CreateQuestRewardBag(Mobile player)
+    {
+        var bag = new Bag { Hue = Utility.RandomDyedHue() };
+        DfiLoot.AddRandomLoot(bag, 5, 600, 5, 5, 50, 100);
+        bag.DropItem(new Bandage(Utility.RandomMinMax(200, 300)));
+        bag.DropItem(new Gold(2000, 4000));
+        bag.DropItem(new TreasureMap(Utility.RandomDouble() < 0.08 ? 6 : Utility.RandomMinMax(3, 5), Map.Felucca));
+
+        if (Utility.RandomDouble() < 0.05)
+        {
+            bag.DropItem(GetBestFightingSkill(player) == SkillName.Archery ? new BowOfHephaestus() : new LongswordOfJustice());
+        }
+        else if (Utility.RandomDouble() < 0.2)
+        {
+            bag.DropItem(RandomPaladinPiece());
+        }
+
+        return bag;
+    }
+
+    public override void OnTalk(PlayerMobile player, bool contextMenu)
+    {
+        Direction = GetDirectionTo(player);
+
+        var qs = player.Quest;
+
+        if (qs is CursedCaveQuest)
+        {
+            if (qs.IsObjectiveInProgress(typeof(CursedCaveBeginObjective)))
+            {
+                qs.AddConversation(new DuringKillTaskConversation());
+                return;
+            }
+
+            var obj = qs.FindObjective(typeof(ReportBackObjective));
+
+            if (obj?.Completed != false)
+            {
+                return;
+            }
+
+            var bag = CreateQuestRewardBag(player);
+
+            if (player.PlaceInBackpack(bag))
+            {
+                obj.Complete();
+
+                if (!player.KarmaLocked)
+                {
+                    player.Karma = Math.Min(15000, player.Karma + 1500);
+                }
+            }
+            else
+            {
+                bag.Delete();
+                // You need to clear some space in your inventory to continue with the quest.  Come back here when you have more space in your inventory.
+                player.SendLocalizedMessage(1046260);
+            }
+        }
+        else if (qs != null)
+        {
+            qs.AddConversation(new DontOfferConversation());
+        }
+        else if (QuestSystem.CanOfferQuest(player, typeof(CursedCaveQuest)))
+        {
+            new CursedCaveQuest(player).SendOffer();
+        }
+    }
+
+    public static SkillName GetBestFightingSkill(Mobile from)
+    {
+        var best = -1.0;
+        var skill = SkillName.Fencing;
+
+        foreach (var name in _fightingSkills)
+        {
+            if (from.Skills[name].Base > best)
+            {
+                best = from.Skills[name].Base;
+                skill = name;
+            }
+        }
+
+        return skill;
+    }
+}
