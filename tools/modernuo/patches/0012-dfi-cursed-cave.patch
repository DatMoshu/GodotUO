+        SetDamageType(ResistanceType.Physical, 20);
+
+        SetResistance(ResistanceType.Physical, 75, 80);
+        SetResistance(ResistanceType.Fire, 100);
+        SetResistance(ResistanceType.Cold, 60, 70);
+        SetResistance(ResistanceType.Poison, 60, 70);
+        SetResistance(ResistanceType.Energy, 60, 70);
+
+        SetSkill(SkillName.MagicResist, 70.7, 140.0);
+        SetSkill(SkillName.Tactics, 97.6, 100.0);
+        SetSkill(SkillName.Wrestling, 97.6, 100.0);
+
+        Fame = 22500;
+        Karma = -22500;
+
+        VirtualArmor = 80;
+
+        AddItem(new LightSource());
+    }
+
+    public override string DefaultName => "Hephaestus";
+    public override bool AlwaysMurderer => true;
+    public override Poison PoisonImmune => Poison.Lethal;
+    public override int TreasureMapLevel => 5;
+
+    public override MonsterAbility[] GetMonsterAbilities() => _abilities;
+
+    public override int GetAngerSound() => 0x567;
+
+    public static Item CreateRandomArtifact() => Loot.Construct(_rewards.RandomElement());
+
+    public override void OnGaveMeleeAttack(Mobile defender, int damage)
+    {
+        base.OnGaveMeleeAttack(defender, damage);
+
+        if (Utility.RandomDouble() >= 0.1)
+        {
+            return;
+        }
+
+        foreach (var m in defender.GetMobilesInRange(8))
+        {
+            if (m == this || m.AccessLevel > AccessLevel.Player || !CanBeHarmful(m) || !InLOS(m))
+            {
+                continue;
+            }
+
+            if (m is BaseCreature bc && (bc.Controlled || bc.Summoned || bc.Team != Team) || m.Player && m.Alive)
+            {
+                CursedCaveLifeDrain.Begin(m, this);
+            }
+        }
+    }
+
+    public override void GenerateLoot()
+    {
+        AddLoot(LootPack.UltraRich, 4);
+
+        if (!m_Spawning)
+        {
+            for (var i = 0; i < 5; ++i)
+            {
+                AddItem(new SulfurousAsh(30));
+            }
+        }
+    }
+
+    public override void OnDeath(Container c)
+    {
+        base.OnDeath(c);
+
+        if (0.03 + LootPack.GetLuckChanceForKiller(this) / 180000.0 > Utility.RandomDouble())
+        {
+            DemonKnight.DistributeArtifact(this, CreateRandomArtifact());
+        }
+    }
+}
