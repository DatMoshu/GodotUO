+    }
+
+    public DfiQuestSystem()
+    {
+    }
+
+    public override void AddConversation(QuestConversation conv)
+    {
+        conv.System = this;
+
+        if (conv.Logged)
+        {
+            Conversations.Add(conv);
+        }
+
+        var gumps = From.GetGumps();
