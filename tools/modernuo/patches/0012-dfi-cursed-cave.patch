+// Ported from DFI RUNUO Scripts/Custom/Engines/Quest System/CursedCave/Mobiles/TheCursedCorpse.cs.
+
+using System;
+using System.Collections.Generic;
+using ModernUO.CodeGeneratedEvents;
+using ModernUO.Serialization;
+using Server.Custom.Dfi;
+using Server.Items;
+using Server.Misc;
+using Server.Regions;
+
+namespace Server.Mobiles;
+
+// A player who dies in the cave rises fourteen seconds later as a cursed copy of themself: half their
+// hits, 80% of their skills, and everything that was on their corpse. At most five walk at once per player.
+[SerializationGenerator(0)]
+public partial class TheCursedCorpse : BaseCursedCreature
+{
+    public const int MaxCorpsesPerPlayer = 5;
+    private const double ScaleHits = 0.5;
+    private const double ScaleSkills = 0.8;
+
+    private static readonly Dictionary<PlayerMobile, int> _registry = new();
+
+    [SerializableField(0)]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private PlayerMobile _owner;
+
+    public TheCursedCorpse(PlayerMobile owner, Corpse corpse) : base(AIType.AI_Melee)
+    {
+        _owner = owner;
+
+        Body = owner.Female ? 0x191 : 0x190;
+        Name = owner.Name;
+        Title = owner.Title;
+        Hue = owner.Hue;
+        HairItemID = owner.HairItemID;
+        HairHue = owner.HairHue;
+
+        SetStr(owner.RawStr);
+        SetDex(owner.RawDex);
+        SetInt(owner.RawInt);
+
+        for (var i = 0; i < owner.Skills.Length && i < Skills.Length; ++i)
+        {
+            Skills[i].Base = Scale(owner.Skills[i].Base, ScaleSkills);
+        }
+
+        SetHits(Scale(owner.HitsMax, ScaleHits));
+        SetStam(owner.StamMax);
+
+        corpse.TurnToBones();
+        TakeItems(corpse);
+
+        Timer.StartTimer(CheckAI);
+    }
+
+    public override bool UseRearm => true;
+    public override InhumanSpeech SpeechType => CursedCave.Speech;
+    public override bool AlwaysAttackable => true;
+    public override bool AlwaysMurderer => true;
+
+    private static int Scale(double value, double scale) => value <= 0 ? 0 : (int)(value * scale);
+
+    private void CheckAI()
+    {
+        if (Weapon is BaseWeapon { Skill: SkillName.Archery })
+        {
+            AI = AIType.AI_Archer;
+        }
+    }
+
+    private void TakeItems(Corpse corpse)
+    {
+        var items = new List<Item>(corpse.Items);
+
+        foreach (var item in items)
+        {
+            var loc = item.Location;
+
+            if (item.Layer is Layer.Hair or Layer.FacialHair || !item.Movable || !corpse.GetRestoreInfo(item, ref loc))
+            {
+                continue;
+            }
+
+            if (corpse.RestoreEquip?.Contains(item) == true && EquipItem(item))
+            {
+                continue;
+            }
+
+            item.Location = loc;
+            Backpack?.AddItem(item);
+        }
+    }
+
