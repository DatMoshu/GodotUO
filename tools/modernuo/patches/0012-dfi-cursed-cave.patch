diff --git a/Projects/UOContent.Tests/Tests/Custom/DfiCursedCaveTests.cs b/Projects/UOContent.Tests/Tests/Custom/DfiCursedCaveTests.cs
new file mode 100644
index 000000000..bcc11b143
--- /dev/null
+++ b/Projects/UOContent.Tests/Tests/Custom/DfiCursedCaveTests.cs
@@ -0,0 +1,323 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Text.Json;
+using Server;
+using Server.Custom.Dfi;
+using Server.Engines.Quests.CursedCave;
+using Server.Engines.Spawners;
+using Server.Items;
+using Server.Misc;
+using Server.Mobiles;
+using Server.Regions;
+using Xunit;
+
+namespace UOContent.Tests.Custom;
+
+[Collection("Sequential UOContent Tests")]
+public class DfiCursedCaveTests : IDisposable
+{
+    private readonly List<IEntity> _created = new();
+
+    public DfiCursedCaveTests()
+    {
+        if (NameList.GetNameList("male") == null)
+        {
+            NameList.Configure();
+        }
+    }
+
+    public static TheoryData<Type> Creatures =>
+    [
+        typeof(TheCursed), typeof(TheCursedArcher), typeof(TheCursedMage), typeof(TheCursedNecro),
+        typeof(CursedSkeleton), typeof(TheCursedWarrior), typeof(TheCursedGuardian), typeof(TheCursedAlchemist),
+        typeof(TheCursedBlacksmith), typeof(TheCursedButcher), typeof(TheCursedCarpenter), typeof(CursedSteed),
+        typeof(DevaTheCursedOne), typeof(Hephaestus)
+    ];
+
+    public static TheoryData<Type> Items =>
+    [
+        typeof(CCKey), typeof(CCMagicDoor), typeof(CCKeywordDoor), typeof(CCTrigger), typeof(CursedCaveTeleporter),
+        typeof(CursedCavePassage), typeof(CCSkeletalCorpse), typeof(CCSummoningAltar), typeof(LongswordOfJustice),
+        typeof(HarvesterOfTheGhost), typeof(BowOfHephaestus)
+    ];
+
+    public static TheoryData<Type> Rares =>
+    [
+        typeof(SRCRBrokenChestOfDrawers), typeof(SRCREmptyToolKit), typeof(SRCRBucket), typeof(SRCRSmallWeb),
+        typeof(SRCRPluckedChicken), typeof(SRCRBooks), typeof(SRCRSturdySmithHammer), typeof(SRCRSturdySaw),
+        typeof(SRCRSturdyProspectorsTool), typeof(SRCREmptyTub), typeof(SRCRSturdyMortarPestle),
+        typeof(SRCRWallTorchEast), typeof(SRCRWallTorchSouth)
+    ];
+
+    private static string SpawnFile => Path.Combine(Core.BaseDirectory, "Data", "Spawns", "dfi", "dfi-cursed-cave.json");
+
+    public void Dispose()
+    {
+        foreach (var e in _created)
+        {
+            e?.Delete();
+        }
+
+        _created.Clear();
+    }
+
+    private T Track<T>(T e) where T : IEntity
+    {
+        _created.Add(e);
+        return e;
+    }
+
+    private T Place<T>(T bc, Point3D at) where T : BaseCreature
+    {
+        bc.MoveToWorld(at, Map.Felucca);
+        bc.AIObject?.AITimer?.Stop();
+        return Track(bc);
+    }
+
+    private PlayerMobile Player(Point3D at)
+    {
+        var m = Track(new PlayerMobile(World.NewMobile));
+        m.DefaultMobileInit();
+        m.Player = true;
+        m.AddItem(new Backpack());
+        m.MoveToWorld(at, Map.Felucca);
+        return m;
+    }
+
+    [Theory]
+    [MemberData(nameof(Creatures))]
+    public void Creature_Spawns_WithNameAndHits(Type type)
+    {
+        var bc = Place(type.CreateInstance<BaseCreature>(), new Point3D(5200, 1470, 0));
+
+        Assert.False(string.IsNullOrEmpty(bc.Name));
+        Assert.True(bc.HitsMax > 0);
+    }
+
+    [Theory]
+    [MemberData(nameof(Items))]
+    public void Item_Constructs(Type type)
+    {
+        var item = Track(type.CreateInstance<Item>());
+
+        Assert.False(item.Deleted);
+    }
+
+    [Theory]
+    [MemberData(nameof(Rares))]
+    public void Rare_IsFixedAndStealableFrom100(Type type)
+    {
+        var item = Track(type.CreateInstance<Item>());
+
+        Assert.False(item.Movable);
+        var rare = Assert.IsAssignableFrom<IStealable>(item);
+        Assert.Equal(100.0, rare.GetMin());
+        Assert.True(rare.GetMax() >= 100.0);
+        Assert.NotNull(CursedCaveRares.NameOf(item));
+    }
+
+    [Fact]
+    public void Cursed_FameByLevel_StaysWithinItsLevel()
+    {
+        for (var i = 0; i < 50; i++)
+        {
+            var fame = CursedCave.FameByLevel(3);
+            var karma = CursedCave.FameByLevel(-3);
+
+            Assert.InRange(fame, 15000, 19999);
+            Assert.InRange(karma, -19999, -15000);
+        }
+    }
+
+    [Fact]
+    public void LevelableWeapon_GainsLevelsFromCaveKillsOnly()
+    {
+        var sword = Track(new LongswordOfJustice());
+        Assert.Equal(1, sword.Level);
+
+        LevelItemManager.CheckLevelable(sword, Track(new Mongbat()));
+        Assert.Equal(0, sword.Experience);
+
+        LevelItemManager.CheckLevelable(sword, Track(new TheCursed()));
+        Assert.True(sword.Experience > 0);
+
+        sword.Experience = 20000;
+
+        Assert.Equal(3, sword.Level);
+        Assert.Equal(LevelItemManager.CalculateProperty(50, 3), sword.Attributes.WeaponDamage);
+
+        sword.Experience = 1_000_000;
+
+        Assert.Equal(LevelItemManager.ExpTable[^1], sword.Experience);
+        Assert.Equal(LevelItemManager.Levels, sword.Level);
+    }
+
+    [Fact]
+    public void CursedWarrior_RisesAsACursedSkeleton()
+    {
+        var at = new Point3D(5210, 1470, 0);
+        var warrior = Place(new TheCursedWarrior(), at);
+
+        Assert.False(warrior.OnBeforeDeath());
+
+        Assert.True(warrior.Deleted);
+        var skeleton = Assert.Single(FindNear<CursedSkeleton>(at));
+        Track(skeleton);
+    }
+
+    private static List<T> FindNear<T>(Point3D at) where T : Mobile
+    {
+        var found = new List<T>();
+
+        foreach (var m in Map.Felucca.GetMobilesInRange(at, 0))
+        {
+            if (m is T t)
+            {
+                found.Add(t);
+            }
+        }
+
+        return found;
+    }
+
+    [Fact]
+    public void SummoningAltar_SummonsHephaestusForEachQueuedKey()
+    {
+        var altar = Track(new CCSummoningAltar());
+        altar.MoveToWorld(CursedCaveGen.ChamberAltar, Map.Felucca);
+        altar.IsActive = true;
+
+        altar.MainQueue = 2;
+
+        var first = Assert.IsType<Hephaestus>(altar.Champion);
+        Track(first);
+        Assert.Equal(1, altar.MainQueue);
+
+        first.Delete();
+        altar.CheckSpawn();
+
+        Track(Assert.IsType<Hephaestus>(altar.Champion));
+        Assert.NotSame(first, altar.Champion);
+        Assert.Equal(0, altar.MainQueue);
+    }
+
+    [Fact]
+    public void SummoningAltar_Inactive_KeepsTheQueue()
+    {
+        var altar = Track(new CCSummoningAltar());
+        altar.MoveToWorld(CursedCaveGen.ChamberAltar, Map.Felucca);
+
+        altar.MainQueue = 3;
+
+        Assert.Null(altar.Champion);
+        Assert.Equal(3, altar.MainQueue);
+    }
+
+    [Fact]
+    public void KeywordDoor_LeadsToTheOtherSide()
+    {
+        var door = Track(
+            new CCKeywordDoor
+            {
+                Range = 3,
+                OneSideArea = new Rectangle2D(6026, 266, 54, 108),
+                PointDest1 = CursedCaveGen.Level2DoorArrival,
+                PointDest2 = CursedCaveGen.Level1DoorArrival,
+                MapDest = Map.Felucca
+            }
+        );
+        door.MoveToWorld(CursedCaveGen.Level1Door, Map.Felucca);
+
+        var player = Player(new Point3D(6067, 361, 22));
+        door.StartTeleport(player);
+
+        Assert.Equal(CursedCaveGen.Level2DoorArrival, player.Location);
+    }
+
+    [Fact]
+    public void MagicDoor_TakesTheHolderIntoTheChamber()
+    {
+        var door = Track(new CCMagicDoor { PointDest = CursedCaveGen.ChamberArrival, OneSideArea = CursedCaveGen.Chamber });
+        door.MoveToWorld(CursedCaveGen.ChamberDoor, Map.Felucca);
+
+        var player = Player(new Point3D(5155, 1493, 0));
+
+        Assert.True(door.Teleport(player));
+        Assert.Equal(CursedCaveGen.ChamberArrival, player.Location);
+        Assert.True(CursedCaveGen.Chamber.Contains(player.Location));
+    }
+
+    [Fact]
+    public void Quest_RunsSixRoundsStartingWithHellCats()
+    {
+        var first = new CursedCaveBeginObjective(0);
+
+        Assert.Equal(6, CursedCaveBeginObjective.Rounds);
+        Assert.Equal(typeof(HellCat), first.Monster);
+        Assert.Equal(4, first.MaxProgress);
+        Assert.Equal(typeof(DevaTheCursedOne), new CursedCaveBeginObjective(5).Monster);
+    }
+
+    [Fact]
+    public void Warren_CountsTheCaveRaresInAPack()
+    {
+        var player = Player(new Point3D(2545, 288, 15));
+
+        for (var i = 0; i < 12; i++)
+        {
+            player.Backpack.DropItem(new SRCRSmallWeb { Movable = true });
+        }
+
+        player.Backpack.DropItem(new Gold(100));
+
+        Assert.Equal(WarrenTheGuard.ArtifactAmount, WarrenTheGuard.FindRares(player, WarrenTheGuard.ArtifactAmount).Count);
+    }
+
+    [Fact]
+    public void Warren_RareRewardBag_HoldsGoldBandagesAndAMap()
+    {
+        var bag = Track(WarrenTheGuard.CreateRareRewardBag());
+
+        Assert.NotNull(bag.FindItemByType<Gold>());
+        Assert.NotNull(bag.FindItemByType<Bandage>());
+        Assert.NotNull(bag.FindItemByType<TreasureMap>());
+    }
+
+    [Fact]
+    public void Fixtures_PlaceAndReplaceCleanly()
+    {
+        var placed = CursedCaveGen.Place();
+
+        try
+        {
+            Assert.True(placed > 10);
+            Assert.Single(FindNear<WarrenTheGuard>(CursedCaveGen.WarrenSpot));
+        }
+        finally
+        {
+            Assert.Equal(placed, CursedCaveGen.Remove());
+        }
+    }
+
+    [Fact]
+    public void SpawnFile_EveryEntryIsAType_AndEverySpawnerIsInTheCave()
+    {
+        var dtos = JsonSerializer.Deserialize<List<SpawnerDto>>(File.ReadAllText(SpawnFile), SpawnerJsonSerializer.Options);
+
+        Assert.Equal(40, dtos.Count);
+
+        foreach (var dto in dtos)
+        {
+            Assert.True(
+                CursedCaveRegion.LevelsArea.Contains(dto.Location) || CursedCaveRegion.Level3Area.Contains(dto.Location),
+                $"{dto.Name} at {dto.Location} is outside the cave"
+            );
+
+            foreach (var entry in dto.EntryView)
+            {
+                Assert.NotNull(AssemblyHandler.FindTypeByName(entry.SpawnedName));
+            }
+        }
+    }
+}
