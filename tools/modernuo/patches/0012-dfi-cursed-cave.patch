+// DFI Network's Cursed Cave region, ported from DFI RUNUO Scripts/Custom/Engines/Quest System/CursedCave/CursedCaveRegion.cs.
+
+using Server.Network;
+using Server.Spells;
+
+namespace Server.Regions;
+
+// Levels 1 and 2 are a pair of walled halls in Felucca's dungeon area; level 3 is a separate cave.
+// Spells and the bard skills fail inside, as on DFI.
+public class CursedCaveRegion : BaseRegion
+{
+    public const string LevelsName = "Cursed Cave";
+    public const string Level3Name = "Cursed Cave Level 3";
+
+    public static readonly Rectangle2D LevelsArea = new(6026, 266, 107, 108);
+    public static readonly Rectangle2D Level3Area = new(5124, 1412, 246, 101);
+
+    public CursedCaveRegion(string name, Rectangle2D area) : base(name, Map.Felucca, DefaultPriority + 1, area)
+    {
+    }
+
+    public static void Initialize()
+    {
+        new CursedCaveRegion(LevelsName, LevelsArea).Register();
+        new CursedCaveRegion(Level3Name, Level3Area).Register();
+    }
+
+    public override bool AllowHousing(Mobile from, Point3D p) => false;
+
+    public override void OnEnter(Mobile m)
+    {
+        if (m.Target != null)
+        {
+            Targeting.Target.Cancel(m);
+            FizzleStrangely(m);
+        }
+    }
+
+    public override bool OnSkillUse(Mobile m, int skill)
+    {
+        if (skill is (int)SkillName.Peacemaking or (int)SkillName.Provocation or (int)SkillName.Discordance)
+        {
+            m.PrivateOverheadMessage(MessageType.Regular, 0x3B2, false, "You can't seem to use that skill here.", m.NetState);
+            return false;
+        }
+
+        return true;
+    }
+
+    public override bool OnBeginSpellCast(Mobile m, ISpell s)
+    {
+        if (m.Player)
+        {
+            FizzleStrangely(m);
+            return false;
+        }
+
+        return base.OnBeginSpellCast(m, s);
+    }
+
+    public override void AlterLightLevel(Mobile m, ref int global, ref int personal)
+    {
+        global = LightCycle.DungeonLevel;
+    }
+
+    public static void FizzleStrangely(Mobile m)
+    {
+        m.PrivateOverheadMessage(MessageType.Regular, 0x3B2, false, "The spell fizzles strangely.", m.NetState);
+        m.FixedParticles(0x3779, 1, 46, 9502, 5, 3, EffectLayer.Waist);
+        m.FixedEffect(0x3735, 6, 30);
+        m.PlaySound(0x5C);
+    }
+}
diff --git a/Projects/UOContent/Custom/DFI/CursedCave/CursedCaveWeapons.cs b/Projects/UOContent/Custom/DFI/CursedCave/CursedCaveWeapons.cs
