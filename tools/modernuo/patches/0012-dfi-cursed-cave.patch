--- /dev/null
+++ b/Projects/UOContent/Custom/DFI/CursedCave/CursedCaveWeapons.cs
@@ -0,0 +1,552 @@
+// The Cursed Cave's talking artifacts, ported from DFI RUNUO Scripts/Custom/Engines/Quest System/CursedCave
+// (Items/LongswordOfJustice.cs, HarvesterOfTheGhost.cs, BowOfHephaestus.cs, Items/Levelable Items).
+
+using System;
+using ModernUO.CodeGeneratedEvents;
+using ModernUO.Serialization;
+using Server.Collections;
+using Server.ContextMenus;
+using Server.Custom.Dfi;
+using Server.Gumps;
+using Server.Mobiles;
+using Server.Text;
+
+namespace Server.Items;
+
+public interface ILevelable
+{
+    int Experience { get; set; }
+    int Level { get; set; }
+    Type[] Types { get; }
+    void OnLevel(int oldLevel, int newLevel);
+    string GetHtml();
+}
+
+// Weapons that grow with the kills of the creatures they were made for: ten levels, the next one
+// 10,000 experience further on, each kill worth a tenth of the creature's stats and skills.
+public static class LevelItemManager
+{
+    public const int Levels = 10;
+
+    public static int[] ExpTable { get; } = [0, 10000, 20000, 30000, 40000, 50000, 60000, 70000, 80000, 90000];
+
+    public static int CalcExp(Mobile targ)
+    {
+        double val = targ.Hits + targ.Stam + targ.Mana;
+
+        for (var i = 0; i < targ.Skills.Length; i++)
+        {
+            val += targ.Skills[i].Base;
+        }
+
+        if (val > 700)
+        {
+            val = 700 + (val - 700) / 3.66667;
+        }
+
+        if (targ is BaseCreature bc)
+        {
+            if (bc.AI == AIType.AI_Mage && bc.Skills.Magery.Base > 5.0)
+            {
+                val += 100;
+            }
+
+            if (bc.GetMonsterAbilities()?.Length > 0)
+            {
+                val += 100;
+            }
+
+            if (bc.PoisonImmune != null)
+            {
+                val += 100;
+            }
+
+            if (bc is VampireBat or VampireBatFamiliar)
+            {
+                val += 100;
+            }
+
+            var poison = bc.HitPoison;
+            val += (poison == null ? 0 : poison.Level + 1) * 20;
+        }
+
+        return (int)(val / 10);
+    }
+
+    public static int CalculateProperty(int max, int level) => (int)(max * ((double)level / Levels));
+
+    public static void InvalidateLevel(ILevelable item)
+    {
+        for (var i = 0; i < ExpTable.Length; ++i)
+        {
+            if (item.Experience < ExpTable[i])
+            {
+                return;
+            }
+
+            item.Level = i + 1;
+        }
+    }
+
+    // DFI checked the killer's equipment on the killing blow; the creature's last killer is the same mobile.
+    [OnEvent(nameof(CreatureEvents.CreatureDeathEvent))]
+    public static void OnCreatureDeath(BaseCreature killed)
+    {
+        var killer = killed.LastKiller;
+
+        if (killer == null || killed.IsDeadBondedPet)
+        {
+            return;
+        }
+
+        for (var i = 0; i < 25; ++i)
+        {
+            if (killer.FindItemOnLayer((Layer)i) is ILevelable item)
+            {
+                CheckLevelable(item, killed);
+            }
+        }
+    }
+
+    public static void CheckLevelable(ILevelable item, Mobile killed)
+    {
+        if (item.Types == null || item.Level >= Levels || Array.IndexOf(item.Types, killed.GetType()) < 0)
+        {
+            return;
+        }
+
+        var oldLevel = item.Level;
+        item.Experience += CalcExp(killed);
+        InvalidateLevel(item);
+
+        if (item.Level != oldLevel)
+        {
+            item.OnLevel(oldLevel, item.Level);
+        }
+
+        (item as Item)?.InvalidateProperties();
+    }
+
+    public static string LevelGainList()
+    {
+        using var builder = ValueStringBuilder.Create();
+        builder.Append("<div align=center><i>LEVEL GAIN LIST</i></div>");
+
+        for (var i = 1; i < ExpTable.Length; i++)
+        {
+            builder.Append($"Level {i + 1} at {ExpTable[i]} EXP<br>");
+        }
+
+        return builder.ToString();
+    }
+
+    public static readonly Type[] CursedCaveTypes =
+    [
+        typeof(TheCursed), typeof(TheCursedArcher), typeof(TheCursedMage), typeof(TheCursedNecro),
+        typeof(CursedSkeleton), typeof(TheCursedWarrior), typeof(TheCursedGuardian), typeof(TheCursedAlchemist),
+        typeof(TheCursedBlacksmith), typeof(TheCursedButcher), typeof(TheCursedCarpenter), typeof(DevaTheCursedOne),
+        typeof(CursedSteed), typeof(Hephaestus)
+    ];
+
+    public static void AddEntries(Mobile from, Item item, ref PooledRefList<ContextMenuEntry> list)
+    {
+        if (from.Alive && (from.Items.Contains(item) || item.IsChildOf(from.Backpack)))
+        {
+            list.Add(new WeaponTalkEntry(item));
+            list.Add(new LevelInfoEntry((ILevelable)item));
+        }
+    }
+}
+
+public class LevelInfoEntry : ContextMenuEntry
+{
+    private readonly ILevelable _item;
+
+    public LevelInfoEntry(ILevelable item) : base(98, 3) => _item = item;
+
+    public override void OnClick(Mobile from, IEntity target)
+    {
+        from.SendGump(new ItemInfoGump(_item), true);
+    }
+}
+
+public class WeaponTalkEntry : ContextMenuEntry
+{
+    private readonly Item _weapon;
+
+    public WeaponTalkEntry(Item weapon) : base(6146) => _weapon = weapon;
+
+    public override void OnClick(Mobile from, IEntity target)
+    {
+        _weapon.SendLocalizedMessageTo(from, 1070722, 0x3B2, CursedCave.WeaponChatter(from));
+    }
+}
+
+public class ItemInfoGump : DynamicGump
+{
+    private readonly ILevelable _item;
+
+    public ItemInfoGump(ILevelable item) : base(50, 50) => _item = item;
+
+    public override bool Singleton => true;
+
+    protected override void BuildLayout(ref DynamicGumpBuilder builder)
+    {
+        builder.AddPage();
+        builder.AddBackground(0, 0, 273, 388, 2620);
+        builder.AddAlphaRegion(5, 7, 262, 373);
+        builder.AddLabel(45, 15, 955, "Levelable Weapon Information");
+        builder.AddLabel(20, 50, 955, "This item's attributes are level based.");
+        builder.AddLabel(20, 68, 955, "You can gain levels by fighting the");
+        builder.AddLabel(20, 86, 955, "monsters in the following list.");
+        builder.AddButton(233, 354, 4017, 4018, 0);
+        builder.AddLabel(192, 354, 955, "Close");
+
+        using var html = ValueStringBuilder.Create();
+        html.Append("<div align=center><i>MONSTER LIST</i></div>");
+
+        if (_item.Types != null)
+        {
+            foreach (var type in _item.Types)
+            {
+                html.Append($"{type.Name}<br>");
+            }
+        }
+
+        html.Append(_item.GetHtml());
+        builder.AddHtml(13, 110, 247, 235, html.AsSpan(), background: true, scrollbar: true);
+    }
+}
+
+// The shared body of the three artifacts: level, experience and their properties.
+public static class LevelableWeapon
+{
+    public static int ClampExperience(int value) => Math.Min(value, LevelItemManager.ExpTable[^1]);
+
+    public static int ClampLevel(int value) => Math.Clamp(value, 1, LevelItemManager.Levels);
+
+    public static void AddProperties(IPropertyList list, int level, int experience)
+    {
+        list.Add(1060658, $"{"Level"}\t{level}");
+        list.Add(1060659, $"{"Experience"}\t{experience}");
+    }
+}
