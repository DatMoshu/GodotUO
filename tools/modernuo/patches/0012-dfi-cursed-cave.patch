+// DFI Network's Cursed Cave, ported from DFI RUNUO Scripts/Custom/Engines/Quest System/CursedCave
+// (CursedCaveUtility.cs, CursedCaveSpeech.cs) and the helpers it borrowed from
+// DFI's core: Notoriety.GetNotorietyByLevel, Teleporter.Teleport, BoneRemains.PackSkullsAndSmallBones.
+
+using System;
+using Server.Items;
+using Server.Misc;
+using Server.Mobiles;
+using Server.Network;
+
+namespace Server.Custom.Dfi;
+
+public static class CursedCave
+{
+    // DFI's Notoriety.GetNotorietyByLevel: fame or karma for a level from -6 to 6, randomised within it.
+    public static int FameByLevel(int level)
+    {
+        level = Math.Clamp(level, -6, 6);
+        var random = Utility.Random(5000) * (level < 0 ? -1 : 1);
+        return 5000 * level + random;
+    }
+
+    // The cave's gear rolls 1 to 5 properties at 20-100% intensity, with the given luck in percent.
+    public static Item MutateItem(Item item, int percentValue) =>
+        DfiLoot.Mutate(item, Utility.RandomMinMax(1, 5), 20, 100, percentValue * 100);
+
+    public static void PackSkullsAndSmallBones(Container c, int amount)
+    {
+        if (c == null)
+        {
+            return;
+        }
+
+        for (var i = 0; i < amount; i++)
+        {
+            var bone = Utility.RandomBool()
+                ? new Item(Utility.Random(0x1AE0, 5)) { Name = "a skull" }
+                : new Item(Utility.Random(0x1B13, 10)) { Name = "bones" };
+
+            bone.Weight = 0.1;
+            c.DropItem(bone);
+        }
+    }
+
+    // DFI's Teleporter.Teleport: players only, pets follow when allowed, and the sound plays at both ends.
+    public static bool Teleport(
+        Mobile m, bool active, Point3D loc, Map destMap, bool allowPets, string teleName, int soundID = 0x228
+    )
+    {
+        if (!m.Player)
+        {
+            return false;
+        }
+
+        if (!active)
+        {
+            if (!string.IsNullOrEmpty(teleName))
+            {
+                m.SendLocalizedMessage(1042753, $"The {teleName}"); // ~1_SOMETHING~ has been temporarily disabled.
+            }
+
+            return false;
+        }
+
+        var map = destMap == null || destMap == Map.Internal ? m.Map : destMap;
+        var p = loc == Point3D.Zero ? m.Location : loc;
+        var sendEffect = !m.Hidden || m.AccessLevel == AccessLevel.Player;
+
+        if (sendEffect)
+        {
+            TeleEffect(m, soundID);
+        }
+
+        if (allowPets)
+        {
+            BaseCreature.TeleportPets(m, p, map);
+        }
+        else if (m.Followers > 0)
+        {
+            m.SendMessage("Your pets cannot follow you...");
+        }
+
+        m.MoveToWorld(p, map);
+
+        if (sendEffect)
+        {
+            TeleEffect(m, soundID);
+        }
+
+        return true;
+    }
+
+    private static void TeleEffect(Mobile m, int soundID)
+    {
+        Effects.SendLocationParticles(
+            EffectItem.Create(m.Location, m.Map, EffectItem.DefaultDuration),
+            0x3728,
+            10,
+            10,
+            2023
+        );
+        m.PlaySound(soundID);
+    }
+
+    public static void PrivateMessage(Mobile from, string message)
+    {
+        from.PrivateOverheadMessage(MessageType.Regular, 0x3B2, false, message, from.NetState);
+    }
+
+    public enum TriggerCheck
+    {
+        All,
+        None,
+        LongswordOfJustice,
+        HarvesterOfTheGhost,
+        BowOfHephaestus
+    }
+
+    public static bool HasTalkingWeapon(Mobile from, out string weaponName, TriggerCheck type)
+    {
+        weaponName = from.Weapon switch
+        {
+            HarvesterOfTheGhost when type is TriggerCheck.HarvesterOfTheGhost or TriggerCheck.All => "Harvester Of The Ghost",
+            LongswordOfJustice when type is TriggerCheck.LongswordOfJustice or TriggerCheck.All   => "Longsword Of Justice",
+            BowOfHephaestus when type is TriggerCheck.BowOfHephaestus or TriggerCheck.All         => "Bow Of Hephaestus",
+            _                                                                                    => null
+        };
+
+        return weaponName != null;
+    }
+
+    public static void WeaponSpeak(Mobile attacker, Mobile defender, string weaponName)
+    {
+        var line = defender switch
+        {
+            BaseCreature => Utility.Random(8) switch
+            {
+                0 => "I never liked these creatures!",
+                1 => "Slay all of them!",
+                2 => "Take that foul creature!",
+                3 => "I will slay you all!",
+                4 => "Die foul creature!",
+                5 => $"Lets kill them all master {attacker.Name}!",
+                6 => "Die die die!",
+                _ => $"Nice hit master {attacker.Name}!"
+            },
+            PlayerMobile => Utility.Random(4) switch
+            {
+                0 => $"My master {attacker.Name} will kill you foul human!",
+                1 => "Die human scum!",
+                2 => "Die die die!",
+                _ => $"Nice hit master {attacker.Name}!"
+            },
+            _ => "Take that!"
+        };
+
+        PrivateMessage(attacker, $"{weaponName}: {line}");
+    }
+
+    public static string WeaponChatter(Mobile from) =>
+        Utility.Random(6) switch
+        {
+            0 => $"I will serve thee well master {from.Name}.",
+            1 => $"Lets go kill something master {from.Name}!",
+            2 => $"Lets slay some cursed creatures master {from.Name}!",
+            3 => $"Nice day today master {from.Name}.",
+            4 => "Im bored.",
+            _ => "Lets go to the cursed cave."
+        };
+
+    private static InhumanSpeech _cursedSpeech;
+
+    public static InhumanSpeech Speech =>
+        _cursedSpeech ??= new InhumanSpeech
+        {
+            Hue = 472,
+            Sound = 432,
+            Flags = IHSFlags.All,
+            Keywords =
+            [
+                "meat", "gold", "kill", "killing", "slay", "sword", "axe", "spell", "magic", "spells", "swords",
+                "axes", "mace", "maces", "monster", "monsters", "food", "run", "escape", "away", "help", "dead",
+                "die", "dying", "lose", "losing", "life", "lives", "death", "ghost", "ghosts", "british",
+                "blackthorn", "guild", "guilds", "dragon", "dragons", "game", "games", "ultima", "silly", "stupid",
+                "dumb", "idiot", "idiots", "cheesy", "cheezy", "crazy", "dork", "jerk", "fool", "foolish", "ugly",
+                "insult", "scum"
+            ],
+            Responses =
+            [
+                "meat", "kill", "pound", "crush", "yum yum", "crunch", "destroy", "murder", "eat", "munch",
+                "massacre", "food", "monster", "evil", "run", "die", "lose", "dumb", "idiot", "fool", "crazy",
+                "dinner", "lunch", "breakfast", "fight", "battle", "doomed", "rip apart", "tear apart", "smash",
+                "edible?", "shred", "disembowel", "ugly", "smelly", "stupid", "hideous", "smell", "tasty", "invader",
+                "attack", "raid", "plunder", "pillage", "treasure", "loser", "lose", "scum"
+            ],
+            Syllables =
+            [
+                "skrit", "ch", "ch", "it", "ti", "it", "ti", "ak", "ek", "ik", "ok", "uk", "yk", "ka", "ke", "ki",
+                "ko", "ku", "ky", "at", "et", "it", "ot", "ut", "yt", "cha", "che", "chi", "cho", "chu", "chy",
+                "ach", "ech", "ich", "och", "uch", "ych", "att", "ett", "itt", "ott", "utt", "ytt", "tat", "tet",
+                "tit", "tot", "tut", "tyt", "tta", "tte", "tti", "tto", "ttu", "tty", "tak", "tek", "tik", "tok",
+                "tuk", "tyk", "ack", "eck", "ick", "ock", "uck", "yck", "cka", "cke", "cki", "cko", "cku", "cky",
+                "rak", "rek", "rik", "rok", "ruk", "ryk", "tcha", "tche", "tchi", "tcho", "tchu", "tchy", "rach",
+                "rech", "rich", "roch", "ruch", "rych", "rrap", "rrep", "rrip", "rrop", "rrup", "rryp", "ccka",
+                "ccke", "ccki", "ccko", "ccku", "ccky"
+            ]
+        };
+}
