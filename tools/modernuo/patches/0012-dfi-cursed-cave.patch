+// Six rounds, one creature kind each, killed inside the cave.
+public class CursedCaveBeginObjective : DfiQuestObjective
+{
+    private static readonly (Type Monster, string Name, int Amount)[] _rounds =
+    [
+        (typeof(HellCat), "Hell Cat", 4),
+        (typeof(HellHound), "Hell Hound", 4),
+        (typeof(GiantBlackWidow), "Giant Black Widow", 4),
+        (typeof(TheCursed), "A Cursed", 6),
+        (typeof(CursedSkeleton), "Cursed Warrior", 2),
+        (typeof(DevaTheCursedOne), "Deva The Cursed One", 1)
+    ];
+
+    private int _round;
+
+    public CursedCaveBeginObjective(int round) => _round = round;
+
+    public CursedCaveBeginObjective()
+    {
+    }
+
+    public static int Rounds => _rounds.Length;
+
+    public Type Monster => Current.Monster;
+
+    private (Type Monster, string Name, int Amount) Current => _rounds[Math.Min(_round, _rounds.Length - 1)];
+
+    public override string Text => "Help the guards by killing the following monster in the Cursed Cave.";
+
+    public override int MaxProgress => Current.Amount;
+
+    public override void OnComplete()
+    {
+        if (_round + 1 >= _rounds.Length)
+        {
+            System.AddObjective(new ReportBackObjective());
+        }
+        else
+        {
+            System.AddObjective(new CursedCaveBeginObjective(_round + 1));
+        }
+    }
+
+    public override void RenderProgress(ref DynamicGumpBuilder builder)
+    {
+        if (Completed)
+        {
+            base.RenderProgress(ref builder);
+            return;
+        }
+
+        builder.AddHtml(70, 260, 270, 100, Current.Name.Color(0x8CADFF));
+        builder.AddLabel(70, 280, 0x64, $"{CurProgress} / {Current.Amount}");
+    }
+
+    public override void OnKill(BaseCreature creature, Container corpse)
+    {
+        if (creature?.GetType() == Current.Monster && creature.Region is CursedCaveRegion)
+        {
+            CurProgress++;
+        }
+    }
+
+    public override void ChildDeserialize(IGenericReader reader)
+    {
+        reader.ReadEncodedInt(); // version
+        _round = reader.ReadEncodedInt();
+
+        if (CurProgress > MaxProgress)
+        {
+            CurProgress = MaxProgress - 1;
+        }
+    }
+
+    public override void ChildSerialize(IGenericWriter writer)
+    {
+        writer.WriteEncodedInt(0); // version
+        writer.WriteEncodedInt(_round);
+    }
+}
