@@ -0,0 +1,172 @@
+// Places the Cursed Cave's fixtures. DFI's live placements did not survive in any of its saves, so this
+// layout is GUO's: the entrance and Warren's post north of Minoc Mines, where DFI's hint gump put the cave;
+// walk-on passages and keyword doors between the levels; and Hephaestus' chamber sealed in level 3's
+// south-west dead end. The cave's creatures and rares come from Data/Spawns/dfi/dfi-cursed-cave.json.
+
+using System.Collections.Generic;
+using Server.Commands;
+using Server.Engines.Quests.CursedCave;
+using Server.Items;
+using Server.Logging;
+
+namespace Server.Custom.Dfi;
+
+public static class CursedCaveGen
+{
+    private static readonly ILogger logger = LogFactory.GetLogger(typeof(CursedCaveGen));
+
+    public static readonly Point3D Entrance = new(2548, 288, 15);
+    public static readonly Point3D OutsideArrival = new(2546, 288, 15);
+    public static readonly Point3D WarrenSpot = new(2543, 286, 15);
+
+    public static readonly Point3D Level1Arrival = new(6038, 280, 0);
+    public static readonly Point3D Level1Exit = new(6036, 276, 0);
+
+    public static readonly Point3D Level1Door = new(6068, 362, 22);
+    public static readonly Point3D Level1DoorArrival = new(6064, 358, 22);
+    public static readonly Point3D Level2Door = new(6090, 362, 0);
+    public static readonly Point3D Level2DoorArrival = new(6092, 358, 0);
+
+    public static readonly Point3D Level2Down = new(6118, 284, 22);
+    public static readonly Point3D Level2UpArrival = new(6114, 286, 22);
+    public static readonly Point3D Level3Arrival = new(5140, 1436, 0);
+    public static readonly Point3D Level3Up = new(5135, 1440, 0);
+
+    public static readonly Point3D ChamberDoor = new(5155, 1495, 0);
+    public static readonly Point3D ChamberArrival = new(5155, 1499, 0);
+    public static readonly Point3D ChamberAltar = new(5155, 1506, 20);
+    public static readonly Point3D ChamberExit = new(5158, 1510, 0);
+    public static readonly Point3D ChamberExitArrival = new(5155, 1491, 0);
+    public static readonly Rectangle2D Chamber = new(5150, 1496, 12, 17);
+
+    private const string DoorKeyword = "hephaestus";
+    private const string DoorQuestion = "Speak the name of the god of fire, and the door shall open.";
+
+    public static void Configure()
+    {
+        CommandSystem.Register("CursedCave", AccessLevel.Administrator, OnCommand);
+    }
+
+    [Usage("CursedCave")]
+    [Description("Places the Cursed Cave's entrance, guard, passages, doors and Hephaestus' altar, replacing any placed before.")]
+    private static void OnCommand(CommandEventArgs e)
+    {
+        var removed = Remove();
+        var placed = Place();
+        e.Mobile.SendMessage($"CursedCave: removed {removed} fixtures, placed {placed}.");
+        logger.Information("{User} placed {Placed} Cursed Cave fixtures ({Removed} removed)", e.Mobile, placed, removed);
+    }
+
+    private static bool IsFixture(Item item) =>
+        item is CursedCavePassage or CCKeywordDoor or CCMagicDoor or CCTrigger or CCSummoningAltar or CursedCaveTeleporter ||
+        item is Blocker && item.Map == Map.Felucca && Chamber.Contains(new Point2D(item.X, item.Y + 1));
+
+    public static int Remove()
+    {
+        var doomed = new List<IEntity>();
+
+        foreach (var item in World.Items.Values)
+        {
+            if (IsFixture(item))
+            {
+                doomed.Add(item);
+            }
+        }
+
+        foreach (var m in World.Mobiles.Values)
+        {
+            if (m is WarrenTheGuard)
+            {
+                doomed.Add(m);
+            }
+        }
+
+        foreach (var entity in doomed)
+        {
+            entity.Delete();
+        }
+
+        return doomed.Count;
+    }
+
+    public static int Place()
+    {
+        var map = Map.Felucca;
+        var placed = 0;
+
+        void Put(Item item, Point3D at)
+        {
+            item.MoveToWorld(at, map);
+            placed++;
+
+            if (!map.CanFit(at.X, at.Y, at.Z, 16, true, false) && item is not (Blocker or CCMagicDoor or CCKeywordDoor or CCSummoningAltar))
+            {
+                logger.Warning("Cursed Cave fixture {Item} at {Location} does not fit there", item.GetType().Name, at);
+            }
+        }
+
+        var warren = new WarrenTheGuard();
+        warren.MoveToWorld(WarrenSpot, map);
+        warren.Home = WarrenSpot;
+        placed++;
+
+        Put(new CursedCavePassage(Level1Arrival) { Visible = true, ItemID = 0xDDA, Hue = 0x455, Name = "the Cursed Cave" }, Entrance);
+        Put(new CursedCavePassage(OutsideArrival), Level1Exit);
+
+        Put(Door(new Rectangle2D(6026, 266, 54, 108), Level2DoorArrival, Level1DoorArrival), Level1Door);
+        Put(Door(new Rectangle2D(6026, 266, 54, 108), Level2DoorArrival, Level1DoorArrival), Level2Door);
+
+        Put(new CursedCavePassage(Level3Arrival), Level2Down);
+        Put(new CursedCavePassage(Level2UpArrival), Level3Up);
+
+        var altar = new CCSummoningAltar();
+        Put(altar, ChamberAltar);
+        altar.IsActive = true;
+
+        Put(
+            new CCMagicDoor { PointDest = ChamberArrival, OneSideArea = Chamber, Altar = altar },
+            ChamberDoor
+        );
+
+        for (var x = Chamber.X + 1; x <= Chamber.X + 9; x++)
+        {
+            if (x != ChamberDoor.X)
+            {
+                Put(new Blocker(), new Point3D(x, ChamberDoor.Y, ChamberDoor.Z));
+            }
+        }
+
+        Put(new CursedCavePassage(ChamberExitArrival), ChamberExit);
+
+        Put(
+            new CCTrigger
+            {
+                Message = "You hear screams and strange noises from deep within the cave.",
+                TriggerCheck = CursedCave.TriggerCheck.None
+            },
+            Level1Arrival
+        );
+
+        Put(
+            new CCTrigger { Message = "The god of fire waits behind this door!", TriggerCheck = CursedCave.TriggerCheck.All },
+            new Point3D(ChamberDoor.X, ChamberDoor.Y - 3, ChamberDoor.Z)
+        );
+
+        return placed;
+    }
+
+    private static CCKeywordDoor Door(Rectangle2D level1, Point3D toLevel2, Point3D toLevel1) =>
+        new()
+        {
+            Substring = DoorKeyword,
+            Range = 3,
+            Question = DoorQuestion,
+            OneSideArea = level1,
+            PointDest1 = toLevel2,
+            PointDest2 = toLevel1,
+            MapDest = Map.Felucca,
+            SourceEffect = true,
+            DestEffect = true,
+            SoundID = 0x228
+        };
+}
