+public class GuoTalkDummy : BaseCreature
+{
+    [Constructible]
+    public GuoTalkDummy() : base(AIType.AI_Animal, FightMode.None)
+    {
+        Name = "GUO Talk Dummy";
+        Title = "the listener";
+        Body = 0x190;
+        Hue = Race.Human.RandomSkinHue();
+        CantWalk = true;
+        InitStats(50, 50, 25);
+        SetHits(100);
+        AddItem(new FancyShirt());
+        AddItem(new LongPants());
+        AddItem(new Boots());
+    }
+
+    public GuoTalkDummy(Serial serial) : base(serial)
+    {
+    }
+
+    public override bool ClickTitle => false;
+    public override bool HandlesOnSpeech(Mobile from) => from != null && from.InRange(this, 4);
+
+    public override void OnSpeech(SpeechEventArgs e)
+    {
+        if (e.Mobile == null || e.Mobile == this)
+        {
+            return;
+        }
+
+        Say("GUO_PAD: talk-dummy heard you");
+        e.Mobile.SendMessage("GUO_PAD: talk-dummy heard you");
+        e.Handled = true;
+    }
+
+    public override void Serialize(IGenericWriter writer)
+    {
+        base.Serialize(writer);
+        writer.Write(0);
+    }
+
+    public override void Deserialize(IGenericReader reader)
+    {
+        base.Deserialize(reader);
+        reader.ReadInt();
+    }
+}
