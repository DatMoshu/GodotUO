+public class GuoContextDummy : BaseCreature
+{
+    [Constructible]
+    public GuoContextDummy() : base(AIType.AI_Animal, FightMode.None)
+    {
+        Name = "GUO Context Dummy";
+        Body = 0x190;
+        Hue = 0x845;
+        CantWalk = true;
+        InitStats(50, 50, 25);
+        SetHits(100);
+        AddItem(new Robe(0x455));
+    }
+
+    public GuoContextDummy(Serial serial) : base(serial)
+    {
+    }
+
+    public override bool ClickTitle => false;
+
+    public override void AddCustomContextEntries(Mobile from, ref PooledRefList<ContextMenuEntry> list)
+    {
+        if (from.Alive && from.InRange(this, 3))
+        {
+            list.Add(new GuoPadContextEntry(this));
+        }
+
+        base.AddCustomContextEntries(from, ref list);
+    }
+
+    public override void Serialize(IGenericWriter writer)
+    {
+        base.Serialize(writer);
+        writer.Write(0);
+    }
+
+    public override void Deserialize(IGenericReader reader)
+    {
+        base.Deserialize(reader);
+        reader.ReadInt();
+    }
+
+    private class GuoPadContextEntry : ContextMenuEntry
+    {
+        private readonly GuoContextDummy _dummy;
+
+        public GuoPadContextEntry(GuoContextDummy dummy) : base(3000482, 3) // "Open" cliloc as a stand-in label
+        {
+            _dummy = dummy;
+        }
+
+        public override void OnClick(Mobile from, IEntity target)
+        {
+            from.SendMessage("GUO_PAD: context-dummy picked");
+            _dummy.PublicOverheadMessage(MessageType.Regular, 0x3B2, false, "GUO_PAD: context-dummy picked");
+        }
+    }
+}
