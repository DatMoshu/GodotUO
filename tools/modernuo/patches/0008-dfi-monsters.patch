+using System;
+using Server.Collections;
+using Server.Mobiles;
+
+namespace Server.Custom.Dfi;
+
+public static class DfiMonsterHelpers
+{
+    // DFI's shared life drain: hits players, pets, summons and creatures of another team within range,
+    // and heals the drainer by what it takes.
+    public static void DrainLife(
+        BaseCreature drainer, int range, Func<int> amount, string message = "You feel the life drain out of you!"
+    )
+    {
+        using var list = PooledRefList<Mobile>.Create();
+
+        foreach (var m in drainer.GetMobilesInRange(range))
+        {
+            if (m == drainer || !drainer.CanBeHarmful(m))
+            {
+                continue;
+            }
+
+            if (m is BaseCreature bc && (bc.Controlled || bc.Summoned || bc.Team != drainer.Team) || m.Player)
+            {
+                list.Add(m);
+            }
+        }
+
+        for (var i = 0; i < list.Count; i++)
+        {
+            var m = list[i];
+            drainer.DoHarmful(m);
+
+            m.FixedParticles(0x374A, 10, 15, 5013, 0x496, 0, EffectLayer.Waist);
+            m.PlaySound(0x231);
+            m.SendMessage(message);
+
+            var toDrain = amount();
+            drainer.Hits += toDrain;
+            m.Damage(toDrain, drainer);
+        }
+    }
+}
