+    private void TeleportTick()
+    {
+        var map = Map;
+
+        if (map == null || Utility.RandomDouble() > 0.33)
+        {
+            return;
+        }
+
+        Mobile toTeleport = null;
+
+        foreach (var m in GetMobilesInRange(16))
+        {
+            if (m != this && m.Player && CanBeHarmful(m) && CanSee(m))
+            {
+                toTeleport = m;
+                break;
+            }
+        }
+
+        if (toTeleport == null)
+        {
+            return;
+        }
+
+        var offset = Utility.Random(8) * 2;
+        var to = Location;
+
+        for (var i = 0; i < _offsets.Length; i += 2)
+        {
+            var x = X + _offsets[(offset + i) % _offsets.Length];
+            var y = Y + _offsets[(offset + i + 1) % _offsets.Length];
+
+            if (map.CanSpawnMobile(x, y, Z))
+            {
+                to = new Point3D(x, y, Z);
+                break;
+            }
+
+            var z = map.GetAverageZ(x, y);
+
+            if (map.CanSpawnMobile(x, y, z))
+            {
+                to = new Point3D(x, y, z);
+                break;
+            }
+        }
+
+        var from = toTeleport.Location;
+        toTeleport.Location = to;
+
+        SpellHelper.Turn(this, toTeleport);
+        SpellHelper.Turn(toTeleport, this);
+
+        toTeleport.ProcessDelta();
+
+        Effects.SendLocationParticles(EffectItem.Create(from, toTeleport.Map, EffectItem.DefaultDuration), 0x3728, 10, 10, 2023);
+        Effects.SendLocationParticles(EffectItem.Create(to, toTeleport.Map, EffectItem.DefaultDuration), 0x3728, 10, 10, 5023);
+
+        toTeleport.PlaySound(0x1FE);
+        Combatant = toTeleport;
+    }
+
+    public override void OnAfterDelete()
+    {
+        _teleportToken.Cancel();
+        base.OnAfterDelete();
+    }
