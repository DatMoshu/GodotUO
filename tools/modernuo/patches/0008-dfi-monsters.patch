+    {
+        base.OnCombatantChange();
+
+        if (Hidden && Combatant != null)
+        {
+            Combatant = null;
+        }
+    }
+
+    private void SendTrackingSound()
+    {
+        if (Hidden)
+        {
+            Effects.PlaySound(Location, Map, 0x12C);
+            Combatant = null;
+        }
+        else
+        {
+            Frozen = false;
+            _soundTimerToken.Cancel();
+        }
+    }
+
+    public override void OnThink()
+    {
+        foreach (var mob in GetMobilesInRange(5))
+        {
+            if (mob is PlayerMobile && mob.AccessLevel == AccessLevel.Player)
+            {
+                mob.Hidden = false;
+            }
+        }
+
+        if (!_hasTeleportedAway && Hits < HitsMax / 2 && !Poisoned)
+        {
+            TeleportAway();
+        }
+
+        if (Hits < HitsMax - 10 && !_bandaging)
+        {
+            TryToHeal();
+        }
+
+        base.OnThink();
+    }
+
+    private void TeleportAway()
+    {
+        var map = Map;
+
+        if (map == null)
+        {
+            return;
+        }
+
+        for (var i = 0; i < 10; ++i)
+        {
+            var x = X + Utility.RandomMinMax(5, 10) * (Utility.RandomBool() ? 1 : -1);
+            var y = Y + Utility.RandomMinMax(5, 10) * (Utility.RandomBool() ? 1 : -1);
+
+            if (!map.CanFit(x, y, Z, 16, false, false))
+            {
+                continue;
+            }
+
+            var from = Location;
+            var to = new Point3D(x, y, Z);
+
+            Location = to;
+            ProcessDelta();
+            Hidden = true;
+            Combatant = null;
+
+            Effects.SendLocationParticles(EffectItem.Create(from, map, EffectItem.DefaultDuration), 0x3728, 10, 10, 2023);
+            Effects.SendLocationParticles(EffectItem.Create(to, map, EffectItem.DefaultDuration), 0x3728, 10, 10, 5023);
+            Effects.PlaySound(to, map, 0x1FE);
+
+            _hasTeleportedAway = true;
+            _soundTimerToken.Cancel();
+            Timer.StartTimer(TimeSpan.FromSeconds(5.0), TimeSpan.FromSeconds(2.5), SendTrackingSound, out _soundTimerToken);
+
+            UseSkill(SkillName.Stealth);
+
+            if (AIObject != null)
+            {
+                AIObject.Action = ActionType.Flee;
+            }
+
+            break;
+        }
+    }
+
+    public override void OnMovement(Mobile m, Point3D oldLocation)
+    {
+        base.OnMovement(m, oldLocation);
+
+        if (m.Alive && m is PlayerMobile && InRange(m, 4) && !InRange(oldLocation, 4) && Hits == HitsMax &&
+            Hidden && IsEnemy(m))
+        {
+            Frozen = false;
+            Hidden = false;
+            Combatant = m;
+        }
+    }
+
+    public override void OnDamage(int amount, Mobile from, bool willKill)
+    {
+        if (Hits < HitsMax - 10 && !_bandaging && Hidden)
+        {
+            TryToHeal();
+        }
+
+        base.OnDamage(amount, from, willKill);
+    }
+
+    private void TryToHeal()
+    {
+        _bandaging = true;
+
+        if (Backpack?.FindItemByType<Bandage>() is { } bandage && BandageContext.BeginHeal(this, this) != null)
+        {
+            bandage.Consume();
+        }
+
+        Timer.StartTimer(TimeSpan.FromSeconds(15), () => _bandaging = false);
+    }
+
+    public override void OnAfterDelete()
+    {
+        _soundTimerToken.Cancel();
+        base.OnAfterDelete();
+    }
+}
+
+internal static class OrcMask
+{
+    public static void Punish(Mobile aggressor)
+    {
+        if (aggressor.FindItemOnLayer(Layer.Helm) is not OrcishKinMask mask)
+        {
+            return;
+        }
+
+        AOS.Damage(aggressor, 50, 0, 100, 0, 0, 0);
+        mask.Delete();
+        aggressor.FixedParticles(0x36BD, 20, 10, 5044, EffectLayer.Head);
+        aggressor.PlaySound(0x307);
+    }
+}
diff --git a/Projects/UOContent/Custom/DFI/Mobiles/QuestMobile.cs b/Projects/UOContent/Custom/DFI/Mobiles/QuestMobile.cs
new file mode 100644
index 000000000..430269685
--- /dev/null
+++ b/Projects/UOContent/Custom/DFI/Mobiles/QuestMobile.cs
@@ -0,0 +1,500 @@
+// DFI Network event boss, ported from DFI RunUO Scripts/Custom/Engines/Quest System/QuestMobile.cs.
+// A GM spawns it, names and dresses it, and sets its abilities in [props. With GiveRewardBag on, every
+// player with looting rights receives a "Reward bag for slaying <name>" when it dies.
+
+using System;
+using ModernUO.Serialization;
+using Server.Collections;
+using Server.Custom.Dfi;
+using Server.Items;
+
+namespace Server.Mobiles;
+
+[SerializationGenerator(0)]
+public partial class QuestMobile : BaseCreature
+{
+    [SerializableField(0)]
+    [SerializedCommandProperty(AccessLevel.Seer)]
+    private bool _useGoldSpawn;
+
+    [SerializableField(1)]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private bool _giveRewardBag;
+
+    [SerializableField(2)]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private int _lifeDrainChance;
+
+    // Pull, fireball and lightning are off below 10 seconds; dispel never fires faster than every 5.
+    [SerializableField(3)]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private TimeSpan _delayPull;
+
+    [SerializableField(4)]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private TimeSpan _delayDispel;
+
+    [SerializableField(5)]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private TimeSpan _delayFireBall;
+
+    [SerializableField(6)]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private TimeSpan _delayLightning;
+
+    [SerializableField(7)]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private bool _spawnsCreatures;
+
+    [SerializableField(8)]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private string _spawnTypeOne;
+
+    [SerializableField(9)]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private string _spawnTypeTwo;
+
+    [SerializableField(10)]
+    [SerializedCommandProperty(AccessLevel.GameMaster)]
+    private string _spawnTypeThree;
+
+    private DateTime _lastPull;
+    private DateTime _lastFireBall;
+    private DateTime _lastLightning;
+    private DateTime _lastDispel;
+
+    [Constructible]
+    public QuestMobile() : base(AIType.AI_Mage)
+    {
+        Body = 0x190;
+        SetSpeed(0.05, 0.1);
+
+        SetStr(500);
+        SetDex(500);
+        SetInt(500);
+
+        SetHits(40000);
+
+        SetDamage(20, 30);
+        SetDamageType(ResistanceType.Physical, 100);
+
+        SetResistance(ResistanceType.Physical, 65);
+        SetResistance(ResistanceType.Fire, 65);
+        SetResistance(ResistanceType.Cold, 65);
+        SetResistance(ResistanceType.Poison, 65);
+        SetResistance(ResistanceType.Energy, 65);
+
+        for (var i = 0; i < Skills.Length; ++i)
+        {
+            Skills[i].Base = 140.0;
+        }
+
+        Fame = 24000;
+        Karma = -24000;
+    }
+
+    public override string DefaultName => "blank quest creature";
+    public override bool AlwaysMurderer => true;
+    public override bool BardImmune => true;
+    public override Poison PoisonImmune => Poison.Deadly;
+    public override bool ShowFameTitle => false;
+    public override bool ClickTitle => false;
+
+    public override void AlterMeleeDamageTo(Mobile to, ref int damage)
+    {
+        if (to is BaseCreature { Controlled: true } or BaseCreature { Summoned: true })
+        {
+            damage *= 3;
+        }
+    }
+
+    public override void GenerateLoot()
+    {
+        AddLoot(LootPack.SuperBoss, 2);
+        AddLoot(LootPack.HighScrolls, Utility.RandomMinMax(5, 10));
+    }
+
+    public Container GetNewContainer() => new Bag { Hue = 3, Name = $"Reward bag for slaying {Name}" };
+
+    public override void OnDamage(int amount, Mobile from, bool willKill)
+    {
+        if (_lifeDrainChance != 0 && _lifeDrainChance * 0.01 > Utility.RandomDouble())
+        {
+            DrainLife();
+        }
+
+        if (_spawnsCreatures && Map != null && from != null)
+        {
+            TrySpawnFollower(_spawnTypeOne, 0.10, from);
+            TrySpawnFollower(_spawnTypeTwo, 0.30, from);
+            TrySpawnFollower(_spawnTypeThree, 0.50, from);
+        }
+
+        base.OnDamage(amount, from, willKill);
+    }
+
+    private void TrySpawnFollower(string typeName, double chance, Mobile from)
+    {
+        if (typeName == null || Utility.RandomDouble() >= chance)
+        {
+            return;
+        }
+
+        var type = AssemblyHandler.FindTypeByName(typeName);
+
+        if (type?.IsSubclassOf(typeof(BaseCreature)) != true || type.CreateInstance<BaseCreature>() is not { } bc)
+        {
+            return;
+        }
+
+        bc.MoveToWorld(GetSpawnLocation(from), Map);
+        bc.RangeHome = 5;
+        bc.Home = Location;
+        bc.Combatant = from;
+    }
+
+    public Point3D GetSpawnLocation(Mobile m)
+    {
+        if (m != null && Utility.RandomDouble() < 0.3 && m.Location != Point3D.Zero && m.Map != Map.Internal)
+        {
+            return m.Location;
+        }
+
+        for (var i = 0; i < 10; i++)
+        {
+            var x = X + Utility.RandomMinMax(-5, 5);
+            var y = Y + Utility.RandomMinMax(-5, 5);
+            var z = Map.GetAverageZ(x, y);
+
+            if (Map.CanSpawnMobile(new Point2D(x, y), Z))
+            {
+                return new Point3D(x, y, Z);
+            }
+
+            if (Map.CanSpawnMobile(new Point2D(x, y), z))
+            {
+                return new Point3D(x, y, z);
+            }
+        }
+
+        return Location;
+    }
+
+    public void GiveReward()
+    {
+        var rights = GetLootingRights(DamageEntries, HitsMax);
+
+        for (var i = 0; i < rights.Count; ++i)
+        {
+            if (!rights[i].m_HasRight)
+            {
+                continue;
+            }
+
+            var m = rights[i].m_Mobile;
+
+            m.SendMessage($"You have been rewarded for your help in the battle against {Name}.");
+
+            var cont = GetNewContainer();
+            DfiLoot.AddRandomLoot(cont, 5, 360, 4, 5, 50, 100);
+            DfiLoot.AddRandomLoot(cont, 1, 360, 5, 5, 70, 100);
+
+            if (Utility.RandomDouble() < 0.50)
+            {
+                cont.DropItem(new MessageInABottle(Map.Felucca));
+            }
+
+            if (Utility.RandomDouble() < 0.20)
+            {
+                cont.DropItem(new MessageInABottle(Map.Felucca, 4));
+            }
+
+            if (Utility.RandomDouble() < 0.50)
+            {
+                cont.DropItem(new TreasureMap(5, Map.Felucca));
+            }
+
+            if (Utility.RandomDouble() < 0.25)
+            {
+                cont.DropItem(new TreasureMap(6, Map.Felucca));
+            }
+
+            cont.DropItem(new BankCheck(5000));
+            m.PlaceInBackpack(cont);
+        }
+    }
+
+    public override bool OnBeforeDeath()
+    {
+        if (_giveRewardBag)
+        {
+            GiveReward();
+        }
+
+        if (_useGoldSpawn && Map != null)
+        {
+            for (var x = -12; x <= 12; ++x)
+            {
+                for (var y = -12; y <= 12; ++y)
+                {
+                    if (Math.Sqrt(x * x + y * y) <= 12)
+                    {
+                        var map = Map;
+                        var px = X + x;
+                        var py = Y + y;
+                        Timer.StartTimer(TimeSpan.FromSeconds(Utility.RandomDouble() * 10.0), () => DropGold(map, px, py));
+                    }
+                }
+            }
+        }
+
+        return base.OnBeforeDeath();
+    }
+
+    public override void OnThink()
+    {
+        base.OnThink();
+
+        var now = Core.Now;
+        var dispel = _delayDispel < TimeSpan.FromSeconds(5.0) ? TimeSpan.FromSeconds(5.0) : _delayDispel;
+
+        if (_delayDispel != TimeSpan.Zero && now > _lastDispel + dispel)
+        {
+            Dispel();
+            _lastDispel = now;
+        }
+
+        if (IsActive(_delayFireBall) && Utility.RandomBool() && now > _lastFireBall + _delayFireBall)
+        {
+            FireBall();
+            _lastFireBall = now;
+        }
+
+        if (IsActive(_delayLightning) && Utility.RandomBool() && now > _lastLightning + _delayLightning)
+        {
+            Lightning();
+            _lastLightning = now;
+        }
+
+        if (IsActive(_delayPull) && Utility.RandomBool() && now > _lastPull + _delayPull)
+        {
+            Pull();
+            _lastPull = now;
+        }
+    }
+
+    private static bool IsActive(TimeSpan delay) => delay >= TimeSpan.FromSeconds(10.0);
+
+    private bool IsHostileTarget(Mobile m) =>
+        m != this && CanBeHarmful(m) && CanSee(m) && (m.Player || m is BaseCreature { Controlled: true });
+
+    public void DrainLife()
+    {
+        using var list = PooledRefList<Mobile>.Create();
+
+        foreach (var m in GetMobilesInRange(2))
+        {
+            if (m == this || !CanBeHarmful(m) || !m.Alive || m.Hidden)
+            {
+                continue;
+            }
+
+            if (m is BaseCreature bc && (bc.Controlled || bc.Summoned || bc.Team != Team) || m.Player)
+            {
+                list.Add(m);
+            }
+        }
+
+        for (var i = 0; i < list.Count; i++)
+        {
+            var m = list[i];
+            DoHarmful(m);
+
+            m.FixedParticles(0x374A, 10, 15, 5013, 0x496, 0, EffectLayer.Waist);
+            m.PlaySound(0x231);
+            m.SendMessage("You feel the life drain out of you!");
+
+            var toDrain = Utility.RandomMinMax((int)(m.HitsMax * 0.1), (int)(m.HitsMax * 0.5));
+
+            Hits += toDrain;
+            m.Damage(toDrain, this);
+        }
+    }
+
+    private void FireBall()
+    {
+        using var targets = PooledRefList<Mobile>.Create();
+
+        foreach (var m in GetMobilesInRange(16))
+        {
+            if (IsHostileTarget(m))
+            {
+                targets.Add(m);
+            }
+        }
+
+        for (var i = 0; i < targets.Count; i++)
+        {
+            var m = targets[i];
+            AOS.Damage(m, this, 80, 0, 100, 0, 0, 0);
+            MovingParticles(m, 0x36D4, 7, 0, false, true, 9502, 4019, 0x160);
+            PlaySound(0x15E);
+            m.SendMessage("Your body is scorched by a massive fireball.");
+        }
+    }
+
+    private void Dispel()
+    {
+        using var targets = PooledRefList<Mobile>.Create();
+
+        foreach (var m in GetMobilesInRange(8))
+        {
+            if (m != this && m is BaseCreature { Summoned: true })
+            {
+                targets.Add(m);
+            }
+        }
+
+        if (targets.Count == 0)
+        {
+            return;
+        }
+
+        PlaySound(0x299);
+        FixedParticles(0x37C4, 1, 25, 9922, 14, 3, EffectLayer.Head);
+
+        for (var i = 0; i < targets.Count; i++)
+        {
+            var m = targets[i];
+            Effects.SendLocationParticles(
+                EffectItem.Create(m.Location, m.Map, EffectItem.DefaultDuration),
+                0x3728,
+                8,
+                20,
+                5042
+            );
+            Effects.PlaySound(m, 0x201);
+            m.Delete();
+        }
+    }
+
+    private void Lightning()
+    {
+        using var targets = PooledRefList<Mobile>.Create();
+
+        foreach (var m in GetMobilesInRange(16))
+        {
+            if (IsHostileTarget(m))
+            {
+                targets.Add(m);
+            }
+        }
+
+        for (var i = 0; i < targets.Count; i++)
+        {
+            var m = targets[i];
+            m.BoltEffect(0);
+            AOS.Damage(m, this, 100, 0, 0, 0, 100, 0);
+            m.SendMessage("A huge lightning bolt strikes your body.");
+        }
+    }
+
+    private void Pull()
+    {
+        Mobile toPull = null;
+
+        foreach (var m in GetMobilesInRange(16))
+        {
+            if (m != this && m.Player && CanBeHarmful(m) && m.Alive && !m.Hidden)
+            {
+                toPull = m;
+                break;
+            }
+        }
+
+        if (toPull == null)
+        {
+            return;
+        }
+
+        Effects.SendLocationParticles(EffectItem.Create(Location, Map, EffectItem.DefaultDuration), 0x3728, 10, 10, 2023);
+        Effects.SendLocationParticles(
+            EffectItem.Create(toPull.Location, Map, EffectItem.DefaultDuration),
+            0x3728,
+            10,
+            10,
+            5023
+        );
+        toPull.PlaySound(0x1FE);
+        toPull.MoveToWorld(Location, Map);
+        Combatant = toPull;
+    }
+
+    private static void DropGold(Map map, int x, int y)
+    {
+        var z = map.GetAverageZ(x, y);
+        var canFit = map.CanFit(x, y, z, 6, false, false);
+
+        for (var i = -3; !canFit && i <= 3; ++i)
+        {
+            canFit = map.CanFit(x, y, z + i, 6, false, false);
+
+            if (canFit)
+            {
+                z += i;
+            }
+        }
+
+        if (!canFit)
+        {
+            return;
+        }
+
+        var g = new Gold(300, 500);
+        g.MoveToWorld(new Point3D(x, y, z), map);
+
+        if (Utility.RandomDouble() > 0.5)
+        {
+            return;
+        }
+
+        switch (Utility.Random(3))
+        {
+            case 0: // Fire column
+                {
+                    Effects.SendLocationParticles(
+                        EffectItem.Create(g.Location, g.Map, EffectItem.DefaultDuration),
+                        0x3709,
+                        10,
+                        30,
+                        5052
+                    );
+                    Effects.PlaySound(g, 0x208);
+                    break;
+                }
+            case 1: // Explosion
+                {
+                    Effects.SendLocationParticles(
+                        EffectItem.Create(g.Location, g.Map, EffectItem.DefaultDuration),
+                        0x36BD,
+                        20,
+                        10,
+                        5044
+                    );
+                    Effects.PlaySound(g, 0x307);
+                    break;
+                }
+            case 2: // Ball of fire
+                {
+                    Effects.SendLocationParticles(
+                        EffectItem.Create(g.Location, g.Map, EffectItem.DefaultDuration),
+                        0x36FE,
+                        10,
+                        10,
+                        5052
+                    );
+                    break;
+                }
+        }
+    }
+}
