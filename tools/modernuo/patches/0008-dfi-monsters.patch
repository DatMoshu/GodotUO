+// DFI Network vampires, ported from DFI RunUO Scripts/Custom/Mobiles/Monsters/Humanoid/Vampires and
+// Stealth/MindlessZombie.cs. A vampire shows its true form (body 317) in combat, turns into a wisp
+// (body 165) and stealths away when nearly dead, curses its weapon when hit, and raises a player it
+// kills as a mindless zombie with that player's skills.
+
+using System;
+using ModernUO.Serialization;
+using Server.Items;
+using Server.Spells.Necromancy;
+
+namespace Server.Mobiles;
+
+[SerializationGenerator(0)]
+public abstract partial class BaseVampire : BaseCreature
+{
+    private const int WispBody = 165;
+    private const int TrueFormBody = 317;
+
+    public BaseVampire(AIType ai) : base(ai)
+    {
+        SetSpeed(0.2, 0.4);
+    }
+
+    public override bool AlwaysMurderer => true;
+    public override bool ShowFameTitle => false;
+    public override bool ClickTitle => false;
+    public override double WeaponAbilityChance => 0.5;
+
+    // DFI's vampires used its AI_Stealth; ModernUO's mage AI already casts necromancy for the necro.
+    protected override BaseAI ForcedAI => AI == AIType.AI_Mage ? null : new StealthAI(this);
+
+    protected void DressAsVampire()
+    {
+        if (Female = Utility.RandomBool())
+        {
+            Body = 0x191;
+            Name = NameList.RandomName("female");
+        }
+        else
+        {
+            Body = 0x190;
+            Name = NameList.RandomName("male");
+        }
+
+        Hue = 1150;
+        BaseSoundID = 0x4B0;
+
+        AddItem(new LeatherChest());
+        AddItem(new LeatherLegs());
+        AddItem(new LeatherArms());
+        AddItem(new LeatherCap());
+        AddItem(new LeatherGloves());
+        AddItem(new LeatherGorget());
+
+        HairItemID = Utility.RandomList(0x203B, 0x2049, 0x2048, 0x204A);
+        HairHue = Utility.RandomNondyedHue();
+    }
+
+    protected void ArmLeeching(BaseWeapon weapon, bool shield, Poison poison = null)
+    {
+        weapon.Movable = false;
+        weapon.WeaponAttributes.HitLeechHits = 100;
+
+        if (poison != null)
+        {
+            weapon.Poison = poison;
+            weapon.PoisonCharges = 200;
+        }
+
+        AddItem(weapon);
+
+        if (shield)
+        {
+            AddItem(new WoodenKiteShield());
+        }
+    }
+
+    public void ConvertFromWisp()
+    {
+        SetSkill(SkillName.Hiding, 0);
+        SetSkill(SkillName.Stealth, 0);
+        SetSkill(SkillName.SpiritSpeak, 100);
+    }
+
+    public override WeaponAbility GetWeaponAbility()
+    {
+        if (Weapon is BaseWeapon wep)
+        {
+            return Utility.RandomBool() ? wep.PrimaryAbility : wep.SecondaryAbility;
+        }
+
+        return base.GetWeaponAbility();
+    }
+
+    public override void OnGaveMeleeAttack(Mobile defender, int damage)
+    {
+        base.OnGaveMeleeAttack(defender, damage);
+
+        if (defender.Alive || defender is not PlayerMobile || defender.Corpse is not Corpse corpse)
+        {
+            return;
+        }
+
+        var p = corpse.GetWorldLocation();
+        var map = corpse.Map;
+
+        if (map == null)
+        {
+            return;
+        }
+
+        Say("Rise! Rise my servant!");
+        Effects.PlaySound(p, map, 0x1FB);
+        Effects.SendLocationParticles(
+            EffectItem.Create(p, map, EffectItem.DefaultDuration),
+            0x3789,
+            1,
+            40,
+            0x3F,
+            3,
+            9907,
+            0
+        );
+        Timer.StartTimer(TimeSpan.FromSeconds(2.0), () => SpawnZombie(defender));
+    }
+
+    private void SpawnZombie(Mobile target)
+    {
+        var map = Map;
+
+        if (map == null || Deleted || target.Corpse is not Corpse corpse || corpse.Deleted)
+        {
+            return;
+        }
+
+        var zombie = new MindlessZombie
+        {
+            Name = target.Name,
+            Body = target.Body
+        };
+
+        var targMage = target.Skills.Magery.Value;
+        var targNecro = target.Skills.Necromancy.Value;
+
+        if (targMage > 40 || targNecro > 40)
+        {
+            zombie.AI = AIType.AI_Mage;
+        }
+
+        zombie.SetSkill(SkillName.Anatomy, target.Skills.Anatomy.Value);
+        zombie.SetSkill(SkillName.Stealth, target.Skills.Stealth.Value);
+        zombie.SetSkill(SkillName.Hiding, target.Skills.Hiding.Value);
+        zombie.SetSkill(SkillName.Meditation, target.Skills.Meditation.Value);
+        zombie.SetSkill(SkillName.Magery, targMage);
+        zombie.SetSkill(SkillName.EvalInt, target.Skills.EvalInt.Value);
+        zombie.SetSkill(SkillName.Necromancy, targNecro);
+        zombie.SetSkill(SkillName.SpiritSpeak, target.Skills.SpiritSpeak.Value);
+
+        zombie.RawStr = target.RawStr;
+        zombie.RawDex = target.RawDex;
+        zombie.RawInt = target.RawInt;
+        zombie.SetHits(target.HitsMax);
+        zombie.Team = Team;
+
+        corpse.SendRemovePacket();
+        corpse.ItemID = Utility.Random(0xECA, 9); // bone graphic
+        corpse.Hue = 0;
+
+        var loc = corpse.GetWorldLocation();
+        zombie.MoveToWorld(loc, map);
+        zombie.Home = loc;
+    }
+
+    public override void OnCombatantChange()
+    {
+        base.OnCombatantChange();
+
+        if (Combatant != null && !Mounted)
+        {
+            if (Body == WispBody)
+            {
+                ConvertFromWisp();
+            }
+
+            Body = TrueFormBody;
+            ActiveSpeed = 0.1;
+        }
+        else
+        {
+            Body = Female ? 401 : 400;
+            ActiveSpeed = 0.2;
+        }
+    }
+
+    public override void OnDamage(int amount, Mobile from, bool willKill)
+    {
+        if (Hits - amount < 30 && !willKill && !Mounted)
+        {
+            if (AIObject != null)
+            {
+                AIObject.Action = ActionType.Flee;
+            }
+
+            Combatant = null;
+            Effects.SendLocationParticles(
+                EffectItem.Create(Location, Map, EffectItem.DefaultDuration),
+                0x3728,
+                10,
+                10,
+                2023
+            );
+            Body = WispBody;
+            Hidden = true;
+            SetSkill(SkillName.Hiding, 100);
+            SetSkill(SkillName.Stealth, 100);
+            SetSkill(SkillName.SpiritSpeak, 0);
+            AllowedStealthSteps = 24;
+        }
+        else if (Combatant != null &&
+                 (FindItemOnLayer(Layer.OneHanded) ?? FindItemOnLayer(Layer.TwoHanded)) is BaseWeapon { Cursed: false })
+        {
+            new CurseWeaponSpell(this).Cast();
+        }
+
+        base.OnDamage(amount, from, willKill);
+    }
+
+    public override void OnThink()
+    {
+        base.OnThink();
+
+        if (Hidden && Hits > 100)
+        {
+            Body = TrueFormBody;
+            ConvertFromWisp();
+        }
+        else if (!Hidden && Body == WispBody)
+        {
+            UseSkill(SkillName.Hiding);
+            AllowedStealthSteps = 24;
+        }
+    }
+}
