+internal static class DonationRares
+{
+    public static void Give(BaseCreature boss, string message, Func<Item> rare)
+    {
+        var rights = BaseCreature.GetLootingRights(boss.DamageEntries, boss.HitsMax);
+        var eligible = new List<Mobile>();
+
+        for (var i = 0; i < rights.Count; ++i)
+        {
+            if (rights[i].m_HasRight)
+            {
+                eligible.Add(rights[i].m_Mobile);
+            }
+        }
+
+        for (var i = 0; i < eligible.Count; ++i)
+        {
+            if (Utility.RandomDouble() < 0.03)
+            {
+                eligible[i].SendMessage(message);
+                eligible[i].AddToBackpack(rare());
+            }
+        }
+    }
+}
