+    // Cold wind: 2 damage a second for 5 seconds; a fresh hit restarts it.
+    public override void OnGaveMeleeAttack(Mobile defender, int damage)
+    {
+        base.OnGaveMeleeAttack(defender, damage);
+
+        if (Utility.RandomDouble() >= 0.1)
+        {
+            return;
+        }
+
+        if (_coldWinds.Remove(defender, out var running))
+        {
+            running.Stop();
+            defender.SendLocalizedMessage(1070831); // The freezing wind continues to blow!
+        }
+        else
+        {
+            defender.SendLocalizedMessage(1070832); // An icy wind surrounds you, freezing your lungs as you breathe!
+        }
+
+        var wind = new ColdWind(defender, this);
+        _coldWinds[defender] = wind;
+        wind.Start();
+    }
+
+    private class ColdWind : Timer
+    {
+        private readonly Mobile _mobile;
+        private readonly Mobile _from;
+
+        public ColdWind(Mobile m, Mobile from) : base(TimeSpan.FromSeconds(1.0), TimeSpan.FromSeconds(1.0), 5)
+        {
+            _mobile = m;
+            _from = from;
+        }
+
+        protected override void OnTick()
+        {
+            if (!_mobile.Alive)
+            {
+                Expire();
+                return;
+            }
+
+            _mobile.Damage(2, _from);
+
+            if (Index + 1 >= Count)
+            {
+                Expire();
+                _mobile.SendLocalizedMessage(1070830); // The icy wind dissipates.
+            }
+        }
+
+        private void Expire()
+        {
+            Stop();
+
+            if (_coldWinds.TryGetValue(_mobile, out var current) && current == this)
+            {
+                _coldWinds.Remove(_mobile);
+            }
+        }
+    }
+}
