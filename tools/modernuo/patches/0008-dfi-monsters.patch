@@ -0,0 +1,130 @@
+// DFI Network stealth AI, ported from DFI RunUO Scripts/Custom/Engines/AI/AI/StealthAI.cs.
+// Out of combat the creature hides and stealths about, heals with spirit speak or bandages, and backs
+// off from what it detects while it is low on hits and still stealthed. Creatures opt in with
+// "public override BaseAI ForcedAI => new StealthAI(this);" since ModernUO has no AI_Stealth type.
+
+using Server.Items;
+
+namespace Server.Mobiles;
+
+public class StealthAI : MeleeAI
+{
+    public StealthAI(BaseCreature m) : base(m)
+    {
+    }
+
+    public override bool DoActionWander()
+    {
+        if (AcquireFocusMob(Mobile.RangePerception, Mobile.FightMode, false, false, true))
+        {
+            EngageOrSlipAway();
+            return true;
+        }
+
+        if (Mobile.Hits < Mobile.HitsMax)
+        {
+            HealOurself();
+            base.DoActionWander();
+        }
+        else if (Mobile.Skills.Hiding.Value >= 60.0)
+        {
+            if (!Mobile.Hidden && Mobile.AllowedStealthSteps == 0)
+            {
+                Mobile.UseSkill(SkillName.Hiding);
+            }
+            else if (Mobile.Skills.Stealth.Value >= 70.0 && Mobile.AllowedStealthSteps <= 2)
+            {
+                Mobile.UseSkill(SkillName.Stealth);
+            }
+
+            if (Mobile.AllowedStealthSteps > 0)
+            {
+                base.DoActionWander();
+            }
+        }
+        else
+        {
+            base.DoActionWander();
+        }
+
+        return true;
+    }
+
+    public override bool DoActionCombat()
+    {
+        var result = base.DoActionCombat();
+
+        if (Mobile.Hits < Mobile.HitsMax)
+        {
+            HealOurself();
+        }
+
+        return result;
+    }
+
+    public override bool DoActionGuard()
+    {
+        if (AcquireFocusMob(Mobile.RangePerception, Mobile.FightMode, false, false, true))
+        {
+            EngageOrSlipAway();
+            return true;
+        }
+
+        if (Mobile.Hits < Mobile.HitsMax)
+        {
+            HealOurself();
+        }
+
+        return base.DoActionGuard();
+    }
+
+    public override bool DoActionFlee()
+    {
+        if (Mobile.Hits < Mobile.HitsMax)
+        {
+            HealOurself();
+        }
+
+        return base.DoActionFlee();
+    }
+
+    private void EngageOrSlipAway()
+    {
+        if (Mobile.Hits <= 30 && Mobile.AllowedStealthSteps > 0)
+        {
+            RunFrom(Mobile.FocusMob);
+            return;
+        }
+
+        Mobile.Combatant = Mobile.FocusMob;
+        Action = ActionType.Combat;
+    }
+
+    private void HealOurself()
+    {
+        if (Mobile.Skills.SpiritSpeak.Value >= 60.0 && Mobile.Mana >= 10 && Core.TickCount - Mobile.NextSkillTime >= 0)
+        {
+            Mobile.UseSkill(SkillName.SpiritSpeak);
+        }
+
+        if ((Mobile.Skills.Veterinary.Value >= 60.0 || Mobile.Skills.Healing.Value >= 60.0) &&
+            BandageContext.GetContext(Mobile) == null)
+        {
+            BandageContext.BeginHeal(Mobile, Mobile);
+        }
+    }
+
+    private void RunFrom(Mobile m)
+    {
+        if (Mobile.Spell?.IsCasting == true || Mobile.Paralyzed || Mobile.Frozen || Mobile.DisallowAllMoves)
+        {
+            return;
+        }
+
+        var d = (Mobile.GetDirectionTo(m) - 4) & Direction.Mask;
+
+        // Running breaks stealth, so only run once the stealth steps are spent.
+        Mobile.Direction = Mobile.AllowedStealthSteps == 0 ? d | Direction.Running : d;
+        DoMove(Mobile.Direction, true);
+    }
+}
