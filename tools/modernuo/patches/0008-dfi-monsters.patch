+// DFI Network donation dungeon rares, ported from DFI RunUO
+// Scripts/Custom/Mobiles/Monsters/Donation Dungeon (PlantLoot.cs, RoyalLoot.cs).
+
+using ModernUO.Serialization;
+
+namespace Server.Items;
+
+[SerializationGenerator(0)]
+public partial class PlantRare : Item
+{
+    [Constructible]
+    public PlantRare() : base(RandomPlant())
+    {
+        Weight = 20;
+    }
+
+    public override string DefaultName => "A Tiny Plant";
+
+    private static int RandomPlant()
+    {
+        var roll = Utility.RandomDouble();
+
+        return roll switch
+        {
+            > 0.80  => 10460,
+            > 0.60  => 10461,
+            > 0.40  => 10462,
+            > 0.25  => 10463,
+            > 0.10  => 10464,
+            > 0.06  => 10465,
+            > 0.005 => 10467,
+            _       => 10466
+        };
+    }
+}
+
+[SerializationGenerator(0)]
+public partial class RoyalLoot : Item
+{
+    [Constructible]
+    public RoyalLoot() : base(10296)
+    {
+        Weight = 20;
+
+        var roll = Utility.RandomDouble();
+
+        if (roll > 0.60)
+        {
+            ItemID = 10296;
+            Name = "A Royal Butterfly";
+        }
+        else if (roll > 0.25)
+        {
+            ItemID = 10297;
+            Name = "A Royal Swan";
+        }
+        else if (roll > 0.08)
+        {
+            ItemID = 10298;
+            Name = "A Squashed Frog";
+        }
+        else
+        {
+            ItemID = 10299;
+            Hue = 1151;
+            Name = "A Royal Star";
+        }
+    }
+}
