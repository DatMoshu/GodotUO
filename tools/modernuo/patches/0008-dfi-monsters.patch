@@ -0,0 +1,175 @@
+using System;
+using System.Collections.Generic;
+using Server;
+using Server.Custom.Dfi;
+using Server.Items;
+using Server.Mobiles;
+using Xunit;
+
+namespace UOContent.Tests.Custom;
+
+[Collection("Sequential UOContent Tests")]
+public class DfiContentTests : IDisposable
+{
+    private readonly List<IEntity> _created = new();
+
+    // The shared test server does not load Data/names.xml; vampires and sentinels take random names.
+    public DfiContentTests()
+    {
+        if (NameList.GetNameList("female") == null)
+        {
+            NameList.Configure();
+        }
+    }
+
+    public static TheoryData<Type> Monsters =>
+    [
+        typeof(QuestMobile), typeof(VampireKnight), typeof(VampireFighter), typeof(VampireNecro),
+        typeof(MindlessZombie), typeof(Stalker), typeof(NightStalker), typeof(Undying), typeof(DarkSentinel),
+        typeof(HorrorDaemon), typeof(PoisonousRat), typeof(Doppelganger), typeof(OrcChopper), typeof(OrcScout),
+        typeof(Sphynx), typeof(Harvester), typeof(RoyaltyDefender), typeof(ZealotOfMondain),
+        typeof(AbominationOfMondain), typeof(OpticonWyrm), typeof(GrimReaper), typeof(ValoriteDragon),
+        typeof(Chameleon), typeof(YChameleon)
+    ];
+
+    public void Dispose()
+    {
+        foreach (var e in _created)
+        {
+            e?.Delete();
+        }
+
+        _created.Clear();
+    }
+
+    private T Place<T>(T bc, int x = 1500) where T : BaseCreature
+    {
+        var map = Map.Felucca;
+        map.GetAverageZ(x, 1600, out _, out var z, out _);
+        bc.MoveToWorld(new Point3D(x, 1600, (sbyte)z), map);
+        bc.AIObject?.AITimer?.Stop();
+        _created.Add(bc);
+        return bc;
+    }
+
+    [Theory]
+    [MemberData(nameof(Monsters))]
+    public void Monster_Spawns_WithNameBodyAndHits(Type type)
+    {
+        var bc = Place((BaseCreature)Activator.CreateInstance(type));
+
+        Assert.False(bc.Deleted);
+        Assert.False(string.IsNullOrWhiteSpace(bc.Name));
+        Assert.True(bc.Body.BodyID > 0);
+        Assert.True(bc.HitsMax > 0);
+        Assert.Equal(Map.Felucca, bc.Map);
+    }
+
+    [Fact]
+    public void SuperBoss_GeneratesDfiGoldAndAtLeastNineMagicItems()
+    {
+        var bc = Place(new Doppelganger());
+        var pack = new Backpack();
+        _created.Add(pack);
+
+        // Gold rolls when the creature spawns; magic items roll at death.
+        LootPack.SuperBoss.Generate(bc, pack, true, 0);
+        LootPack.SuperBoss.Generate(bc, pack, false, 0);
+
+        var gold = 0;
+        var items = 0;
+
+        foreach (var item in pack.Items)
+        {
+            if (item is Gold g)
+            {
+                gold += g.Amount;
+            }
+            else
+            {
+                items++;
+            }
+        }
+
+        Assert.InRange(gold, 604, 800); // 4d50+600
+        Assert.True(items >= 9, $"expected at least 9 magic items, got {items}");
+    }
+
+    [Fact]
+    public void QuestMobile_RewardBag_IsNamedForTheBossAndHoldsSixItems()
+    {
+        var boss = Place(new QuestMobile { Name = "Lord Test" });
+
+        var bag = boss.GetNewContainer();
+        _created.Add(bag);
+        DfiLoot.AddRandomLoot(bag, 5, 360, 4, 5, 50, 100);
+        DfiLoot.AddRandomLoot(bag, 1, 360, 5, 5, 70, 100);
+
+        Assert.Equal("Reward bag for slaying Lord Test", bag.Name);
+        Assert.Equal(6, bag.Items.Count);
+    }
+
+    [Fact]
+    public void ZealotOfMondain_Death_SpawnsAbominationCarryingLoot()
+    {
+        var zealot = Place(new ZealotOfMondain());
+        var location = zealot.Location;
+
+        zealot.Kill();
+
+        AbominationOfMondain abomination = null;
+
+        foreach (var m in Map.Felucca.GetMobilesInRange(location, 0))
+        {
+            if (m is AbominationOfMondain a)
+            {
+                abomination = a;
+            }
+        }
+
+        Assert.True(zealot.Deleted);
+        Assert.NotNull(abomination);
+        _created.Add(abomination);
+        Assert.True(abomination.Backpack.Items.Count > 0);
+    }
+
+    [Fact]
+    public void RoyaltyDefender_SurvivesFourDeaths_AsSuccessiveForms()
+    {
+        var defender = Place(new RoyaltyDefender());
+
+        string[] forms = ["The Defender Prince", "The Defender Queen", "The Defender King", "The Defended One"];
+
+        foreach (var form in forms)
+        {
+            defender.Kill();
+
+            Assert.True(defender.Alive);
+            Assert.Equal(form, defender.Name);
+        }
+
+        Assert.Equal(5, defender.Level);
+        Assert.True(defender.AutoDispel);
+    }
+
+    [Fact]
+    public void Undying_CannotDie_UntilHitByHue2121Weapon()
+    {
+        var undying = Place(new Undying());
+
+        undying.Kill();
+
+        Assert.True(undying.Alive);
+        Assert.Equal(50, undying.Hits);
+    }
+
+    [Fact]
+    public void FameLootPack_MatchesDfiTiers()
+    {
+        Assert.Same(LootPack.Average, DfiLoot.GetLootPackFromFame(0));
+        Assert.Same(LootPack.Rich, DfiLoot.GetLootPackFromFame(15000));
+        Assert.Same(LootPack.FilthyRich, DfiLoot.GetLootPackFromFame(20000));
+        Assert.Same(LootPack.UltraRich, DfiLoot.GetLootPackFromFame(25000));
+        Assert.Same(LootPack.SuperBoss, DfiLoot.GetLootPackFromFame(90000));
+    }
+}
