{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guo/muo-shard-profile@1",
  "title": "Shard host profile (docs/data_formats.md section 35)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "name", "server", "listen"],
  "properties": {
    "version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 64},
    "server": {"$ref": "#/$defs/server"},
    "config_overlay": {"$ref": "#/$defs/relpath"},
    "content": {"type": "array", "items": {"$ref": "#/$defs/relpath"}},
    "listen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {
        "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "address": {"type": "string", "pattern": "^[0-9A-Za-z.:]{1,64}$", "default": "0.0.0.0"}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
        "memory_max": {"type": "string", "pattern": "^[0-9]+[KMGT]?$"},
        "restart": {"enum": ["on-failure", "always"], "default": "on-failure"},
        "exec_start_pre": {"$ref": "#/$defs/argv"}
      }
    },
    "client_version": {"type": "string", "pattern": "^[0-9]+([.][0-9]+){1,3}[a-z]?$"},
    "data_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "verify"],
      "properties": {
        "file": {"$ref": "#/$defs/relpath"},
        "verify": {"enum": ["size", "sha256"]}
      }
    },
    "host_packages": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9+.-]*$"}
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {"type": "string", "pattern": "^/[A-Za-z0-9_./-]*$"},
        "include": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/relpath"}},
        "keep": {"type": "integer", "minimum": 1, "default": 14},
        "on_calendar": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9 :*,./~-]+$"}
      }
    },
    "seed": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
    "host_keys": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client_data": {"$ref": "#/$defs/envname"},
        "admin_user": {"$ref": "#/$defs/envname"},
        "admin_password": {"$ref": "#/$defs/envname"}
      }
    }
  },
  "$defs": {
    "relpath": {"type": "string", "minLength": 1, "maxLength": 260, "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$"},
    "envname": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "url", "ref"],
              "properties": {
                "kind": {"const": "git"},
                "url": {"type": "string", "pattern": "^https://[A-Za-z0-9._~:/?#@!$&'()*+,;=%-]+$"},
                "ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "path"],
              "properties": {
                "kind": {"const": "submodule"},
                "path": {"$ref": "#/$defs/relpath"}
              }
            }
          ]
        },
        "patches": {"type": "array", "items": {"$ref": "#/$defs/relpath"}},
        "assemblies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["project", "assembly"],
            "properties": {
              "project": {"$ref": "#/$defs/relpath"},
              "assembly": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+[.]dll$"}
            }
          }
        },
        "dotnet": {"type": "string", "pattern": "^[0-9]+[.][0-9]+$", "default": "10.0"},
        "build": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "output"],
          "properties": {
            "command": {"$ref": "#/$defs/argv"},
            "output": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
